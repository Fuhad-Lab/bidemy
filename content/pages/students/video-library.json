{"slug":"/students/video-library/","source":"students/video-library.html","area":"students","kind":"content","title":"Video Library — JUANOVA CORTEX","description":"","subject":null,"body":"<!-- Sidebar -->\n  <aside id=\"sidebar\" class=\"w-64 md:w-72 lg:w-80 fixed left-0 top-0 h-full bg-white border-r border-slate-200 p-5 flex flex-col gap-6 overflow-auto z-40\">\n    <div class=\"flex items-center gap-3\">\n      <img src=\"/site/assets/images/logo.png\" alt=\"logo\" class=\"h-12 w-12 rounded-full shadow-sm\">\n      <div>\n        <div class=\"text-lg font-bold text-sky-700\">JUANOVA CORTEX</div>\n        <div class=\"text-xs text-slate-500\">Video Learning</div>\n      </div>\n    </div>\n    \n    <nav class=\"flex-1 overflow-auto\">\n      <ul class=\"space-y-1\">\n        <li><a href=\"/students/student-dashboard/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50 text-slate-600 hover:text-slate-800\"><span class=\"mi -home text-sky-600 w-5\" data-mi=\"home\">home</span> Home</a></li>\n        <li><a href=\"/students/news-feed-gemini/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50 text-slate-600 hover:text-slate-800\"><span class=\"mi -newspaper text-pink-500 w-5\" data-mi=\"help_outline\">help_outline</span> News Feed</a></li>\n        <li><a href=\"/students/smart-note/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50 text-slate-600 hover:text-slate-800\"><span class=\"mi -note-sticky text-yellow-500 w-5\" data-mi=\"help_outline\">help_outline</span> Smart Notes</a></li>\n        <li><a href=\"/students/textbooks/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50 text-slate-600 hover:text-slate-800\"><span class=\"mi -book text-indigo-500 w-5\" data-mi=\"menu_book\">menu_book</span> Textbooks</a></li>\n        <li><a href=\"/students/formula-bank/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50 text-slate-600 hover:text-slate-800\"><span class=\"mi -square-root-alt text-teal-600 w-5\" data-mi=\"help_outline\">help_outline</span> Formula Bank</a></li>\n        <li><a href=\"/students/study-plan/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50 text-slate-600 hover:text-slate-800\"><span class=\"mi -calendar-check text-green-500 w-5\" data-mi=\"event_available\">event_available</span> Study Plan</a></li>\n        <li><a href=\"/students/video-library/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg bg-sky-50 text-sky-700\"><span class=\"mi -play-circle text-sky-600 w-5\" data-mi=\"play_circle\">play_circle</span> Video Library</a></li>\n        <li><a href=\"/students/digital-library/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50 text-slate-600 hover:text-slate-800\"><span class=\"mi -book-open text-indigo-500 w-5\" data-mi=\"auto_stories\">auto_stories</span> Digital Library</a></li>\n        <li><a href=\"/students/mock-exams/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50 text-slate-600 hover:text-slate-800\"><span class=\"mi -pencil-alt text-orange-500 w-5\" data-mi=\"edit\">edit</span> Mock Exams</a></li>\n        <li><a href=\"/students/student-live-session/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50 text-slate-600 hover:text-slate-800\"><span class=\"mi -chalkboard-teacher text-blue-400 w-5\" data-mi=\"co_present\">co_present</span> Live Sessions</a></li>\n      </ul>\n    </nav>\n    \n    <div class=\"text-sm text-slate-500 border-t border-slate-200 pt-4\">\n      <div class=\"mb-2 text-slate-400\">Account</div>\n      <div class=\"flex items-center gap-3\">\n        <img id=\"avatar-sm\" src=\"/site/assets/images/unnamed.jpg\" alt=\"avatar\" class=\"h-10 w-10 rounded-full border-2 border-sky-200\">\n        <div>\n          <div id=\"userName\" class=\"font-semibold text-slate-800\">Student</div>\n          <div id=\"userLevel\" class=\"text-xs text-slate-400\">SS 3</div>\n        </div>\n      </div>\n    </div>\n  </aside>\n\n  <!-- Main Content -->\n  <div id=\"main-content\" class=\"flex-1 flex flex-col lg:ml-72\">\n    \n    <!-- Header -->\n    <header class=\"sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-slate-200 px-6 py-4\">\n      <div class=\"flex items-center justify-between gap-4\">\n        <div class=\"flex items-center gap-4\">\n          <button id=\"toggleSidebar\" class=\"p-2 rounded-lg hover:bg-slate-100 lg:hidden\">\n            <span class=\"mi -bars text-slate-400\" data-mi=\"menu\">menu</span>\n          </button>\n          \n          <!-- Search -->\n          <div class=\"relative flex-1 max-w-2xl\">\n            <input id=\"searchInput\" type=\"search\" placeholder=\"Search educational videos, topics, channels...\" class=\"search-input w-full pl-12 pr-4 py-2.5 rounded-full border border-slate-200 bg-slate-50 text-slate-800 placeholder-slate-400 focus:outline-none focus:border-sky-300 focus:bg-white transition-all\">\n            <span class=\"mi -search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400\" data-mi=\"search\">search</span>\n            <kbd class=\"hidden sm:block absolute right-4 top-1/2 -translate-y-1/2 px-2 py-1 rounded bg-slate-100 text-xs text-slate-400 border border-slate-200\">⌘K</kbd>\n          </div>\n        </div>\n        \n        <div class=\"flex items-center gap-4\">\n          <!-- Stats -->\n          <div class=\"hidden md:flex items-center gap-6 text-sm\">\n            <div class=\"text-center\">\n              <div class=\"font-bold text-sky-600\" id=\"totalVideos\">0</div>\n              <div class=\"text-slate-400 text-xs\">Videos</div>\n            </div>\n            <div class=\"text-center\">\n              <div class=\"font-bold text-emerald-600\" id=\"watchedCount\">0</div>\n              <div class=\"text-slate-400 text-xs\">Watched</div>\n            </div>\n            <div class=\"text-center\">\n              <div class=\"font-bold text-amber-600\" id=\"savedCount\">0</div>\n              <div class=\"text-slate-400 text-xs\">Saved</div>\n            </div>\n          </div>\n          \n          <!-- User -->\n          <div class=\"flex items-center gap-3\">\n            <div class=\"text-right hidden sm:block\">\n              <div id=\"topName\" class=\"font-semibold text-slate-800\">Student</div>\n              <div id=\"topLevel\" class=\"text-xs text-slate-400\">SS 3</div>\n            </div>\n            <img id=\"topAvatar\" src=\"/site/assets/images/unnamed.jpg\" alt=\"avatar\" class=\"h-10 w-10 rounded-full border-2 border-sky-200\">\n          </div>\n        </div>\n      </div>\n    </header>\n\n    <!-- Main Body -->\n    <main class=\"p-6 space-y-6\">\n      \n      <!-- Hero Section -->\n      <section class=\"hero-pattern rounded-3xl p-8 text-white relative overflow-hidden\">\n        <div class=\"floating-shape\"></div>\n        <div class=\"floating-shape\"></div>\n        <div class=\"floating-shape\"></div>\n        \n        <div class=\"relative z-10 flex flex-col lg:flex-row items-center gap-8\">\n          <div class=\"flex-1\">\n            <div class=\"inline-flex items-center gap-2 px-4 py-2 bg-white/20 rounded-full text-white text-sm font-medium mb-4\">\n              <span class=\"mi -graduation-cap\" data-mi=\"school\">school</span>\n              <span>Learn Better with Videos</span>\n            </div>\n            <h1 class=\"text-3xl md:text-4xl font-bold mb-3\">\n              Cortex Video Learning\n            </h1>\n            <p class=\"text-white/80 text-lg mb-6 max-w-xl\">\n              Access curated educational videos from Excellence Academy. Master any subject with visual learning designed for WAEC, NECO &amp; JAMB success.\n            </p>\n            <div class=\"flex flex-wrap gap-3\">\n              <button class=\"quick-action px-5 py-2.5 bg-white text-sky-600 rounded-xl font-semibold hover:bg-sky-50 flex items-center gap-2 shadow-lg\">\n                <span class=\"mi -play\" data-mi=\"play_arrow\">play_arrow</span> Start Watching\n              </button>\n            </div>\n          </div>\n          \n          <!-- Featured Video Preview -->\n          <div class=\"w-full lg:w-96\">\n            <div class=\"video-card bg-white rounded-2xl overflow-hidden shadow-lg\">\n              <div class=\"relative aspect-video cursor-pointer\">\n                <img src=\"https://img.youtube.com/vi/MeKprfzpwY4/maxresdefault.jpg\" alt=\"Featured Video\" class=\"w-full h-full object-cover\">\n                <div class=\"play-overlay absolute inset-0 bg-black/40 flex items-center justify-center\">\n                  <div class=\"w-16 h-16 bg-sky-500 rounded-full flex items-center justify-center shadow-lg\">\n                    <span class=\"mi -play text-2xl text-white ml-1\" data-mi=\"play_arrow\">play_arrow</span>\n                  </div>\n                </div>\n                <div class=\"duration-badge absolute bottom-2 right-2 px-2 py-1 rounded text-xs font-medium text-white\">15:28</div>\n                <div class=\"absolute top-2 left-2 px-2 py-1 bg-sky-500 rounded text-xs font-medium text-white\">Featured</div>\n              </div>\n              <div class=\"p-4\">\n                <h3 class=\"font-semibold mb-1 text-slate-800 line-clamp-2\">Newton's Laws of Motion | JAMB &amp; WAEC Physics</h3>\n                <p class=\"text-sm text-slate-500\">Excellence Academy • 102K views</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- Categories -->\n      <section id=\"categoriesSection\" class=\"mt-6\">\n        <div class=\"flex items-center justify-between mb-4\">\n          <h2 class=\"text-xl font-bold text-slate-800\">Browse by Subject</h2>\n        </div>\n        \n        <div class=\"flex flex-wrap gap-2\" id=\"categoryPills\">\n          <button class=\"category-pill active px-4 py-2 rounded-full bg-white border border-slate-200 text-slate-600 font-medium flex items-center gap-2 text-sm\">\n            <span class=\"mi -th-large\" data-mi=\"help_outline\">help_outline</span> All Subjects\n          </button>\n          <button class=\"category-pill px-4 py-2 rounded-full bg-white border border-slate-200 text-slate-600 font-medium flex items-center gap-2 text-sm\">\n            <span class=\"mi -calculator text-red-500\" data-mi=\"calculate\">calculate</span> Mathematics\n          </button>\n          <button class=\"category-pill px-4 py-2 rounded-full bg-white border border-slate-200 text-slate-600 font-medium flex items-center gap-2 text-sm\">\n            <span class=\"mi -atom text-amber-500\" data-mi=\"atom\">atom</span> Physics\n          </button>\n          <button class=\"category-pill px-4 py-2 rounded-full bg-white border border-slate-200 text-slate-600 font-medium flex items-center gap-2 text-sm\">\n            <span class=\"mi -flask text-pink-500\" data-mi=\"science\">science</span> Chemistry\n          </button>\n          <button class=\"category-pill px-4 py-2 rounded-full bg-white border border-slate-200 text-slate-600 font-medium flex items-center gap-2 text-sm\">\n            <span class=\"mi -dna text-green-500\" data-mi=\"biotech\">biotech</span> Biology\n          </button>\n        </div>\n      </section>\n\n      <!-- Video Grid -->\n      <section id=\"videoGridSection\" class=\"mt-6\">\n        <div id=\"videoGrid\" class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5\">\n          <!-- Videos will be loaded dynamically -->\n        </div>\n        \n        <!-- Load More -->\n        <div class=\"text-center mt-8\" id=\"loadMoreContainer\">\n          <button class=\"px-8 py-3 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl font-medium text-slate-600 transition-colors shadow-sm\">\n            <span class=\"mi -plus mr-2\" data-mi=\"add\">add</span>Load More Videos\n          </button>\n        </div>\n      </section>\n\n    </main>\n  </div>\n\n  <!-- Video Player Modal -->\n  <div id=\"videoModal\" class=\"video-modal hidden fixed inset-0 bg-black/70 z-50 flex items-center justify-center p-4\">\n    <div class=\"bg-white rounded-2xl max-w-6xl w-full max-h-[95vh] overflow-hidden shadow-2xl\">\n      <!-- Video Header -->\n      <div class=\"flex items-center justify-between p-4 border-b border-slate-200\">\n        <h3 id=\"modalTitle\" class=\"font-semibold text-lg text-slate-800 truncate\">Video Title</h3>\n        <button class=\"w-10 h-10 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-400 hover:text-slate-600\">\n          <span class=\"mi -times\" data-mi=\"close\">close</span>\n        </button>\n      </div>\n      \n      <!-- Video Player -->\n      <div class=\"relative aspect-video bg-black\">\n        <iframe id=\"videoPlayer\" class=\"absolute inset-0 w-full h-full\" src=\"\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen=\"\">\n        </iframe>\n      </div>\n      \n      <!-- Video Info -->\n      <div class=\"p-5 space-y-4 max-h-60 overflow-y-auto bg-slate-50\">\n        <div class=\"flex items-start justify-between gap-4\">\n          <div class=\"flex-1\">\n            <p id=\"modalDescription\" class=\"text-slate-600 text-sm mb-3\">Video description will appear here...</p>\n            <div class=\"flex items-center gap-4 text-sm text-slate-500\">\n              <span id=\"modalViews\"><span class=\"mi -eye mr-1 text-slate-400\" data-mi=\"visibility\">visibility</span> 0 views</span>\n              <span id=\"modalDate\"><span class=\"mi -calendar mr-1 text-slate-400\" data-mi=\"calendar_month\">calendar_month</span> Today</span>\n              <span id=\"modalSubject\"><span class=\"mi -book mr-1 text-slate-400\" data-mi=\"menu_book\">menu_book</span> Subject</span>\n            </div>\n          </div>\n          <div class=\"flex gap-2\">\n            <button id=\"saveBtn\" class=\"px-4 py-2 bg-white border border-slate-200 hover:bg-slate-100 rounded-lg text-sm flex items-center gap-2 text-slate-600\">\n              <span class=\"mi -bookmark\" data-mi=\"bookmark\">bookmark</span> Save\n            </button>\n            <button class=\"px-4 py-2 bg-white border border-slate-200 hover:bg-slate-100 rounded-lg text-sm flex items-center gap-2 text-slate-600\">\n              <span class=\"mi -share\" data-mi=\"share\">share</span> Share\n            </button>\n          </div>\n        </div>\n        \n        <!-- Related Videos -->\n        <div>\n          <h4 class=\"font-medium mb-3 text-sm text-slate-500\">Related Videos</h4>\n          <div class=\"flex gap-3 overflow-x-auto pb-2\" id=\"relatedVideos\">\n            <!-- Related videos will be loaded here -->\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Toast Notification -->\n  <div id=\"toast\" class=\"fixed bottom-6 right-6 bg-white border border-slate-200 rounded-xl px-5 py-3 shadow-2xl transform translate-y-20 opacity-0 transition-all duration-300 z-50\">\n    <div class=\"flex items-center gap-3\">\n      <span class=\"mi -check-circle text-emerald-500\" data-mi=\"check_circle\">check_circle</span>\n      <span id=\"toastMessage\" class=\"text-sm text-slate-600\">Action completed</span>\n    </div>\n  </div>","bodyClass":"bg-slate-50 text-slate-800 min-h-screen","bodyStyle":"","css":["* { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }\n    \n    /* Custom Scrollbar */\n    ::-webkit-scrollbar { width: 8px; height: 8px; }\n    ::-webkit-scrollbar-track { background: #f1f5f9; }\n    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }\n    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }\n    \n    /* Video Card Hover */\n    .video-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }\n    .video-card:hover { transform: translateY(-5px); box-shadow: 0 20px 40px -12px rgba(14, 165, 233, 0.25); }\n    .video-card:hover .video-thumbnail { transform: scale(1.02); }\n    .video-thumbnail { transition: transform 0.3s ease; }\n    \n    /* Category Pills */\n    .category-pill { transition: all 0.2s ease; }\n    .category-pill:hover { transform: scale(1.02); }\n    .category-pill.active { background: linear-gradient(135deg, #0ea5e9, #0284c7); color: white; border-color: transparent; }\n    \n    /* Gradient Text */\n    .gradient-text { background: linear-gradient(135deg, #0ea5e9, #0284c7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }\n    \n    /* Hero Pattern */\n    .hero-pattern {\n      background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 50%, #0369a1 100%);\n      position: relative;\n      overflow: hidden;\n    }\n    \n    .hero-pattern::before {\n      content: '';\n      position: absolute;\n      top: 0; left: 0; right: 0; bottom: 0;\n      background-image: url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.08'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\");\n      animation: patternMove 20s linear infinite;\n    }\n    \n    @keyframes patternMove {\n      0% { background-position: 0 0; }\n      100% { background-position: 60px 60px; }\n    }\n    \n    /* Floating shapes */\n    .floating-shape {\n      position: absolute;\n      border-radius: 50%;\n      background: rgba(255, 255, 255, 0.1);\n      animation: float 6s ease-in-out infinite;\n    }\n    \n    .floating-shape:nth-child(1) { width: 100px; height: 100px; top: 10%; right: 10%; animation-delay: 0s; }\n    .floating-shape:nth-child(2) { width: 60px; height: 60px; bottom: 20%; right: 30%; animation-delay: 2s; }\n    .floating-shape:nth-child(3) { width: 80px; height: 80px; top: 50%; right: 5%; animation-delay: 4s; }\n    \n    @keyframes float {\n      0%, 100% { transform: translateY(0) rotate(0deg); }\n      50% { transform: translateY(-20px) rotate(10deg); }\n    }\n    \n    /* Sidebar */\n    #sidebar { transition: transform 0.3s ease-in-out; }\n    #sidebar.hide { transform: translateX(-100%); }\n    @media (min-width: 1024px) { #sidebar { transform: translateX(0) !important; } }\n    \n    /* Video Player Modal */\n    .video-modal { backdrop-filter: blur(8px); }\n    \n    /* Duration Badge */\n    .duration-badge { background: rgba(0,0,0,0.8); backdrop-filter: blur(4px); }\n    \n    /* Play Button Overlay */\n    .play-overlay { opacity: 0; transition: opacity 0.3s ease; }\n    .video-card:hover .play-overlay { opacity: 1; }\n    \n    /* Tab Active */\n    .tab-btn { position: relative; }\n    .tab-btn.active { color: #0ea5e9; }\n    .tab-btn.active::after { content: ''; position: absolute; bottom: -1px; left: 0; right: 0; height: 3px; background: #0ea5e9; border-radius: 2px 2px 0 0; }\n    \n    /* Search Focus */\n    .search-input:focus { box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.15); }\n    \n    /* Quick Action */\n    .quick-action {\n      transition: all 0.2s ease;\n    }\n    .quick-action:hover {\n      transform: translateY(-2px) scale(1.02);\n    }\n    \n    /* Stat Card Gradient */\n    .stat-card {\n      position: relative;\n      overflow: hidden;\n    }\n    .stat-card::before {\n      content: '';\n      position: absolute;\n      top: 0; right: 0;\n      width: 100px; height: 100px;\n      border-radius: 50%;\n      transform: translate(30%, -30%);\n      opacity: 0.1;\n    }"],"quiz":null,"tracker":null,"links":[]}