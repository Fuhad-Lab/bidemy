{"slug":"/students/study-plan/","source":"students/study-plan.html","area":"students","kind":"content","title":"Study Plan - JUANOVA CORTEX","description":"","subject":null,"body":"<div class=\"min-h-screen flex\">\n    <!-- Sidebar -->\n    <aside id=\"sidebar\" class=\"w-64 md:w-72 lg:w-80 fixed left-0 top-0 h-full bg-white border-r border-slate-200 p-5 flex flex-col gap-6 overflow-auto z-40\">\n      <div class=\"flex items-center gap-3\">\n        <img src=\"/site/assets/images/logo.png\" alt=\"logo\" class=\"h-12 w-12 rounded-full shadow-sm\">\n        <div>\n          <div class=\"text-lg font-bold text-sky-700\">JUANOVA CORTEX</div>\n          <div class=\"text-xs text-slate-500\">Student Dashboard</div>\n        </div>\n      </div>\n      <nav class=\"flex-1 overflow-auto\">\n        <ul class=\"space-y-1\">\n          <li><a href=\"/students/subjects/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -home text-sky-600\" data-mi=\"home\">home</span> Home</a></li>\n          <li><a href=\"/students/news-feed-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -newspaper text-pink-500\" data-mi=\"help_outline\">help_outline</span> News Feed</a></li>\n          <li><a href=\"/students/notes-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -note-sticky text-yellow-500\" data-mi=\"help_outline\">help_outline</span> Study Notes</a></li>\n          <li><a href=\"/students/textbooks-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -book text-indigo-500\" data-mi=\"menu_book\">menu_book</span> Textbooks</a></li>\n          <li><a href=\"/students/formula-bank-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -book-open text-teal-600\" data-mi=\"auto_stories\">auto_stories</span> All Formula</a></li>\n          <li><a href=\"/students/study-plan-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50 bg-sky-50\"><span class=\"mi -calendar-check text-green-500\" data-mi=\"event_available\">event_available</span> Study Plan</a></li>\n          <li><a href=\"/students/video-library-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -photo-video text-cyan-600\" data-mi=\"help_outline\">help_outline</span> Video Library</a></li>\n          <li><a href=\"/students/digital-library-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -book text-indigo-500\" data-mi=\"menu_book\">menu_book</span> Digital Library</a></li>\n          <li><a href=\"/students/mock-exams-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -pencil-alt text-orange-500\" data-mi=\"edit\">edit</span> Mock Exams</a></li>\n          <li><a href=\"/students/notifications-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -bell text-pink-600\" data-mi=\"notifications\">notifications</span> Notifications</a></li>\n          <li><a href=\"/students/student-live-session-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -chalkboard-teacher text-blue-400\" data-mi=\"co_present\">co_present</span> Live Sessions</a></li>\n          <li><a href=\"/students/nobel-laureate-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -award text-yellow-600\" data-mi=\"workspace_premium\">workspace_premium</span> Nobel Laureate</a></li>\n        </ul>\n      </nav>\n      <div class=\"text-sm text-slate-500 border-t pt-4\">\n        <div class=\"mb-2\">Account</div>\n        <div class=\"flex items-center gap-3\">\n          <img id=\"avatar-sm\" src=\"/site/assets/images/unnamed.jpg\" alt=\"avatar\" class=\"h-10 w-10 rounded-full border\">\n          <div>\n            <div id=\"userName\" class=\"font-semibold\">Student</div>\n            <div id=\"userLevel\" class=\"text-xs text-slate-400\"></div>\n          </div>\n        </div>\n      </div>\n    </aside>\n\n    <!-- Main Content -->\n    <div id=\"main-content\" class=\"flex-1 flex flex-col ml-64 md:ml-72 lg:ml-80\">\n      <!-- Header -->\n      <header class=\"flex items-center justify-between p-4 bg-white border-b border-slate-200 sticky top-0 z-30\">\n        <div class=\"flex items-center gap-3\">\n          <button id=\"toggleSidebar\" class=\"p-2 rounded-md hover:bg-slate-100 lg:hidden\">\n            <span class=\"mi -bars\" data-mi=\"menu\">menu</span>\n          </button>\n          <h1 class=\"text-xl font-semibold\">Study Plan</h1>\n        </div>\n        <div class=\"flex items-center gap-4\">\n          <div class=\"relative\">\n            <button id=\"notifBtn\" class=\"p-2 rounded-full hover:bg-slate-50\">\n              <span class=\"mi -bell text-sky-600\" data-mi=\"notifications\">notifications</span>\n            </button>\n            <span id=\"notifCount\" class=\"absolute -top-1 -right-1 bg-pink-500 text-white rounded-full w-5 h-5 text-xs flex items-center justify-center\">0</span>\n          </div>\n          <div class=\"flex items-center gap-3\">\n            <div class=\"text-right mr-2\">\n              <div id=\"topName\" class=\"font-semibold\">Student Name</div>\n              <div id=\"topLevel\" class=\"text-xs text-slate-400\">SS 3</div>\n            </div>\n            <img id=\"topAvatar\" src=\"/site/assets/images/unnamed.jpg\" alt=\"avatar\" class=\"h-10 w-10 rounded-full border-2\">\n          </div>\n        </div>\n      </header>\n\n      <!-- Main Content Area -->\n      <main class=\"flex-1 p-6 overflow-auto\">\n        <!-- Plan Creation Wizard (shown when no active plan) -->\n        <div id=\"planWizard\" class=\"max-w-4xl mx-auto\">\n          <!-- Progress Steps -->\n          <div class=\"flex items-center justify-center mb-8\">\n            <div class=\"flex items-center gap-2\">\n              <div id=\"step1-indicator\" class=\"w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center font-semibold\">1</div>\n              <div class=\"w-16 h-1 bg-slate-200\" id=\"progress1\"><div class=\"h-full bg-primary transition-all duration-500\" style=\"width: 0%\"></div></div>\n              <div id=\"step2-indicator\" class=\"w-10 h-10 rounded-full bg-slate-200 text-slate-500 flex items-center justify-center font-semibold\">2</div>\n              <div class=\"w-16 h-1 bg-slate-200\" id=\"progress2\"><div class=\"h-full bg-primary transition-all duration-500\" style=\"width: 0%\"></div></div>\n              <div id=\"step3-indicator\" class=\"w-10 h-10 rounded-full bg-slate-200 text-slate-500 flex items-center justify-center font-semibold\">3</div>\n              <div class=\"w-16 h-1 bg-slate-200\" id=\"progress3\"><div class=\"h-full bg-primary transition-all duration-500\" style=\"width: 0%\"></div></div>\n              <div id=\"step4-indicator\" class=\"w-10 h-10 rounded-full bg-slate-200 text-slate-500 flex items-center justify-center font-semibold\">4</div>\n            </div>\n          </div>\n\n          <!-- Step 1: Exam Selection -->\n          <div id=\"step1\" class=\"step-content fade-in\">\n            <div class=\"text-center mb-8\">\n              <h2 class=\"text-2xl font-bold text-slate-800 mb-2\">Which exam are you preparing for?</h2>\n              <p class=\"text-slate-500\">Select the exam type to customize your study plan</p>\n            </div>\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n              <button class=\"step-card p-6 rounded-xl border-2 border-slate-200 bg-white text-center hover:border-primary cursor-pointer\">\n                <div class=\"w-16 h-16 mx-auto mb-4 bg-green-100 rounded-full flex items-center justify-center\">\n                  <span class=\"mi -graduation-cap text-3xl text-green-600\" data-mi=\"school\">school</span>\n                </div>\n                <h3 class=\"text-xl font-semibold text-slate-800\">JAMB</h3>\n                <p class=\"text-sm text-slate-500 mt-2\">4 Subjects (English compulsory)</p>\n              </button>\n              <button class=\"step-card p-6 rounded-xl border-2 border-slate-200 bg-white text-center hover:border-primary cursor-pointer\">\n                <div class=\"w-16 h-16 mx-auto mb-4 bg-blue-100 rounded-full flex items-center justify-center\">\n                  <span class=\"mi -certificate text-3xl text-blue-600\" data-mi=\"card_membership\">card_membership</span>\n                </div>\n                <h3 class=\"text-xl font-semibold text-slate-800\">WAEC</h3>\n                <p class=\"text-sm text-slate-500 mt-2\">Select 9 subjects</p>\n              </button>\n              <button class=\"step-card p-6 rounded-xl border-2 border-slate-200 bg-white text-center hover:border-primary cursor-pointer\">\n                <div class=\"w-16 h-16 mx-auto mb-4 bg-purple-100 rounded-full flex items-center justify-center\">\n                  <span class=\"mi -award text-3xl text-purple-600\" data-mi=\"workspace_premium\">workspace_premium</span>\n                </div>\n                <h3 class=\"text-xl font-semibold text-slate-800\">NECO</h3>\n                <p class=\"text-sm text-slate-500 mt-2\">Select 9 subjects</p>\n              </button>\n            </div>\n          </div>\n\n          <!-- Step 2: Subject Selection -->\n          <div id=\"step2\" class=\"step-content hidden fade-in\">\n            <div class=\"text-center mb-6\">\n              <h2 class=\"text-2xl font-bold text-slate-800 mb-2\">Select Your Subjects</h2>\n              <p id=\"subjectInstruction\" class=\"text-slate-500\">Choose your subjects for the exam</p>\n            </div>\n            \n            <!-- Selected Subjects Counter -->\n            <div class=\"bg-primary/10 rounded-lg p-4 mb-6 flex items-center justify-between\">\n              <div class=\"flex items-center gap-3\">\n                <span class=\"mi -check-circle text-primary text-xl\" data-mi=\"check_circle\">check_circle</span>\n                <span id=\"selectedCount\" class=\"font-semibold text-slate-700\">0 subjects selected</span>\n              </div>\n              <span id=\"subjectLimit\" class=\"text-sm text-slate-500\">Select at least 3 subjects</span>\n            </div>\n\n            <!-- Subjects Grid -->\n            <div id=\"subjectsGrid\" class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mb-6 max-h-96 overflow-y-auto custom-scrollbar p-2\">\n              <!-- Subjects will be loaded here -->\n            </div>\n\n            <div class=\"flex justify-between mt-6\">\n              <button class=\"px-6 py-3 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-50\">\n                <span class=\"mi -arrow-left mr-2\" data-mi=\"arrow_back\">arrow_back</span> Back\n              </button>\n              <button id=\"nextToStep3\" disabled=\"\" class=\"px-6 py-3 rounded-lg bg-primary text-white hover:bg-primary/90 disabled:opacity-50 disabled:cursor-not-allowed\">\n                Continue <span class=\"mi -arrow-right ml-2\" data-mi=\"arrow_forward\">arrow_forward</span>\n              </button>\n            </div>\n          </div>\n\n          <!-- Step 3: Study Preferences -->\n          <div id=\"step3\" class=\"step-content hidden fade-in\">\n            <div class=\"text-center mb-8\">\n              <h2 class=\"text-2xl font-bold text-slate-800 mb-2\">Study Preferences</h2>\n              <p class=\"text-slate-500\">Help us create the perfect plan for you</p>\n            </div>\n\n            <div class=\"space-y-8 max-w-2xl mx-auto\">\n              <!-- Time to Exam -->\n              <div>\n                <label class=\"block text-lg font-semibold text-slate-700 mb-3\">\n                  <span class=\"mi -calendar-alt text-primary mr-2\" data-mi=\"calendar_month\">calendar_month</span>\n                  How long until your exam?\n                </label>\n                <div class=\"grid grid-cols-3 md:grid-cols-6 gap-3\">\n                  <button class=\"month-btn py-3 px-4 rounded-lg border-2 border-slate-200 hover:border-primary text-center\" data-months=\"1\">1 mo</button>\n                  <button class=\"month-btn py-3 px-4 rounded-lg border-2 border-slate-200 hover:border-primary text-center\" data-months=\"2\">2 mo</button>\n                  <button class=\"month-btn py-3 px-4 rounded-lg border-2 border-slate-200 hover:border-primary text-center\" data-months=\"3\">3 mo</button>\n                  <button class=\"month-btn py-3 px-4 rounded-lg border-2 border-slate-200 hover:border-primary text-center\" data-months=\"6\">6 mo</button>\n                  <button class=\"month-btn py-3 px-4 rounded-lg border-2 border-slate-200 hover:border-primary text-center\" data-months=\"12\">12 mo</button>\n                  <button class=\"month-btn py-3 px-4 rounded-lg border-2 border-slate-200 hover:border-primary text-center\" data-months=\"24\">24+ mo</button>\n                </div>\n              </div>\n\n              <!-- Learner Type -->\n              <div>\n                <label class=\"block text-lg font-semibold text-slate-700 mb-3\">\n                  <span class=\"mi -brain text-secondary mr-2\" data-mi=\"psychology\">psychology</span>\n                  What type of learner are you?\n                </label>\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                  <button class=\"learner-btn p-4 rounded-xl border-2 border-slate-200 hover:border-primary text-center\">\n                    <span class=\"mi -bolt text-2xl text-yellow-500 mb-2\" data-mi=\"bolt\">bolt</span>\n                    <h4 class=\"font-semibold\">Fast Learner</h4>\n                    <p class=\"text-xs text-slate-500\">Quick grasp, minimal repetition</p>\n                  </button>\n                  <button class=\"learner-btn p-4 rounded-xl border-2 border-slate-200 hover:border-primary text-center\">\n                    <span class=\"mi -balance-scale text-2xl text-blue-500 mb-2\" data-mi=\"balance\">balance</span>\n                    <h4 class=\"font-semibold\">Average Learner</h4>\n                    <p class=\"text-xs text-slate-500\">Moderate pace, some repetition</p>\n                  </button>\n                  <button class=\"learner-btn p-4 rounded-xl border-2 border-slate-200 hover:border-primary text-center\">\n                    <span class=\"mi -turtle text-2xl text-green-500 mb-2\" data-mi=\"help_outline\">help_outline</span>\n                    <h4 class=\"font-semibold\">Slow Learner</h4>\n                    <p class=\"text-xs text-slate-500\">Thorough, needs more practice</p>\n                  </button>\n                </div>\n              </div>\n\n              <!-- Daily Study Time -->\n              <div>\n                <label class=\"block text-lg font-semibold text-slate-700 mb-3\">\n                  <span class=\"mi -clock text-accent mr-2\" data-mi=\"schedule\">schedule</span>\n                  How much time daily for studying?\n                </label>\n                <div class=\"grid grid-cols-4 md:grid-cols-7 gap-3\">\n                  <button class=\"hours-btn py-3 px-2 rounded-lg border-2 border-slate-200 hover:border-primary text-center text-sm\" data-hours=\"1\">1 hr</button>\n                  <button class=\"hours-btn py-3 px-2 rounded-lg border-2 border-slate-200 hover:border-primary text-center text-sm\" data-hours=\"2\">2 hrs</button>\n                  <button class=\"hours-btn py-3 px-2 rounded-lg border-2 border-slate-200 hover:border-primary text-center text-sm\" data-hours=\"3\">3 hrs</button>\n                  <button class=\"hours-btn py-3 px-2 rounded-lg border-2 border-slate-200 hover:border-primary text-center text-sm\" data-hours=\"4\">4 hrs</button>\n                  <button class=\"hours-btn py-3 px-2 rounded-lg border-2 border-slate-200 hover:border-primary text-center text-sm\" data-hours=\"6\">6 hrs</button>\n                  <button class=\"hours-btn py-3 px-2 rounded-lg border-2 border-slate-200 hover:border-primary text-center text-sm\" data-hours=\"8\">8 hrs</button>\n                  <button class=\"hours-btn py-3 px-2 rounded-lg border-2 border-slate-200 hover:border-primary text-center text-sm\" data-hours=\"0\">Always free</button>\n                </div>\n              </div>\n            </div>\n\n            <div class=\"flex justify-between mt-8\">\n              <button class=\"px-6 py-3 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-50\">\n                <span class=\"mi -arrow-left mr-2\" data-mi=\"arrow_back\">arrow_back</span> Back\n              </button>\n              <button id=\"nextToStep4\" disabled=\"\" class=\"px-6 py-3 rounded-lg bg-primary text-white hover:bg-primary/90 disabled:opacity-50 disabled:cursor-not-allowed\">\n                Continue <span class=\"mi -arrow-right ml-2\" data-mi=\"arrow_forward\">arrow_forward</span>\n              </button>\n            </div>\n          </div>\n\n          <!-- Step 4: Review & Create -->\n          <div id=\"step4\" class=\"step-content hidden fade-in\">\n            <div class=\"text-center mb-8\">\n              <h2 class=\"text-2xl font-bold text-slate-800 mb-2\">Review Your Plan</h2>\n              <p class=\"text-slate-500\">Confirm your settings and create your personalized study plan</p>\n            </div>\n\n            <div class=\"max-w-2xl mx-auto\">\n              <!-- Summary Card -->\n              <div class=\"bg-white rounded-2xl shadow-lg border border-slate-200 overflow-hidden\">\n                <div class=\"bg-gradient-to-r from-primary to-secondary p-6 text-white\">\n                  <div class=\"flex items-center gap-4\">\n                    <div class=\"w-16 h-16 bg-white/20 rounded-full flex items-center justify-center\">\n                      <span class=\"mi -graduation-cap text-3xl\" data-mi=\"school\">school</span>\n                    </div>\n                    <div>\n                      <h3 id=\"reviewExamType\" class=\"text-2xl font-bold\">JAMB</h3>\n                      <p class=\"text-white/80\">Exam Preparation Plan</p>\n                    </div>\n                  </div>\n                </div>\n                \n                <div class=\"p-6 space-y-4\">\n                  <div class=\"flex justify-between items-center py-3 border-b border-slate-100\">\n                    <span class=\"text-slate-600\"><span class=\"mi -book mr-2 text-primary\" data-mi=\"menu_book\">menu_book</span>Subjects</span>\n                    <span id=\"reviewSubjects\" class=\"font-semibold text-slate-800\">-</span>\n                  </div>\n                  <div class=\"flex justify-between items-center py-3 border-b border-slate-100\">\n                    <span class=\"text-slate-600\"><span class=\"mi -calendar mr-2 text-primary\" data-mi=\"calendar_month\">calendar_month</span>Time to Exam</span>\n                    <span id=\"reviewMonths\" class=\"font-semibold text-slate-800\">-</span>\n                  </div>\n                  <div class=\"flex justify-between items-center py-3 border-b border-slate-100\">\n                    <span class=\"text-slate-600\"><span class=\"mi -brain mr-2 text-primary\" data-mi=\"psychology\">psychology</span>Learner Type</span>\n                    <span id=\"reviewLearnerType\" class=\"font-semibold text-slate-800\">-</span>\n                  </div>\n                  <div class=\"flex justify-between items-center py-3\">\n                    <span class=\"text-slate-600\"><span class=\"mi -clock mr-2 text-primary\" data-mi=\"schedule\">schedule</span>Daily Study Time</span>\n                    <span id=\"reviewDailyHours\" class=\"font-semibold text-slate-800\">-</span>\n                  </div>\n                </div>\n              </div>\n\n              <!-- AI Notice -->\n              <div class=\"mt-6 bg-amber-50 border border-amber-200 rounded-xl p-4\">\n                <div class=\"flex gap-3\">\n                  <span class=\"mi -lightbulb text-amber-500 text-xl\" data-mi=\"lightbulb\">lightbulb</span>\n                  <div>\n                    <h4 class=\"font-semibold text-amber-800\">AI-Powered Planning</h4>\n                    <p class=\"text-sm text-amber-700\">Our AI will create a personalized day-by-day study plan with prerequisites properly ordered. Topics that build on each other will be arranged in the optimal learning sequence.</p>\n                  </div>\n                </div>\n              </div>\n\n              <div class=\"flex justify-between mt-8\">\n                <button class=\"px-6 py-3 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-50\">\n                  <span class=\"mi -arrow-left mr-2\" data-mi=\"arrow_back\">arrow_back</span> Back\n                </button>\n                <button id=\"createPlanBtn\" class=\"px-8 py-3 rounded-lg bg-gradient-to-r from-primary to-secondary text-white font-semibold hover:opacity-90 transition-opacity\">\n                  <span class=\"mi -magic mr-2\" data-mi=\"help_outline\">help_outline</span> Create My Study Plan\n                </button>\n              </div>\n            </div>\n          </div>\n\n          <!-- Loading State -->\n          <div id=\"loadingState\" class=\"hidden text-center py-16\">\n            <div class=\"w-20 h-20 mx-auto mb-6 rounded-full bg-primary/10 flex items-center justify-center\">\n              <span class=\"mi -cog -spin text-4xl text-primary\" data-mi=\"settings\">settings</span>\n            </div>\n            <h3 class=\"text-xl font-semibold text-slate-800 mb-2\">Creating Your Study Plan...</h3>\n            <p class=\"text-slate-500\">Our AI is designing the optimal learning path for you</p>\n            <div class=\"mt-6 max-w-md mx-auto\">\n              <div class=\"h-2 bg-slate-200 rounded-full overflow-hidden\">\n                <div id=\"loadingProgress\" class=\"h-full bg-primary rounded-full transition-all duration-500\" style=\"width: 0%\"></div>\n              </div>\n              <p id=\"loadingStatus\" class=\"text-sm text-slate-500 mt-2\">Analyzing your subjects...</p>\n            </div>\n          </div>\n        </div>\n\n        <!-- Active Plan View (shown when plan exists) -->\n        <div id=\"activePlanView\" class=\"hidden\">\n          <!-- Plan Header -->\n          <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-6 mb-6\">\n            <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n              <div>\n                <div class=\"flex items-center gap-3 mb-2\">\n                  <span class=\"px-3 py-1 rounded-full bg-green-100 text-green-700 text-sm font-medium\">\n                    <span class=\"mi -check-circle mr-1\" data-mi=\"check_circle\">check_circle</span> Active Plan\n                  </span>\n                  <span id=\"planExamBadge\" class=\"px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-medium\">JAMB</span>\n                </div>\n                <h2 class=\"text-2xl font-bold text-slate-800\">Your Study Plan</h2>\n                <p id=\"planExamDate\" class=\"text-slate-500 mt-1\">\n                  <span class=\"mi -calendar mr-2\" data-mi=\"calendar_month\">calendar_month</span>Exam date: <span class=\"font-medium\">Not set</span>\n                </p>\n              </div>\n              <div class=\"flex items-center gap-3\">\n                <button class=\"px-4 py-2 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-50\">\n                  <span class=\"mi -redo mr-2\" data-mi=\"redo\">redo</span> Reset Plan\n                </button>\n              </div>\n            </div>\n\n            <!-- Progress Overview -->\n            <div class=\"grid grid-cols-2 md:grid-cols-4 gap-4 mt-6\">\n              <div class=\"bg-slate-50 rounded-xl p-4 text-center\">\n                <div class=\"text-3xl font-bold text-primary\" id=\"totalDays\">0</div>\n                <div class=\"text-sm text-slate-500\">Total Days</div>\n              </div>\n              <div class=\"bg-slate-50 rounded-xl p-4 text-center\">\n                <div class=\"text-3xl font-bold text-green-500\" id=\"completedDays\">0</div>\n                <div class=\"text-sm text-slate-500\">Completed</div>\n              </div>\n              <div class=\"bg-slate-50 rounded-xl p-4 text-center\">\n                <div class=\"text-3xl font-bold text-amber-500\" id=\"currentStreak\">0</div>\n                <div class=\"text-sm text-slate-500\">Day Streak</div>\n              </div>\n              <div class=\"bg-slate-50 rounded-xl p-4 text-center\">\n                <div class=\"text-3xl font-bold text-secondary\" id=\"overallProgress\">0%</div>\n                <div class=\"text-sm text-slate-500\">Progress</div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Day-by-Day Plan -->\n          <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n            <!-- Calendar/Schedule View -->\n            <div class=\"lg:col-span-2\">\n              <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden\">\n                <div class=\"p-4 border-b border-slate-200 flex items-center justify-between\">\n                  <h3 class=\"font-semibold text-slate-800\">\n                    <span class=\"mi -calendar-alt text-primary mr-2\" data-mi=\"calendar_month\">calendar_month</span>Study Schedule\n                  </h3>\n                  <div class=\"flex gap-2\">\n                    <button class=\"task-filter px-3 py-1 rounded-lg text-sm bg-primary text-white\" data-filter=\"all\">All</button>\n                    <button class=\"task-filter px-3 py-1 rounded-lg text-sm bg-slate-100 text-slate-600 hover:bg-slate-200\" data-filter=\"pending\">Pending</button>\n                    <button class=\"task-filter px-3 py-1 rounded-lg text-sm bg-slate-100 text-slate-600 hover:bg-slate-200\" data-filter=\"completed\">Completed</button>\n                  </div>\n                </div>\n                <div id=\"daysContainer\" class=\"max-h-[600px] overflow-y-auto custom-scrollbar\">\n                  <!-- Days will be loaded here -->\n                </div>\n              </div>\n            </div>\n\n            <!-- Today's Tasks Sidebar -->\n            <div>\n              <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden sticky top-24\">\n                <div class=\"bg-gradient-to-r from-primary to-secondary p-4 text-white\">\n                  <h3 class=\"font-semibold\">\n                    <span class=\"mi -tasks mr-2\" data-mi=\"checklist\">checklist</span>Today's Tasks\n                  </h3>\n                  <p id=\"todayDate\" class=\"text-sm text-white/80 mt-1\"></p>\n                </div>\n                <div id=\"todayTasks\" class=\"p-4 max-h-96 overflow-y-auto custom-scrollbar\">\n                  <!-- Today's tasks will be loaded here -->\n                </div>\n                <div class=\"p-4 border-t border-slate-100\">\n                  <div class=\"flex items-center justify-between text-sm\">\n                    <span class=\"text-slate-500\">Today's Progress</span>\n                    <span id=\"todayProgress\" class=\"font-semibold text-primary\">0%</span>\n                  </div>\n                  <div class=\"h-2 bg-slate-100 rounded-full mt-2 overflow-hidden\">\n                    <div id=\"todayProgressBar\" class=\"h-full bg-primary rounded-full transition-all duration-500\" style=\"width: 0%\"></div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </main>\n    </div>\n  </div>\n\n  <!-- Task Completion Modal -->\n  <div id=\"taskModal\" class=\"fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden\">\n    <div class=\"bg-white rounded-2xl max-w-md w-full mx-4 overflow-hidden\">\n      <div class=\"p-6\">\n        <h3 id=\"modalTaskTitle\" class=\"text-xl font-bold text-slate-800 mb-2\">Task Title</h3>\n        <p id=\"modalTaskSubject\" class=\"text-sm text-slate-500 mb-4\">\n          <span class=\"mi -book mr-1\" data-mi=\"menu_book\">menu_book</span> Subject\n        </p>\n        \n        <div id=\"modalPrerequisites\" class=\"mb-4\">\n          <h4 class=\"text-sm font-semibold text-slate-600 mb-2\">Prerequisites:</h4>\n          <div id=\"prereqList\" class=\"text-sm text-slate-500\"></div>\n        </div>\n\n        <div class=\"mb-4\">\n          <label class=\"block text-sm font-semibold text-slate-600 mb-2\">Notes (optional):</label>\n          <textarea id=\"taskNotes\" rows=\"3\" class=\"w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent\" placeholder=\"Add any notes about this topic...\"></textarea>\n        </div>\n      </div>\n      <div class=\"flex border-t border-slate-200\">\n        <button class=\"flex-1 py-3 text-slate-600 hover:bg-slate-50\">Cancel</button>\n        <button class=\"flex-1 py-3 bg-green-500 text-white hover:bg-green-600 font-semibold\">Mark Complete</button>\n      </div>\n    </div>\n  </div>","bodyClass":"bg-slate-50 min-h-screen","bodyStyle":"","css":["#sidebar { transition: transform 0.3s ease-in-out; }\n    #sidebar.hide { transform: translateX(-100%); }\n    @media (min-width: 1024px) { #sidebar { transform: translateX(0) !important; } }\n    \n    .step-card { transition: all 0.3s ease; }\n    .step-card:hover { transform: translateY(-2px); }\n    .step-card.active { border-color: #0ea5e9; background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%); }\n    .step-card.selected { border-color: #22c55e; background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); }\n    \n    .subject-card { transition: all 0.2s ease; }\n    .subject-card:hover { transform: scale(1.02); }\n    .subject-card.selected { border-color: #22c55e; background: #f0fdf4; box-shadow: 0 0 0 2px #22c55e; }\n    \n    .task-item { transition: all 0.2s ease; }\n    .task-item:hover { background: #f8fafc; }\n    .task-item.completed { opacity: 0.7; background: #f0fdf4; }\n    \n    .progress-ring { transition: stroke-dashoffset 0.5s ease; }\n    \n    .fade-in { animation: fadeIn 0.3s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }\n    \n    .slide-up { animation: slideUp 0.4s ease; }\n    @keyframes slideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }\n    \n    .pulse-dot { animation: pulse 2s infinite; }\n    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }\n    \n    .custom-scrollbar::-webkit-scrollbar { width: 6px; }\n    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 3px; }\n    .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }\n    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }"],"quiz":null,"tracker":null,"links":[]}