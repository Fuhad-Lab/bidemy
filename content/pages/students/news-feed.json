{"slug":"/students/news-feed/","source":"students/news-feed.html","area":"students","kind":"content","title":"News Feed - JUANOVA CORTEX","description":"","subject":null,"body":"<!-- Main content area -->\n  <div id=\"main-content\" class=\"flex-1 flex flex-col ml-64 md:ml-72 lg:ml-80\">\n    <!-- Topbar -->\n    <header class=\"flex items-center justify-between p-4 bg-white border-b border-slate-200\">\n      <div class=\"flex items-center gap-3\">\n        <button id=\"toggleSidebar\" class=\"p-2 rounded-md hover:bg-slate-100 lg:hidden\" title=\"Toggle sidebar\">\n          <span class=\"mi -bars\" data-mi=\"menu\">menu</span>\n        </button>\n        <div class=\"relative\">\n          <input id=\"globalSearch\" type=\"search\" placeholder=\"Search news and updates...\" class=\"w-[520px] hidden md:inline-block pl-10 pr-4 py-2 rounded-full border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-sky-100\">\n          <span class=\"mi -search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" data-mi=\"search\">search</span>\n        </div>\n      </div>\n\n      <div class=\"flex items-center gap-4\">\n        <div class=\"relative\">\n          <button id=\"notifBtn\" class=\"p-2 rounded-full hover:bg-slate-50\" aria-label=\"Notifications\">\n            <span class=\"mi -bell text-sky-600\" data-mi=\"notifications\">notifications</span>\n          </button>\n          <span id=\"notifCount\" class=\"absolute -top-1 -right-1 bg-pink-500 text-white rounded-full w-5 h-5 text-xs flex items-center justify-center\">0</span>\n        </div>\n        <div class=\"flex items-center gap-3\">\n          <div class=\"text-right mr-2\">\n            <div id=\"topName\" class=\"font-semibold\">Student Name</div>\n            <div id=\"topLevel\" class=\"text-xs text-slate-400\">SS 3</div>\n          </div>\n          <img id=\"topAvatar\" src=\"/site/assets/images/unnamed.jpg\" alt=\"avatar\" class=\"h-10 w-10 rounded-full border-2\">\n        </div>\n      </div>\n    </header>\n\n    <!-- Page Content -->\n    <main class=\"p-6\">\n      <!-- Page Header -->\n      <div class=\"mb-8\">\n        <h1 class=\"text-3xl font-bold text-gray-800 mb-2\">Educational News Feed</h1>\n        <p class=\"text-gray-600\">Stay updated with the latest educational news, exam updates, and study tips.</p>\n      </div>\n\n      <!-- Categories Filter -->\n      <div class=\"flex gap-3 mb-6 overflow-x-auto pb-2\">\n        <button class=\"px-4 py-2 rounded-full bg-sky-600 text-white font-medium text-sm\">All Updates</button>\n        <button class=\"px-4 py-2 rounded-full bg-white text-slate-600 font-medium text-sm hover:bg-slate-50\">Exam News</button>\n        <button class=\"px-4 py-2 rounded-full bg-white text-slate-600 font-medium text-sm hover:bg-slate-50\">Study Tips</button>\n        <button class=\"px-4 py-2 rounded-full bg-white text-slate-600 font-medium text-sm hover:bg-slate-50\">Resources</button>\n        <button class=\"px-4 py-2 rounded-full bg-white text-slate-600 font-medium text-sm hover:bg-slate-50\">Events</button>\n      </div>\n\n      <!-- News Feed Grid -->\n      <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n        <!-- News Items -->\n        <div class=\"bg-white rounded-xl shadow p-5 space-y-4\">\n          <div class=\"flex items-center gap-3\">\n            <div class=\"w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center\">\n              <span class=\"mi -newspaper text-purple-600 text-xl\" data-mi=\"help_outline\">help_outline</span>\n            </div>\n            <div class=\"flex-1\">\n              <h3 class=\"font-semibold text-gray-800\">2026 WAEC Updates</h3>\n              <p class=\"text-sm text-gray-500\">2 hours ago</p>\n            </div>\n          </div>\n          <p class=\"text-gray-600\">Important updates about the upcoming WAEC examination schedule and format changes.</p>\n          <a href=\"#\" class=\"text-sky-600 text-sm font-medium hover:underline\">Read more</a>\n        </div>\n\n        <div class=\"bg-white rounded-xl shadow p-5 space-y-4\">\n          <div class=\"flex items-center gap-3\">\n            <div class=\"w-12 h-12 bg-green-100 rounded-full flex items-center justify-center\">\n              <span class=\"mi -lightbulb text-green-600 text-xl\" data-mi=\"lightbulb\">lightbulb</span>\n            </div>\n            <div class=\"flex-1\">\n              <h3 class=\"font-semibold text-gray-800\">Study Tip of the Day</h3>\n              <p class=\"text-sm text-gray-500\">5 hours ago</p>\n            </div>\n          </div>\n          <p class=\"text-gray-600\">Discover effective memory techniques for better exam preparation.</p>\n          <a href=\"#\" class=\"text-sky-600 text-sm font-medium hover:underline\">Read more</a>\n        </div>\n\n        <div class=\"bg-white rounded-xl shadow p-5 space-y-4\">\n          <div class=\"flex items-center gap-3\">\n            <div class=\"w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center\">\n              <span class=\"mi -calendar-alt text-blue-600 text-xl\" data-mi=\"calendar_month\">calendar_month</span>\n            </div>\n            <div class=\"flex-1\">\n              <h3 class=\"font-semibold text-gray-800\">Upcoming Live Sessions</h3>\n              <p class=\"text-sm text-gray-500\">1 day ago</p>\n            </div>\n          </div>\n          <p class=\"text-gray-600\">Join our expert tutors for interactive sessions on key exam topics.</p>\n          <a href=\"#\" class=\"text-sky-600 text-sm font-medium hover:underline\">Read more</a>\n        </div>\n\n        <div class=\"bg-white rounded-xl shadow p-5 space-y-4\">\n          <div class=\"flex items-center gap-3\">\n            <div class=\"w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center\">\n              <span class=\"mi -book text-yellow-600 text-xl\" data-mi=\"menu_book\">menu_book</span>\n            </div>\n            <div class=\"flex-1\">\n              <h3 class=\"font-semibold text-gray-800\">New Study Materials</h3>\n              <p class=\"text-sm text-gray-500\">2 days ago</p>\n            </div>\n          </div>\n          <p class=\"text-gray-600\">Access the latest study materials and practice questions for all subjects.</p>\n          <a href=\"#\" class=\"text-sky-600 text-sm font-medium hover:underline\">Read more</a>\n        </div>\n\n        <div class=\"bg-white rounded-xl shadow p-5 space-y-4\">\n          <div class=\"flex items-center gap-3\">\n            <div class=\"w-12 h-12 bg-pink-100 rounded-full flex items-center justify-center\">\n              <span class=\"mi -trophy text-pink-600 text-xl\" data-mi=\"emoji_events\">emoji_events</span>\n            </div>\n            <div class=\"flex-1\">\n              <h3 class=\"font-semibold text-gray-800\">Success Stories</h3>\n              <p class=\"text-sm text-gray-500\">3 days ago</p>\n            </div>\n          </div>\n          <p class=\"text-gray-600\">Read inspiring stories from students who achieved their exam goals.</p>\n          <a href=\"#\" class=\"text-sky-600 text-sm font-medium hover:underline\">Read more</a>\n        </div>\n\n        <div class=\"bg-white rounded-xl shadow p-5 space-y-4\">\n          <div class=\"flex items-center gap-3\">\n            <div class=\"w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center\">\n              <span class=\"mi -graduation-cap text-indigo-600 text-xl\" data-mi=\"school\">school</span>\n            </div>\n            <div class=\"flex-1\">\n              <h3 class=\"font-semibold text-gray-800\">Career Guidance</h3>\n              <p class=\"text-sm text-gray-500\">4 days ago</p>\n            </div>\n          </div>\n          <p class=\"text-gray-600\">Expert advice on choosing the right career path after exams.</p>\n          <a href=\"#\" class=\"text-sky-600 text-sm font-medium hover:underline\">Read more</a>\n        </div>\n      </div>\n\n      <!-- Load More Button -->\n      <div class=\"text-center mt-8\">\n        <button class=\"px-6 py-2 bg-sky-600 text-white font-medium rounded-full hover:bg-sky-700 transition-colors\">\n          Load More News\n        </button>\n      </div>\n    </main>\n  </div>\n\n  <!-- Chatbot Widget -->\n  <div id=\"cortex-ai-chat-button\" role=\"button\" aria-label=\"Open Cortex AI chat\">\n    <img src=\"/site/cortex-owl-brain.svg\" alt=\"Cortex AI\" class=\"cortex-icon\" style=\"width:72px;height:72px;box-shadow:0 4px 16px rgba(0,0,0,0.20);border-radius:16px;transition:transform 0.18s cubic-bezier(.4,2,.6,1),box-shadow 0.18s;cursor:pointer;\" onmouseover=\"this.style.transform='scale(1.12)';this.style.boxShadow='0 8px 32px rgba(0,0,0,0.28)';\" onmouseout=\"this.style.transform='scale(1)';this.style.boxShadow='0 4px 16px rgba(0,0,0,0.20)';\" onmousedown=\"this.style.transform='scale(0.96)';\" onmouseup=\"this.style.transform='scale(1.12)';\">\n  </div>\n  <iframe id=\"cortex-ai-chat-popup\" src=\"https://app.edcafe.ai/chatbots/68b96ebb2a5be310497b6a0b\"></iframe>\n\n  <!-- Scripts -->\n  \n\n  <!-- Import shared student page components -->\n  \n  \n\n  <style>\n    #cortex-ai-chat-button {\n      position: fixed;\n      bottom: 20px;\n      right: 20px;\n      background: transparent;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 0;\n      border: none;\n      z-index: 1000;\n    }\n\n    #cortex-ai-chat-popup {\n      position: fixed;\n      bottom: 90px;\n      right: 20px;\n      width: 380px;\n      height: 500px;\n      border: none;\n      border-radius: 12px;\n      box-shadow: 0px 4px 16px rgba(0,0,0,0.4);\n      display: none;\n      z-index: 1000;\n    }\n  </style>","bodyClass":"bg-slate-50","bodyStyle":"","css":["#sidebar { transition: transform 0.3s ease-in-out; }\n    #sidebar.hide { transform: translateX(-100%); }\n    @media (min-width: 1024px) { #sidebar { transform: translateX(0) !important; } }","#cortex-ai-chat-button {\n      position: fixed;\n      bottom: 20px;\n      right: 20px;\n      background: transparent;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 0;\n      border: none;\n      z-index: 1000;\n    }\n\n    #cortex-ai-chat-popup {\n      position: fixed;\n      bottom: 90px;\n      right: 20px;\n      width: 380px;\n      height: 500px;\n      border: none;\n      border-radius: 12px;\n      box-shadow: 0px 4px 16px rgba(0,0,0,0.4);\n      display: none;\n      z-index: 1000;\n    }"],"quiz":null,"tracker":null,"links":[]}