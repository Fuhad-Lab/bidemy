{"slug":"/students/js/student-template/","source":"students/js/student-template.html","area":"students","kind":"content","title":"Student Page - JUANOVA CORTEX","description":"","subject":null,"body":"<!-- Main content area -->\n  <div id=\"main-content\" class=\"flex-1 flex flex-col ml-64 md:ml-72 lg:ml-80\">\n    <!-- Topbar -->\n    <header class=\"flex items-center justify-between p-4 bg-white border-b border-slate-200\">\n      <div class=\"flex items-center gap-3\">\n        <button id=\"toggleSidebar\" class=\"p-2 rounded-md hover:bg-slate-100 lg:hidden\" title=\"Toggle sidebar\">\n          <span class=\"mi -bars\" data-mi=\"menu\">menu</span>\n        </button>\n        <div class=\"relative\">\n          <input id=\"globalSearch\" type=\"search\" placeholder=\"Search...\" class=\"w-[520px] hidden md:inline-block pl-10 pr-4 py-2 rounded-full border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-sky-100\">\n          <span class=\"mi -search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" data-mi=\"search\">search</span>\n        </div>\n      </div>\n\n      <div class=\"flex items-center gap-4\">\n        <div class=\"relative\">\n          <button id=\"notifBtn\" class=\"p-2 rounded-full hover:bg-slate-50\" aria-label=\"Notifications\">\n            <span class=\"mi -bell text-sky-600\" data-mi=\"notifications\">notifications</span>\n          </button>\n          <span id=\"notifCount\" class=\"absolute -top-1 -right-1 bg-pink-500 text-white rounded-full w-5 h-5 text-xs flex items-center justify-center\">0</span>\n        </div>\n        <div class=\"flex items-center gap-3\">\n          <div class=\"text-right mr-2\">\n            <div id=\"topName\" class=\"font-semibold\">Student Name</div>\n            <div id=\"topLevel\" class=\"text-xs text-slate-400\">SS 3</div>\n          </div>\n          <img id=\"topAvatar\" src=\"/site/assets/images/unnamed.jpg\" alt=\"avatar\" class=\"h-10 w-10 rounded-full border-2\">\n        </div>\n      </div>\n    </header>\n\n    <!-- Page Content Goes Here -->\n    <main class=\"p-6\">\n      <!-- Content will be inserted here -->\n    </main>\n  </div>\n\n  <!-- Chatbot Widget -->\n  <div id=\"cortex-ai-chat-button\" role=\"button\" aria-label=\"Open Cortex AI chat\">\n    <img src=\"../cortex-owl-brain.svg\" alt=\"Cortex AI\" class=\"cortex-icon\" style=\"width:72px;height:72px;box-shadow:0 4px 16px rgba(0,0,0,0.20);border-radius:16px;transition:transform 0.18s cubic-bezier(.4,2,.6,1),box-shadow 0.18s;cursor:pointer;\" onmouseover=\"this.style.transform='scale(1.12)';this.style.boxShadow='0 8px 32px rgba(0,0,0,0.28)';\" onmouseout=\"this.style.transform='scale(1)';this.style.boxShadow='0 4px 16px rgba(0,0,0,0.20)';\" onmousedown=\"this.style.transform='scale(0.96)';\" onmouseup=\"this.style.transform='scale(1.12)';\">\n  </div>\n  <iframe id=\"cortex-ai-chat-popup\" src=\"https://app.edcafe.ai/chatbots/68b96ebb2a5be310497b6a0b\"></iframe>\n\n  <!-- Scripts -->\n  \n\n  <!-- Import shared student page components -->\n  \n  \n\n  <style>\n    #cortex-ai-chat-button {\n      position: fixed;\n      bottom: 20px;\n      right: 20px;\n      background: transparent;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 0;\n      border: none;\n      z-index: 1000;\n    }\n\n    #cortex-ai-chat-popup {\n      position: fixed;\n      bottom: 90px;\n      right: 20px;\n      width: 380px;\n      height: 500px;\n      border: none;\n      border-radius: 12px;\n      box-shadow: 0px 4px 16px rgba(0,0,0,0.4);\n      display: none;\n      z-index: 1000;\n    }\n  </style>","bodyClass":"bg-slate-50","bodyStyle":"","css":["#cortex-ai-chat-button {\n      position: fixed;\n      bottom: 20px;\n      right: 20px;\n      background: transparent;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 0;\n      border: none;\n      z-index: 1000;\n    }\n\n    #cortex-ai-chat-popup {\n      position: fixed;\n      bottom: 90px;\n      right: 20px;\n      width: 380px;\n      height: 500px;\n      border: none;\n      border-radius: 12px;\n      box-shadow: 0px 4px 16px rgba(0,0,0,0.4);\n      display: none;\n      z-index: 1000;\n    }"],"quiz":null,"tracker":null,"links":[]}