{"slug":"/students/learning-report/learning-report/","source":"students/learning-report/learning-report.html","area":"students","kind":"content","title":"Learning Report - Juanova Cortex","description":"","subject":null,"body":"<!-- Navigation Bar -->\n    <nav class=\"bg-white border-b border-slate-200 sticky top-0 z-50\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"flex justify-between h-16\">\n                <!-- Logo -->\n                <div class=\"flex items-center\">\n                    <a href=\"/students/student-dashboard/\" class=\"flex items-center gap-2\">\n                        <span class=\"text-2xl\">🧠</span>\n                        <span class=\"text-xl font-bold bg-gradient-to-r from-sky-600 to-blue-600 bg-clip-text text-transparent\">\n                            Juanova Cortex\n                        </span>\n                    </a>\n                </div>\n                \n                <!-- Navigation Links -->\n                <div class=\"hidden md:flex items-center gap-6\">\n                    <a href=\"/students/student-dashboard/\" class=\"text-slate-600 hover:text-sky-600 transition-colors\">Dashboard</a>\n                    <a href=\"/students/cbt/cbt/\" class=\"text-slate-600 hover:text-sky-600 transition-colors\">Take Quiz</a>\n                    <a href=\"#\" class=\"text-sky-600 font-medium\">Learning Report</a>\n                </div>\n                \n                <!-- User Menu -->\n                <div class=\"flex items-center gap-4\">\n                    <button class=\"p-2 text-slate-400 hover:text-sky-600 transition-colors\" title=\"Refresh\">\n                        <span class=\"mi -sync-alt\" data-mi=\"sync\">sync</span>\n                    </button>\n                    <a href=\"/students/student-dashboard/\" class=\"px-4 py-2 bg-slate-100 text-slate-600 rounded-lg hover:bg-slate-200 transition-colors text-sm font-medium\">\n                        <span class=\"mi -arrow-left mr-2\" data-mi=\"arrow_back\">arrow_back</span>Back\n                    </a>\n                </div>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Main Content -->\n    <main class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8\">\n        <!-- Error Container -->\n        <div id=\"errorContainer\" class=\"hidden mb-6\"></div>\n\n        <!-- Page Header -->\n        <div class=\"flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8\">\n            <div>\n                <h1 class=\"text-3xl font-bold text-slate-800\">📊 Learning Report</h1>\n                <p class=\"text-slate-500 mt-1\">Track your progress and identify areas for improvement</p>\n            </div>\n            \n            <!-- Date Range Filter -->\n            <div class=\"flex items-center gap-2 bg-white rounded-xl p-1 shadow-sm border border-slate-200\">\n                <button class=\"date-range-btn px-4 py-2 rounded-lg text-sm font-medium bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors\" data-range=\"week\">Week</button>\n                <button class=\"date-range-btn px-4 py-2 rounded-lg text-sm font-medium bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors\" data-range=\"month\">Month</button>\n                <button class=\"date-range-btn px-4 py-2 rounded-lg text-sm font-medium bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors\" data-range=\"year\">Year</button>\n                <button class=\"date-range-btn px-4 py-2 rounded-lg text-sm font-medium bg-sky-600 text-white transition-colors\" data-range=\"all\">All Time</button>\n            </div>\n        </div>\n\n        <!-- Overview Cards -->\n        <section class=\"grid grid-cols-2 md:grid-cols-4 gap-4 mb-8\">\n            <!-- Average Score Card -->\n            <div class=\"bg-white rounded-2xl p-6 shadow-sm border border-slate-100\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <span class=\"text-sm text-slate-500\">Average Score</span>\n                    <span class=\"text-2xl\">📊</span>\n                </div>\n                <div class=\"flex items-center justify-center\">\n                    <div class=\"score-circle\" id=\"avgScoreCircle\" style=\"background: conic-gradient(#e5e7eb 0%, #e5e7eb 100%)\">\n                        <span id=\"avgScoreValue\" class=\"text-slate-800\">--%</span>\n                    </div>\n                </div>\n            </div>\n            \n            <!-- Quizzes Taken -->\n            <div class=\"bg-white rounded-2xl p-6 shadow-sm border border-slate-100\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <span class=\"text-sm text-slate-500\">Quizzes Taken</span>\n                    <span class=\"text-2xl\">📝</span>\n                </div>\n                <div class=\"text-4xl font-bold text-slate-800\" id=\"quizzesTaken\">--</div>\n                <div class=\"text-sm text-slate-500 mt-1\">total attempts</div>\n            </div>\n            \n            <!-- Study Hours -->\n            <div class=\"bg-white rounded-2xl p-6 shadow-sm border border-slate-100\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <span class=\"text-sm text-slate-500\">Study Time</span>\n                    <span class=\"text-2xl\">⏰</span>\n                </div>\n                <div class=\"text-4xl font-bold text-slate-800\" id=\"studyHours\">--</div>\n                <div class=\"text-sm text-slate-500 mt-1\">hours total</div>\n            </div>\n            \n            <!-- Streak -->\n            <div class=\"bg-white rounded-2xl p-6 shadow-sm border border-slate-100\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <span class=\"text-sm text-slate-500\">Current Streak</span>\n                    <span class=\"text-2xl\">🔥</span>\n                </div>\n                <div class=\"text-4xl font-bold text-slate-800\"><span id=\"streakDays\">--</span></div>\n                <div class=\"text-sm text-slate-500 mt-1\">days in a row</div>\n            </div>\n        </section>\n\n        <!-- Main Content Grid -->\n        <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n            <!-- Left Column -->\n            <div class=\"lg:col-span-2 space-y-6\">\n                <!-- Performance Trend Chart -->\n                <div class=\"bg-white rounded-2xl p-6 shadow-sm border border-slate-100\">\n                    <div class=\"flex items-center justify-between mb-4\">\n                        <h2 class=\"text-lg font-semibold text-slate-800\">Performance Trend</h2>\n                        <span class=\"text-sm text-slate-500\">Recent quiz scores</span>\n                    </div>\n                    \n                    <!-- Skeleton Loader -->\n                    <div class=\"skeleton-loader h-64 skeleton\"></div>\n                    \n                    <!-- Chart -->\n                    <div class=\"data-content h-64\" style=\"display: none;\">\n                        <canvas id=\"performanceChart\"></canvas>\n                    </div>\n                </div>\n\n                <!-- Subject Breakdown -->\n                <div class=\"bg-white rounded-2xl p-6 shadow-sm border border-slate-100\">\n                    <div class=\"flex items-center justify-between mb-4\">\n                        <h2 class=\"text-lg font-semibold text-slate-800\">Subject Breakdown</h2>\n                        <a href=\"/students/cbt/cbt/\" class=\"text-sm text-sky-600 hover:underline\">Practice more</a>\n                    </div>\n                    \n                    <!-- Skeleton Loader -->\n                    <div class=\"skeleton-loader space-y-4\">\n                        <div class=\"h-16 skeleton\"></div>\n                        <div class=\"h-16 skeleton\"></div>\n                        <div class=\"h-16 skeleton\"></div>\n                    </div>\n                    \n                    <!-- Content -->\n                    <div id=\"subjectBreakdown\" class=\"data-content space-y-4\" style=\"display: none;\">\n                        <!-- Subject progress bars will be rendered here -->\n                    </div>\n                </div>\n\n                <!-- Recent Activity -->\n                <div class=\"bg-white rounded-2xl p-6 shadow-sm border border-slate-100\">\n                    <div class=\"flex items-center justify-between mb-4\">\n                        <h2 class=\"text-lg font-semibold text-slate-800\">Recent Activity</h2>\n                        <span class=\"text-sm text-slate-500\">Latest quiz results</span>\n                    </div>\n                    \n                    <!-- Skeleton Loader -->\n                    <div class=\"skeleton-loader space-y-3\">\n                        <div class=\"h-14 skeleton\"></div>\n                        <div class=\"h-14 skeleton\"></div>\n                        <div class=\"h-14 skeleton\"></div>\n                        <div class=\"h-14 skeleton\"></div>\n                    </div>\n                    \n                    <!-- Content -->\n                    <div id=\"recentActivity\" class=\"data-content space-y-3\" style=\"display: none;\">\n                        <!-- Recent quiz results will be rendered here -->\n                    </div>\n                </div>\n            </div>\n\n            <!-- Right Column -->\n            <div class=\"space-y-6\">\n                <!-- Strengths -->\n                <div class=\"bg-white rounded-2xl p-6 shadow-sm border border-slate-100\">\n                    <div class=\"flex items-center gap-2 mb-4\">\n                        <span class=\"text-xl\">💪</span>\n                        <h2 class=\"text-lg font-semibold text-slate-800\">Your Strengths</h2>\n                    </div>\n                    \n                    <!-- Skeleton Loader -->\n                    <div class=\"skeleton-loader space-y-3\">\n                        <div class=\"h-14 skeleton\"></div>\n                        <div class=\"h-14 skeleton\"></div>\n                    </div>\n                    \n                    <!-- Content -->\n                    <div id=\"strengthsList\" class=\"data-content space-y-3\" style=\"display: none;\">\n                        <!-- Strengths will be rendered here -->\n                    </div>\n                </div>\n\n                <!-- Weaknesses -->\n                <div class=\"bg-white rounded-2xl p-6 shadow-sm border border-slate-100\">\n                    <div class=\"flex items-center gap-2 mb-4\">\n                        <span class=\"text-xl\">⚠️</span>\n                        <h2 class=\"text-lg font-semibold text-slate-800\">Needs Improvement</h2>\n                    </div>\n                    \n                    <!-- Skeleton Loader -->\n                    <div class=\"skeleton-loader space-y-3\">\n                        <div class=\"h-14 skeleton\"></div>\n                        <div class=\"h-14 skeleton\"></div>\n                    </div>\n                    \n                    <!-- Content -->\n                    <div id=\"weaknessesList\" class=\"data-content space-y-3\" style=\"display: none;\">\n                        <!-- Weaknesses will be rendered here -->\n                    </div>\n                </div>\n\n                <!-- Goals Progress -->\n                <div class=\"bg-white rounded-2xl p-6 shadow-sm border border-slate-100\">\n                    <div class=\"flex items-center justify-between mb-4\">\n                        <div class=\"flex items-center gap-2\">\n                            <span class=\"text-xl\">🎯</span>\n                            <h2 class=\"text-lg font-semibold text-slate-800\">Goals Progress</h2>\n                        </div>\n                    </div>\n                    \n                    <!-- Skeleton Loader -->\n                    <div class=\"skeleton-loader space-y-3\">\n                        <div class=\"h-20 skeleton\"></div>\n                        <div class=\"h-20 skeleton\"></div>\n                    </div>\n                    \n                    <!-- Content -->\n                    <div id=\"goalsProgress\" class=\"data-content space-y-4\" style=\"display: none;\">\n                        <!-- Goals will be rendered here -->\n                    </div>\n                </div>\n\n                <!-- Improvement Insights -->\n                <div class=\"bg-gradient-to-br from-sky-50 to-blue-50 rounded-2xl p-6 border border-sky-100\">\n                    <div class=\"flex items-center gap-2 mb-4\">\n                        <span class=\"text-xl\">💡</span>\n                        <h2 class=\"text-lg font-semibold text-slate-800\">Insights</h2>\n                    </div>\n                    \n                    <!-- Skeleton Loader -->\n                    <div class=\"skeleton-loader space-y-3\">\n                        <div class=\"h-16 skeleton\"></div>\n                        <div class=\"h-16 skeleton\"></div>\n                    </div>\n                    \n                    <!-- Content -->\n                    <div id=\"improvementInsights\" class=\"data-content space-y-3\" style=\"display: none;\">\n                        <!-- Insights will be rendered here -->\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Quick Actions -->\n        <section class=\"mt-8 bg-white rounded-2xl p-6 shadow-sm border border-slate-100\">\n            <h2 class=\"text-lg font-semibold text-slate-800 mb-4\">Quick Actions</h2>\n            <div class=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n                <a href=\"/students/cbt/cbt/\" class=\"flex items-center gap-3 p-4 bg-sky-50 rounded-xl hover:bg-sky-100 transition-colors\">\n                    <span class=\"text-2xl\">📝</span>\n                    <div>\n                        <div class=\"font-medium text-slate-700\">Take a Quiz</div>\n                        <div class=\"text-sm text-slate-500\">Practice now</div>\n                    </div>\n                </a>\n                <a href=\"/students/student-dashboard/\" class=\"flex items-center gap-3 p-4 bg-emerald-50 rounded-xl hover:bg-emerald-100 transition-colors\">\n                    <span class=\"text-2xl\">🎯</span>\n                    <div>\n                        <div class=\"font-medium text-slate-700\">Set Goals</div>\n                        <div class=\"text-sm text-slate-500\">Update targets</div>\n                    </div>\n                </a>\n                <a href=\"/students/cbt/cbt/\" class=\"flex items-center gap-3 p-4 bg-amber-50 rounded-xl hover:bg-amber-100 transition-colors\">\n                    <span class=\"text-2xl\">📚</span>\n                    <div>\n                        <div class=\"font-medium text-slate-700\">Study Materials</div>\n                        <div class=\"text-sm text-slate-500\">Browse resources</div>\n                    </div>\n                </a>\n                <button class=\"flex items-center gap-3 p-4 bg-purple-50 rounded-xl hover:bg-purple-100 transition-colors text-left\">\n                    <span class=\"text-2xl\">🔄</span>\n                    <div>\n                        <div class=\"font-medium text-slate-700\">Refresh Data</div>\n                        <div class=\"text-sm text-slate-500\">Update report</div>\n                    </div>\n                </button>\n            </div>\n        </section>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"bg-white border-t border-slate-200 mt-12\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n            <div class=\"flex flex-col md:flex-row justify-between items-center gap-4\">\n                <div class=\"text-slate-500 text-sm\">\n                    © 2024 Juanova Cortex. All rights reserved.\n                </div>\n                <div class=\"flex gap-6\">\n                    <a href=\"#\" class=\"text-slate-500 hover:text-sky-600 text-sm\">Privacy Policy</a>\n                    <a href=\"#\" class=\"text-slate-500 hover:text-sky-600 text-sm\">Terms of Service</a>\n                    <a href=\"#\" class=\"text-slate-500 hover:text-sky-600 text-sm\">Help</a>\n                </div>\n            </div>\n        </div>\n    </footer>\n\n    <!-- Load Learning Report JS -->","bodyClass":"bg-slate-50 min-h-screen","bodyStyle":"","css":["/* Custom styles */\n        .score-circle {\n            position: relative;\n            width: 120px;\n            height: 120px;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n        \n        .score-circle::before {\n            content: '';\n            position: absolute;\n            inset: 8px;\n            background: white;\n            border-radius: 50%;\n        }\n        \n        .score-circle span {\n            position: relative;\n            z-index: 1;\n            font-size: 2rem;\n            font-weight: 700;\n        }\n        \n        /* Skeleton loading animation */\n        @keyframes shimmer {\n            0% { background-position: -200% 0; }\n            100% { background-position: 200% 0; }\n        }\n        \n        .skeleton {\n            background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);\n            background-size: 200% 100%;\n            animation: shimmer 1.5s infinite;\n            border-radius: 8px;\n        }\n        \n        /* Scrollbar */\n        ::-webkit-scrollbar {\n            width: 6px;\n            height: 6px;\n        }\n        ::-webkit-scrollbar-track {\n            background: #f1f1f1;\n            border-radius: 10px;\n        }\n        ::-webkit-scrollbar-thumb {\n            background: #c1c1c1;\n            border-radius: 10px;\n        }\n        ::-webkit-scrollbar-thumb:hover {\n            background: #a1a1a1;\n        }\n        \n        /* Date range button active state */\n        .date-range-btn.active {\n            background-color: #0ea5e9;\n            color: white;\n        }"],"quiz":null,"tracker":null,"links":[]}