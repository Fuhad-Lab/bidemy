{"slug":"/students/smart-note/","source":"students/smart-note.html","area":"students","kind":"content","title":"Smart Notes - Prep100","description":"","subject":null,"body":"<div class=\"min-h-screen flex\">\n      <!-- Sidebar -->\n      <aside id=\"sidebar\" class=\"fixed inset-y-0 left-0 w-64 sm:w-72 bg-white border-r border-slate-200 flex flex-col p-3 sm:p-4 z-40 transition-transform duration-300 -translate-x-full lg:translate-x-0\">\n        <div class=\"flex items-center gap-2 sm:gap-3\">\n          <img src=\"/site/assets/images/logo.png\" alt=\"logo\" class=\"h-10 w-10 sm:h-12 sm:w-12 rounded-full shadow-sm\">\n          <div>\n            <div class=\"text-base sm:text-lg font-bold text-sky-700\">JUANOVA CORTEX</div>\n            <div class=\"text-xs text-slate-500\">Student Dashboard</div>\n          </div>\n        </div>\n\n        <nav class=\"flex-1 overflow-auto mt-3 sm:mt-4\">\n          <ul class=\"space-y-0.5 sm:space-y-1 text-sm\">\n            <li><a href=\"/students/student-dashboard/\" class=\"flex items-center gap-2 sm:gap-3 px-2 sm:px-3 py-1.5 sm:py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -home text-sky-600 text-xs sm:text-sm\" data-mi=\"home\">home</span> Home</a></li>\n            <li><a href=\"/students/news-feed-gemini/\" class=\"flex items-center gap-2 sm:gap-3 px-2 sm:px-3 py-1.5 sm:py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -newspaper text-pink-500 text-xs sm:text-sm\" data-mi=\"help_outline\">help_outline</span> News Feed</a></li>\n            <li><a href=\"/students/ai-tutor-chatbot/\" class=\"flex items-center gap-2 sm:gap-3 px-2 sm:px-3 py-1.5 sm:py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -robot text-purple-500 text-xs sm:text-sm\" data-mi=\"smart_toy\">smart_toy</span> AI Tutor</a></li>\n            <li><a href=\"/students/study-plan/\" class=\"flex items-center gap-2 sm:gap-3 px-2 sm:px-3 py-1.5 sm:py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -calendar-check text-green-500 text-xs sm:text-sm\" data-mi=\"event_available\">event_available</span> Study Plan</a></li>\n            <li><a href=\"/students/formula-bank/\" class=\"flex items-center gap-2 sm:gap-3 px-2 sm:px-3 py-1.5 sm:py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -book-open text-teal-600 text-xs sm:text-sm\" data-mi=\"auto_stories\">auto_stories</span> All Formula</a></li>\n            <li><a href=\"/students/subjects/accounting/content/divisions/accounting-cycle/\" class=\"flex items-center gap-2 sm:gap-3 px-2 sm:px-3 py-1.5 sm:py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -gamepad text-red-500 text-xs sm:text-sm\" data-mi=\"sports_esports\">sports_esports</span> Game</a></li>\n            <li><a href=\"/students/video-library/\" class=\"flex items-center gap-2 sm:gap-3 px-2 sm:px-3 py-1.5 sm:py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -film text-rose-500 text-xs sm:text-sm\" data-mi=\"movie\">movie</span> Video Library</a></li>\n            <li><a href=\"/students/digital-library/\" class=\"flex items-center gap-2 sm:gap-3 px-2 sm:px-3 py-1.5 sm:py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -book text-indigo-500 text-xs sm:text-sm\" data-mi=\"menu_book\">menu_book</span> Digital Library</a></li>\n            <li><a href=\"/students/mock-exams/\" class=\"flex items-center gap-2 sm:gap-3 px-2 sm:px-3 py-1.5 sm:py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -pencil-alt text-orange-500 text-xs sm:text-sm\" data-mi=\"edit\">edit</span> Mock Exams</a></li>\n            <li><a href=\"/students/cbt/cbt/\" class=\"flex items-center gap-2 sm:gap-3 px-2 sm:px-3 py-1.5 sm:py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -computer text-red-500 text-xs sm:text-sm\" data-mi=\"help_outline\">help_outline</span> JAMB CBT</a></li>\n            <li><a href=\"/students/notifications/\" class=\"flex items-center gap-2 sm:gap-3 px-2 sm:px-3 py-1.5 sm:py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -bell text-pink-600 text-xs sm:text-sm\" data-mi=\"notifications\">notifications</span> Notifications</a></li>\n            <li><a href=\"/students/student-live-session/\" class=\"flex items-center gap-2 sm:gap-3 px-2 sm:px-3 py-1.5 sm:py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -chalkboard-teacher text-blue-400 text-xs sm:text-sm\" data-mi=\"co_present\">co_present</span> Live Sessions</a></li>\n            <li><a href=\"/students/smart-note/\" class=\"flex items-center gap-2 sm:gap-3 px-2 sm:px-3 py-1.5 sm:py-2 rounded-lg bg-yellow-50 text-yellow-700 font-semibold\"><span class=\"mi -sticky-note text-yellow-500 text-xs sm:text-sm\" data-mi=\"sticky_note_2\">sticky_note_2</span> Smart Notes</a></li>\n            <li><a href=\"/students/learning-report/\" class=\"flex items-center gap-2 sm:gap-3 px-2 sm:px-3 py-1.5 sm:py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -chart-line text-indigo-500 text-xs sm:text-sm\" data-mi=\"show_chart\">show_chart</span> Learning Report</a></li>\n            <li><a href=\"/students/Nobel-laureate/\" class=\"flex items-center gap-2 sm:gap-3 px-2 sm:px-3 py-1.5 sm:py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -award text-yellow-600 text-xs sm:text-sm\" data-mi=\"workspace_premium\">workspace_premium</span> Nobel Laureate</a></li>\n          </ul>\n        </nav>\n\n        <div class=\"text-xs sm:text-sm text-slate-500 pt-3 sm:pt-4 border-t\">\n          <div class=\"mb-1.5 sm:mb-2\">Account</div>\n          <div class=\"flex items-center gap-2 sm:gap-3\">\n            <img id=\"avatar-sm\" src=\"/site/assets/images/unnamed.jpg\" alt=\"avatar\" class=\"h-8 w-8 sm:h-10 sm:w-10 rounded-full border\">\n            <div>\n              <div id=\"userName\" class=\"font-semibold text-sm\">Student</div>\n              <div id=\"userLevel\" class=\"text-xs text-slate-400\"></div>\n            </div>\n          </div>\n        </div>\n      </aside>\n\n      <!-- Main area -->\n      <div id=\"main-content\" class=\"flex-1 flex flex-col lg:ml-64 xl:ml-72\">\n        <!-- Top Bar -->\n        <header class=\"flex items-center justify-between p-2 sm:p-4 bg-white border-b border-slate-200 sticky top-0 z-30\">\n          <div class=\"flex items-center gap-2 sm:gap-3 flex-1 min-w-0\">\n            <button id=\"toggleSidebar\" class=\"p-1.5 sm:p-2 rounded-md hover:bg-slate-100 lg:hidden flex-shrink-0\" title=\"Toggle sidebar\">\n              <span class=\"mi -bars text-sm sm:text-base\" data-mi=\"menu\">menu</span>\n            </button>\n            <div class=\"relative flex-1 max-w-xs sm:max-w-sm md:max-w-md lg:max-w-lg\">\n              <span class=\"mi -search absolute left-2 sm:left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs sm:text-sm\" data-mi=\"search\">search</span>\n              <input id=\"searchInput\" type=\"search\" placeholder=\"Search notes...\" class=\"w-full pl-7 sm:pl-9 pr-3 sm:pr-4 py-1.5 sm:py-2 text-xs sm:text-sm rounded-full border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-yellow-100 focus:border-yellow-400\">\n            </div>\n          </div>\n\n          <div class=\"flex items-center gap-1.5 sm:gap-3 flex-shrink-0\">\n            <!-- Streak Counter - Hidden on very small screens -->\n            <div class=\"hidden md:flex items-center gap-1.5 bg-gradient-to-r from-orange-100 to-yellow-100 px-2.5 py-1 rounded-full\">\n              <span class=\"mi -fire text-orange-500 text-xs streak-fire\" data-mi=\"local_fire_department\">local_fire_department</span>\n              <span id=\"streakCount\" class=\"font-bold text-orange-600 text-xs\">0</span>\n              <span class=\"text-xs text-orange-500 hidden sm:inline\">streak</span>\n            </div>\n            \n            <!-- Points Counter -->\n            <div class=\"hidden md:flex items-center gap-1.5 bg-gradient-to-r from-violet-100 to-purple-100 px-2.5 py-1 rounded-full\">\n              <span class=\"mi -gem text-violet-500 text-xs\" data-mi=\"diamond\">diamond</span>\n              <span id=\"pointsCount\" class=\"font-bold text-violet-600 text-xs\">0</span>\n              <span class=\"text-xs text-violet-500 hidden sm:inline\">pts</span>\n            </div>\n            \n            <div class=\"relative\">\n              <button id=\"notifBtn\" class=\"p-1.5 sm:p-2 rounded-full hover:bg-slate-50\" aria-label=\"Notifications\">\n                <span class=\"mi -bell text-sky-600 text-sm sm:text-base\" data-mi=\"notifications\">notifications</span>\n              </button>\n              <span id=\"notifCount\" class=\"absolute -top-0.5 -right-0.5 bg-pink-500 text-white rounded-full w-4 h-4 text-xs flex items-center justify-center\">0</span>\n            </div>\n            <div class=\"flex items-center gap-1.5 sm:gap-2\">\n              <div class=\"text-right hidden sm:block\">\n                <div id=\"topName\" class=\"font-semibold text-xs sm:text-sm\">Student</div>\n                <div id=\"topLevel\" class=\"text-xs text-slate-400\">SS 3</div>\n              </div>\n              <img id=\"topAvatar\" src=\"/site/assets/images/unnamed.jpg\" alt=\"avatar\" class=\"h-8 w-8 sm:h-9 sm:w-9 rounded-full border-2\">\n            </div>\n          </div>\n        </header>\n\n        <main class=\"p-2 sm:p-4 md:p-6 space-y-3 sm:space-y-4 md:space-y-6 safe-bottom\">\n          <!-- Banner / Header -->\n          <div class=\"rounded-2xl sm:rounded-3xl bg-gradient-to-r from-yellow-500 via-amber-500 to-orange-500 text-white p-3 sm:p-5 md:p-6 shadow-lg relative overflow-hidden\">\n            <div class=\"absolute top-0 right-0 w-24 sm:w-32 h-24 sm:h-32 bg-white/10 rounded-full -translate-y-1/2 translate-x-1/2\"></div>\n            <div class=\"absolute bottom-0 left-1/4 w-12 sm:w-16 h-12 sm:h-16 bg-white/10 rounded-full translate-y-1/2\"></div>\n            \n            <div class=\"relative z-10\">\n              <div class=\"flex flex-col gap-2 sm:gap-3 md:gap-4\">\n                <div>\n                  <h1 class=\"text-lg sm:text-xl md:text-2xl font-extrabold flex items-center gap-1.5 sm:gap-2\">\n                    <span class=\"mi -sticky-note text-base sm:text-lg md:text-2xl\" data-mi=\"sticky_note_2\">sticky_note_2</span>\n                    Smart Notes\n                  </h1>\n                  <p class=\"text-yellow-100 mt-0.5 sm:mt-1 text-xs sm:text-sm\">Create notes, flashcards &amp; AI-powered quizzes!</p>\n                </div>\n                <div class=\"flex flex-wrap gap-1.5 sm:gap-2\">\n                  <button id=\"openCreate\" class=\"bg-white text-yellow-600 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full font-semibold hover:bg-yellow-50 transition-all shadow-md text-xs sm:text-sm\">\n                    <span class=\"mi -plus mr-1 text-xs\" data-mi=\"add\">add</span> Create\n                  </button>\n                  <button id=\"importBtn\" class=\"bg-white/20 text-white px-3 sm:px-4 py-1.5 sm:py-2 rounded-full font-semibold hover:bg-white/30 transition-all border border-white/30 text-xs sm:text-sm\">\n                    <span class=\"mi -file-import mr-1 text-xs\" data-mi=\"help_outline\">help_outline</span> Import\n                  </button>\n                  <button id=\"aiGenerateBtn\" class=\"bg-gradient-to-r from-violet-500 to-purple-600 text-white px-3 sm:px-4 py-1.5 sm:py-2 rounded-full font-semibold hover:from-violet-600 hover:to-purple-700 transition-all shadow-md text-xs sm:text-sm\">\n                    <span class=\"mi -magic mr-1 text-xs\" data-mi=\"help_outline\">help_outline</span> AI\n                  </button>\n                </div>\n              </div>\n              \n              <!-- Quick Stats -->\n              <div class=\"flex flex-wrap gap-2 sm:gap-3 md:gap-4 mt-3 sm:mt-4 pt-3 sm:pt-4 border-t border-white/20\">\n                <div class=\"flex items-center gap-1.5 sm:gap-2\">\n                  <div class=\"w-6 h-6 sm:w-8 sm:h-8 bg-white/20 rounded-lg flex items-center justify-center\">\n                    <span class=\"mi -sticky-note text-xs sm:text-sm\" data-mi=\"sticky_note_2\">sticky_note_2</span>\n                  </div>\n                  <div>\n                    <div id=\"totalNotes\" class=\"font-bold text-sm sm:text-base\">0</div>\n                    <div class=\"text-xs text-yellow-100\">Notes</div>\n                  </div>\n                </div>\n                <div class=\"flex items-center gap-1.5 sm:gap-2\">\n                  <div class=\"w-6 h-6 sm:w-8 sm:h-8 bg-white/20 rounded-lg flex items-center justify-center\">\n                    <span class=\"mi -layer-group text-xs sm:text-sm\" data-mi=\"help_outline\">help_outline</span>\n                  </div>\n                  <div>\n                    <div id=\"totalFlashcards\" class=\"font-bold text-sm sm:text-base\">0</div>\n                    <div class=\"text-xs text-yellow-100\">Cards</div>\n                  </div>\n                </div>\n                <div class=\"flex items-center gap-1.5 sm:gap-2\">\n                  <div class=\"w-6 h-6 sm:w-8 sm:h-8 bg-white/20 rounded-lg flex items-center justify-center\">\n                    <span class=\"mi -check-circle text-xs sm:text-sm\" data-mi=\"check_circle\">check_circle</span>\n                  </div>\n                  <div>\n                    <div id=\"cardsLearned\" class=\"font-bold text-sm sm:text-base\">0</div>\n                    <div class=\"text-xs text-yellow-100\">Learned</div>\n                  </div>\n                </div>\n                <div class=\"flex items-center gap-1.5 sm:gap-2\">\n                  <div class=\"w-6 h-6 sm:w-8 sm:h-8 bg-white/20 rounded-lg flex items-center justify-center\">\n                    <span class=\"mi -percentage text-xs sm:text-sm\" data-mi=\"percent\">percent</span>\n                  </div>\n                  <div>\n                    <div id=\"masteryLevel\" class=\"font-bold text-sm sm:text-base\">0%</div>\n                    <div class=\"text-xs text-yellow-100\">Mastery</div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Mode Tabs -->\n          <div class=\"bg-white rounded-xl sm:rounded-2xl shadow-sm border border-slate-200 overflow-hidden\">\n            <div class=\"flex border-b border-slate-200 overflow-x-auto\">\n              <button id=\"tabNotes\" class=\"flex-1 min-w-0 px-2 sm:px-4 md:px-6 py-2.5 sm:py-3 md:py-4 font-semibold text-yellow-600 tab-active transition-colors text-xs sm:text-sm whitespace-nowrap\">\n                <span class=\"mi -sticky-note mr-1 sm:mr-2 text-xs sm:text-sm\" data-mi=\"sticky_note_2\">sticky_note_2</span>Notes\n              </button>\n              <button id=\"tabFlashcards\" class=\"flex-1 min-w-0 px-2 sm:px-4 md:px-6 py-2.5 sm:py-3 md:py-4 font-semibold text-slate-500 hover:text-slate-700 transition-colors text-xs sm:text-sm whitespace-nowrap\">\n                <span class=\"mi -layer-group mr-1 sm:mr-2 text-xs sm:text-sm\" data-mi=\"help_outline\">help_outline</span>Cards\n              </button>\n              <button id=\"tabQuiz\" class=\"flex-1 min-w-0 px-2 sm:px-4 md:px-6 py-2.5 sm:py-3 md:py-4 font-semibold text-slate-500 hover:text-slate-700 transition-colors text-xs sm:text-sm whitespace-nowrap\">\n                <span class=\"mi -gamepad mr-1 sm:mr-2 text-xs sm:text-sm\" data-mi=\"sports_esports\">sports_esports</span>Quiz\n              </button>\n              <button id=\"tabSpaced\" class=\"flex-1 min-w-0 px-2 sm:px-4 md:px-6 py-2.5 sm:py-3 md:py-4 font-semibold text-slate-500 hover:text-slate-700 transition-colors text-xs sm:text-sm whitespace-nowrap\">\n                <span class=\"mi -clock mr-1 sm:mr-2 text-xs sm:text-sm\" data-mi=\"schedule\">schedule</span>Review\n              </button>\n            </div>\n            \n            <!-- Tab Content -->\n            <div class=\"p-2 sm:p-4 md:p-6\">\n              <!-- Notes View -->\n              <div id=\"viewNotes\" class=\"space-y-3 sm:space-y-4\">\n                <div id=\"notesGrid\" class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2 sm:gap-3 md:gap-4\"></div>\n              </div>\n              \n              <!-- Flashcards View -->\n              <div id=\"viewFlashcards\" class=\"hidden\">\n                <div class=\"flex flex-col md:flex-row gap-3 sm:gap-4 md:gap-6\">\n                  <!-- Decks Sidebar -->\n                  <div class=\"w-full md:w-56 lg:w-64 space-y-2\">\n                    <div class=\"flex items-center justify-between mb-2 sm:mb-4\">\n                      <h3 class=\"font-bold text-slate-800 text-sm sm:text-base\">Decks</h3>\n                      <button class=\"text-yellow-600 hover:text-yellow-700 text-sm\">\n                        <span class=\"mi -plus\" data-mi=\"add\">add</span>\n                      </button>\n                    </div>\n                    <div id=\"decksList\" class=\"flex md:flex-col gap-2 overflow-x-auto md:overflow-y-auto md:max-h-[60vh] custom-scrollbar pb-2 md:pb-0\"></div>\n                  </div>\n                  \n                  <!-- Flashcards Grid -->\n                  <div class=\"flex-1 min-w-0\">\n                    <div id=\"flashcardsContainer\" class=\"grid grid-cols-1 sm:grid-cols-2 gap-2 sm:gap-3\">\n                      <div class=\"col-span-full text-center py-6 sm:py-12 text-slate-400 text-xs sm:text-sm\">\n                        <span class=\"mi -layer-group text-2xl sm:text-4xl mb-2 sm:mb-3\" data-mi=\"help_outline\">help_outline</span>\n                        <p>Select a deck or create flashcards</p>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              \n              <!-- Quiz View -->\n              <div id=\"viewQuiz\" class=\"hidden\">\n                <div id=\"quizSetup\" class=\"max-w-lg mx-auto text-center py-4 sm:py-8\">\n                  <div class=\"w-14 h-14 sm:w-20 sm:h-20 bg-gradient-to-br from-violet-100 to-purple-100 rounded-2xl flex items-center justify-center mx-auto mb-3 sm:mb-4\">\n                    <span class=\"mi -gamepad text-2xl sm:text-3xl text-violet-600\" data-mi=\"sports_esports\">sports_esports</span>\n                  </div>\n                  <h3 class=\"text-lg sm:text-xl font-bold text-slate-800 mb-1 sm:mb-2\">Ready to Quiz?</h3>\n                  <p class=\"text-slate-500 mb-4 sm:mb-6 text-xs sm:text-sm\">Test your knowledge with AI questions</p>\n                  \n                  <div class=\"space-y-3 sm:space-y-4\">\n                    <div class=\"flex flex-wrap justify-center gap-2\">\n                      <button class=\"bg-gradient-to-r from-violet-500 to-purple-600 text-white px-4 sm:px-6 py-2 sm:py-3 rounded-xl font-semibold hover:from-violet-600 hover:to-purple-700 transition-all text-xs sm:text-sm\">\n                        <span class=\"mi -random mr-1 sm:mr-2\" data-mi=\"shuffle\">shuffle</span>Quick Quiz\n                      </button>\n                      <button class=\"bg-gradient-to-r from-orange-500 to-amber-500 text-white px-4 sm:px-6 py-2 sm:py-3 rounded-xl font-semibold hover:from-orange-600 hover:to-amber-600 transition-all text-xs sm:text-sm\">\n                        <span class=\"mi -clock mr-1 sm:mr-2\" data-mi=\"schedule\">schedule</span>Due Cards\n                      </button>\n                    </div>\n                    \n                    <div class=\"pt-3 sm:pt-4 border-t border-slate-200\">\n                      <p class=\"text-xs sm:text-sm text-slate-500 mb-2\">Or select a deck:</p>\n                      <div id=\"quizDeckSelect\" class=\"flex flex-wrap justify-center gap-1.5 sm:gap-2\"></div>\n                    </div>\n                  </div>\n                </div>\n                \n                <div id=\"quizActive\" class=\"hidden max-w-2xl mx-auto\">\n                  <div class=\"mb-4 sm:mb-6\">\n                    <div class=\"flex justify-between text-xs sm:text-sm text-slate-500 mb-1.5 sm:mb-2\">\n                      <span>Q<span id=\"quizCurrent\">1</span>/<span id=\"quizTotal\">10</span></span>\n                      <span><span class=\"mi -gem text-violet-500 mr-1\" data-mi=\"diamond\">diamond</span><span id=\"quizScore\">0</span> pts</span>\n                    </div>\n                    <div class=\"h-1.5 sm:h-2 bg-slate-200 rounded-full overflow-hidden\">\n                      <div id=\"quizProgress\" class=\"h-full bg-gradient-to-r from-yellow-400 to-orange-500 progress-fill\" style=\"width: 10%\"></div>\n                    </div>\n                  </div>\n                  \n                  <div id=\"questionCard\" class=\"bg-white rounded-xl sm:rounded-2xl border border-slate-200 shadow-lg p-4 sm:p-6 md:p-8 text-center\">\n                    <div id=\"questionText\" class=\"text-base sm:text-lg md:text-xl font-semibold text-slate-800 mb-4 sm:mb-6\">Loading...</div>\n                    <div id=\"questionOptions\" class=\"space-y-2 sm:space-y-3 text-left\"></div>\n                  </div>\n                  \n                  <div class=\"flex justify-between mt-4 sm:mt-6\">\n                    <button class=\"px-3 sm:px-4 py-1.5 sm:py-2 text-slate-500 hover:text-slate-700 text-xs sm:text-sm\">\n                      <span class=\"mi -times mr-1\" data-mi=\"close\">close</span> End\n                    </button>\n                    <button id=\"nextQuestionBtn\" class=\"bg-gradient-to-r from-yellow-400 to-orange-500 text-white px-4 sm:px-6 py-1.5 sm:py-2 rounded-full font-semibold hidden text-xs sm:text-sm\">\n                      Next <span class=\"mi -arrow-right ml-1\" data-mi=\"arrow_forward\">arrow_forward</span>\n                    </button>\n                  </div>\n                </div>\n                \n                <div id=\"quizResults\" class=\"hidden max-w-lg mx-auto text-center py-4 sm:py-8\">\n                  <div id=\"resultsContent\"></div>\n                </div>\n              </div>\n              \n              <!-- Spaced Repetition View -->\n              <div id=\"viewSpaced\" class=\"hidden\">\n                <div class=\"max-w-4xl mx-auto\">\n                  <div class=\"text-center mb-4 sm:mb-6\">\n                    <h3 class=\"text-lg sm:text-xl font-bold text-slate-800\">Cards Due for Review</h3>\n                    <p class=\"text-slate-500 text-xs sm:text-sm\">Spaced repetition algorithm</p>\n                  </div>\n                  \n                  <div id=\"dueCardsContainer\" class=\"space-y-2 sm:space-y-4\">\n                    <div class=\"text-center py-8 sm:py-12 text-slate-400\">\n                      <span class=\"mi -check-circle text-3xl sm:text-4xl mb-2 sm:mb-3 text-green-500\" data-mi=\"check_circle\">check_circle</span>\n                      <p class=\"text-green-600 font-semibold text-sm sm:text-base\">All caught up!</p>\n                      <p class=\"text-xs sm:text-sm\">No cards due for review.</p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </main>\n      </div>\n    </div>\n\n    <!-- Note Modal -->\n    <div id=\"jotModal\" class=\"fixed inset-0 bg-black/40 modal-backdrop hidden items-center justify-center z-50 p-3 sm:p-4\">\n      <div class=\"bg-white rounded-xl sm:rounded-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto animate-bounce-in\">\n        <div class=\"sticky top-0 bg-white border-b border-slate-100 p-3 sm:p-4 flex items-center justify-between\">\n          <h2 id=\"modalTitle\" class=\"text-base sm:text-lg md:text-xl font-bold text-slate-800\">Create Note</h2>\n          <button id=\"closeModalBtn\" class=\"text-slate-400 hover:text-slate-600 p-1.5 sm:p-2\">\n            <span class=\"mi -times text-sm sm:text-base\" data-mi=\"close\">close</span>\n          </button>\n        </div>\n        <div class=\"p-3 sm:p-4 md:p-6 space-y-3 sm:space-y-4\">\n          <div>\n            <label class=\"block text-xs sm:text-sm font-medium text-slate-700 mb-1\">Title</label>\n            <input id=\"jotTitle\" type=\"text\" placeholder=\"Enter note title...\" class=\"w-full p-2 sm:p-3 text-sm border border-slate-200 rounded-lg sm:rounded-xl focus:outline-none focus:ring-2 focus:ring-yellow-100 focus:border-yellow-400\">\n          </div>\n          <div>\n            <label class=\"block text-xs sm:text-sm font-medium text-slate-700 mb-1\">Content</label>\n            <textarea id=\"jotContent\" placeholder=\"Write your notes here...\" class=\"w-full p-2 sm:p-3 text-sm border border-slate-200 rounded-lg sm:rounded-xl h-32 sm:h-48 focus:outline-none focus:ring-2 focus:ring-yellow-100 focus:border-yellow-400\"></textarea>\n          </div>\n          <div>\n            <label class=\"block text-xs sm:text-sm font-medium text-slate-700 mb-1\">Tags</label>\n            <input id=\"jotTags\" type=\"text\" placeholder=\"physics, formulas (comma-separated)\" class=\"w-full p-2 sm:p-3 text-sm border border-slate-200 rounded-lg sm:rounded-xl focus:outline-none focus:ring-2 focus:ring-yellow-100 focus:border-yellow-400\">\n          </div>\n          \n          <!-- AI Options -->\n          <div class=\"bg-gradient-to-r from-violet-50 to-purple-50 rounded-lg sm:rounded-xl p-3 sm:p-4 border border-violet-100\">\n            <div class=\"flex items-center gap-2 mb-2 sm:mb-3\">\n              <span class=\"mi -magic text-violet-500 text-sm\" data-mi=\"help_outline\">help_outline</span>\n              <span class=\"font-semibold text-violet-700 text-xs sm:text-sm\">AI Options</span>\n            </div>\n            <div class=\"flex flex-wrap gap-1.5 sm:gap-2\">\n              <label class=\"flex items-center gap-1.5 sm:gap-2 bg-white px-2.5 sm:px-3 py-1.5 sm:py-2 rounded-lg border border-violet-200 cursor-pointer hover:bg-violet-50 text-xs sm:text-sm\">\n                <input type=\"checkbox\" id=\"autoFlashcard\" class=\"accent-violet-500\">\n                <span>Auto flashcards</span>\n              </label>\n              <label class=\"flex items-center gap-1.5 sm:gap-2 bg-white px-2.5 sm:px-3 py-1.5 sm:py-2 rounded-lg border border-violet-200 cursor-pointer hover:bg-violet-50 text-xs sm:text-sm\">\n                <input type=\"checkbox\" id=\"autoQuiz\" class=\"accent-violet-500\">\n                <span>Quiz questions</span>\n              </label>\n            </div>\n          </div>\n          \n          <div class=\"flex gap-2 sm:gap-3 justify-end pt-3 sm:pt-4 border-t border-slate-100\">\n            <button id=\"cancelJotBtn\" class=\"px-4 sm:px-6 py-2 sm:py-2.5 rounded-lg sm:rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-medium text-xs sm:text-sm\">Cancel</button>\n            <button id=\"saveJotBtn\" class=\"px-4 sm:px-6 py-2 sm:py-2.5 rounded-lg sm:rounded-xl bg-gradient-to-r from-yellow-400 to-orange-500 text-white font-semibold hover:from-yellow-500 hover:to-orange-600 shadow-md text-xs sm:text-sm\">\n              <span class=\"mi -save mr-1\" data-mi=\"save\">save</span> Save\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Import Modal -->\n    <div id=\"importModal\" class=\"fixed inset-0 bg-black/40 modal-backdrop hidden items-center justify-center z-50 p-3 sm:p-4\">\n      <div class=\"bg-white rounded-xl sm:rounded-2xl w-full max-w-lg animate-bounce-in\">\n        <div class=\"p-3 sm:p-4 border-b border-slate-100 flex items-center justify-between\">\n          <h2 class=\"text-base sm:text-lg md:text-xl font-bold text-slate-800\">Import Content</h2>\n          <button class=\"text-slate-400 hover:text-slate-600 p-1.5 sm:p-2\">\n            <span class=\"mi -times text-sm sm:text-base\" data-mi=\"close\">close</span>\n          </button>\n        </div>\n        <div class=\"p-3 sm:p-4 md:p-6 space-y-3 sm:space-y-4\">\n          <!-- Import Tabs -->\n          <div class=\"flex border-b border-slate-200\">\n            <button class=\"import-tab flex-1 px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm font-medium text-red-500 border-b-2 border-red-500\" data-tab=\"youtube\">\n              <span class=\"mi -youtube mr-1\" data-mi=\"smart_display\">smart_display</span> YouTube\n            </button>\n            <button class=\"import-tab flex-1 px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm font-medium text-slate-500\" data-tab=\"pdf\">\n              <span class=\"mi -file-pdf mr-1\" data-mi=\"picture_as_pdf\">picture_as_pdf</span> PDF\n            </button>\n            <button class=\"import-tab flex-1 px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm font-medium text-slate-500\" data-tab=\"paste\">\n              <span class=\"mi -paste mr-1\" data-mi=\"content_paste\">content_paste</span> Paste\n            </button>\n          </div>\n          \n          <!-- YouTube Import -->\n          <div id=\"importYoutube\" class=\"space-y-3 sm:space-y-4\">\n            <div>\n              <label class=\"block text-xs sm:text-sm font-medium text-slate-700 mb-1\">YouTube URL</label>\n              <input type=\"url\" id=\"youtubeUrl\" placeholder=\"https://youtube.com/watch?v=...\" class=\"w-full p-2 sm:p-3 text-sm border border-slate-200 rounded-lg sm:rounded-xl focus:outline-none focus:ring-2 focus:ring-red-100 focus:border-red-400\">\n            </div>\n            <p class=\"text-xs text-slate-500\">\n              <span class=\"mi -info-circle mr-1\" data-mi=\"info\">info</span>\n              AI extracts key concepts from videos\n            </p>\n            <button class=\"w-full py-2 sm:py-3 bg-red-500 hover:bg-red-600 text-white rounded-lg sm:rounded-xl font-semibold transition-colors text-xs sm:text-sm\">\n              <span class=\"mi -download mr-1\" data-mi=\"download\">download</span> Import\n            </button>\n          </div>\n          \n          <!-- PDF Import -->\n          <div id=\"importPdf\" class=\"hidden space-y-3 sm:space-y-4\">\n            <div class=\"border-2 border-dashed border-slate-300 rounded-lg sm:rounded-xl p-6 sm:p-8 text-center hover:border-yellow-400 transition-colors cursor-pointer\" data-bidemy-toggle-modal=\"pdfInput\">\n              <span class=\"mi -cloud-upload-alt text-3xl sm:text-4xl text-slate-400 mb-2 sm:mb-3\" data-mi=\"help_outline\">help_outline</span>\n              <p class=\"text-slate-600 text-xs sm:text-sm\">Tap to upload PDF</p>\n              <p class=\"text-xs text-slate-400 mt-1\">Max 10MB</p>\n              <input type=\"file\" id=\"pdfInput\" accept=\".pdf\" class=\"hidden\" onchange=\"handlePdfUpload(event)\">\n            </div>\n          </div>\n          \n          <!-- Paste Import -->\n          <div id=\"importPaste\" class=\"hidden space-y-3 sm:space-y-4\">\n            <div>\n              <label class=\"block text-xs sm:text-sm font-medium text-slate-700 mb-1\">Paste content</label>\n              <textarea id=\"pasteContent\" placeholder=\"Paste text here...\" class=\"w-full p-2 sm:p-3 text-sm border border-slate-200 rounded-lg sm:rounded-xl h-28 sm:h-40 focus:outline-none focus:ring-2 focus:ring-yellow-100 focus:border-yellow-400\"></textarea>\n            </div>\n            <button class=\"w-full py-2 sm:py-3 bg-gradient-to-r from-yellow-400 to-orange-500 hover:from-yellow-500 hover:to-orange-600 text-white rounded-lg sm:rounded-xl font-semibold transition-colors text-xs sm:text-sm\">\n              <span class=\"mi -magic mr-1\" data-mi=\"help_outline\">help_outline</span> Generate\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Flashcard Study Modal -->\n    <div id=\"studyModal\" class=\"fixed inset-0 bg-black/40 modal-backdrop hidden items-center justify-center z-50 p-3 sm:p-4\">\n      <div class=\"w-full max-w-sm sm:max-w-lg\">\n        <div class=\"flex justify-between text-white text-xs sm:text-sm mb-2 sm:mb-4\">\n          <span>Card <span id=\"studyCurrent\">1</span>/<span id=\"studyTotal\">10</span></span>\n          <span id=\"studyDeckName\" class=\"font-semibold text-xs\"></span>\n        </div>\n        \n        <div id=\"studyCard\" class=\"flip-card cursor-pointer\">\n          <div class=\"flip-card-inner relative\">\n            <div class=\"flip-card-front bg-white rounded-xl sm:rounded-2xl shadow-2xl p-4 sm:p-6 md:p-8 min-h-[200px] sm:min-h-[300px] flex flex-col items-center justify-center\">\n              <div class=\"text-xs text-slate-400 mb-2 sm:mb-4 uppercase tracking-wide\">Question</div>\n              <div id=\"studyQuestion\" class=\"text-base sm:text-lg md:text-xl font-semibold text-slate-800 text-center\"></div>\n              <div class=\"text-xs sm:text-sm text-slate-400 mt-3 sm:mt-6\">\n                <span class=\"mi -hand-pointer mr-1\" data-mi=\"help_outline\">help_outline</span> Tap to flip\n              </div>\n            </div>\n            <div class=\"flip-card-back bg-gradient-to-br from-yellow-400 to-orange-500 rounded-xl sm:rounded-2xl shadow-2xl p-4 sm:p-6 md:p-8 min-h-[200px] sm:min-h-[300px] flex flex-col items-center justify-center absolute inset-0\">\n              <div class=\"text-xs text-yellow-100 mb-2 sm:mb-4 uppercase tracking-wide\">Answer</div>\n              <div id=\"studyAnswer\" class=\"text-base sm:text-lg md:text-xl font-semibold text-white text-center\"></div>\n            </div>\n          </div>\n        </div>\n        \n        <div id=\"ratingButtons\" class=\"hidden mt-4 sm:mt-6\">\n          <p class=\"text-white text-center text-xs sm:text-sm mb-2 sm:mb-3\">How well did you know this?</p>\n          <div class=\"flex justify-center gap-1.5 sm:gap-2\">\n            <button class=\"flex-1 py-2 sm:py-3 bg-red-500 hover:bg-red-600 text-white rounded-lg sm:rounded-xl font-semibold transition-colors text-xs sm:text-sm\">\n              <span class=\"mi -times mr-1\" data-mi=\"close\">close</span>Again\n            </button>\n            <button class=\"flex-1 py-2 sm:py-3 bg-orange-500 hover:bg-orange-600 text-white rounded-lg sm:rounded-xl font-semibold transition-colors text-xs sm:text-sm\">\n              <span class=\"mi -redo mr-1\" data-mi=\"redo\">redo</span>Hard\n            </button>\n            <button class=\"flex-1 py-2 sm:py-3 bg-green-500 hover:bg-green-600 text-white rounded-lg sm:rounded-xl font-semibold transition-colors text-xs sm:text-sm\">\n              <span class=\"mi -check mr-1\" data-mi=\"check\">check</span>Good\n            </button>\n            <button class=\"flex-1 py-2 sm:py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-lg sm:rounded-xl font-semibold transition-colors text-xs sm:text-sm\">\n              <span class=\"mi -bolt mr-1\" data-mi=\"bolt\">bolt</span>Easy\n            </button>\n          </div>\n        </div>\n        \n        <button class=\"w-full mt-3 sm:mt-4 text-white/80 hover:text-white py-1.5 sm:py-2 text-xs sm:text-sm\">\n          <span class=\"mi -times mr-1\" data-mi=\"close\">close</span> End Session\n        </button>\n      </div>\n    </div>\n\n    <!-- Achievement Toast -->\n    <div id=\"achievementToast\" class=\"fixed bottom-4 right-4 left-4 sm:left-auto sm:w-auto bg-white rounded-xl sm:rounded-2xl shadow-2xl p-3 sm:p-4 hidden z-50 animate-slide-up max-w-xs\">\n      <div class=\"flex items-center gap-2 sm:gap-3\">\n        <div id=\"achievementIcon\" class=\"w-10 h-10 sm:w-12 sm:h-12 rounded-lg sm:rounded-xl flex items-center justify-center text-xl sm:text-2xl\"></div>\n        <div>\n          <div id=\"achievementTitle\" class=\"font-bold text-slate-800 text-sm sm:text-base\"></div>\n          <div id=\"achievementDesc\" class=\"text-xs sm:text-sm text-slate-500\"></div>\n        </div>\n      </div>\n    </div>","bodyClass":"bg-slate-50 text-slate-800 text-sm sm:text-base","bodyStyle":"","css":["/* Custom animations */\n      @keyframes float {\n        0%, 100% { transform: translateY(0) rotate(0deg); }\n        50% { transform: translateY(-10px) rotate(2deg); }\n      }\n      @keyframes bounce-in {\n        0% { transform: scale(0.5); opacity: 0; }\n        50% { transform: scale(1.1); }\n        100% { transform: scale(1); opacity: 1; }\n      }\n      @keyframes slide-up {\n        0% { transform: translateY(20px); opacity: 0; }\n        100% { transform: translateY(0); opacity: 1; }\n      }\n      .animate-bounce-in { animation: bounce-in 0.5s ease-out; }\n      .animate-slide-up { animation: slide-up 0.3s ease-out; }\n      \n      /* Flip card for flashcards */\n      .flip-card { perspective: 1000px; }\n      .flip-card-inner {\n        transition: transform 0.6s;\n        transform-style: preserve-3d;\n      }\n      .flip-card.flipped .flip-card-inner { transform: rotateY(180deg); }\n      .flip-card-front, .flip-card-back {\n        backface-visibility: hidden;\n        -webkit-backface-visibility: hidden;\n      }\n      .flip-card-back { transform: rotateY(180deg); }\n      \n      /* Progress bar animation */\n      .progress-fill { transition: width 1s ease-out; }\n      \n      /* Streak fire effect */\n      .streak-fire { text-shadow: 0 0 10px rgba(251, 146, 60, 0.5); }\n      \n      /* Tab active indicator */\n      .tab-active {\n        position: relative;\n      }\n      .tab-active::after {\n        content: '';\n        position: absolute;\n        bottom: -2px;\n        left: 0;\n        right: 0;\n        height: 3px;\n        background: linear-gradient(90deg, #f59e0b, #fbbf24);\n        border-radius: 2px;\n      }\n      \n      /* Custom scrollbar */\n      .custom-scrollbar::-webkit-scrollbar { width: 4px; }\n      .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 3px; }\n      .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }\n      .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }\n      \n      /* Modal backdrop blur */\n      .modal-backdrop {\n        backdrop-filter: blur(8px);\n        -webkit-backdrop-filter: blur(8px);\n      }\n      \n      /* Quiz option styles */\n      .quiz-option { transition: all 0.2s ease; }\n      .quiz-option.selected { background: #dbeafe; border-color: #3b82f6; }\n      .quiz-option.correct { background: #dcfce7; border-color: #22c55e; }\n      .quiz-option.incorrect { background: #fee2e2; border-color: #ef4444; }\n      \n      /* Mobile-specific styles */\n      @media (max-width: 640px) {\n        /* Smaller text sizes */\n        .mobile-text-xs { font-size: 0.65rem; }\n        .mobile-text-sm { font-size: 0.75rem; }\n        .mobile-text-base { font-size: 0.875rem; }\n        .mobile-text-lg { font-size: 1rem; }\n        .mobile-text-xl { font-size: 1.125rem; }\n        .mobile-text-2xl { font-size: 1.25rem; }\n        \n        /* Smaller padding/margins */\n        .mobile-p-2 { padding: 0.5rem; }\n        .mobile-p-3 { padding: 0.75rem; }\n        .mobile-p-4 { padding: 1rem; }\n        \n        /* Smaller icons */\n        .mobile-icon-sm { font-size: 0.75rem; }\n        .mobile-icon { font-size: 0.875rem; }\n        .mobile-icon-lg { font-size: 1rem; }\n        \n        /* Compact cards */\n        .mobile-card { padding: 0.75rem; }\n        .mobile-card-sm { padding: 0.5rem; }\n        \n        /* Smaller buttons */\n        .mobile-btn { padding: 0.5rem 0.75rem; font-size: 0.75rem; }\n        .mobile-btn-sm { padding: 0.375rem 0.5rem; font-size: 0.65rem; }\n        \n        /* Smaller inputs */\n        .mobile-input { padding: 0.5rem; font-size: 0.875rem; }\n        \n        /* Tab adjustments */\n        .mobile-tab { padding: 0.5rem 0.25rem; font-size: 0.65rem; }\n        .mobile-tab i { font-size: 0.75rem; }\n        \n        /* Badge adjustments */\n        .mobile-badge { padding: 0.125rem 0.375rem; font-size: 0.6rem; }\n        \n        /* Hide on mobile */\n        .mobile-hide { display: none !important; }\n        \n        /* Smaller rounded corners */\n        .mobile-rounded { border-radius: 0.75rem; }\n        .mobile-rounded-lg { border-radius: 0.5rem; }\n        \n        /* Adjust banner */\n        .mobile-banner { padding: 0.75rem; }\n        \n        /* Smaller gap */\n        .mobile-gap-1 { gap: 0.25rem; }\n        .mobile-gap-2 { gap: 0.5rem; }\n        .mobile-gap-3 { gap: 0.75rem; }\n        \n        /* Full width on mobile */\n        .mobile-w-full { width: 100%; }\n        \n        /* Smaller avatars */\n        .mobile-avatar { width: 1.5rem; height: 1.5rem; }\n        .mobile-avatar-lg { width: 2rem; height: 2rem; }\n        \n        /* Note card compact */\n        .note-card-mobile { \n          padding: 0.625rem; \n          margin-bottom: 0.5rem;\n        }\n        .note-card-mobile h3 { font-size: 0.875rem; }\n        .note-card-mobile p { font-size: 0.75rem; }\n      }\n      \n      /* Prevent text selection on mobile for buttons */\n      @media (max-width: 640px) {\n        button, .no-select {\n          -webkit-user-select: none;\n          user-select: none;\n          -webkit-touch-callout: none;\n        }\n      }\n      \n      /* Safe area for mobile */\n      @supports (padding-bottom: env(safe-area-inset-bottom)) {\n        .safe-bottom { padding-bottom: env(safe-area-inset-bottom); }\n      }"],"quiz":null,"tracker":null,"links":[]}