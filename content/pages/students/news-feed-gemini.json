{"slug":"/students/news-feed-gemini/","source":"students/news-feed-gemini.html","area":"students","kind":"content","title":"EduNews Feed — Prep100","description":"","subject":null,"body":"<div class=\"min-h-screen flex\">\n   <aside id=\"sidebar\" class=\"w-64 md:w-72 lg:w-80 fixed left-0 top-0 h-full bg-white border-r border-slate-200 p-5 flex flex-col gap-6 overflow-auto z-40\">\n      <div class=\"flex items-center gap-3\">\n        <img src=\"/site/assets/images/logo.png\" alt=\"logo\" class=\"h-12 w-12 rounded-full shadow-sm\">\n        <div>\n          <div class=\"text-lg font-bold text-sky-700\">JUANOVA CORTEX</div>\n          <div class=\"text-xs text-slate-500\">Student Dashboard</div>\n        </div>\n      </div>\n\n      <nav class=\"flex-1 overflow-auto\">\n        <ul class=\"space-y-1\">\n          <li><a href=\"/students/student-dashboard/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -home text-sky-600\" data-mi=\"home\">home</span> Home</a></li>\n          <li><a href=\"/students/news-feed-gemini/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50 bg-sky-50\"><span class=\"mi -newspaper text-pink-500\" data-mi=\"help_outline\">help_outline</span> News Feed</a></li>\n          <li><a href=\"/students/notes/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -note-sticky text-yellow-500\" data-mi=\"help_outline\">help_outline</span> Study Notes</a></li>\n          <li><a href=\"/students/textbooks/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -book text-indigo-500\" data-mi=\"menu_book\">menu_book</span> Textbooks</a></li>\n          <li><a href=\"/students/formula-bank/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -book-open text-teal-600\" data-mi=\"auto_stories\">auto_stories</span> All Formula</a></li>\n          <li><a href=\"/students/study-plan/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -calendar-check text-green-500\" data-mi=\"event_available\">event_available</span> Study Plan</a></li>\n          <li><a href=\"/students/video-library/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -photo-video text-cyan-600\" data-mi=\"help_outline\">help_outline</span> Video Library</a></li>\n          <li><a href=\"/students/digital-library/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -book text-indigo-500\" data-mi=\"menu_book\">menu_book</span> Digital Library</a></li>\n          <li><a href=\"/students/game/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -puzzle-piece text-purple-500\" data-mi=\"extension\">extension</span> Game</a></li>\n          <li><a href=\"/students/mock-exams/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -pencil-alt text-orange-500\" data-mi=\"edit\">edit</span> Mock Exams</a></li>\n          <li><a href=\"/students/cbt/cbt/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -computer text-red-500\" data-mi=\"help_outline\">help_outline</span> JAMB CBT</a></li>\n          <li><a href=\"/students/notifications/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -bell text-pink-600\" data-mi=\"notifications\">notifications</span> Notifications</a></li>\n          <li><a href=\"/students/student-live-session/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -chalkboard-teacher text-blue-400\" data-mi=\"co_present\">co_present</span> Live Sessions</a></li>\n          <li><a href=\"/students/Nobel-laureate/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -award text-yellow-600\" data-mi=\"workspace_premium\">workspace_premium</span> Nobel Laureate</a></li>\n        </ul>\n      </nav>\n\n      <div class=\"text-sm text-slate-500 border-t pt-4\">\n        <div class=\"mb-2\">Account</div>\n        <div class=\"flex items-center gap-3\">\n          <img id=\"avatar-sm\" src=\"/site/assets/images/unnamed.jpg\" alt=\"avatar\" class=\"h-10 w-10 rounded-full border\">\n          <div>\n            <div id=\"userName\" class=\"font-semibold\">Student</div>\n            <div id=\"userLevel\" class=\"text-xs text-slate-400\"></div>\n          </div>\n        </div>\n      </div>\n    </aside>\n\n    <!-- Quick personalization: apply preloaded/cached user info to sidebar/topbar immediately -->\n    \n\n  <div id=\"main-content\" class=\"flex-1 flex flex-col lg:ml-72\">\n        <header class=\"flex items-center justify-between p-4 bg-white border-b border-slate-200\">\n          <div class=\"flex items-center gap-3\">\n            <button id=\"toggleSidebar\" class=\"p-2 rounded-md hover:bg-slate-100 lg:hidden\" title=\"Toggle sidebar\"><span class=\"mi -bars\" data-mi=\"menu\">menu</span></button>\n            <div class=\"relative\">\n              <input id=\"globalSearch\" type=\"search\" placeholder=\"Search subjects, topics, resources...\" class=\"w-[520px] hidden md:inline-block pl-10 pr-4 py-2 rounded-full border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-sky-100\">\n              <span class=\"mi -search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" data-mi=\"search\">search</span>\n            </div>\n          </div>\n\n          <div class=\"flex items-center gap-4\">\n            <div class=\"relative\">\n              <button id=\"notifBtn\" class=\"p-2 rounded-full hover:bg-slate-50\" aria-label=\"Notifications\"><span class=\"mi -bell text-sky-600\" data-mi=\"notifications\">notifications</span></button>\n              <span id=\"notifCount\" class=\"absolute -top-1 -right-1 bg-pink-500 text-white rounded-full w-5 h-5 text-xs flex items-center justify-center\">0</span>\n            </div>\n            <div class=\"flex items-center gap-3\">\n              <div class=\"text-right mr-2\">\n                <div id=\"topName\" class=\"font-semibold\">Student Name</div>\n                <div id=\"topLevel\" class=\"text-xs text-slate-400\">SS 3</div>\n              </div>\n              <img id=\"topAvatar\" src=\"/site/assets/images/unnamed.jpg\" alt=\"avatar\" class=\"h-10 w-10 rounded-full border-2\">\n            </div>\n          </div>\n        </header>\n\n        <main class=\"p-6 space-y-6\">\n          <!-- Page content preserved -->\n          <div class=\"max-w-4xl mx-auto py-6 px-4\">\n            <header class=\"text-center mb-6\">\n              <h1 class=\"text-4xl md:text-5xl font-extrabold text-blue-800\">EduNews Feed</h1>\n              <p class=\"mt-2 text-lg text-gray-600\">Your daily source for WAEC, JAMB, NECO &amp; University News</p>\n            </header>\n\n            <div id=\"news-feed-list\" class=\"space-y-6\">\n              <div class=\"bg-white/80 backdrop-blur-sm rounded-2xl shadow-lg p-6 flex items-center gap-4 border border-blue-200\">\n                <svg class=\"w-8 h-8 text-blue-500 flex-shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 7v4a2 2 0 01-2 2H7a2 2 0 01-2-2V7m14 0a2 2 0 00-2-2H7a2 2 0 00-2 2m14 0V5a2 2 0 00-2-2H7a2 2 0 00-2 2v2m14 0H5\"></path></svg>\n                <div>\n                  <h2 id=\"newsWelcome\" class=\"font-bold text-xl text-blue-800 mb-1\">Welcome to your News Feed!</h2>\n                  <p class=\"text-blue-600\">Stay updated with the latest announcements and information from top educational sources.</p>\n                </div>\n              </div>\n\n              <div id=\"news-loading\" class=\"text-center text-blue-600 py-8 flex items-center justify-center gap-3\">\n                <svg class=\"animate-spin h-6 w-6 text-blue-500\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n                  <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                  <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n                </svg>\n                <span>Fetching latest educational news...</span>\n              </div>\n            </div>\n          </div>\n        </main>\n\n        <link rel=\"stylesheet\" href=\"./dashboard-styles.css\">\n      </div>\n    </div>","bodyClass":"bg-slate-50 text-slate-800","bodyStyle":"","css":["#sidebar { transition: transform 0.3s ease-in-out; }\n    #sidebar.hide { transform: translateX(-100%); }\n    @media (min-width: 1024px) { #sidebar { transform: translateX(0) !important; } }","/* from students/dashboard-styles.css */\n/* Base styles */\n.min-h-screen {\n    min-height: 100vh;\n}\n\n/* Mobile (Portrait): up to 480px */\n@media screen and (max-width: 480px) {\n\n    \n    /* Search bar */\n    #globalSearch {\n        width: 100%;\n        max-width: calc(100vw - 120px);\n    }\n    \n    /* Grid adjustments */\n    .grid.grid-cols-2.sm\\:grid-cols-3.lg\\:grid-cols-6 {\n        grid-template-columns: repeat(2, 1fr);\n    }\n    \n    /* Stats grid */\n    .grid.grid-cols-1.lg\\:grid-cols-3 {\n        gap: 1rem;\n    }\n    \n    /* Floating buttons */\n    .fixed.bottom-8.right-8 {\n        bottom: 1rem;\n        right: 1rem;\n    }\n}\n\n/* Mobile (Landscape) and Small Tablets: 481px to 768px */\n@media screen and (min-width: 481px) and (max-width: 768px) {\n\n    \n    /* Search bar */\n    #globalSearch {\n        width: 320px;\n    }\n    \n    /* Grid adjustments */\n    .grid.grid-cols-2.sm\\:grid-cols-3.lg\\:grid-cols-6 {\n        grid-template-columns: repeat(3, 1fr);\n    }\n}\n\n/* Tablets (Portrait): 768px to 1024px */\n@media screen and (min-width: 768px) and (max-width: 1024px) {\n\n    \n    /* Search bar */\n    #globalSearch {\n        width: 400px;\n    }\n    \n    /* Grid adjustments */\n    .grid.grid-cols-2.sm\\:grid-cols-3.lg\\:grid-cols-6 {\n        grid-template-columns: repeat(4, 1fr);\n    }\n    \n    /* Two column layout adjustments */\n    .grid.grid-cols-1.lg\\:grid-cols-3 {\n        grid-template-columns: 2fr 1fr;\n        gap: 1.5rem;\n    }\n}\n\n/* Tablets (Landscape) and Laptops: 769px to 1024px */\n@media screen and (min-width: 769px) and (max-width: 1024px) and (orientation: landscape) {\n\n    \n    /* Search bar */\n    #globalSearch {\n        width: 480px;\n    }\n    \n    /* Grid adjustments */\n    .grid.grid-cols-2.sm\\:grid-cols-3.lg\\:grid-cols-6 {\n        grid-template-columns: repeat(5, 1fr);\n    }\n}\n\n/* Shared responsive utilities */\n.show-mobile {\n    display: none !important;\n}\n\n@media screen and (max-width: 768px) {\n    .hide-mobile {\n        display: none !important;\n    }\n    \n    .show-mobile {\n        display: block !important;\n    }\n    \n    /* Card and container padding adjustments */\n    .p-6 {\n        padding: 1rem;\n    }\n    \n    .gap-6 {\n        gap: 1rem;\n    }\n    \n    /* Text size adjustments */\n    .text-2xl {\n        font-size: 1.5rem;\n    }\n    \n    /* Button size adjustments */\n    .px-4.py-3 {\n        padding: 0.5rem 1rem;\n    }\n}\n"],"quiz":null,"tracker":null,"links":[]}