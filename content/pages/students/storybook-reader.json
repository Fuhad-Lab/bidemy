{"slug":"/students/storybook-reader/","source":"students/storybook-reader.html","area":"students","kind":"content","title":"The Lekki Headmaster - By Kabir Alabi Garba","description":"","subject":null,"body":"<div class=\"flex h-screen overflow-hidden\">\n    <!-- Sidebar -->\n    <aside id=\"sidebar\" class=\"hide md:translate-x-0 fixed md:relative z-40 w-72 h-full bg-white border-r border-slate-200 flex flex-col shadow-lg md:shadow-none\">\n      <div class=\"bg-gradient-to-r from-sky-600 to-sky-500 text-white p-6\">\n        <div class=\"flex items-center gap-3 mb-2\">\n          <div class=\"w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center\">\n            <span class=\"mi -book-open text-lg\" data-mi=\"auto_stories\">auto_stories</span>\n          </div>\n          <div>\n            <h1 class=\"font-serif text-xl font-bold\">The Lekki Headmaster</h1>\n            <p class=\"text-xs text-sky-100 opacity-90\">By Kabir Alabi Garba</p>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"p-4 bg-sky-50 border-b border-slate-100\">\n        <h3 class=\"text-xs font-bold text-slate-500 uppercase tracking-wider mb-3\">Reading Progress</h3>\n        <div class=\"grid grid-cols-2 gap-3\">\n          <div class=\"bg-white rounded-lg p-3 text-center shadow-sm\">\n            <div class=\"text-2xl font-bold text-sky-600\" id=\"pagesReadCount\">0</div>\n            <div class=\"text-xs text-slate-500\">Pages Read</div>\n          </div>\n          <div class=\"bg-white rounded-lg p-3 text-center shadow-sm\">\n            <div class=\"text-2xl font-bold text-emerald-600\" id=\"quizScoreDisplay\">-</div>\n            <div class=\"text-xs text-slate-500\">Last Score</div>\n          </div>\n        </div>\n        <div class=\"mt-3\">\n          <div class=\"flex justify-between text-xs text-slate-500 mb-1\">\n            <span>Progress</span>\n            <span id=\"progressText\">0%</span>\n          </div>\n          <div class=\"h-2 bg-slate-200 rounded-full overflow-hidden\">\n            <div id=\"sidebarProgress\" class=\"h-full bg-gradient-to-r from-sky-500 to-emerald-500 transition-all duration-300\" style=\"width: 0%\"></div>\n          </div>\n        </div>\n      </div>\n      \n      <nav class=\"flex-1 overflow-y-auto p-4 space-y-6\">\n        <div>\n          <h3 class=\"text-xs font-bold text-slate-400 uppercase tracking-wider mb-3 flex items-center gap-2\">\n            <span class=\"mi -bookmark text-sky-500\" data-mi=\"bookmark\">bookmark</span> Bookmarks\n          </h3>\n          <div id=\"bookmarksList\" class=\"space-y-2\">\n            <p class=\"text-sm text-slate-400 italic\">No bookmarks yet</p>\n          </div>\n        </div>\n        <div>\n          <h3 class=\"text-xs font-bold text-slate-400 uppercase tracking-wider mb-3 flex items-center gap-2\">\n            <span class=\"mi -sticky-note text-sky-500\" data-mi=\"sticky_note_2\">sticky_note_2</span> Notes\n          </h3>\n          <div id=\"notesList\" class=\"space-y-2\">\n            <p class=\"text-sm text-slate-400 italic\">No notes yet</p>\n          </div>\n        </div>\n        <div>\n          <h3 class=\"text-xs font-bold text-slate-400 uppercase tracking-wider mb-3 flex items-center gap-2\">\n            <span class=\"mi -spell-check text-sky-500\" data-mi=\"help_outline\">help_outline</span> Vocabulary\n          </h3>\n          <div id=\"vocabularyList\" class=\"space-y-2\">\n            <p class=\"text-sm text-slate-400 italic\">No words added</p>\n          </div>\n        </div>\n      </nav>\n      \n      <div class=\"p-4 border-t border-slate-100\">\n        <a href=\"/students/student-dashboard/\" id=\"backToDashboard\" class=\"flex items-center gap-2 text-sm text-slate-500 hover:text-sky-600 transition\">\n          <span class=\"mi -arrow-left\" data-mi=\"arrow_back\">arrow_back</span> Back to Dashboard\n        </a>\n      </div>\n    </aside>\n    \n    <!-- Main Content -->\n    <main class=\"flex-1 flex flex-col min-w-0\">\n      <header class=\"bg-white border-b border-slate-200 px-4 py-3 flex items-center justify-between gap-4 flex-wrap\">\n        <div class=\"flex items-center gap-2\">\n          <button id=\"sidebarToggle\" class=\"p-2 rounded-lg hover:bg-slate-100 md:hidden transition\" title=\"Toggle sidebar\">\n            <span class=\"mi -bars text-slate-600\" data-mi=\"menu\">menu</span>\n          </button>\n          <button id=\"toggleDarkMode\" class=\"p-2 rounded-lg hover:bg-slate-100 transition\" title=\"Dark mode\">\n            <span class=\"mi -moon text-slate-600\" data-mi=\"dark_mode\">dark_mode</span>\n          </button>\n        </div>\n        \n        <div class=\"flex items-center gap-2\">\n          <button id=\"prevBtn\" class=\"p-2 px-3 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 transition disabled:opacity-50\">\n            <span class=\"mi -chevron-left\" data-mi=\"chevron_left\">chevron_left</span>\n          </button>\n          <div class=\"flex items-center gap-2 bg-slate-100 rounded-lg px-3 py-2\">\n            <input type=\"number\" id=\"pageInput\" min=\"1\" class=\"w-12 bg-transparent text-center font-semibold text-slate-700 focus:outline-none\">\n            <span class=\"text-slate-400\">/</span>\n            <span id=\"totalPages\" class=\"text-slate-600 font-medium\">1</span>\n          </div>\n          <button id=\"nextBtn\" class=\"p-2 px-3 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 transition disabled:opacity-50\">\n            <span class=\"mi -chevron-right\" data-mi=\"chevron_right\">chevron_right</span>\n          </button>\n        </div>\n        \n        <div class=\"flex items-center gap-2\">\n          <button id=\"bookmarkBtn\" class=\"p-2 px-4 rounded-lg bg-slate-100 hover:bg-sky-100 hover:text-sky-600 text-slate-600 transition flex items-center gap-2\" title=\"Bookmark page\">\n            <span class=\"mi -bookmark\" data-mi=\"bookmark\">bookmark</span>\n            <span class=\"hidden sm:inline text-sm font-medium\">Bookmark</span>\n          </button>\n          <button id=\"addNoteBtn\" class=\"p-2 px-4 rounded-lg bg-slate-100 hover:bg-sky-100 hover:text-sky-600 text-slate-600 transition flex items-center gap-2\" title=\"Add note\">\n            <span class=\"mi -sticky-note\" data-mi=\"sticky_note_2\">sticky_note_2</span>\n            <span class=\"hidden sm:inline text-sm font-medium\">Note</span>\n          </button>\n          <button id=\"speakBtn\" class=\"p-2 px-4 rounded-lg bg-gradient-to-r from-sky-500 to-sky-600 hover:from-sky-600 hover:to-sky-700 text-white transition flex items-center gap-2\" title=\"Read aloud\">\n            <span class=\"mi -volume-up\" data-mi=\"volume_up\">volume_up</span>\n            <span class=\"hidden sm:inline text-sm font-medium\">Read</span>\n          </button>\n        </div>\n      </header>\n      \n      <div class=\"h-1 bg-slate-100\">\n        <div id=\"progressFill\" class=\"h-full bg-gradient-to-r from-sky-500 to-sky-400 transition-all duration-300\" style=\"width: 0%\"></div>\n      </div>\n      \n      <div class=\"bg-gradient-to-r from-sky-50 to-white px-4 py-2 border-b border-slate-100\">\n        <div class=\"flex items-center justify-between text-sm\">\n          <span class=\"text-slate-500\">\n            <span class=\"mi -book-reader text-sky-500 mr-2\" data-mi=\"local_library\">local_library</span>\n            Reading Progress: <span id=\"progressPercent\" class=\"font-semibold text-sky-600\">0%</span>\n          </span>\n          <span id=\"pageInfo\" class=\"text-slate-500\">Page <span class=\"font-semibold text-slate-700\">1</span> of <span class=\"font-semibold text-slate-700\">1</span></span>\n        </div>\n      </div>\n      \n      <!-- PDF Container -->\n      <div id=\"pdfContainer\" class=\"flex-1 overflow-auto bg-gradient-to-b from-slate-100 to-slate-50 p-4 md:p-8\">\n        <!-- Loading State -->\n        <div id=\"loadingState\" class=\"flex flex-col items-center justify-center h-full py-20\">\n          <div class=\"w-16 h-16 border-4 border-sky-200 border-t-sky-500 rounded-full animate-spin mb-4\"></div>\n          <p class=\"text-slate-600 text-lg\" id=\"loadingMsg\">Loading PDF...</p>\n          <p class=\"text-slate-400 text-sm mt-2\" id=\"loadingPath\"></p>\n        </div>\n        \n        <!-- Error State -->\n        <div id=\"errorState\" class=\"hidden flex flex-col items-center justify-center h-full py-20\">\n          <div class=\"bg-white rounded-xl shadow-lg p-8 max-w-md text-center\">\n            <span class=\"mi -exclamation-triangle text-5xl text-red-500 mb-4\" data-mi=\"warning_amber\">warning_amber</span>\n            <h3 class=\"text-xl font-bold text-slate-800 mb-2\">Unable to Load PDF</h3>\n            <p class=\"text-slate-500 mb-4\" id=\"errorMsg\">The PDF file could not be loaded.</p>\n            <button class=\"px-6 py-2 bg-sky-500 text-white rounded-lg hover:bg-sky-600 transition\">\n              <span class=\"mi -redo mr-2\" data-mi=\"redo\">redo</span>Retry\n            </button>\n          </div>\n        </div>\n        \n        <!-- PDF Canvas -->\n        <div id=\"canvasWrapper\" class=\"hidden flex justify-center\">\n          <canvas id=\"pdfCanvas\" class=\"max-w-full h-auto bg-white rounded-xl shadow-2xl\"></canvas>\n        </div>\n      </div>\n    </main>\n  </div>\n  \n  <div id=\"overlay\" class=\"fixed inset-0 bg-slate-900/50 z-30 hidden md:hidden\"></div>\n  \n  <!-- Note Modal -->\n  <div id=\"noteModal\" class=\"fixed inset-0 bg-slate-900/50 z-50 hidden items-center justify-center p-4\">\n    <div class=\"bg-white rounded-2xl shadow-2xl w-full max-w-md animate-slide-up\">\n      <div class=\"p-6 border-b border-slate-100\">\n        <div class=\"flex items-center justify-between\">\n          <h2 class=\"font-serif text-xl font-bold text-slate-800\">Add Note</h2>\n          <button class=\"p-2 hover:bg-slate-100 rounded-lg transition\">\n            <span class=\"mi -times text-slate-400\" data-mi=\"close\">close</span>\n          </button>\n        </div>\n      </div>\n      <div class=\"p-6 space-y-4\">\n        <div>\n          <label class=\"block text-sm font-medium text-slate-700 mb-2\">Title</label>\n          <input type=\"text\" id=\"noteTitle\" placeholder=\"Enter note title...\" class=\"w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-sky-500 focus:ring-2 focus:ring-sky-100 outline-none transition\">\n        </div>\n        <div>\n          <label class=\"block text-sm font-medium text-slate-700 mb-2\">Content</label>\n          <textarea id=\"noteContent\" rows=\"4\" placeholder=\"Write your note...\" class=\"w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-sky-500 focus:ring-2 focus:ring-sky-100 outline-none transition resize-none\"></textarea>\n        </div>\n        <button class=\"w-full py-3 bg-gradient-to-r from-sky-500 to-sky-600 hover:from-sky-600 hover:to-sky-700 text-white font-semibold rounded-xl transition\">Save Note</button>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Exit Quiz Modal -->\n  <div id=\"exitQuizModal\" class=\"fixed inset-0 bg-slate-900/80 z-[100] hidden items-center justify-center p-4 overflow-y-auto\">\n    <div class=\"bg-white rounded-2xl shadow-2xl w-full max-w-2xl my-8 animate-slide-up\">\n      <div class=\"p-6 border-b border-slate-100 bg-gradient-to-r from-sky-500 to-sky-600 rounded-t-2xl text-white\">\n        <div class=\"flex items-center justify-between\">\n          <div>\n            <h2 class=\"font-serif text-xl font-bold\">📖 Reading Comprehension Quiz</h2>\n            <p class=\"text-sm text-sky-100 mt-1\">Complete this quiz before leaving (Pages 1 - <span id=\"quizUpToPage\">1</span>)</p>\n          </div>\n        </div>\n        <div class=\"mt-4 flex items-center justify-between text-sm\">\n          <span>Question <span id=\"currentQuestionNum\">1</span> of <span id=\"totalQuestions\">5</span></span>\n          <span>Score: <span id=\"quizCurrentScore\">0</span>/<span id=\"quizMaxScore\">5</span></span>\n        </div>\n        <div class=\"mt-3 h-2 bg-white/20 rounded-full overflow-hidden\">\n          <div id=\"quizProgressBar\" class=\"h-full bg-white transition-all duration-300\" style=\"width: 0%\"></div>\n        </div>\n      </div>\n      \n      <div class=\"p-6\">\n        <div id=\"quizQuestionContainer\">\n          <p id=\"quizQuestion\" class=\"text-lg font-medium text-slate-800 mb-6\"></p>\n          <div id=\"quizOptions\" class=\"space-y-3\"></div>\n        </div>\n        \n        <div id=\"quizResults\" class=\"hidden text-center py-6\">\n          <div class=\"w-20 h-20 mx-auto mb-4 rounded-full flex items-center justify-center bg-green-100\" id=\"quizResultIcon\">\n            <span class=\"mi -trophy text-3xl text-yellow-500\" data-mi=\"emoji_events\">emoji_events</span>\n          </div>\n          <h3 class=\"text-2xl font-bold text-slate-800 mb-2\">Quiz Complete!</h3>\n          <p class=\"text-slate-500 mb-2\">You scored <span id=\"finalScore\" class=\"font-bold text-sky-600\">0</span> out of <span id=\"finalMaxScore\">5</span></p>\n          <p class=\"text-sm text-slate-400 mb-4\" id=\"quizPercentageText\">Percentage: 0%</p>\n          <button id=\"exitAfterQuiz\" class=\"px-8 py-3 bg-gradient-to-r from-sky-500 to-sky-600 hover:from-sky-600 hover:to-sky-700 text-white font-semibold rounded-xl transition\">\n            <span class=\"mi -check mr-2\" data-mi=\"check\">check</span>Continue\n          </button>\n        </div>\n      </div>\n      \n      <div id=\"quizFooter\" class=\"p-6 border-t border-slate-100 flex justify-end\">\n        <button id=\"nextQuestionBtn\" class=\"px-6 py-2 bg-gradient-to-r from-sky-500 to-sky-600 hover:from-sky-600 hover:to-sky-700 text-white font-medium rounded-xl transition\">\n          Next<span class=\"mi -arrow-right ml-2\" data-mi=\"arrow_forward\">arrow_forward</span>\n        </button>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Warning Modal -->\n  <div id=\"warningModal\" class=\"fixed inset-0 bg-slate-900/80 z-[100] hidden items-center justify-center p-4\">\n    <div class=\"bg-white rounded-2xl shadow-2xl w-full max-w-md animate-slide-up\">\n      <div class=\"p-6 text-center\">\n        <div class=\"w-16 h-16 mx-auto mb-4 bg-amber-100 rounded-full flex items-center justify-center\">\n          <span class=\"mi -exclamation-triangle text-3xl text-amber-500\" data-mi=\"warning_amber\">warning_amber</span>\n        </div>\n        <h3 class=\"text-xl font-bold text-slate-800 mb-2\">Quiz Required</h3>\n        <p class=\"text-slate-500 mb-6\">Please complete the reading comprehension quiz before leaving. You've read up to page <span id=\"warningPageNum\" class=\"font-bold text-sky-600\">1</span>.</p>\n        <button class=\"w-full py-3 bg-gradient-to-r from-sky-500 to-sky-600 hover:from-sky-600 hover:to-sky-700 text-white font-semibold rounded-xl transition\">\n          <span class=\"mi -play mr-2\" data-mi=\"play_arrow\">play_arrow</span>Start Quiz\n        </button>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Toast -->\n  <div id=\"toast\" class=\"fixed bottom-4 right-4 z-50 hidden\">\n    <div class=\"bg-slate-800 text-white px-6 py-3 rounded-xl shadow-lg flex items-center gap-3 animate-fade-in\">\n      <span class=\"mi -check-circle text-green-400\" data-mi=\"check_circle\">check_circle</span>\n      <span id=\"toastMessage\">Action completed</span>\n    </div>\n  </div>","bodyClass":"bg-slate-50 text-slate-800 font-sans","bodyStyle":"","css":["@keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }\n    @keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }\n    @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }\n    @keyframes spin { to { transform: rotate(360deg); } }\n    .animate-fade-in { animation: fadeIn 0.3s ease-out; }\n    .animate-slide-up { animation: slideUp 0.3s ease-out; }\n    .animate-shake { animation: shake 0.5s ease-in-out; }\n    .animate-spin { animation: spin 1s linear infinite; }\n    .font-serif { font-family: 'Playfair Display', serif; }\n    ::-webkit-scrollbar { width: 6px; }\n    ::-webkit-scrollbar-track { background: #f1f5f9; }\n    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }\n    #sidebar { transition: transform 0.3s ease-in-out; }\n    #sidebar.hide { transform: translateX(-100%); }\n    @media (min-width: 768px) { #sidebar { transform: translateX(0) !important; } }\n    .quiz-option { transition: all 0.2s ease; }\n    .quiz-option:hover:not(.selected):not(.correct):not(.wrong) { background: #f0f9ff; border-color: #0ea5e9; }\n    .quiz-option.selected { background: #0ea5e9; color: white; border-color: #0ea5e9; }\n    .quiz-option.correct { background: #10b981; color: white; border-color: #10b981; }\n    .quiz-option.wrong { background: #ef4444; color: white; border-color: #ef4444; }\n    body.quiz-active { overflow: hidden; }"],"quiz":null,"tracker":null,"links":[]}