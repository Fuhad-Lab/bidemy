{"slug":"/students/formula-bank-supabase/","source":"students/formula-bank-supabase.html","area":"students","kind":"content","title":"Formula Bank - Prep100","description":"","subject":null,"body":"<div class=\"min-h-screen flex\">\n    <!-- Sidebar (Embedded) -->\n    <aside id=\"sidebar\" class=\"w-64 md:w-72 lg:w-80 fixed left-0 top-0 h-full bg-white border-r border-slate-200 p-5 flex flex-col gap-6 overflow-auto z-40\">\n      <div class=\"flex items-center gap-3\">\n        <img src=\"/site/assets/images/logo.png\" alt=\"logo\" class=\"h-12 w-12 rounded-full shadow-sm\">\n        <div>\n          <div class=\"text-lg font-bold text-sky-700\">JUANOVA CORTEX</div>\n          <div class=\"text-xs text-slate-500\">Student Dashboard</div>\n        </div>\n      </div>\n\n      <nav class=\"flex-1 overflow-auto\">\n        <ul class=\"space-y-1\">\n          <li><a href=\"/students/subjects/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -home text-sky-600\" data-mi=\"home\">home</span> Home</a></li>\n          <li><a href=\"/students/news-feed-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -newspaper text-pink-500\" data-mi=\"help_outline\">help_outline</span> News Feed</a></li>\n          <li><a href=\"/students/notes-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -note-sticky text-yellow-500\" data-mi=\"help_outline\">help_outline</span> Study Notes</a></li>\n          <li><a href=\"/students/textbooks-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -book text-indigo-500\" data-mi=\"menu_book\">menu_book</span> Textbooks</a></li>\n          <li><a href=\"/students/formula-bank-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50 bg-sky-50\"><span class=\"mi -book-open text-teal-600\" data-mi=\"auto_stories\">auto_stories</span> All Formula</a></li>\n          <li><a href=\"/students/study-plan-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -calendar-check text-green-500\" data-mi=\"event_available\">event_available</span> Study Plan</a></li>\n          <li><a href=\"/students/video-library-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -photo-video text-cyan-600\" data-mi=\"help_outline\">help_outline</span> Video Library</a></li>\n          <li><a href=\"/students/digital-library-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -book text-indigo-500\" data-mi=\"menu_book\">menu_book</span> Digital Library</a></li>\n          <li><a href=\"/students/game/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -puzzle-piece text-purple-500\" data-mi=\"extension\">extension</span> Game</a></li>\n          <li><a href=\"/students/mock-exams-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -pencil-alt text-orange-500\" data-mi=\"edit\">edit</span> Mock Exams</a></li>\n          <li><a href=\"/students/cbt/cbt/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -computer text-red-500\" data-mi=\"help_outline\">help_outline</span> JAMB CBT</a></li>\n          <li><a href=\"/students/notifications-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -bell text-pink-600\" data-mi=\"notifications\">notifications</span> Notifications</a></li>\n          <li><a href=\"/students/student-live-session-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -chalkboard-teacher text-blue-400\" data-mi=\"co_present\">co_present</span> Live Sessions</a></li>\n          <li><a href=\"/students/nobel-laureate-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -award text-yellow-600\" data-mi=\"workspace_premium\">workspace_premium</span> Nobel Laureate</a></li>\n        </ul>\n      </nav>\n\n      <div class=\"text-sm text-slate-500 border-t pt-4\">\n        <div class=\"mb-2\">Account</div>\n        <div class=\"flex items-center gap-3\">\n          <img id=\"avatar-sm\" src=\"/site/assets/images/unnamed.jpg\" alt=\"avatar\" class=\"h-10 w-10 rounded-full border\">\n          <div>\n            <div id=\"userName\" class=\"font-semibold\">Student</div>\n            <div id=\"userLevel\" class=\"text-xs text-slate-400\"></div>\n          </div>\n        </div>\n      </div>\n    </aside>\n\n    <!-- Main Content -->\n      <div class=\"layout\">\n      <!-- Sidebar injected at runtime by students/js/sidebar-fragment.js -->\n\n    <main class=\"main-content\" style=\"margin-left: 18rem;\">\n      <div class=\"page-header\">\n        <h1 class=\"page-title\"><span class=\"mi -lightbulb\" data-mi=\"lightbulb\">lightbulb</span> Quick Formula Bank</h1>\n        <button class=\"add-formula-btn\">\n          <span class=\"mi -plus\" data-mi=\"add\">add</span> Add Formula\n        </button>\n      </div>\n\n      <div class=\"search-bar\">\n        <input type=\"search\" class=\"search-input\" placeholder=\"Search formulas...\">\n        <label for=\"subject-filter\" class=\"visually-hidden\">Filter by subject</label>\n        <select class=\"subject-filter\" id=\"subject-filter\">\n          <option value=\"\">All Subjects</option>\n          <option value=\"mathematics\">Mathematics</option>\n          <option value=\"physics\">Physics</option>\n          <option value=\"chemistry\">Chemistry</option>\n        </select>\n      </div>\n\n      <div class=\"formulas-grid\">\n        <!-- Mathematics Formulas -->\n        <div class=\"formula-card\">\n          <div class=\"formula-subject\">Mathematics</div>\n          <h3 class=\"formula-title\">Quadratic Formula</h3>\n          <div class=\"formula-content\">x = (-b ± √(b² - 4ac)) / 2a</div>\n          <div class=\"formula-actions\">\n            <button class=\"formula-btn\" title=\"Edit\"><span class=\"mi -edit\" data-mi=\"edit\">edit</span></button>\n            <button class=\"formula-btn\" title=\"Delete\"><span class=\"mi -trash\" data-mi=\"delete\">delete</span></button>\n            <button class=\"formula-btn\" title=\"Copy\"><span class=\"mi -copy\" data-mi=\"content_copy\">content_copy</span></button>\n          </div>\n        </div>\n\n        <!-- Physics Formulas -->\n        <div class=\"formula-card\">\n          <div class=\"formula-subject\">Physics</div>\n          <h3 class=\"formula-title\">Force</h3>\n          <div class=\"formula-content\">F = ma</div>\n          <div class=\"formula-actions\">\n            <button class=\"formula-btn\" title=\"Edit\"><span class=\"mi -edit\" data-mi=\"edit\">edit</span></button>\n            <button class=\"formula-btn\" title=\"Delete\"><span class=\"mi -trash\" data-mi=\"delete\">delete</span></button>\n            <button class=\"formula-btn\" title=\"Copy\"><span class=\"mi -copy\" data-mi=\"content_copy\">content_copy</span></button>\n          </div>\n        </div>\n\n        <!-- Chemistry Formulas -->\n        <div class=\"formula-card\">\n          <div class=\"formula-subject\">Chemistry</div>\n          <h3 class=\"formula-title\">Density</h3>\n          <div class=\"formula-content\">ρ = m/V</div>\n          <div class=\"formula-actions\">\n            <button class=\"formula-btn\" title=\"Edit\"><span class=\"mi -edit\" data-mi=\"edit\">edit</span></button>\n            <button class=\"formula-btn\" title=\"Delete\"><span class=\"mi -trash\" data-mi=\"delete\">delete</span></button>\n            <button class=\"formula-btn\" title=\"Copy\"><span class=\"mi -copy\" data-mi=\"content_copy\">content_copy</span></button>\n          </div>\n        </div>\n      </div>\n    </main>\n  </div>\n\n  <!-- Add Formula Modal -->\n  <div class=\"modal-overlay\" id=\"addFormulaModal\">\n    <div class=\"modal\">\n      <div class=\"modal-header\">\n        <h2 class=\"modal-title\">Add New Formula</h2>\n        <button class=\"modal-close\">×</button>\n      </div>\n      <form class=\"modal-form\" id=\"addFormulaForm\" onsubmit=\"handleAddFormula(event)\">\n        <div class=\"form-group\">\n          <label for=\"formulaSubject\">Subject</label>\n          <select id=\"formulaSubject\" required=\"\">\n            <option value=\"\">Select Subject</option>\n            <option value=\"mathematics\">Mathematics</option>\n            <option value=\"physics\">Physics</option>\n            <option value=\"chemistry\">Chemistry</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"formulaCategory\">Category</label>\n          <select id=\"formulaCategory\">\n            <option value=\"General\">General</option>\n            <option value=\"Mechanics\">Mechanics</option>\n            <option value=\"Kinematics\">Kinematics</option>\n            <option value=\"Electricity\">Electricity</option>\n            <option value=\"Electromagnetism\">Electromagnetism</option>\n            <option value=\"Optics\">Optics</option>\n            <option value=\"Sound\">Sound</option>\n            <option value=\"Fluid Mechanics\">Fluid Mechanics</option>\n            <option value=\"Thermodynamics\">Thermodynamics</option>\n            <option value=\"Waves\">Waves</option>\n            <!-- Chemistry Categories -->\n            <option value=\"Stoichiometry\">Stoichiometry</option>\n            <option value=\"Gas Laws\">Gas Laws</option>\n            <option value=\"Solutions\">Solutions</option>\n            <option value=\"Kinetics\">Kinetics</option>\n            <option value=\"Equilibrium\">Equilibrium</option>\n            <option value=\"Acids and Bases\">Acids and Bases</option>\n            <option value=\"Thermochemistry\">Thermochemistry</option>\n            <option value=\"Electrochemistry\">Electrochemistry</option>\n            <option value=\"Nuclear Chemistry\">Nuclear Chemistry</option>\n            <option value=\"Organic Chemistry\">Organic Chemistry</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"formulaTitle\">Formula Title</label>\n          <input type=\"text\" id=\"formulaTitle\" required=\"\" placeholder=\"e.g., Pythagorean Theorem\">\n        </div>\n        <div class=\"form-group\">\n          <label for=\"formulaContent\">Formula</label>\n          <textarea id=\"formulaContent\" required=\"\" placeholder=\"e.g., a² + b² = c²\"></textarea>\n        </div>\n        <div class=\"modal-actions\">\n          <button type=\"button\" class=\"modal-btn cancel\">Cancel</button>\n          <button type=\"submit\" class=\"modal-btn save\">Save Formula</button>\n        </div>\n      </form>\n    </div>\n  </div>\n  </div>","bodyClass":"bg-slate-50 text-slate-800","bodyStyle":"","css":["#sidebar { transition: transform 0.3s ease-in-out; }\n    #sidebar.hide { transform: translateX(-100%); }\n    @media (min-width: 1024px) { #sidebar { transform: translateX(0) !important; } }"],"quiz":null,"tracker":null,"links":[]}