{"slug":"/students/student-live-session-supabase/","source":"students/student-live-session-supabase.html","area":"students","kind":"content","title":"Live Sessions - Prep100","description":"","subject":null,"body":"<div class=\"min-h-screen flex\">\n    <aside id=\"sidebar\" class=\"w-64 md:w-72 lg:w-80 fixed left-0 top-0 h-full bg-white border-r border-slate-200 p-5 flex flex-col gap-6 overflow-auto z-40\">\n      <div class=\"flex items-center gap-3\"><img src=\"/site/assets/images/logo.png\" alt=\"logo\" class=\"h-12 w-12 rounded-full shadow-sm\"><div><div class=\"text-lg font-bold text-sky-700\">JUANOVA CORTEX</div><div class=\"text-xs text-slate-500\">Student Dashboard</div></div></div>\n      <nav class=\"flex-1 overflow-auto\"><ul class=\"space-y-1\">\n        <li><a href=\"/students/subjects/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -home text-sky-600\" data-mi=\"home\">home</span> Home</a></li>\n        <li><a href=\"/students/news-feed-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -newspaper text-pink-500\" data-mi=\"help_outline\">help_outline</span> News Feed</a></li>\n        <li><a href=\"/students/notes-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -note-sticky text-yellow-500\" data-mi=\"help_outline\">help_outline</span> Study Notes</a></li>\n        <li><a href=\"/students/textbooks-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -book text-indigo-500\" data-mi=\"menu_book\">menu_book</span> Textbooks</a></li>\n        <li><a href=\"/students/formula-bank-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -book-open text-teal-600\" data-mi=\"auto_stories\">auto_stories</span> All Formula</a></li>\n        <li><a href=\"/students/study-plan-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -calendar-check text-green-500\" data-mi=\"event_available\">event_available</span> Study Plan</a></li>\n        <li><a href=\"/students/video-library-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -photo-video text-cyan-600\" data-mi=\"help_outline\">help_outline</span> Video Library</a></li>\n        <li><a href=\"/students/digital-library-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -book text-indigo-500\" data-mi=\"menu_book\">menu_book</span> Digital Library</a></li>\n        <li><a href=\"/students/game/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -puzzle-piece text-purple-500\" data-mi=\"extension\">extension</span> Game</a></li>\n        <li><a href=\"/students/mock-exams-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -pencil-alt text-orange-500\" data-mi=\"edit\">edit</span> Mock Exams</a></li>\n        <li><a href=\"/students/notifications-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -bell text-pink-600\" data-mi=\"notifications\">notifications</span> Notifications</a></li>\n        <li><a href=\"/students/student-live-session-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50 bg-sky-50\"><span class=\"mi -chalkboard-teacher text-blue-400\" data-mi=\"co_present\">co_present</span> Live Sessions</a></li>\n        <li><a href=\"/students/nobel-laureate-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -award text-yellow-600\" data-mi=\"workspace_premium\">workspace_premium</span> Nobel Laureate</a></li>\n      </ul></nav>\n      <div class=\"text-sm text-slate-500 border-t pt-4\"><div class=\"mb-2\">Account</div><div class=\"flex items-center gap-3\"><img id=\"avatar-sm\" src=\"/site/assets/images/unnamed.jpg\" alt=\"avatar\" class=\"h-10 w-10 rounded-full border\"><div><div id=\"userName\" class=\"font-semibold\">Student</div><div id=\"userLevel\" class=\"text-xs text-slate-400\"></div></div></div></div>\n    </aside>\n          <div id=\"main-content\" class=\"flex-1 flex flex-col lg:ml-72\">\n        <header class=\"flex items-center justify-between p-4 bg-white border-b border-slate-200 w-full\">\n          <div class=\"flex items-center gap-3\">\n            <button id=\"toggleSidebar\" class=\"p-2 rounded-md hover:bg-slate-100 lg:hidden\" title=\"Toggle sidebar\"><span class=\"mi -bars\" data-mi=\"menu\">menu</span></button>\n            <div class=\"relative\">\n              <span class=\"mi -search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" data-mi=\"search\">search</span>\n              <input id=\"globalSearch\" type=\"search\" placeholder=\"Search sessions, teachers or topics...\" class=\"w-[520px] hidden md:inline-block pl-10 pr-4 py-2 rounded-full border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-sky-100\" aria-label=\"Search sessions\">\n            </div>\n          </div>\n\n          <div class=\"flex items-center gap-4\">\n            <div class=\"relative\">\n              <button id=\"notifBtn\" class=\"p-2 rounded-full hover:bg-slate-50\" aria-label=\"Notifications\"><span class=\"mi -bell text-sky-600\" data-mi=\"notifications\">notifications</span></button>\n              <span id=\"notifCount\" class=\"absolute -top-1 -right-1 bg-pink-500 text-white rounded-full w-5 h-5 text-xs flex items-center justify-center\">0</span>\n            </div>\n            <div class=\"flex items-center gap-3\">\n              <div class=\"text-right mr-2\">\n                <div id=\"topName\" class=\"font-semibold\">Student Name</div>\n                <div id=\"topLevel\" class=\"text-xs text-slate-400\">SS 3</div>\n              </div>\n              <img id=\"topAvatar\" src=\"/site/assets/images/unnamed.jpg\" alt=\"avatar\" class=\"h-10 w-10 rounded-full border-2\">\n            </div>\n          </div>\n        </header>\n\n        <main class=\"p-6 space-y-6\">\n      <!-- Hero: next session & actions -->\n      <section class=\"rounded-3xl bg-gradient-to-r from-blue-600 to-blue-400 text-white p-6 shadow mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4\">\n        <div>\n          <h1 class=\"text-2xl font-extrabold\">Live Sessions</h1>\n          <p class=\"text-blue-100 mt-1\">Quickly join live classes, explore upcoming schedules, or watch recordings.</p>\n          <div class=\"mt-3 flex items-center gap-3\">\n            <div class=\"text-sm\">Next:</div>\n            <div id=\"nextSessionTitle\" class=\"font-semibold\">—</div>\n            <div id=\"nextCountdown\" class=\"ml-3 text-sm countdown bg-white/20 px-3 py-1 rounded\">—</div>\n          </div>\n        </div>\n        <div class=\"flex items-center gap-3\">\n          <button id=\"viewSchedule\" class=\"bg-white text-blue-600 px-4 py-2 rounded-full font-semibold\">View Schedule</button>\n          <button id=\"quickJoin\" class=\"bg-green-500 px-4 py-2 rounded-full font-semibold shadow hover:bg-green-600\">Join Next</button>\n        </div>\n      </section>\n\n      <!-- Tabs + Filters -->\n      <div class=\"flex items-center justify-between mb-4 gap-4\">\n        <nav class=\"flex items-center gap-2\" role=\"tablist\" aria-label=\"Session tabs\">\n          <button class=\"tab-btn px-4 py-2 rounded-md bg-white border\" role=\"tab\" aria-selected=\"true\" data-tab=\"live\">Live Now</button>\n          <button class=\"tab-btn px-4 py-2 rounded-md bg-white border\" role=\"tab\" aria-selected=\"false\" data-tab=\"upcoming\">Upcoming</button>\n          <button class=\"tab-btn px-4 py-2 rounded-md bg-white border\" role=\"tab\" aria-selected=\"false\" data-tab=\"recordings\">Recordings</button>\n          <button class=\"tab-btn px-4 py-2 rounded-md bg-white border\" role=\"tab\" aria-selected=\"false\" data-tab=\"my\">My Sessions</button>\n        </nav>\n\n        <div class=\"flex items-center gap-2\">\n          <select id=\"filterSubject\" aria-label=\"Filter by subject\" class=\"px-3 py-2 border rounded bg-white\">\n            <option value=\"\">All subjects</option>\n          </select>\n          <select id=\"filterMode\" aria-label=\"Filter by mode\" class=\"px-3 py-2 border rounded bg-white\">\n            <option value=\"\">All modes</option>\n            <option value=\"webinar\">Webinar</option>\n            <option value=\"breakout\">Breakout</option>\n          </select>\n        </div>\n      </div>\n\n      <div id=\"contentArea\" class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        <!-- Main column: session lists -->\n        <section id=\"listColumn\" class=\"lg:col-span-2\">\n          <div id=\"sessionsList\" class=\"grid grid-cols-1 gap-4\"></div>\n        </section>\n\n        <!-- Right column: details / pinned info -->\n        <aside id=\"rightColumn\" class=\"space-y-4\">\n          <div class=\"p-4 bg-white rounded-lg shadow\">\n            <h3 class=\"font-semibold\">Quick Actions</h3>\n            <p class=\"text-sm text-gray-600\">Jump between live, upcoming and recorded sessions easily.</p>\n            <div class=\"mt-3 flex flex-col gap-2\">\n              <button id=\"openCalendar\" class=\"px-3 py-2 bg-gray-100 rounded\">Open Calendar</button>\n              <button id=\"openRecordings\" class=\"px-3 py-2 bg-gray-100 rounded\">Browse Recordings</button>\n            </div>\n          </div>\n\n          <div id=\"upcomingMini\" class=\"p-4 bg-white rounded-lg shadow\">\n            <h4 class=\"font-semibold\">Soon</h4>\n            <ul id=\"upcomingList\" class=\"text-sm text-gray-600 mt-2 space-y-2\"></ul>\n          </div>\n        </aside>\n      </div>\n\n      <!-- Slide-over detail -->\n      <div id=\"slideOver\" class=\"fixed right-0 top-0 h-full w-full md:w-1/3 bg-white shadow-lg slide-over z-50\" aria-hidden=\"true\">\n        <div class=\"p-6 h-full flex flex-col\">\n          <div class=\"flex items-start justify-between\">\n            <div>\n              <h2 id=\"detailTitle\" class=\"text-xl font-bold\">Session title</h2>\n              <div id=\"detailMeta\" class=\"text-sm text-gray-600\">Teacher • Subject • 1h</div>\n            </div>\n            <div class=\"flex items-center gap-2\">\n              <button id=\"detailCopy\" class=\"p-2 rounded hover:bg-gray-100\" title=\"Copy link\" aria-label=\"Copy link\"><span class=\"mi -link\" data-mi=\"link\">link</span></button>\n              <button id=\"detailClose\" class=\"p-2 rounded hover:bg-gray-100\" title=\"Close\" aria-label=\"Close detail\"><span class=\"mi -times\" data-mi=\"close\">close</span></button>\n            </div>\n          </div>\n\n          <div id=\"detailBody\" class=\"mt-4 flex-1 overflow-auto\">\n            <p id=\"detailDescription\" class=\"text-gray-700\">Details about the session, materials, and quick actions.</p>\n            <div id=\"detailMaterials\" class=\"mt-4\"></div>\n          </div>\n\n          <div class=\"mt-4 flex gap-2\">\n            <a id=\"detailJoin\" class=\"ml-auto bg-green-500 px-4 py-2 rounded text-white font-semibold\" role=\"button\">Join</a>\n            <button id=\"detailPreview\" class=\"px-4 py-2 rounded bg-gray-100\">Preview</button>\n          </div>\n        </div>\n      </div>\n\n      <!-- Mini-player placeholder (appears when user joins a session) -->\n      <div id=\"miniPlayer\" class=\"hidden mini-player bg-white p-3 flex items-center gap-3\">\n        <div class=\"w-12 h-8 bg-gray-200 rounded\"></div>\n        <div class=\"flex-1 text-sm\">\n          <div id=\"miniTitle\" class=\"font-semibold\">Live: —</div>\n          <div id=\"miniTeacher\" class=\"text-xs text-gray-600\">Teacher</div>\n        </div>\n        <div>\n          <button id=\"miniClose\" class=\"p-2 rounded hover:bg-gray-100\" aria-label=\"Close mini player\"><span class=\"mi -times\" data-mi=\"close\">close</span></button>\n        </div>\n      </div>\n\n    </main>\n  </div>\n\n\n      \n  \n\n</div>","bodyClass":"bg-slate-50","bodyStyle":"","css":["#sidebar { transition: transform 0.3s ease-in-out; } #sidebar.hide { transform: translateX(-100%); } @media (min-width: 1024px) { #sidebar { transform: translateX(0) !important; } }"],"quiz":null,"tracker":null,"links":[]}