{"slug":"/students/notifications/","source":"students/notifications.html","area":"students","kind":"content","title":"Notifications - Prep100","description":"","subject":null,"body":"<div class=\"min-h-screen flex\">\n      <aside id=\"sidebar\" class=\"w-64 md:w-72 lg:w-80 fixed left-0 top-0 h-full bg-white border-r border-slate-200 p-5 flex flex-col gap-6 overflow-auto z-40\">\n        <div class=\"flex items-center gap-3\"><img src=\"/site/assets/images/logo.png\" alt=\"logo\" class=\"h-12 w-12 rounded-full shadow-sm\"><div><div class=\"text-lg font-bold text-sky-700\">JUANOVA CORTEX</div><div class=\"text-xs text-slate-500\">Student Dashboard</div></div></div>\n        <nav class=\"flex-1 overflow-auto\"><ul class=\"space-y-1\">\n          <li><a href=\"/students/student-dashboard/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -home text-sky-600\" data-mi=\"home\">home</span> Home</a></li>\n          <li><a href=\"/students/news-feed-gemini/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -newspaper text-pink-500\" data-mi=\"help_outline\">help_outline</span> News Feed</a></li>\n          <li><a href=\"/students/notes/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -note-sticky text-yellow-500\" data-mi=\"help_outline\">help_outline</span> Study Notes</a></li>\n          <li><a href=\"/students/textbooks/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -book text-indigo-500\" data-mi=\"menu_book\">menu_book</span> Textbooks</a></li>\n          <li><a href=\"/students/formula-bank/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -book-open text-teal-600\" data-mi=\"auto_stories\">auto_stories</span> All Formula</a></li>\n          <li><a href=\"/students/study-plan/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><spa