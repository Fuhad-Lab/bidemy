                <div id=\"topLevel\" class=\"text-xs text-slate-400\">SS 3</div>\n              </div>\n              <img id=\"topAvatar\" src=\"/site/assets/images/unnamed.jpg\" alt=\"avatar\" class=\"h-10 w-10 rounded-full border-2\">\n            </div>\n          </div>\n  </header>\n\n  <main class=\"p-6 space-y-6\">\n  <div class=\"rounded-3xl bg-gradient-to-r from-yellow-500 to-yellow-400 text-white p-6 shadow mb-6\">\n          <div class=\"flex items-center justify-between\">\n            <div>\n              <h1 class=\"text-2xl font-extrabold\">Notifications</h1>\n              <p class=\"text-yellow-100 mt-1\">Important updates and alerts for your account and sessions.</p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"bg-white rounded-xl p-6 shadow max-w-3xl\">\n          <div class=\"text-gray-600\">No notifications yet.</div>\n        </div>\n\n      </main>\n    </div>\n  \n    \n    \n    \n    \n  \n  \n</div>","bodyClass":"bg-slate-50 text-slate-800","bodyStyle":"","css":[],"quiz":null,"tracker":null,"links":[]}