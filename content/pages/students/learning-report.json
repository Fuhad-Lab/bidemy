{"slug":"/students/learning-report/","source":"students/learning-report.html","area":"students","kind":"content","title":"Learning Report - Juanova Cortex","description":"","subject":null,"body":"<!-- Header -->\n    <header class=\"bg-white border-b border-slate-200 sticky top-0 z-50\">\n        <div class=\"max-w-7xl mx-auto px-4 py-4\">\n            <div class=\"flex items-center justify-between\">\n                <div class=\"flex items-center gap-4\">\n                    <a href=\"/students/student-dashboard/\" class=\"flex items-center gap-2 text-slate-600 hover:text-sky-600\">\n                        <span class=\"mi -arrow-left\" data-mi=\"arrow_back\">arrow_back</span>\n                    </a>\n                    <div>\n                        <h1 class=\"text-2xl font-bold text-slate-800\">📊 Learning Report</h1>\n                        <p class=\"text-sm text-slate-500\">Track your CBT progress and performance</p>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-3\">\n                    <button class=\"p-2 text-slate-400 hover:text-sky-600 hover:bg-sky-50 rounded-lg transition-colors\" title=\"Refresh\">\n                        <span class=\"mi -sync-alt\" data-mi=\"sync\">sync</span>\n                    </button>\n                    <a href=\"/students/cbt/cbt/\" class=\"px-4 py-2 bg-sky-600 text-white rounded-lg hover:bg-sky-700 transition-colors text-sm font-medium\">\n                        <span class=\"mi -play mr-2\" data-mi=\"play_arrow\">play_arrow</span>Take Quiz\n                    </a>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Error Banner -->\n    <div id=\"errorBanner\" class=\"hidden max-w-7xl mx-auto px-4 mt-4\">\n        <div class=\"bg-red-50 border border-red-200 rounded-xl p-4 flex items-center gap-3\">\n            <span class=\"mi -exclamation-circle text-red-500 text-xl\" data-mi=\"error_outline\">error_outline</span>\n            <p id=\"errorMessage\" class=\"text-red-700\"></p>\n            <button class=\"ml-auto px-3 py-1 bg-red-600 text-white rounded-lg text-sm\">Retry</button>\n        </div>\n    </div>\n\n    <main class=\"max-w-7xl mx-auto px-4 py-6\">\n        <!-- Date Filter -->\n        <div class=\"flex justify-end mb-6\">\n            <div class=\"bg-white rounded-lg p-1 flex gap-1 shadow-sm\">\n                <button class=\"date-btn px-4 py-2 rounded-md text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors\" data-range=\"week\">Week</button>\n                <button class=\"date-btn px-4 py-2 rounded-md text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors\" data-range=\"month\">Month</button>\n                <button class=\"date-btn px-4 py-2 rounded-md text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors\" data-range=\"year\">Year</button>\n                <button class=\"date-btn active px-4 py-2 rounded-md text-sm font-medium transition-colors\" data-range=\"all\">All Time</button>\n            </div>\n        </div>\n\n        <!-- Stats Cards -->\n        <section class=\"grid grid-cols-2 md:grid-cols-4 gap-4 mb-6\">\n            <!-- Average Score -->\n            <div class=\"bg-white rounded-2xl p-6 shadow-sm\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <span class=\"text-sm font-medium text-slate-500\">Average Score</span>\n                    <span class=\"text-2xl\">🎯</span>\n                </div>\n                <div class=\"flex justify-center\">\n                    <div class=\"score-ring\">\n                        <svg width=\"140\" height=\"140\">\n                            <circle cx=\"70\" cy=\"70\" r=\"60\" fill=\"none\" stroke=\"#e2e8f0\" stroke-width=\"10\"></circle>\n                            <circle id=\"scoreCircle\" cx=\"70\" cy=\"70\" r=\"60\" fill=\"none\" stroke=\"#0ea5e9\" stroke-width=\"10\" stroke-linecap=\"round\" stroke-dasharray=\"377\" stroke-dashoffset=\"377\"></circle>\n                        </svg>\n                        <div class=\"value\">\n                            <span id=\"avgScore\" class=\"text-3xl font-bold text-slate-800\">--</span>\n                            <span class=\"text-sm text-slate-500\">percent</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Quizzes Taken -->\n            <div class=\"bg-white rounded-2xl p-6 shadow-sm\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <span class=\"text-sm font-medium text-slate-500\">Quizzes Taken</span>\n                    <span class=\"text-2xl\">📝</span>\n                </div>\n                <div id=\"quizCount\" class=\"text-4xl font-bold text-slate-800\">--</div>\n                <p class=\"text-sm text-slate-500 mt-1\">total attempts</p>\n                <div class=\"mt-4 flex items-center gap-2 text-sm\">\n                    <span id=\"passedCount\" class=\"text-emerald-600 font-medium\">0 passed</span>\n                    <span class=\"text-slate-300\">•</span>\n                    <span id=\"failedCount\" class=\"text-red-500 font-medium\">0 failed</span>\n                </div>\n            </div>\n\n            <!-- Study Time -->\n            <div class=\"bg-white rounded-2xl p-6 shadow-sm\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <span class=\"text-sm font-medium text-slate-500\">Study Time</span>\n                    <span class=\"text-2xl\">⏰</span>\n                </div>\n                <div id=\"studyTime\" class=\"text-4xl font-bold text-slate-800\">--</div>\n                <p class=\"text-sm text-slate-500 mt-1\">hours total</p>\n                <div class=\"mt-4 pt-4 border-t border-slate-100\">\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-slate-500\">This week</span>\n                        <span id=\"weeklyTime\" class=\"font-medium text-slate-700\">0h</span>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Streak -->\n            <div class=\"bg-white rounded-2xl p-6 shadow-sm\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <span class=\"text-sm font-medium text-slate-500\">Current Streak</span>\n                    <span class=\"text-2xl\">🔥</span>\n                </div>\n                <div class=\"flex items-baseline gap-1\">\n                    <span id=\"streakDays\" class=\"text-4xl font-bold text-slate-800\">--</span>\n                    <span class=\"text-slate-500\">days</span>\n                </div>\n                <p class=\"text-sm text-slate-500 mt-1\">consecutive study</p>\n                <div class=\"mt-4 pt-4 border-t border-slate-100\">\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-slate-500\">Best streak</span>\n                        <span id=\"bestStreak\" class=\"font-medium text-slate-700\">0 days</span>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Main Content -->\n        <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n            <!-- Left Column -->\n            <div class=\"lg:col-span-2 space-y-6\">\n                <!-- Performance Chart -->\n                <div class=\"bg-white rounded-2xl p-6 shadow-sm\">\n                    <div class=\"flex items-center justify-between mb-4\">\n                        <h2 class=\"text-lg font-semibold text-slate-800\">Performance Trend</h2>\n                        <span class=\"text-sm text-slate-500\">Score history</span>\n                    </div>\n                    <div id=\"chartSkeleton\" class=\"h-64 skeleton\"></div>\n                    <div id=\"chartContainer\" class=\"h-64 hidden\">\n                        <canvas id=\"performanceChart\"></canvas>\n                    </div>\n                </div>\n\n                <!-- Subject Performance -->\n                <div class=\"bg-white rounded-2xl p-6 shadow-sm\">\n                    <div class=\"flex items-center justify-between mb-4\">\n                        <h2 class=\"text-lg font-semibold text-slate-800\">Subject Performance</h2>\n                        <a href=\"/students/subjects/\" class=\"text-sm text-sky-600 hover:underline\">Practice more</a>\n                    </div>\n                    <div id=\"subjectsSkeleton\" class=\"space-y-4\">\n                        <div class=\"h-16 skeleton\"></div>\n                        <div class=\"h-16 skeleton\"></div>\n                        <div class=\"h-16 skeleton\"></div>\n                    </div>\n                    <div id=\"subjectsContainer\" class=\"space-y-4 hidden\"></div>\n                </div>\n\n                <!-- Recent Results -->\n                <div class=\"bg-white rounded-2xl p-6 shadow-sm\">\n                    <div class=\"flex items-center justify-between mb-4\">\n                        <h2 class=\"text-lg font-semibold text-slate-800\">Recent Quiz Results</h2>\n                        <span class=\"text-sm text-slate-500\">Latest attempts</span>\n                    </div>\n                    <div id=\"recentSkeleton\" class=\"space-y-3\">\n                        <div class=\"h-14 skeleton\"></div>\n                        <div class=\"h-14 skeleton\"></div>\n                        <div class=\"h-14 skeleton\"></div>\n                    </div>\n                    <div id=\"recentContainer\" class=\"space-y-3 hidden\"></div>\n                </div>\n            </div>\n\n            <!-- Right Column -->\n            <div class=\"space-y-6\">\n                <!-- Strengths -->\n                <div class=\"bg-white rounded-2xl p-6 shadow-sm\">\n                    <div class=\"flex items-center gap-2 mb-4\">\n                        <span class=\"text-xl\">💪</span>\n                        <h2 class=\"text-lg font-semibold text-slate-800\">Your Strengths</h2>\n                    </div>\n                    <div id=\"strengthsSkeleton\" class=\"space-y-3\">\n                        <div class=\"h-14 skeleton\"></div>\n                        <div class=\"h-14 skeleton\"></div>\n                    </div>\n                    <div id=\"strengthsContainer\" class=\"space-y-3 hidden\"></div>\n                </div>\n\n                <!-- Weaknesses -->\n                <div class=\"bg-white rounded-2xl p-6 shadow-sm\">\n                    <div class=\"flex items-center gap-2 mb-4\">\n                        <span class=\"text-xl\">⚠️</span>\n                        <h2 class=\"text-lg font-semibold text-slate-800\">Needs Improvement</h2>\n                    </div>\n                    <div id=\"weaknessesSkeleton\" class=\"space-y-3\">\n                        <div class=\"h-14 skeleton\"></div>\n                        <div class=\"h-14 skeleton\"></div>\n                    </div>\n                    <div id=\"weaknessesContainer\" class=\"space-y-3 hidden\"></div>\n                </div>\n\n                <!-- Goals -->\n                <div class=\"bg-white rounded-2xl p-6 shadow-sm\">\n                    <div class=\"flex items-center justify-between mb-4\">\n                        <div class=\"flex items-center gap-2\">\n                            <span class=\"text-xl\">🎯</span>\n                            <h2 class=\"text-lg font-semibold text-slate-800\">Goals Progress</h2>\n                        </div>\n                        <a href=\"/students/student-dashboard/\" class=\"text-sm text-sky-600 hover:underline\">Edit</a>\n                    </div>\n                    <div id=\"goalsSkeleton\" class=\"space-y-3\">\n                        <div class=\"h-20 skeleton\"></div>\n                        <div class=\"h-20 skeleton\"></div>\n                    </div>\n                    <div id=\"goalsContainer\" class=\"space-y-4 hidden\"></div>\n                </div>\n\n                <!-- Insights -->\n                <div class=\"bg-gradient-to-br from-sky-50 to-blue-50 rounded-2xl p-6 border border-sky-100\">\n                    <div class=\"flex items-center gap-2 mb-4\">\n                        <span class=\"text-xl\">💡</span>\n                        <h2 class=\"text-lg font-semibold text-slate-800\">Insights</h2>\n                    </div>\n                    <div id=\"insightsSkeleton\" class=\"space-y-3\">\n                        <div class=\"h-16 skeleton\"></div>\n                        <div class=\"h-16 skeleton\"></div>\n                    </div>\n                    <div id=\"insightsContainer\" class=\"space-y-3 hidden\"></div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Quick Actions -->\n        <section class=\"mt-8 bg-white rounded-2xl p-6 shadow-sm\">\n            <h2 class=\"text-lg font-semibold text-slate-800 mb-4\">Quick Actions</h2>\n            <div class=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n                <a href=\"/students/cbt/cbt/\" class=\"flex items-center gap-3 p-4 bg-sky-50 rounded-xl hover:bg-sky-100 transition-colors\">\n                    <span class=\"text-2xl\">📝</span>\n                    <div>\n                        <div class=\"font-medium text-slate-700\">Take a Quiz</div>\n                        <div class=\"text-sm text-slate-500\">Practice now</div>\n                    </div>\n                </a>\n                <a href=\"/students/student-dashboard/\" class=\"flex items-center gap-3 p-4 bg-emerald-50 rounded-xl hover:bg-emerald-100 transition-colors\">\n                    <span class=\"text-2xl\">🎯</span>\n                    <div>\n                        <div class=\"font-medium text-slate-700\">Set Goals</div>\n                        <div class=\"text-sm text-slate-500\">Update targets</div>\n                    </div>\n                </a>\n                <a href=\"/students/digital-library/\" class=\"flex items-center gap-3 p-4 bg-amber-50 rounded-xl hover:bg-amber-100 transition-colors\">\n                    <span class=\"text-2xl\">📚</span>\n                    <div>\n                        <div class=\"font-medium text-slate-700\">Study Materials</div>\n                        <div class=\"text-sm text-slate-500\">Browse resources</div>\n                    </div>\n                </a>\n                <button class=\"flex items-center gap-3 p-4 bg-purple-50 rounded-xl hover:bg-purple-100 transition-colors text-left\">\n                    <span class=\"text-2xl\">🔄</span>\n                    <div>\n                        <div class=\"font-medium text-slate-700\">Refresh Data</div>\n                        <div class=\"text-sm text-slate-500\">Update report</div>\n                    </div>\n                </button>\n            </div>\n        </section>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"bg-white border-t border-slate-200 mt-12\">\n        <div class=\"max-w-7xl mx-auto px-4 py-6 text-center text-slate-500 text-sm\">\n            © 2024 Juanova Cortex. All rights reserved.\n        </div>\n    </footer>\n\n    <!-- Supabase Configuration -->","bodyClass":"bg-slate-100 min-h-screen","bodyStyle":"","css":["@keyframes shimmer {\n            0% { background-position: -200% 0; }\n            100% { background-position: 200% 0; }\n        }\n        .skeleton {\n            background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);\n            background-size: 200% 100%;\n            animation: shimmer 1.5s infinite;\n            border-radius: 8px;\n        }\n        .score-ring {\n            position: relative;\n            width: 140px;\n            height: 140px;\n        }\n        .score-ring svg {\n            transform: rotate(-90deg);\n        }\n        .score-ring .value {\n            position: absolute;\n            inset: 0;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-direction: column;\n        }\n        .date-btn.active {\n            background-color: #0284c7;\n            color: white;\n        }\n        ::-webkit-scrollbar { width: 6px; height: 6px; }\n        ::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 10px; }\n        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }\n        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }"],"quiz":null,"tracker":null,"links":[]}