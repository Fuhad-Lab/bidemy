{"slug":"/students/progress/","source":"students/progress.html","area":"students","kind":"content","title":"Progress & Analytics - JUANOVA CORTEX","description":"","subject":null,"body":"<!-- Main content area -->\n  <div id=\"main-content\" class=\"flex-1 flex flex-col ml-64 md:ml-72 lg:ml-80\">\n    <!-- Topbar -->\n    <header class=\"flex items-center justify-between p-4 bg-white border-b border-slate-200\">\n      <div class=\"flex items-center gap-3\">\n        <button id=\"toggleSidebar\" class=\"p-2 rounded-md hover:bg-slate-100 lg:hidden\" title=\"Toggle sidebar\">\n          <span class=\"mi -bars\" data-mi=\"menu\">menu</span>\n        </button>\n        <div class=\"relative\">\n          <input id=\"globalSearch\" type=\"search\" placeholder=\"Search analytics...\" class=\"w-[520px] hidden md:inline-block pl-10 pr-4 py-2 rounded-full border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-sky-100\">\n          <span class=\"mi -search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" data-mi=\"search\">search</span>\n        </div>\n      </div>\n\n      <div class=\"flex items-center gap-4\">\n        <div class=\"relative\">\n          <button id=\"notifBtn\" class=\"p-2 rounded-full hover:bg-slate-50\" aria-label=\"Notifications\">\n            <span class=\"mi -bell text-sky-600\" data-mi=\"notifications\">notifications</span>\n          </button>\n          <span id=\"notifCount\" class=\"absolute -top-1 -right-1 bg-pink-500 text-white rounded-full w-5 h-5 text-xs flex items-center justify-center\">0</span>\n        </div>\n        <div class=\"flex items-center gap-3\">\n          <div class=\"text-right mr-2\">\n            <div id=\"topName\" class=\"font-semibold\">Student Name</div>\n            <div id=\"topLevel\" class=\"text-xs text-slate-400\">SS 3</div>\n          </div>\n          <img id=\"topAvatar\" src=\"/site/assets/images/unnamed.jpg\" alt=\"avatar\" class=\"h-10 w-10 rounded-full border-2\">\n        </div>\n      </div>\n    </header>\n\n    <!-- Page Content -->\n    <main class=\"p-6\">\n      <!-- Page Header -->\n      <div class=\"mb-8\">\n        <h1 class=\"text-3xl font-bold text-gray-800 mb-2\">Progress &amp; Analytics</h1>\n        <p class=\"text-gray-600\">Track your learning progress and performance insights.</p>\n      </div>\n\n      <!-- Time Period Filter -->\n      <div class=\"flex gap-3 mb-6 overflow-x-auto pb-2\">\n        <button class=\"px-4 py-2 rounded-full bg-sky-600 text-white font-medium text-sm\">This Week</button>\n        <button class=\"px-4 py-2 rounded-full bg-white text-slate-600 font-medium text-sm hover:bg-slate-50\">This Month</button>\n        <button class=\"px-4 py-2 rounded-full bg-white text-slate-600 font-medium text-sm hover:bg-slate-50\">Last 3 Months</button>\n        <button class=\"px-4 py-2 rounded-full bg-white text-slate-600 font-medium text-sm hover:bg-slate-50\">All Time</button>\n      </div>\n\n      <!-- Stats Overview -->\n      <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8\">\n        <div class=\"bg-white rounded-xl shadow p-6\">\n          <div class=\"flex items-center gap-4 mb-4\">\n            <div class=\"w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center\">\n              <span class=\"mi -clock text-blue-600 text-xl\" data-mi=\"schedule\">schedule</span>\n            </div>\n            <div>\n              <h3 class=\"text-sm font-medium text-gray-500\">Study Time</h3>\n              <p class=\"text-2xl font-bold text-gray-800\">32.5 hrs</p>\n            </div>\n          </div>\n          <div class=\"flex items-center gap-2 text-sm\">\n            <span class=\"text-green-500\">↑ 12%</span>\n            <span class=\"text-gray-500\">vs last week</span>\n          </div>\n        </div>\n\n        <div class=\"bg-white rounded-xl shadow p-6\">\n          <div class=\"flex items-center gap-4 mb-4\">\n            <div class=\"w-12 h-12 bg-green-100 rounded-full flex items-center justify-center\">\n              <span class=\"mi -check-circle text-green-600 text-xl\" data-mi=\"check_circle\">check_circle</span>\n            </div>\n            <div>\n              <h3 class=\"text-sm font-medium text-gray-500\">Questions Solved</h3>\n              <p class=\"text-2xl font-bold text-gray-800\">248</p>\n            </div>\n          </div>\n          <div class=\"flex items-center gap-2 text-sm\">\n            <span class=\"text-green-500\">↑ 8%</span>\n            <span class=\"text-gray-500\">vs last week</span>\n          </div>\n        </div>\n\n        <div class=\"bg-white rounded-xl shadow p-6\">\n          <div class=\"flex items-center gap-4 mb-4\">\n            <div class=\"w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center\">\n              <span class=\"mi -trophy text-purple-600 text-xl\" data-mi=\"emoji_events\">emoji_events</span>\n            </div>\n            <div>\n              <h3 class=\"text-sm font-medium text-gray-500\">Test Score Avg</h3>\n              <p class=\"text-2xl font-bold text-gray-800\">76%</p>\n            </div>\n          </div>\n          <div class=\"flex items-center gap-2 text-sm\">\n            <span class=\"text-red-500\">↓ 3%</span>\n            <span class=\"text-gray-500\">vs last week</span>\n          </div>\n        </div>\n\n        <div class=\"bg-white rounded-xl shadow p-6\">\n          <div class=\"flex items-center gap-4 mb-4\">\n            <div class=\"w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center\">\n              <span class=\"mi -fire text-orange-600 text-xl\" data-mi=\"local_fire_department\">local_fire_department</span>\n            </div>\n            <div>\n              <h3 class=\"text-sm font-medium text-gray-500\">Study Streak</h3>\n              <p class=\"text-2xl font-bold text-gray-800\">7 days</p>\n            </div>\n          </div>\n          <div class=\"flex items-center gap-2 text-sm\">\n            <span class=\"text-green-500\">↑ 2 days</span>\n            <span class=\"text-gray-500\">vs last week</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Charts Section -->\n      <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8\">\n        <!-- Study Time Distribution -->\n        <div class=\"bg-white rounded-xl shadow p-6\">\n          <h3 class=\"text-lg font-semibold text-gray-800 mb-4\">Study Time by Subject</h3>\n          <canvas id=\"studyTimeChart\" height=\"300\"></canvas>\n        </div>\n\n        <!-- Performance Trends -->\n        <div class=\"bg-white rounded-xl shadow p-6\">\n          <h3 class=\"text-lg font-semibold text-gray-800 mb-4\">Performance Trends</h3>\n          <canvas id=\"performanceChart\" height=\"300\"></canvas>\n        </div>\n      </div>\n\n      <!-- Subject Performance -->\n      <div class=\"bg-white rounded-xl shadow p-6 mb-8\">\n        <h3 class=\"text-lg font-semibold text-gray-800 mb-4\">Subject Performance</h3>\n        <div class=\"space-y-4\">\n          <!-- Mathematics -->\n          <div>\n            <div class=\"flex items-center justify-between mb-2\">\n              <span class=\"text-gray-700 font-medium\">Mathematics</span>\n              <span class=\"text-gray-600\">85%</span>\n            </div>\n            <div class=\"h-2 bg-slate-100 rounded-full\">\n              <div class=\"h-2 bg-sky-600 rounded-full\" style=\"width: 85%\"></div>\n            </div>\n          </div>\n\n          <!-- Physics -->\n          <div>\n            <div class=\"flex items-center justify-between mb-2\">\n              <span class=\"text-gray-700 font-medium\">Physics</span>\n              <span class=\"text-gray-600\">78%</span>\n            </div>\n            <div class=\"h-2 bg-slate-100 rounded-full\">\n              <div class=\"h-2 bg-sky-600 rounded-full\" style=\"width: 78%\"></div>\n            </div>\n          </div>\n\n          <!-- Chemistry -->\n          <div>\n            <div class=\"flex items-center justify-between mb-2\">\n              <span class=\"text-gray-700 font-medium\">Chemistry</span>\n              <span class=\"text-gray-600\">72%</span>\n            </div>\n            <div class=\"h-2 bg-slate-100 rounded-full\">\n              <div class=\"h-2 bg-sky-600 rounded-full\" style=\"width: 72%\"></div>\n            </div>\n          </div>\n\n          <!-- Biology -->\n          <div>\n            <div class=\"flex items-center justify-between mb-2\">\n              <span class=\"text-gray-700 font-medium\">Biology</span>\n              <span class=\"text-gray-600\">90%</span>\n            </div>\n            <div class=\"h-2 bg-slate-100 rounded-full\">\n              <div class=\"h-2 bg-sky-600 rounded-full\" style=\"width: 90%\"></div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </main>\n  </div>\n\n  <!-- Chatbot Widget -->\n  <div id=\"cortex-ai-chat-button\" role=\"button\" aria-label=\"Open Cortex AI chat\">\n    <img src=\"/site/cortex-owl-brain.svg\" alt=\"Cortex AI\" class=\"cortex-icon\" style=\"width:72px;height:72px;box-shadow:0 4px 16px rgba(0,0,0,0.20);border-radius:16px;transition:transform 0.18s cubic-bezier(.4,2,.6,1),box-shadow 0.18s;cursor:pointer;\" onmouseover=\"this.style.transform='scale(1.12)';this.style.boxShadow='0 8px 32px rgba(0,0,0,0.28)';\" onmouseout=\"this.style.transform='scale(1)';this.style.boxShadow='0 4px 16px rgba(0,0,0,0.20)';\" onmousedown=\"this.style.transform='scale(0.96)';\" onmouseup=\"this.style.transform='scale(1.12)';\">\n  </div>\n  <iframe id=\"cortex-ai-chat-popup\" src=\"https://app.edcafe.ai/chatbots/68b96ebb2a5be310497b6a0b\"></iframe>\n\n  <!-- Scripts -->\n  \n\n  <!-- Import shared student page components -->\n  \n  \n\n  <style>\n    #cortex-ai-chat-button {\n      position: fixed;\n      bottom: 20px;\n      right: 20px;\n      background: transparent;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 0;\n      border: none;\n      z-index: 1000;\n    }\n\n    #cortex-ai-chat-popup {\n      position: fixed;\n      bottom: 90px;\n      right: 20px;\n      width: 380px;\n      height: 500px;\n      border: none;\n      border-radius: 12px;\n      box-shadow: 0px 4px 16px rgba(0,0,0,0.4);\n      display: none;\n      z-index: 1000;\n    }\n  </style>","bodyClass":"bg-slate-50","bodyStyle":"","css":["#cortex-ai-chat-button {\n      position: fixed;\n      bottom: 20px;\n      right: 20px;\n      background: transparent;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 0;\n      border: none;\n      z-index: 1000;\n    }\n\n    #cortex-ai-chat-popup {\n      position: fixed;\n      bottom: 90px;\n      right: 20px;\n      width: 380px;\n      height: 500px;\n      border: none;\n      border-radius: 12px;\n      box-shadow: 0px 4px 16px rgba(0,0,0,0.4);\n      display: none;\n      z-index: 1000;\n    }"],"quiz":null,"tracker":null,"links":[]}