{"slug":"/students/textbooks/","source":"students/textbooks.html","area":"students","kind":"content","title":"Textbooks - Prep100","description":"","subject":null,"body":"<div class=\"min-h-screen flex\">\n    <aside id=\"sidebar\" class=\"w-64 md:w-72 lg:w-80 fixed left-0 top-0 h-full bg-white border-r border-slate-200 p-5 flex flex-col gap-6 overflow-auto z-40\">\n      <div class=\"flex items-center gap-3\"><img src=\"/site/assets/images/logo.png\" alt=\"logo\" class=\"h-12 w-12 rounded-full shadow-sm\"><div><div class=\"text-lg font-bold text-sky-700\">JUANOVA CORTEX</div><div class=\"text-xs text-slate-500\">Student Dashboard</div></div></div>\n      <nav class=\"flex-1 overflow-auto\"><ul class=\"space-y-1\">\n        <li><a href=\"/students/subjects/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -home text-sky-600\" data-mi=\"home\">home</span> Home</a></li>\n        <li><a href=\"/students/news-feed-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -newspaper text-pink-500\" data-mi=\"help_outline\">help_outline</span> News Feed</a></li>\n        <li><a href=\"/students/notes-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -note-sticky text-yellow-500\" data-mi=\"help_outline\">help_outline</span> Study Notes</a></li>\n        <li><a href=\"/students/textbooks-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50 bg-sky-50\"><span class=\"mi -book text-indigo-500\" data-mi=\"menu_book\">menu_book</span> Textbooks</a></li>\n        <li><a href=\"/students/formula-bank-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -book-open text-teal-600\" data-mi=\"auto_stories\">auto_stories</span> All Formula</a></li>\n        <li><a href=\"/students/study-plan-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -calendar-check text-green-500\" data-mi=\"event_available\">event_available</span> Study Plan</a></li>\n        <li><a href=\"/students/video-library-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -photo-video text-cyan-600\" data-mi=\"help_outline\">help_outline</span> Video Library</a></li>\n        <li><a href=\"/students/digital-library-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -book text-indigo-500\" data-mi=\"menu_book\">menu_book</span> Digital Library</a></li>\n        <li><a href=\"/students/game/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -puzzle-piece text-purple-500\" data-mi=\"extension\">extension</span> Game</a></li>\n        <li><a href=\"/students/mock-exams-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -pencil-alt text-orange-500\" data-mi=\"edit\">edit</span> Mock Exams</a></li>\n        <li><a href=\"/students/notifications-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -bell text-pink-600\" data-mi=\"notifications\">notifications</span> Notifications</a></li>\n        <li><a href=\"/students/student-live-session-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -chalkboard-teacher text-blue-400\" data-mi=\"co_present\">co_present</span> Live Sessions</a></li>\n        <li><a href=\"/students/nobel-laureate-supabase/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -award text-yellow-600\" data-mi=\"workspace_premium\">workspace_premium</span> Nobel Laureate</a></li>\n      </ul></nav>\n      <div class=\"text-sm text-slate-500 border-t pt-4\"><div class=\"mb-2\">Account</div><div class=\"flex items-center gap-3\"><img id=\"avatar-sm\" src=\"/site/assets/images/unnamed.jpg\" alt=\"avatar\" class=\"h-10 w-10 rounded-full border\"><div><div id=\"userName\" class=\"font-semibold\">Student</div><div id=\"userLevel\" class=\"text-xs text-slate-400\"></div></div></div></div>\n    </aside>\n\n    \n\n    <!-- Main content area -->\n  <div id=\"main-content\" class=\"flex-1 flex flex-col ml-64 md:ml-72 lg:ml-80\">\n    <!-- Topbar -->\n    <header class=\"flex items-center justify-between p-4 bg-white border-b border-slate-200\">\n      <div class=\"flex items-center gap-3\">\n        <button id=\"toggleSidebar\" class=\"p-2 rounded-md hover:bg-slate-100 lg:hidden\" title=\"Toggle sidebar\">\n          <span class=\"mi -bars\" data-mi=\"menu\">menu</span>\n        </button>\n        <div class=\"relative\">\n          <input id=\"globalSearch\" type=\"search\" placeholder=\"Search textbooks...\" class=\"w-[520px] hidden md:inline-block pl-10 pr-4 py-2 rounded-full border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-sky-100\">\n          <span class=\"mi -search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" data-mi=\"search\">search</span>\n        </div>\n      </div>\n\n      <div class=\"flex items-center gap-4\">\n        <div class=\"relative\">\n          <button id=\"notifBtn\" class=\"p-2 rounded-full hover:bg-slate-50\" aria-label=\"Notifications\">\n            <span class=\"mi -bell text-sky-600\" data-mi=\"notifications\">notifications</span>\n          </button>\n          <span id=\"notifCount\" class=\"absolute -top-1 -right-1 bg-pink-500 text-white rounded-full w-5 h-5 text-xs flex items-center justify-center\">0</span>\n        </div>\n        <div class=\"flex items-center gap-3\">\n          <div class=\"text-right mr-2\">\n            <div id=\"topName\" class=\"font-semibold\">Student Name</div>\n            <div id=\"topLevel\" class=\"text-xs text-slate-400\">SS 3</div>\n          </div>\n          <img id=\"topAvatar\" src=\"/site/assets/images/unnamed.jpg\" alt=\"avatar\" class=\"h-10 w-10 rounded-full border-2\">\n        </div>\n      </div>\n    </header>\n\n    <!-- Page Content -->\n    <main class=\"p-6\">\n      <!-- Page Header -->\n      <div class=\"mb-8\">\n        <h1 class=\"text-3xl font-bold text-gray-800 mb-2\">Digital Textbooks</h1>\n        <p class=\"text-gray-600\">Access your digital textbooks and study materials.</p>\n      </div>\n\n      <!-- Subject Filter -->\n      <div class=\"flex gap-3 mb-6 overflow-x-auto pb-2\">\n        <button class=\"px-4 py-2 rounded-full bg-sky-600 text-white font-medium text-sm\">All Subjects</button>\n        <button class=\"px-4 py-2 rounded-full bg-white text-slate-600 font-medium text-sm hover:bg-slate-50\">Mathematics</button>\n        <button class=\"px-4 py-2 rounded-full bg-white text-slate-600 font-medium text-sm hover:bg-slate-50\">Physics</button>\n        <button class=\"px-4 py-2 rounded-full bg-white text-slate-600 font-medium text-sm hover:bg-slate-50\">Chemistry</button>\n        <button class=\"px-4 py-2 rounded-full bg-white text-slate-600 font-medium text-sm hover:bg-slate-50\">Biology</button>\n      </div>\n\n      <!-- Textbooks Grid -->\n      <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6\">\n        <!-- Mathematics Textbook -->\n        <div class=\"bg-white rounded-xl shadow\">\n          <div class=\"aspect-[3/4] relative rounded-t-xl overflow-hidden bg-slate-100\">\n            <img src=\"/assets/images/math-textbook-cover.jpg\" alt=\"Mathematics Textbook\" class=\"absolute inset-0 w-full h-full object-cover\">\n            <div class=\"absolute top-3 right-3\">\n              <button class=\"p-2 bg-white rounded-full shadow hover:bg-slate-50\">\n                <span class=\"mi -heart text-pink-500\" data-mi=\"favorite\">favorite</span>\n              </button>\n            </div>\n          </div>\n          <div class=\"p-4\">\n            <h3 class=\"font-semibold text-gray-800 mb-1\">Advanced Mathematics</h3>\n            <p class=\"text-sm text-gray-500 mb-3\">Essential concepts for WAEC</p>\n            <div class=\"flex items-center gap-2 text-sm text-gray-600 mb-4\">\n              <span class=\"mi -book-open\" data-mi=\"auto_stories\">auto_stories</span>\n              <span>24 chapters</span>\n              <span class=\"mx-2\">•</span>\n              <span class=\"mi -clock\" data-mi=\"schedule\">schedule</span>\n              <span>480 pages</span>\n            </div>\n            <button class=\"w-full py-2 bg-sky-600 text-white font-medium rounded-md hover:bg-sky-700 transition-colors\">\n              Open Book\n            </button>\n          </div>\n        </div>\n\n        <!-- Physics Textbook -->\n        <div class=\"bg-white rounded-xl shadow\">\n          <div class=\"aspect-[3/4] relative rounded-t-xl overflow-hidden bg-slate-100\">\n            <img src=\"/assets/images/physics-textbook-cover.jpg\" alt=\"Physics Textbook\" class=\"absolute inset-0 w-full h-full object-cover\">\n            <div class=\"absolute top-3 right-3\">\n              <button class=\"p-2 bg-white rounded-full shadow hover:bg-slate-50\">\n                <span class=\"mi -heart text-pink-500\" data-mi=\"favorite\">favorite</span>\n              </button>\n            </div>\n          </div>\n          <div class=\"p-4\">\n            <h3 class=\"font-semibold text-gray-800 mb-1\">Modern Physics</h3>\n            <p class=\"text-sm text-gray-500 mb-3\">Complete WAEC guide</p>\n            <div class=\"flex items-center gap-2 text-sm text-gray-600 mb-4\">\n              <span class=\"mi -book-open\" data-mi=\"auto_stories\">auto_stories</span>\n              <span>18 chapters</span>\n              <span class=\"mx-2\">•</span>\n              <span class=\"mi -clock\" data-mi=\"schedule\">schedule</span>\n              <span>320 pages</span>\n            </div>\n            <button class=\"w-full py-2 bg-sky-600 text-white font-medium rounded-md hover:bg-sky-700 transition-colors\">\n              Open Book\n            </button>\n          </div>\n        </div>\n\n        <!-- Chemistry Textbook -->\n        <div class=\"bg-white rounded-xl shadow\">\n          <div class=\"aspect-[3/4] relative rounded-t-xl overflow-hidden bg-slate-100\">\n            <img src=\"/assets/images/chemistry-textbook-cover.jpg\" alt=\"Chemistry Textbook\" class=\"absolute inset-0 w-full h-full object-cover\">\n            <div class=\"absolute top-3 right-3\">\n              <button class=\"p-2 bg-white rounded-full shadow hover:bg-slate-50\">\n                <span class=\"mi -heart text-pink-500\" data-mi=\"favorite\">favorite</span>\n              </button>\n            </div>\n          </div>\n          <div class=\"p-4\">\n            <h3 class=\"font-semibold text-gray-800 mb-1\">Chemistry Fundamentals</h3>\n            <p class=\"text-sm text-gray-500 mb-3\">WAEC preparation guide</p>\n            <div class=\"flex items-center gap-2 text-sm text-gray-600 mb-4\">\n              <span class=\"mi -book-open\" data-mi=\"auto_stories\">auto_stories</span>\n              <span>20 chapters</span>\n              <span class=\"mx-2\">•</span>\n              <span class=\"mi -clock\" data-mi=\"schedule\">schedule</span>\n              <span>400 pages</span>\n            </div>\n            <button class=\"w-full py-2 bg-sky-600 text-white font-medium rounded-md hover:bg-sky-700 transition-colors\">\n              Open Book\n            </button>\n          </div>\n        </div>\n\n        <!-- Biology Textbook -->\n        <div class=\"bg-white rounded-xl shadow\">\n          <div class=\"aspect-[3/4] relative rounded-t-xl overflow-hidden bg-slate-100\">\n            <img src=\"/assets/images/biology-textbook-cover.jpg\" alt=\"Biology Textbook\" class=\"absolute inset-0 w-full h-full object-cover\">\n            <div class=\"absolute top-3 right-3\">\n              <button class=\"p-2 bg-white rounded-full shadow hover:bg-slate-50\">\n                <span class=\"mi -heart text-pink-500\" data-mi=\"favorite\">favorite</span>\n              </button>\n            </div>\n          </div>\n          <div class=\"p-4\">\n            <h3 class=\"font-semibold text-gray-800 mb-1\">Biology in Context</h3>\n            <p class=\"text-sm text-gray-500 mb-3\">Complete WAEC syllabus</p>\n            <div class=\"flex items-center gap-2 text-sm text-gray-600 mb-4\">\n              <span class=\"mi -book-open\" data-mi=\"auto_stories\">auto_stories</span>\n              <span>22 chapters</span>\n              <span class=\"mx-2\">•</span>\n              <span class=\"mi -clock\" data-mi=\"schedule\">schedule</span>\n              <span>440 pages</span>\n            </div>\n            <button class=\"w-full py-2 bg-sky-600 text-white font-medium rounded-md hover:bg-sky-700 transition-colors\">\n              Open Book\n            </button>\n          </div>\n        </div>\n      </div>\n\n      <!-- Recently Accessed Section -->\n      <div class=\"mt-8\">\n        <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Recently Accessed</h2>\n        <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6\">\n          <!-- Recent Book 1 -->\n          <div class=\"bg-white rounded-xl shadow p-4 flex items-center gap-4\">\n            <div class=\"w-16 h-20 bg-slate-100 rounded-lg overflow-hidden\">\n              <img src=\"/assets/images/math-textbook-cover.jpg\" alt=\"Mathematics\" class=\"w-full h-full object-cover\">\n            </div>\n            <div class=\"flex-1\">\n              <h3 class=\"font-semibold text-gray-800 mb-1\">Advanced Mathematics</h3>\n              <p class=\"text-sm text-gray-500 mb-2\">Last accessed 2 hours ago</p>\n              <button class=\"text-sky-600 text-sm font-medium hover:text-sky-700\">Continue Reading</button>\n            </div>\n          </div>\n\n          <!-- Recent Book 2 -->\n          <div class=\"bg-white rounded-xl shadow p-4 flex items-center gap-4\">\n            <div class=\"w-16 h-20 bg-slate-100 rounded-lg overflow-hidden\">\n              <img src=\"/assets/images/physics-textbook-cover.jpg\" alt=\"Physics\" class=\"w-full h-full object-cover\">\n            </div>\n            <div class=\"flex-1\">\n              <h3 class=\"font-semibold text-gray-800 mb-1\">Modern Physics</h3>\n              <p class=\"text-sm text-gray-500 mb-2\">Last accessed 1 day ago</p>\n              <button class=\"text-sky-600 text-sm font-medium hover:text-sky-700\">Continue Reading</button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </main>\n  </div>\n\n  <!-- Chatbot Widget -->\n  <div id=\"cortex-ai-chat-button\" role=\"button\" aria-label=\"Open Cortex AI chat\">\n    <img src=\"/site/cortex-owl-brain.svg\" alt=\"Cortex AI\" class=\"cortex-icon\" style=\"width:72px;height:72px;box-shadow:0 4px 16px rgba(0,0,0,0.20);border-radius:16px;transition:transform 0.18s cubic-bezier(.4,2,.6,1),box-shadow 0.18s;cursor:pointer;\" onmouseover=\"this.style.transform='scale(1.12)';this.style.boxShadow='0 8px 32px rgba(0,0,0,0.28)';\" onmouseout=\"this.style.transform='scale(1)';this.style.boxShadow='0 4px 16px rgba(0,0,0,0.20)';\" onmousedown=\"this.style.transform='scale(0.96)';\" onmouseup=\"this.style.transform='scale(1.12)';\">\n  </div>\n  <iframe id=\"cortex-ai-chat-popup\" src=\"https://app.edcafe.ai/chatbots/68b96ebb2a5be310497b6a0b\"></iframe>\n</div>\n  <!-- Scripts -->\n  \n\n  <!-- Import shared student page components -->\n  \n  \n\n  \n  <style>\n    #cortex-ai-chat-button {\n      position: fixed;\n      bottom: 20px;\n      right: 20px;\n      background: transparent;\n      display: flex;\n      align-items: center;\n      justify-center;\n      font-size: 0;\n      border: none;\n      z-index: 1000;\n    }\n\n    #cortex-ai-chat-popup {\n      position: fixed;\n      bottom: 90px;\n      right: 20px;\n      width: 380px;\n      height: 500px;\n      border: none;\n      border-radius: 12px;\n      box-shadow: 0px 4px 16px rgba(0,0,0,0.4);\n      display: none;\n      z-index: 1000;\n    }\n  </style>","bodyClass":"bg-slate-50","bodyStyle":"","css":["#sidebar { transition: transform 0.3s ease-in-out; } #sidebar.hide { transform: translateX(-100%); } @media (min-width: 1024px) { #sidebar { transform: translateX(0) !important; } }","#cortex-ai-chat-button {\n      position: fixed;\n      bottom: 20px;\n      right: 20px;\n      background: transparent;\n      display: flex;\n      align-items: center;\n      justify-center;\n      font-size: 0;\n      border: none;\n      z-index: 1000;\n    }\n\n    #cortex-ai-chat-popup {\n      position: fixed;\n      bottom: 90px;\n      right: 20px;\n      width: 380px;\n      height: 500px;\n      border: none;\n      border-radius: 12px;\n      box-shadow: 0px 4px 16px rgba(0,0,0,0.4);\n      display: none;\n      z-index: 1000;\n    }"],"quiz":null,"tracker":null,"links":[]}