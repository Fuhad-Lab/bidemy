{"slug":"/students/templates/topic-template/","source":"students/templates/topic-template.html","area":"students","kind":"content","title":"Topic - Template","description":"","subject":null,"body":"<header class=\"bg-white shadow-sm sticky top-0 z-40\">\n    <div class=\"max-w-6xl mx-auto px-4 py-3 flex items-center justify-between\">\n      <div class=\"flex items-center gap-3\">\n        <a href=\"/students/subjects/accounting/content/divisions/accounting-cycle/\" class=\"text-gray-600 hover:text-gray-900\"><span class=\"mi -arrow-left\" data-mi=\"arrow_back\">arrow_back</span></a>\n        <h1 id=\"topicTitle\" class=\"text-lg font-semibold\">Topic Title</h1>\n      </div>\n      <div class=\"flex items-center gap-4\">\n        <div class=\"text-sm text-gray-600\">Progress: <span id=\"progressPercent\">0%</span></div>\n        <div class=\"w-40 h-2 bg-gray-200 rounded-full\"><div id=\"progressBar\" class=\"step-progress h-2 bg-blue-600 rounded-full\" style=\"width:0%\"></div></div>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"pt-6 pb-16\">\n    <div class=\"max-w-6xl mx-auto px-4 grid md:grid-cols-12 gap-6\">\n      <aside class=\"md:col-span-3\">\n        <div class=\"card p-4 rounded-lg sticky top-24\">\n          <h3 class=\"font-semibold mb-3\">Steps</h3>\n          <ul id=\"stepsList\" class=\"space-y-2 text-sm text-gray-700\">\n            <!-- JS populated -->\n          </ul>\n        </div>\n      </aside>\n\n      <section class=\"md:col-span-9 space-y-6\">\n        <div class=\"card p-6 rounded-lg\" id=\"stepContainer\">\n          <!-- step content inserted here -->\n        </div>\n\n        <div class=\"card p-6 rounded-lg\" id=\"resourcesContainer\">\n          <h3 class=\"font-semibold mb-4\">Resources</h3>\n          <div id=\"resourcesGrid\" class=\"grid sm:grid-cols-2 lg:grid-cols-3 gap-4\"></div>\n        </div>\n      </section>\n    </div>\n  </main>\n\n  <div class=\"fixed bottom-0 left-0 right-0 bg-white border-t\">\n    <div class=\"max-w-6xl mx-auto px-4 py-3 flex justify-between\">\n      <button id=\"prevStepBtn\" class=\"text-gray-600 px-3 py-2 rounded disabled:opacity-50\" disabled=\"\"><span class=\"mi -chevron-left mr-1\" data-mi=\"chevron_left\">chevron_left</span>Previous</button>\n      <div class=\"flex gap-3\">\n        <button id=\"startQuizBtn\" class=\"px-3 py-2 bg-yellow-100 text-yellow-800 rounded\">Take Quiz</button>\n        <button id=\"nextStepBtn\" class=\"px-3 py-2 bg-blue-600 text-white rounded\">Next <span class=\"mi -chevron-right ml-1\" data-mi=\"chevron_right\">chevron_right</span></button>\n      </div>\n    </div>\n  </div>\n\n  <!-- Quiz Modal -->\n  <div id=\"quizModal\" class=\"hidden fixed inset-0 z-50 bg-black bg-opacity-50 flex items-start justify-center p-6\">\n    <div class=\"bg-white w-full max-w-2xl rounded-lg p-6\">\n      <div class=\"flex justify-between items-center mb-4\"><h3 class=\"font-semibold\">Quick Quiz</h3><button id=\"closeQuiz\" class=\"text-gray-600\">×</button></div>\n      <div id=\"quizContent\"></div>\n    </div>\n  </div>","bodyClass":"","bodyStyle":"","css":["body{font-family:Inter, sans-serif;background:#f8fafc}\n    .card{backdrop-filter:blur(8px);background:rgba(255,255,255,0.85);border:1px solid rgba(0,0,0,0.04);}\n    .step-progress{transition:width .25s ease}\n    .hidden{display:none}"],"quiz":null,"tracker":null,"links":[]}