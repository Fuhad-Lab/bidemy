{"slug":"/students/practice-exams/","source":"students/practice-exams.html","area":"students","kind":"content","title":"Practice Exams - Prep100","description":"","subject":null,"body":"<div class=\"min-h-screen flex\">\n            <!-- Sidebar injected by sidebar-fragment.js -->\n        <div class=\"flex items-center gap-3\">\n          <img src=\"/site/assets/images/logo.png\" alt=\"logo\" class=\"h-12 w-12 rounded-full shadow-sm\">\n          <div>\n            <div class=\"text-lg font-bold text-sky-700\">JUANOVA CORTEX</div>\n            <div class=\"text-xs text-slate-500\">Student Dashboard</div>\n          </div>\n        </div>\n\n        <nav class=\"flex-1 overflow-auto\">\n          <ul class=\"space-y-1\">\n            <li><a href=\"/students/student-dashboard/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -home text-sky-600\" data-mi=\"home\">home</span> Home</a></li>\n            <li><a href=\"/students/news-feed-gemini/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -newspaper text-pink-500\" data-mi=\"help_outline\">help_outline</span> News Feed</a></li>\n            <li><a href=\"/students/ai-tutor-chatbot/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -robot text-purple-500\" data-mi=\"smart_toy\">smart_toy</span> AI Tutor</a></li>\n            <li><a href=\"/students/study-plan/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -calendar-check text-green-500\" data-mi=\"event_available\">event_available</span> Study Plan</a></li>\n           <li><a href=\"/students/all-formula/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -book-open text-teal-600\" data-mi=\"auto_stories\">auto_stories</span> All Formula</a></li>\n            <li><a href=\"/students/video-library/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -video text-red-500\" data-mi=\"videocam\">videocam</span> Video Library</a></li>\n            <li><a href=\"/students/mock-exams/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -pencil-alt text-orange-500\" data-mi=\"edit\">edit</span> Mock Exams</a></li>\n            <li><a href=\"/students/cbt/cbt/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -computer text-red-500\" data-mi=\"help_outline\">help_outline</span> JAMB CBT</a></li>\n            <li><a href=\"/students/notifications/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -bell text-pink-600\" data-mi=\"notifications\">notifications</span> Notifications</a></li>\n            <li><a href=\"/students/student-live-session/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -chalkboard-teacher text-blue-400\" data-mi=\"co_present\">co_present</span> Live Sessions</a></li>\n            <li><a href=\"/students/smart-note/\" class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50\"><span class=\"mi -sticky-note text-yellow-500\" data-mi=\"sticky_note_2\">sticky_note_2</span> Smart Notes</a></li>\n          </ul>\n        </nav>\n\n        <div class=\"text-sm text-slate-500\">\n          <div class=\"mb-2\">Account</div>\n          <div class=\"flex items-center gap-3\">\n            <img id=\"avatar-sm\" src=\"/site/assets/images/unnamed.jpg\" alt=\"avatar\" class=\"h-10 w-10 rounded-full border\">\n            <div>\n              <div id=\"userName\" class=\"font-semibold\">Student</div>\n              <div id=\"userLevel\" class=\"text-xs text-slate-400\"></div>\n            </div>\n          </div>\n        </div>\n      \n      <div id=\"main-cards\" class=\"practice-list\">\n        <div class=\"practice-card\">\n          <div class=\"practice-title\">Topic-by-topic</div>\n          <div class=\"practice-meta\">Practice by subject and topic</div>\n        </div>\n        <div class=\"practice-card\">\n          <div class=\"practice-title\">Year-by-year</div>\n          <div class=\"practice-meta\">Practice by year for each subject</div>\n        </div>\n        <div class=\"practice-card\">\n          <div class=\"practice-title\">English Essay Writing</div>\n          <div class=\"practice-meta\">Practice WAEC/NECO essay types</div>\n        </div>\n      </div>\n      <div id=\"dynamic-content\"></div>\n    \n  </div>\n  \n        <!-- Main Content -->\n        <main class=\"flex-1 p-8 lg:ml-72 ml-0 pt-16 lg:pt-0\">\n            <!-- Top Bar -->\n            <div class=\"flex items-center justify-between mb-8\">\n                <div class=\"flex-1 max-w-xl relative\">\n                    <span class=\"mi -search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400\" data-mi=\"search\">search</span>\n                    <input type=\"text\" class=\"w-full pl-12 pr-4 py-3 rounded-full border-2 border-gray-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-100 bg-white\" placeholder=\"Search topics, subjects, or questions...\">\n                </div>\n                <div class=\"flex items-center gap-4\">\n                    <span class=\"bg-blue-100 text-blue-700 px-4 py-1 rounded-full font-semibold text-sm\">SS 3</span>\n                    <span class=\"font-semibold text-gray-700\">Student</span>\n                    <div class=\"relative\">\n                        <button class=\"p-2 rounded-full hover:bg-blue-100 transition\" aria-label=\"Notifications\" title=\"Notifications\">\n                            <span class=\"mi -bell text-blue-600 text-lg\" data-mi=\"notifications\">notifications</span>\n                            <span class=\"absolute -top-1 -right-1 bg-pink-500 text-white rounded-full w-5 h-5 flex items-center justify-center text-xs font-bold\">3</span>\n                        </button>\n                    </div>\n                    <img src=\"/site/assets/images/unnamed.jpg\" alt=\"User\" class=\"h-10 w-10 rounded-full border-2 border-blue-500\">\n                </div>\n            </div>\n\n            <!-- Page Title -->\n            <h1 class=\"text-3xl font-bold text-gray-800 mb-6\">Mock Exams</h1>\n\n            <!-- Cards Section -->\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\" id=\"main-cards\">\n                <div class=\"bg-white rounded-2xl p-6 shadow hover:shadow-lg transition cursor-pointer\">\n                    <h2 class=\"text-xl font-bold text-gray-800 mb-2\">Topic-by-topic</h2>\n                    <p class=\"text-gray-600\">Practice by subject and topic in JAMB CBT format with past WAEC questions</p>\n                </div>\n                <div class=\"bg-white rounded-2xl p-6 shadow hover:shadow-lg transition cursor-pointer\">\n                    <h2 class=\"text-xl font-bold text-gray-800 mb-2\">Year-by-year</h2>\n                    <p class=\"text-gray-600\">Practice past WAEC years in JAMB CBT format</p>\n                </div>\n                <div class=\"bg-white rounded-2xl p-6 shadow hover:shadow-lg transition cursor-pointer\">\n                    <h2 class=\"text-xl font-bold text-gray-800 mb-2\">English Essay Writing</h2>\n                    <p class=\"text-gray-600\">Practice WAEC/NECO essay types with auto topics and COEM marking</p>\n                </div>\n            </div>\n\n            <!-- Dynamic Content Section -->\n            <div id=\"dynamic-content\" class=\"mt-8\"></div>\n\n            <!-- Quick Actions Toolbar -->\n            <div id=\"toolbar\" class=\"fixed bottom-8 right-12\">\n                <div class=\"relative group\">\n                    <button id=\"toolsButton\" title=\"Learning Tools\" aria-label=\"Toggle Learning Tools\" class=\"text-purple-500 hover:text-purple-700 transition-colors p-2\">\n                        <span class=\"mi -toolbox text-4xl drop-shadow-lg hover:scale-110 transform transition-transform\" data-mi=\"help_outline\">help_outline</span>\n                    </button>\n\n                    <div id=\"toolsMenu\" class=\"hidden absolute bottom-14 right-0 bg-white/95 backdrop-blur-sm rounded-xl shadow-2xl overflow-hidden min-w-[220px] border border-purple-100/50\">\n                        <button class=\"w-full px-6 py-4 flex items-center gap-4 hover:bg-purple-50 transition-all text-left group\">\n                            <span class=\"mi -robot text-xl text-purple-500 group-hover:scale-110 transition-transform\" data-mi=\"smart_toy\">smart_toy</span>\n                            <span class=\"text-gray-700 group-hover:text-purple-600 font-medium\">AI Tutor</span>\n                        </button>\n                        <button class=\"w-full px-6 py-4 flex items-center gap-4 hover:bg-yellow-50 transition-all text-left group border-t border-purple-100/30\">\n                            <span class=\"mi -sticky-note text-xl text-yellow-500 group-hover:scale-110 transition-transform\" data-mi=\"sticky_note_2\">sticky_note_2</span>\n                            <span class=\"text-gray-700 group-hover:text-yellow-600 font-medium\">Smart Notes</span>\n                        </button>\n                        <button class=\"w-full px-6 py-4 flex items-center gap-4 hover:bg-teal-50 transition-all text-left group border-t border-purple-100/30\">\n                            <span class=\"mi -superscript text-xl text-teal-500 group-hover:scale-110 transition-transform\" data-mi=\"help_outline\">help_outline</span>\n                            <span class=\"text-gray-700 group-hover:text-teal-600 font-medium\">Formula Tool</span>\n                        </button>\n                        <button class=\"w-full px-6 py-4 flex items-center gap-4 hover:bg-amber-50 transition-all text-left group border-t border-purple-100/30\">\n                            <span class=\"mi -book-reader text-xl text-amber-500 group-hover:scale-110 transition-transform\" data-mi=\"local_library\">local_library</span>\n                            <span class=\"text-gray-700 group-hover:text-amber-600 font-medium\">Dictionary</span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Tool Windows (Initially Hidden) -->\n            <div id=\"smart-notes-window\" class=\"hidden fixed bg-white rounded-lg shadow-2xl p-4 w-80 cursor-move z-[1000]\">\n                <div class=\"flex justify-between items-center mb-4\">\n                    <h3 class=\"font-bold text-lg text-yellow-600\">Smart Notes</h3>\n                    <button class=\"text-gray-500 hover:text-gray-700\" title=\"Close Smart Notes\" aria-label=\"Close Smart Notes\">\n                        <span class=\"mi -times\" data-mi=\"close\">close</span>\n                    </button>\n                </div>\n                <textarea id=\"smart-notes-input\" class=\"w-full p-2 border rounded-lg mb-2\" rows=\"4\" placeholder=\"Write your note...\"></textarea>\n                <button class=\"w-full bg-yellow-500 text-white py-2 rounded-lg hover:bg-yellow-600\">Save Note</button>\n            </div>\n\n            <div id=\"formula-window\" class=\"hidden fixed bg-white rounded-lg shadow-2xl p-4 w-80 cursor-move z-[1000]\">\n                <div class=\"flex justify-between items-center mb-4\">\n                    <h3 class=\"font-bold text-lg text-teal-600\">Formula Tool</h3>\n                    <button class=\"text-gray-500 hover:text-gray-700\" title=\"Close Formula Tool\" aria-label=\"Close Formula Tool\">\n                        <span class=\"mi -times\" data-mi=\"close\">close</span>\n                    </button>\n                </div>\n                <input type=\"text\" id=\"formula-name\" class=\"w-full p-2 border rounded-lg mb-2 dynamic-width\" placeholder=\"Formula Name\">\n                <textarea id=\"formula-input\" class=\"w-full p-2 border rounded-lg mb-2\" rows=\"3\" placeholder=\"Enter your formula...\"></textarea>\n                <button class=\"w-full bg-teal-600 text-white py-2 rounded-lg hover:bg-teal-700\">Save Formula</button>\n            </div>\n\n            <div id=\"dictionary-window\" class=\"hidden fixed bg-white rounded-lg shadow-2xl p-4 w-80 cursor-move z-[1000]\">\n                <div class=\"flex justify-between items-center mb-4\">\n                    <h3 class=\"font-bold text-lg text-amber-600\">Dictionary</h3>\n                    <button class=\"text-gray-500 hover:text-gray-700\" title=\"Close Dictionary\" aria-label=\"Close Dictionary\">\n                        <span class=\"mi -times\" data-mi=\"close\">close</span>\n                    </button>\n                </div>\n                <input type=\"text\" id=\"dictionary-search\" class=\"w-full p-2 border rounded-lg mb-2 dynamic-width\" placeholder=\"Search word...\">\n                <div id=\"dictionary-result\" class=\"text-gray-600\"></div>\n            </div>\n        </main>","bodyClass":"bg-slate-50 text-slate-800","bodyStyle":"","css":["/* Ensure textareas and inputs don't overflow */\n    textarea, input[type=\"text\"] {\n      max-width: 100%;\n      box-sizing: border-box;\n    }\n    /* Style for address textareas */\n    .address-textarea {\n      resize: none;\n      height: 60px;\n      min-height: 60px;\n    }\n    /* Dynamic input width */\n    input.dynamic-width {\n      width: auto;\n      min-width: 200px;\n      max-width: 100%;\n      transition: width 0.2s ease;\n    }"],"quiz":null,"tracker":null,"links":[]}