{"slug":"/students/cbt-simple/","source":"students/cbt-simple.html","area":"students","kind":"content","title":"JAMB CBT - Physics Practice","description":"","subject":null,"body":"<!-- Home Screen -->\n    <div id=\"home-screen\" class=\"min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 flex items-center justify-center p-4\">\n        <div class=\"bg-white rounded-2xl shadow-2xl p-8 max-w-md w-full\">\n            <div class=\"text-center mb-8\">\n                <h1 class=\"text-3xl font-bold text-slate-800 mb-2\">JAMB CBT</h1>\n                <p class=\"text-slate-600\">Physics Practice Test</p>\n            </div>\n\n            <div class=\"mb-6\">\n                <label class=\"block text-sm font-medium text-slate-700 mb-2\">Select Year</label>\n                <select id=\"year-select\" class=\"w-full p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-rose-500 text-lg\">\n                    <option value=\"2010\">2010 (50 questions)</option>\n                    <option value=\"2011\">2011 (50 questions)</option>\n                    <option value=\"2012\">2012 (50 questions)</option>\n                    <option value=\"2013\">2013 (50 questions)</option>\n                    <option value=\"2014\">2014 (50 questions)</option>\n                    <option value=\"2015\">2015 (40 questions)</option>\n                    <option value=\"2016\">2016 (40 questions)</option>\n                    <option value=\"2017\">2017 (40 questions)</option>\n                    <option value=\"2018\">2018 (40 questions)</option>\n                </select>\n            </div>\n\n            <div class=\"bg-rose-50 rounded-lg p-4 mb-6\">\n                <h3 class=\"font-semibold text-rose-800 mb-2\">Instructions</h3>\n                <ul class=\"text-sm text-rose-700 space-y-1\">\n                    <li>• Each question is displayed as an image</li>\n                    <li>• Select the correct option (A, B, C, or D)</li>\n                    <li>• You have 35 minutes to complete</li>\n                    <li>• Navigate using the question buttons</li>\n                </ul>\n            </div>\n\n            <button class=\"w-full bg-rose-600 hover:bg-rose-700 text-white font-semibold py-4 rounded-xl transition-colors text-lg\">\n                Start Test\n            </button>\n        </div>\n    </div>\n\n    <!-- Exam Screen -->\n    <div id=\"exam-screen\" class=\"hidden min-h-screen flex flex-col\">\n        <!-- Header -->\n        <header class=\"bg-white shadow-sm sticky top-0 z-10\">\n            <div class=\"max-w-4xl mx-auto px-4 py-3 flex items-center justify-between\">\n                <div class=\"flex items-center gap-3\">\n                    <span id=\"year-badge\" class=\"px-3 py-1 bg-rose-100 text-rose-600 font-semibold rounded-lg text-sm\">2010</span>\n                    <span class=\"text-slate-500\">Physics</span>\n                </div>\n                \n                <div class=\"flex items-center gap-4\">\n                    <div class=\"flex items-center gap-2 bg-rose-50 px-4 py-2 rounded-lg\">\n                        <svg class=\"w-5 h-5 text-rose-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n                        </svg>\n                        <span id=\"timer\" class=\"font-mono font-bold text-rose-600\">35:00</span>\n                    </div>\n                    \n                    <button class=\"bg-rose-600 hover:bg-rose-700 text-white px-4 py-2 rounded-lg font-medium transition-colors\">\n                        Submit\n                    </button>\n                </div>\n            </div>\n        </header>\n\n        <!-- Main Content -->\n        <main class=\"flex-1 p-4\">\n            <div class=\"max-w-4xl mx-auto\">\n                <!-- Question Card -->\n                <div class=\"bg-white rounded-2xl shadow-sm overflow-hidden mb-4\">\n                    <div class=\"bg-slate-50 px-6 py-3 border-b border-slate-100\">\n                        <span id=\"question-number\" class=\"font-semibold text-rose-600\">Question 1 of 50</span>\n                    </div>\n\n                    <div class=\"p-6\">\n                        <div id=\"question-image-container\" class=\"cursor-zoom-in\">\n                            <img id=\"question-image\" src=\"\" alt=\"Question\" class=\"max-w-full h-auto mx-auto rounded-lg border border-slate-200 shadow-sm\" style=\"max-height: 400px;\">\n                        </div>\n                        <p class=\"text-center text-sm text-slate-400 mt-2\">Click image to enlarge</p>\n                    </div>\n\n                    <!-- Options -->\n                    <div class=\"px-6 pb-6\">\n                        <div class=\"grid grid-cols-2 gap-3\">\n                            <button id=\"opt-0\" class=\"p-4 rounded-xl border-2 border-slate-200 hover:border-slate-300 bg-white text-left flex items-center gap-3 transition-all\">\n                                <span class=\"w-10 h-10 rounded-full flex items-center justify-center text-sm font-semibold bg-slate-100 text-slate-600\">A</span>\n                                <span class=\"font-medium text-slate-700\">Option A</span>\n                            </button>\n                            <button id=\"opt-1\" class=\"p-4 rounded-xl border-2 border-slate-200 hover:border-slate-300 bg-white text-left flex items-center gap-3 transition-all\">\n                                <span class=\"w-10 h-10 rounded-full flex items-center justify-center text-sm font-semibold bg-slate-100 text-slate-600\">B</span>\n                                <span class=\"font-medium text-slate-700\">Option B</span>\n                            </button>\n                            <button id=\"opt-2\" class=\"p-4 rounded-xl border-2 border-slate-200 hover:border-slate-300 bg-white text-left flex items-center gap-3 transition-all\">\n                                <span class=\"w-10 h-10 rounded-full flex items-center justify-center text-sm font-semibold bg-slate-100 text-slate-600\">C</span>\n                                <span class=\"font-medium text-slate-700\">Option C</span>\n                            </button>\n                            <button id=\"opt-3\" class=\"p-4 rounded-xl border-2 border-slate-200 hover:border-slate-300 bg-white text-left flex items-center gap-3 transition-all\">\n                                <span class=\"w-10 h-10 rounded-full flex items-center justify-center text-sm font-semibold bg-slate-100 text-slate-600\">D</span>\n                                <span class=\"font-medium text-slate-700\">Option D</span>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Navigation Buttons -->\n                <div class=\"flex gap-3 mb-4\">\n                    <button id=\"prev-btn\" class=\"flex-1 py-3 bg-white border border-slate-200 rounded-xl font-medium hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors\">\n                        Previous\n                    </button>\n                    <button id=\"next-btn\" class=\"flex-1 py-3 bg-slate-800 text-white rounded-xl font-medium hover:bg-slate-900 disabled:opacity-50 disabled:cursor-not-allowed transition-colors\">\n                        Next\n                    </button>\n                </div>\n\n                <!-- Question Navigation -->\n                <div class=\"bg-white rounded-2xl shadow-sm p-4\">\n                    <div id=\"question-nav\" class=\"flex flex-wrap gap-2 justify-center\">\n                        <!-- Buttons will be generated here -->\n                    </div>\n                    <div class=\"flex justify-center gap-6 mt-4 text-sm\">\n                        <div class=\"flex items-center gap-2\">\n                            <div class=\"w-4 h-4 bg-rose-600 rounded\"></div>\n                            <span class=\"text-slate-600\">Current</span>\n                        </div>\n                        <div class=\"flex items-center gap-2\">\n                            <div class=\"w-4 h-4 bg-green-500 rounded\"></div>\n                            <span class=\"text-slate-600\">Answered</span>\n                        </div>\n                        <div class=\"flex items-center gap-2\">\n                            <div class=\"w-4 h-4 bg-slate-100 rounded\"></div>\n                            <span class=\"text-slate-600\">Not Answered</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </main>\n    </div>\n\n    <!-- Result Screen -->\n    <div id=\"result-screen\" class=\"hidden min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 flex items-center justify-center p-4\">\n        <div class=\"bg-white rounded-2xl shadow-2xl p-8 max-w-md w-full\">\n            <div class=\"text-center mb-8\">\n                <h1 class=\"text-3xl font-bold text-slate-800 mb-2\">Test Complete!</h1>\n                <p class=\"text-slate-600\">Here is your result</p>\n            </div>\n\n            <div class=\"flex justify-center mb-6\">\n                <div class=\"relative w-32 h-32\">\n                    <svg class=\"w-full h-full transform -rotate-90\">\n                        <circle cx=\"64\" cy=\"64\" r=\"45\" stroke=\"#e5e7eb\" stroke-width=\"12\" fill=\"none\"></circle>\n                        <circle id=\"progress-circle\" cx=\"64\" cy=\"64\" r=\"45\" stroke=\"#22c55e\" stroke-width=\"12\" fill=\"none\" stroke-linecap=\"round\"></circle>\n                    </svg>\n                    <div class=\"absolute inset-0 flex items-center justify-center\">\n                        <span id=\"score-percentage\" class=\"text-3xl font-bold text-slate-800\">0%</span>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"grid grid-cols-3 gap-4 mb-6\">\n                <div class=\"bg-green-50 rounded-xl p-4 text-center\">\n                    <div id=\"correct-count\" class=\"text-2xl font-bold text-green-600\">0</div>\n                    <div class=\"text-sm text-slate-500\">Correct</div>\n                </div>\n                <div class=\"bg-red-50 rounded-xl p-4 text-center\">\n                    <div id=\"wrong-count\" class=\"text-2xl font-bold text-red-600\">0</div>\n                    <div class=\"text-sm text-slate-500\">Wrong</div>\n                </div>\n                <div class=\"bg-slate-50 rounded-xl p-4 text-center\">\n                    <div id=\"total-count\" class=\"text-2xl font-bold text-slate-600\">0</div>\n                    <div class=\"text-sm text-slate-500\">Total</div>\n                </div>\n            </div>\n\n            <button class=\"w-full bg-rose-600 hover:bg-rose-700 text-white font-semibold py-4 rounded-xl transition-colors\">\n                Try Again\n            </button>\n        </div>\n    </div>\n\n    <!-- Image Modal -->\n    <div id=\"image-modal\" class=\"fixed inset-0 bg-black/90 z-50 hidden items-center justify-center p-4\">\n        <button class=\"absolute top-4 right-4 w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-lg hover:bg-slate-100 transition-colors\">\n            <svg class=\"w-6 h-6 text-slate-700\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"></path>\n            </svg>\n        </button>\n        <img id=\"modal-image\" src=\"\" alt=\"Question\" class=\"max-w-full max-h-[90vh] object-contain rounded-lg\">\n    </div>","bodyClass":"bg-slate-100 min-h-screen","bodyStyle":"","css":[".question-btn.current { background-color: #e11d48; color: white; }\n        .question-btn.answered { background-color: #22c55e; color: white; }\n        .question-btn { background-color: #f1f5f9; }"],"quiz":null,"tracker":null,"links":[]}