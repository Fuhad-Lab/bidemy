{"slug":"/students/notes/","source":"students/notes.html","area":"students","kind":"content","title":"Study Notes - JUANOVA CORTEX","description":"","subject":null,"body":"<!-- Main content area -->\n  <div id=\"main-content\" class=\"flex-1 flex flex-col ml-64 md:ml-72 lg:ml-80\">\n    <!-- Topbar -->\n    <header class=\"flex items-center justify-between p-4 bg-white border-b border-slate-200\">\n      <div class=\"flex items-center gap-3\">\n        <button id=\"toggleSidebar\" class=\"p-2 rounded-md hover:bg-slate-100 lg:hidden\" title=\"Toggle sidebar\">\n          <span class=\"mi -bars\" data-mi=\"menu\">menu</span>\n        </button>\n        <div class=\"relative\">\n          <input id=\"globalSearch\" type=\"search\" placeholder=\"Search notes...\" class=\"w-[520px] hidden md:inline-block pl-10 pr-4 py-2 rounded-full border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-sky-100\">\n          <span class=\"mi -search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" data-mi=\"search\">search</span>\n        </div>\n      </div>\n\n      <div class=\"flex items-center gap-4\">\n        <div class=\"relative\">\n          <button id=\"notifBtn\" class=\"p-2 rounded-full hover:bg-slate-50\" aria-label=\"Notifications\">\n            <span class=\"mi -bell text-sky-600\" data-mi=\"notifications\">notifications</span>\n          </button>\n          <span id=\"notifCount\" class=\"absolute -top-1 -right-1 bg-pink-500 text-white rounded-full w-5 h-5 text-xs flex items-center justify-center\">0</span>\n        </div>\n        <div class=\"flex items-center gap-3\">\n          <div class=\"text-right mr-2\">\n            <div id=\"topName\" class=\"font-semibold\">Student Name</div>\n            <div id=\"topLevel\" class=\"text-xs text-slate-400\">SS 3</div>\n          </div>\n          <img id=\"topAvatar\" src=\"/site/assets/images/unnamed.jpg\" alt=\"avatar\" class=\"h-10 w-10 rounded-full border-2\">\n        </div>\n      </div>\n    </header>\n\n    <!-- Page Content -->\n    <main class=\"p-6\">\n      <!-- Page Header -->\n      <div class=\"mb-8\">\n        <h1 class=\"text-3xl font-bold text-gray-800 mb-2\">Study Notes</h1>\n        <p class=\"text-gray-600\">Organize and access your study materials for better preparation.</p>\n      </div>\n\n      <!-- Action Buttons -->\n      <div class=\"flex gap-4 mb-6\">\n        <button class=\"px-4 py-2 bg-sky-600 text-white font-medium rounded-md hover:bg-sky-700 transition-colors flex items-center gap-2\">\n          <span class=\"mi -plus\" data-mi=\"add\">add</span>\n          New Note\n        </button>\n        <button class=\"px-4 py-2 bg-white text-slate-600 font-medium rounded-md hover:bg-slate-50 transition-colors flex items-center gap-2\">\n          <span class=\"mi -folder-plus\" data-mi=\"help_outline\">help_outline</span>\n          New Folder\n        </button>\n      </div>\n\n      <!-- Quick Filters -->\n      <div class=\"flex gap-3 mb-6 overflow-x-auto pb-2\">\n        <button class=\"px-4 py-2 rounded-full bg-sky-600 text-white font-medium text-sm\">All Notes</button>\n        <button class=\"px-4 py-2 rounded-full bg-white text-slate-600 font-medium text-sm hover:bg-slate-50\">Recent</button>\n        <button class=\"px-4 py-2 rounded-full bg-white text-slate-600 font-medium text-sm hover:bg-slate-50\">Favorites</button>\n        <button class=\"px-4 py-2 rounded-full bg-white text-slate-600 font-medium text-sm hover:bg-slate-50\">Shared</button>\n      </div>\n\n      <!-- Notes Grid -->\n      <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n        <!-- Subject Folders -->\n        <div class=\"bg-white rounded-xl shadow p-5 space-y-4\">\n          <div class=\"flex items-center gap-3\">\n            <div class=\"w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center\">\n              <span class=\"mi -calculator text-blue-600 text-xl\" data-mi=\"calculate\">calculate</span>\n            </div>\n            <div class=\"flex-1\">\n              <h3 class=\"font-semibold text-gray-800\">Mathematics</h3>\n              <p class=\"text-sm text-gray-500\">12 notes</p>\n            </div>\n            <button class=\"text-gray-400 hover:text-gray-600\">\n              <span class=\"mi -ellipsis-v\" data-mi=\"more_vert\">more_vert</span>\n            </button>\n          </div>\n          <div class=\"flex items-center justify-between text-sm\">\n            <span class=\"text-gray-500\">Last updated: 2 hours ago</span>\n            <button class=\"text-sky-600 hover:text-sky-700\">Open</button>\n          </div>\n        </div>\n\n        <div class=\"bg-white rounded-xl shadow p-5 space-y-4\">\n          <div class=\"flex items-center gap-3\">\n            <div class=\"w-12 h-12 bg-green-100 rounded-full flex items-center justify-center\">\n              <span class=\"mi -flask text-green-600 text-xl\" data-mi=\"science\">science</span>\n            </div>\n            <div class=\"flex-1\">\n              <h3 class=\"font-semibold text-gray-800\">Biology</h3>\n              <p class=\"text-sm text-gray-500\">8 notes</p>\n            </div>\n            <button class=\"text-gray-400 hover:text-gray-600\">\n              <span class=\"mi -ellipsis-v\" data-mi=\"more_vert\">more_vert</span>\n            </button>\n          </div>\n          <div class=\"flex items-center justify-between text-sm\">\n            <span class=\"text-gray-500\">Last updated: 1 day ago</span>\n            <button class=\"text-sky-600 hover:text-sky-700\">Open</button>\n          </div>\n        </div>\n\n        <div class=\"bg-white rounded-xl shadow p-5 space-y-4\">\n          <div class=\"flex items-center gap-3\">\n            <div class=\"w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center\">\n              <span class=\"mi -atom text-purple-600 text-xl\" data-mi=\"atom\">atom</span>\n            </div>\n            <div class=\"flex-1\">\n              <h3 class=\"font-semibold text-gray-800\">Physics</h3>\n              <p class=\"text-sm text-gray-500\">10 notes</p>\n            </div>\n            <button class=\"text-gray-400 hover:text-gray-600\">\n              <span class=\"mi -ellipsis-v\" data-mi=\"more_vert\">more_vert</span>\n            </button>\n          </div>\n          <div class=\"flex items-center justify-between text-sm\">\n            <span class=\"text-gray-500\">Last updated: 3 days ago</span>\n            <button class=\"text-sky-600 hover:text-sky-700\">Open</button>\n          </div>\n        </div>\n\n        <!-- Recent Notes -->\n        <div class=\"bg-white rounded-xl shadow p-5 space-y-4\">\n          <div class=\"flex items-center gap-3\">\n            <div class=\"w-12 h-12 bg-pink-100 rounded-full flex items-center justify-center\">\n              <span class=\"mi -note-sticky text-pink-600 text-xl\" data-mi=\"help_outline\">help_outline</span>\n            </div>\n            <div class=\"flex-1\">\n              <h3 class=\"font-semibold text-gray-800\">Quadratic Equations</h3>\n              <p class=\"text-sm text-gray-500\">Mathematics</p>\n            </div>\n            <button class=\"text-yellow-400 hover:text-yellow-500\">\n              <span class=\"mi -star\" data-mi=\"star\">star</span>\n            </button>\n          </div>\n          <p class=\"text-gray-600 text-sm\">Key concepts and formulas for solving quadratic equations...</p>\n          <div class=\"flex items-center justify-between text-sm\">\n            <span class=\"text-gray-500\">Modified 5 hours ago</span>\n            <button class=\"text-sky-600 hover:text-sky-700\">View</button>\n          </div>\n        </div>\n\n        <div class=\"bg-white rounded-xl shadow p-5 space-y-4\">\n          <div class=\"flex items-center gap-3\">\n            <div class=\"w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center\">\n              <span class=\"mi -note-sticky text-yellow-600 text-xl\" data-mi=\"help_outline\">help_outline</span>\n            </div>\n            <div class=\"flex-1\">\n              <h3 class=\"font-semibold text-gray-800\">Cell Structure</h3>\n              <p class=\"text-sm text-gray-500\">Biology</p>\n            </div>\n            <button class=\"text-gray-400 hover:text-yellow-500\">\n              <span class=\"mi -star\" data-mi=\"star\">star</span>\n            </button>\n          </div>\n          <p class=\"text-gray-600 text-sm\">Detailed notes on cell organelles and their functions...</p>\n          <div class=\"flex items-center justify-between text-sm\">\n            <span class=\"text-gray-500\">Modified 1 day ago</span>\n            <button class=\"text-sky-600 hover:text-sky-700\">View</button>\n          </div>\n        </div>\n\n        <div class=\"bg-white rounded-xl shadow p-5 space-y-4\">\n          <div class=\"flex items-center gap-3\">\n            <div class=\"w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center\">\n              <span class=\"mi -note-sticky text-indigo-600 text-xl\" data-mi=\"help_outline\">help_outline</span>\n            </div>\n            <div class=\"flex-1\">\n              <h3 class=\"font-semibold text-gray-800\">Newton's Laws</h3>\n              <p class=\"text-sm text-gray-500\">Physics</p>\n            </div>\n            <button class=\"text-yellow-400 hover:text-yellow-500\">\n              <span class=\"mi -star\" data-mi=\"star\">star</span>\n            </button>\n          </div>\n          <p class=\"text-gray-600 text-sm\">Study notes on Newton's three laws of motion...</p>\n          <div class=\"flex items-center justify-between text-sm\">\n            <span class=\"text-gray-500\">Modified 2 days ago</span>\n            <button class=\"text-sky-600 hover:text-sky-700\">View</button>\n          </div>\n        </div>\n      </div>\n    </main>\n  </div>\n\n  <!-- Chatbot Widget -->\n  <div id=\"cortex-ai-chat-button\" role=\"button\" aria-label=\"Open Cortex AI chat\">\n    <img src=\"/site/cortex-owl-brain.svg\" alt=\"Cortex AI\" class=\"cortex-icon\" style=\"width:72px;height:72px;box-shadow:0 4px 16px rgba(0,0,0,0.20);border-radius:16px;transition:transform 0.18s cubic-bezier(.4,2,.6,1),box-shadow 0.18s;cursor:pointer;\" onmouseover=\"this.style.transform='scale(1.12)';this.style.boxShadow='0 8px 32px rgba(0,0,0,0.28)';\" onmouseout=\"this.style.transform='scale(1)';this.style.boxShadow='0 4px 16px rgba(0,0,0,0.20)';\" onmousedown=\"this.style.transform='scale(0.96)';\" onmouseup=\"this.style.transform='scale(1.12)';\">\n  </div>\n  <iframe id=\"cortex-ai-chat-popup\" src=\"https://app.edcafe.ai/chatbots/68b96ebb2a5be310497b6a0b\"></iframe>\n\n  <!-- Scripts -->\n  \n\n  <!-- Import shared student page components -->\n  \n  \n  \n\n  <style>\n    #cortex-ai-chat-button {\n      position: fixed;\n      bottom: 20px;\n      right: 20px;\n      background: transparent;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 0;\n      border: none;\n      z-index: 1000;\n    }\n\n    #cortex-ai-chat-popup {\n      position: fixed;\n      bottom: 90px;\n      right: 20px;\n      width: 380px;\n      height: 500px;\n      border: none;\n      border-radius: 12px;\n      box-shadow: 0px 4px 16px rgba(0,0,0,0.4);\n      display: none;\n      z-index: 1000;\n    }\n  </style>","bodyClass":"bg-slate-50","bodyStyle":"","css":["#cortex-ai-chat-button {\n      position: fixed;\n      bottom: 20px;\n      right: 20px;\n      background: transparent;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 0;\n      border: none;\n      z-index: 1000;\n    }\n\n    #cortex-ai-chat-popup {\n      position: fixed;\n      bottom: 90px;\n      right: 20px;\n      width: 380px;\n      height: 500px;\n      border: none;\n      border-radius: 12px;\n      box-shadow: 0px 4px 16px rgba(0,0,0,0.4);\n      display: none;\n      z-index: 1000;\n    }"],"quiz":null,"tracker":null,"links":[]}