{"slug":"/students/subjects/topic-template/","source":"students/subjects/topic-template.html","area":"students","kind":"content","title":"Topic Learning Dashboard","description":"","subject":null,"body":"<!-- Top Navigation Bar -->\n    <nav class=\"bg-white shadow-sm fixed top-0 w-full z-50\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"flex justify-between h-16\">\n                <div class=\"flex items-center\">\n                    <button id=\"backBtn\" class=\"mr-4 text-gray-600 hover:text-gray-900\">\n                        <span class=\"mi -arrow-left\" data-mi=\"arrow_back\">arrow_back</span>\n                    </button>\n                    <h1 class=\"text-xl font-semibold text-gray-900\" id=\"topicTitle\">Topic Title</h1>\n                </div>\n                <div class=\"flex items-center space-x-4\">\n                    <div class=\"text-sm text-gray-600\">\n                        Progress: <span id=\"progressPercent\">0%</span>\n                    </div>\n                    <div class=\"w-32 h-2 bg-gray-200 rounded-full\">\n                        <div class=\"step-progress h-2 bg-blue-500 rounded-full\" style=\"width: 0%\"></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Main Content Area -->\n    <main class=\"pt-20 pb-16\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <!-- Topic Overview -->\n            <div class=\"mb-8 bg-white rounded-lg shadow-sm p-6\">\n                <h2 class=\"text-2xl font-semibold mb-4\">Overview</h2>\n                <p class=\"text-gray-600\" id=\"topicDescription\">Topic description goes here...</p>\n                <div class=\"mt-4 flex items-center text-sm text-gray-500\">\n                    <span class=\"mi -clock mr-2\" data-mi=\"schedule\">schedule</span>\n                    <span>Estimated time: <span id=\"estimatedTime\">45 minutes</span></span>\n                </div>\n            </div>\n\n            <!-- Learning Path Grid -->\n            <div class=\"grid md:grid-cols-12 gap-6\">\n                <!-- Left Sidebar - Steps List -->\n                <div class=\"md:col-span-3\">\n                    <div class=\"bg-white rounded-lg shadow-sm p-4\">\n                        <h3 class=\"font-semibold mb-4\">Learning Steps</h3>\n                        <ul class=\"space-y-2\" id=\"stepsList\">\n                            <!-- Steps will be dynamically populated -->\n                        </ul>\n                    </div>\n                </div>\n\n                <!-- Main Content Area -->\n                <div class=\"md:col-span-9\">\n                    <!-- Current Step Content -->\n                    <div class=\"bg-white rounded-lg shadow-sm p-6 mb-6\" id=\"currentStep\">\n                        <div class=\"mb-6\">\n                            <h3 class=\"text-xl font-semibold mb-4\" id=\"stepTitle\">Step Title</h3>\n                            <div id=\"stepContent\">\n                                <!-- Step content will be dynamically loaded here -->\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Resources Section -->\n                    <div class=\"bg-white rounded-lg shadow-sm p-6\">\n                        <h3 class=\"text-lg font-semibold mb-4\">Resources</h3>\n                        <div class=\"grid sm:grid-cols-2 lg:grid-cols-3 gap-4\" id=\"resourcesGrid\">\n                            <!-- Resource cards will be dynamically populated -->\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    <!-- Bottom Navigation Bar -->\n    <div class=\"fixed bottom-0 w-full bg-white border-t border-gray-200\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"flex justify-between py-4\">\n                <button id=\"prevStep\" class=\"px-4 py-2 text-gray-600 hover:text-gray-900 disabled:opacity-50\">\n                    <span class=\"mi -chevron-left mr-2\" data-mi=\"chevron_left\">chevron_left</span>\n                    Previous\n                </button>\n                <button id=\"nextStep\" class=\"px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 disabled:opacity-50\">\n                    Next\n                    <span class=\"mi -chevron-right ml-2\" data-mi=\"chevron_right\">chevron_right</span>\n                </button>\n            </div>\n        </div>\n    </div>\n\n    <!-- Quiz Modal -->\n    <div id=\"quizModal\" class=\"hidden fixed inset-0 bg-gray-600 bg-opacity-50 flex items-center justify-center\">\n        <div class=\"bg-white rounded-lg shadow-xl max-w-2xl w-full mx-4\">\n            <div class=\"p-6\">\n                <h3 class=\"text-xl font-semibold mb-4\">Knowledge Check</h3>\n                <div id=\"quizContent\">\n                    <!-- Quiz content will be dynamically loaded -->\n                </div>\n                <div class=\"mt-6 flex justify-end\">\n                    <button id=\"submitQuiz\" class=\"px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600\">\n                        Submit\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>","bodyClass":"bg-gray-50","bodyStyle":"","css":[".step-progress {\n            transition: width 0.3s ease-in-out;\n        }\n        .resource-card {\n            transition: transform 0.2s;\n        }\n        .resource-card:hover {\n            transform: translateY(-4px);\n        }"],"quiz":null,"tracker":null,"links":[]}