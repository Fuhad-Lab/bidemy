{"slug":"/students/subjects/accounting/accounting-new/","source":"students/subjects/accounting/accounting-new.html","area":"students","kind":"division","title":"Accounting - JUANOVA CORTEX","description":"","subject":"accounting","body":"<div class=\"container mx-auto px-4 py-8\">\n        <nav class=\"breadcrumbs mb-6\">\n            <a href=\"/students/student-dashboard/\">Dashboard</a>\n            <span class=\"mi -chevron-right text-sm\" data-mi=\"chevron_right\">chevron_right</span>\n            <span>Accounting</span>\n        </nav>\n\n        <header class=\"mb-8\">\n            <h1 class=\"text-3xl font-bold text-gray-900 mb-2\">Accounting</h1>\n            <p class=\"text-gray-600\">Master fundamental accounting principles and practices</p>\n        </header>\n\n        <div class=\"divisions-grid\">\n            <!-- Core Accounting Foundations -->\n            <div class=\"division-card\">\n                <span class=\"mi -book-open division-icon\" data-mi=\"auto_stories\">auto_stories</span>\n                <h3 class=\"division-title\">Core Accounting Foundations</h3>\n                <p class=\"division-description\">Basic principles, development, branches, and significance of accounting</p>\n                <div class=\"quick-stats\">\n                    <div class=\"quick-stat\">\n                        <span class=\"mi -book\" data-mi=\"menu_book\">menu_book</span>\n                        <span>5 Topics</span>\n                    </div>\n                    <div class=\"quick-stat\">\n                        <span class=\"mi -clock\" data-mi=\"schedule\">schedule</span>\n                        <span>3 Hours</span>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Double Entry System -->\n            <div class=\"division-card\">\n                <span class=\"mi -balance-scale division-icon\" data-mi=\"balance\">balance</span>\n                <h3 class=\"division-title\">Double Entry System</h3>\n                <p class=\"division-description\">Source documents, books of entry, ledgers, and trial balance</p>\n                <div class=\"quick-stats\">\n                    <div class=\"quick-stat\">\n                        <span class=\"mi -book\" data-mi=\"menu_book\">menu_book</span>\n                        <span>6 Topics</span>\n                    </div>\n                    <div class=\"quick-stat\">\n                        <span class=\"mi -clock\" data-mi=\"schedule\">schedule</span>\n                        <span>4 Hours</span>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Professional Ethics -->\n            <div class=\"division-card\">\n                <span class=\"mi -shield-alt division-icon\" data-mi=\"shield\">shield</span>\n                <h3 class=\"division-title\">Professional Ethics</h3>\n                <p class=\"division-description\">Ethical principles, professional conduct, and qualities of an accountant</p>\n                <div class=\"quick-stats\">\n                    <div class=\"quick-stat\">\n                        <span class=\"mi -book\" data-mi=\"menu_book\">menu_book</span>\n                        <span>2 Topics</span>\n                    </div>\n                    <div class=\"quick-stat\">\n                        <span class=\"mi -clock\" data-mi=\"schedule\">schedule</span>\n                        <span>1.5 Hours</span>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Study Resources -->\n            <div class=\"division-card bg-gradient-to-br from-blue-50 to-purple-50\">\n                <span class=\"mi -lightbulb division-icon text-yellow-500\" data-mi=\"lightbulb\">lightbulb</span>\n                <h3 class=\"division-title\">Study Resources</h3>\n                <div class=\"flex flex-col gap-2 mt-4\">\n                    <button class=\"text-sm px-4 py-2 bg-white rounded-lg hover:bg-blue-50 transition flex items-center gap-2 border border-gray-200\">\n                        <span class=\"mi -calculator text-blue-600\" data-mi=\"calculate\">calculate</span>\n                        <span>Financial Calculator</span>\n                    </button>\n                    <button class=\"text-sm px-4 py-2 bg-white rounded-lg hover:bg-blue-50 transition flex items-center gap-2 border border-gray-200\">\n                        <span class=\"mi -sticky-note text-yellow-500\" data-mi=\"sticky_note_2\">sticky_note_2</span>\n                        <span>Quick Notes</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n\n        <!-- Tips Section -->\n        <div class=\"mt-12 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-8\">\n            <h2 class=\"text-xl font-bold text-gray-800 mb-4\">Tips for Success</h2>\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"mi -check-circle text-green-500 mt-1\" data-mi=\"check_circle\">check_circle</span>\n                    <p class=\"text-gray-600\">Start with core foundations before advancing to complex topics</p>\n                </div>\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"mi -check-circle text-green-500 mt-1\" data-mi=\"check_circle\">check_circle</span>\n                    <p class=\"text-gray-600\">Practice double entry exercises regularly</p>\n                </div>\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"mi -check-circle text-green-500 mt-1\" data-mi=\"check_circle\">check_circle</span>\n                    <p class=\"text-gray-600\">Focus on understanding concepts rather than memorizing</p>\n                </div>\n            </div>\n        </div>\n    </div>","bodyClass":"bg-gray-50","bodyStyle":"","css":[".divisions-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n            gap: 1.5rem;\n            margin-top: 2rem;\n        }\n\n        .division-card {\n            background: white;\n            border-radius: 1rem;\n            padding: 1.5rem;\n            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\n            transition: all 0.3s ease;\n            cursor: pointer;\n        }\n\n        .division-card:hover {\n            transform: translateY(-4px);\n            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);\n        }\n\n        .division-icon {\n            font-size: 2rem;\n            margin-bottom: 1rem;\n            color: var(--accent-blue);\n        }\n\n        .division-title {\n            font-size: 1.25rem;\n            font-weight: 600;\n            color: #1F2937;\n            margin-bottom: 0.5rem;\n        }\n\n        .division-description {\n            color: #6B7280;\n            font-size: 0.875rem;\n            line-height: 1.25rem;\n        }\n\n        .quick-stats {\n            display: flex;\n            gap: 1rem;\n            margin-top: 1rem;\n            font-size: 0.875rem;\n            color: #6B7280;\n        }\n\n        .quick-stat {\n            display: flex;\n            align-items: center;\n            gap: 0.5rem;\n        }"],"quiz":null,"tracker":null,"links":[]}