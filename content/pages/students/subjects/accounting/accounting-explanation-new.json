          font-weight: 600;\n        }\n\n        .prose p {\n            color: #4B5563;\n            margin-bottom: 1rem;\n            line-height: 1.75;\n        }\n\n        .prose ul {\n            list-style-type: disc;\n            padding-left: 1.5rem;\n            margin-bottom: 1rem;\n        }\n\n        .prose li {\n            color: #4B5563;\n            margin-bottom: 0.5rem;\n        }\n\n        .key-point {\n            background: rgba(59, 130, 246, 0.1);\n            border-left: 4px solid #2563EB;\n            padding: 1rem;\n            margin: 1rem 0;\n            border-radius: 0.5rem;\n        }"],"quiz":null,"tracker":null,"links":[]}