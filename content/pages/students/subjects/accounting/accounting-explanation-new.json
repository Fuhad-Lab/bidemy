{"slug":"/students/subjects/accounting/accounting-explanation-new/","source":"students/subjects/accounting/accounting-explanation-new.html","area":"students","kind":"division","title":"Accounting Topic Explanation - JUANOVA CORTEX","description":"","subject":"accounting","body":"<!-- Navigation Bar -->\n    <nav class=\"fixed top-0 left-0 right-0 glass-effect border-b border-blue-100 z-50\">\n        <div class=\"container mx-auto px-4 py-3\">\n            <div class=\"flex items-center justify-between\">\n                <div class=\"flex items-center gap-3\">\n                    <a href=\"/students/subjects/accounting/accounting-topic/\" class=\"text-blue-600 hover:text-blue-800 transition\">\n                        <span class=\"mi -arrow-left\" data-mi=\"arrow_back\">arrow_back</span>\n                        <span class=\"ml-2\">Back to Topics</span>\n                    </a>\n                </div>\n                <div class=\"flex items-center gap-4\">\n                    <button class=\"px-4 py-2 rounded-lg border border-green-600 text-green-600 hover:bg-green-50 transition\">\n                        <span class=\"mi -bookmark mr-2\" data-mi=\"bookmark\">bookmark</span>\n                        Save Progress\n                    </button>\n                </div>\n            </div>\n        </div>\n    </nav>\n\n    <main class=\"container mx-auto px-4 pt-20 pb-12\">\n        <!-- Topic Header -->\n        <header class=\"mb-12\">\n            <h1 class=\"section-title mb-4\" id=\"topicTitle\">Loading Topic...</h1>\n            <div class=\"flex items-center justify-center gap-6 text-gray-600\">\n                <span class=\"flex items-center gap-2\">\n                    <span class=\"mi -clock\" data-mi=\"schedule\">schedule</span>\n                    <span id=\"duration\">20 mins</span>\n                </span>\n                <span class=\"flex items-center gap-2\">\n                    <span class=\"mi -chart-line\" data-mi=\"show_chart\">show_chart</span>\n                    <span id=\"difficulty\">Intermediate</span>\n                </span>\n            </div>\n        </header>\n\n        <!-- Main Content Area -->\n        <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n            <!-- Left Sidebar - Navigation -->\n            <div class=\"lg:col-span-1\">\n                <div class=\"card rounded-2xl p-6 sticky top-24\">\n                    <h2 class=\"text-xl font-bold text-gray-900 mb-4\">Topic Outline</h2>\n                    <div class=\"space-y-1\" id=\"topicOutline\">\n                        <!-- Subtopics will be populated by JavaScript -->\n                    </div>\n                    \n                    <!-- Learning Progress -->\n                    <div class=\"mt-6 pt-6 border-t border-gray-200\">\n                        <h3 class=\"text-lg font-semibold text-gray-800 mb-3\">Your Progress</h3>\n                        <div class=\"space-y-3\">\n                            <div>\n                                <div class=\"flex justify-between text-sm text-gray-600 mb-1\">\n                                    <span>Topic Progress</span>\n                                    <span id=\"progressPercent\">0%</span>\n                                </div>\n                                <div class=\"h-2 bg-gray-200 rounded-full\">\n                                    <div class=\"h-full bg-blue-500 rounded-full\" style=\"width: 0%\" id=\"progressBar\"></div>\n                                </div>\n                            </div>\n                            <div class=\"flex justify-between text-sm\">\n                                <span class=\"text-gray-600\">\n                                    <span class=\"mi -check-circle mr-1\" data-mi=\"check_circle\">check_circle</span>\n                                    Completed Sections\n                                </span>\n                                <span class=\"text-gray-800 font-medium\" id=\"completedSections\">0/4</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Main Content -->\n            <div class=\"lg:col-span-2 space-y-6\">\n                <!-- Content Section -->\n                <div class=\"card rounded-2xl p-8\" id=\"contentSection\">\n                    <div class=\"prose max-w-none\">\n                        <!-- Content will be populated by JavaScript -->\n                    </div>\n                </div>\n\n                <!-- Key Points & Examples -->\n                <div class=\"card rounded-2xl p-8\">\n                    <h3 class=\"text-xl font-bold text-gray-900 mb-6\">Key Points &amp; Examples</h3>\n                    <div class=\"space-y-6\" id=\"keyPoints\">\n                        <!-- Key points will be populated by JavaScript -->\n                    </div>\n                </div>\n\n                <!-- Interactive Elements -->\n                <div class=\"card rounded-2xl p-8\">\n                    <div class=\"flex items-center justify-between mb-6\">\n                        <h3 class=\"text-xl font-bold text-gray-900\">Practice Questions</h3>\n                        <button class=\"px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition\">\n                            Check Answers\n                        </button>\n                    </div>\n                    <div class=\"space-y-6\" id=\"practiceQuestions\">\n                        <!-- Questions will be populated by JavaScript -->\n                    </div>\n                </div>\n\n                <!-- Resources -->\n                <div class=\"card rounded-2xl p-8\">\n                    <h3 class=\"text-xl font-bold text-gray-900 mb-6\">Learning Resources</h3>\n                    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\" id=\"resources\">\n                        <!-- Resources will be populated by JavaScript -->\n                    </div>\n                </div>\n\n                <!-- Next Steps -->\n                <div class=\"card rounded-2xl p-8 bg-gradient-to-br from-blue-50 to-white\">\n                    <h3 class=\"text-xl font-bold text-gray-900 mb-4\">Next Steps</h3>\n                    <div class=\"flex items-center justify-between\">\n                        <div class=\"flex items-center gap-4\">\n                            <button id=\"prevTopicBtn\" class=\"px-4 py-2 border border-blue-600 text-blue-600 rounded-lg hover:bg-blue-50 transition flex items-center gap-2\">\n                                <span class=\"mi -arrow-left\" data-mi=\"arrow_back\">arrow_back</span>\n                                Previous Topic\n                            </button>\n                            <button id=\"nextTopicBtn\" class=\"px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition flex items-center gap-2\">\n                                Next Topic\n                                <span class=\"mi -arrow-right\" data-mi=\"arrow_forward\">arrow_forward</span>\n                            </button>\n                        </div>\n                        <button class=\"px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition flex items-center gap-2\">\n                            <span class=\"mi -check\" data-mi=\"check\">check</span>\n                            Mark as Complete\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </main>","bodyClass":"min-h-screen bg-gradient-to-br from-blue-100 via-white to-blue-50","bodyStyle":"","css":["body {\n            font-family: 'Inter', sans-serif;\n        }\n\n        .card {\n            background: rgba(255, 255, 255, 0.9);\n            -webkit-backdrop-filter: blur(8px);\n            backdrop-filter: blur(8px);\n            border: 1px solid rgba(59, 130, 246, 0.1);\n            box-shadow: 0 4px 6px