{"slug":"/students/subjects/accounting/accounting-main/","source":"students/subjects/accounting/accounting-main.html","area":"students","kind":"division","title":"Accounting Course Overview - JUANOVA CORTEX","description":"","subject":"accounting","body":"<div class=\"container mx-auto px-4 py-8\">\n        <nav class=\"breadcrumbs mb-6\">\n            <a href=\"/students/student-dashboard/\">Dashboard</a>\n            <span class=\"mi -chevron-right text-sm\" data-mi=\"chevron_right\">chevron_right</span>\n            <span>Accounting</span>\n        </nav>\n\n        <header class=\"mb-8\">\n            <h1 class=\"text-3xl font-bold text-gray-900 mb-2\">Accounting</h1>\n            <p class=\"text-gray-600\">Comprehensive guide to accounting principles and practices</p>\n        </header>\n\n        <div class=\"divisions-grid\">\n            <!-- Fundamentals Division -->\n            <div class=\"division-card\">\n                <span class=\"mi -book-open division-icon\" data-mi=\"auto_stories\">auto_stories</span>\n                <h3 class=\"division-title\">Accounting Fundamentals</h3>\n                <p class=\"division-description\">Core concepts, principles, and foundations of accounting</p>\n                <div class=\"topic-preview\">\n                    <ul class=\"topic-list\">\n                        <li>Nature and Significance</li>\n                        <li>Basic Concepts and Conventions</li>\n                        <li>Professional Ethics</li>\n                    </ul>\n                </div>\n                <div class=\"stats-container\">\n                    <div class=\"stat\">\n                        <span class=\"mi -book\" data-mi=\"menu_book\">menu_book</span>\n                        <span>3 Topics</span>\n                    </div>\n                    <div class=\"stat\">\n                        <span class=\"mi -clock\" data-mi=\"schedule\">schedule</span>\n                        <span>4h</span>\n                    </div>\n                </div>\n                <div class=\"progress-bar\">\n                    <div class=\"progress-fill\" style=\"width: 0%\"></div>\n                </div>\n            </div>\n\n            <!-- Recording Division -->\n            <div class=\"division-card\">\n                <span class=\"mi -pen-to-square division-icon\" data-mi=\"help_outline\">help_outline</span>\n                <h3 class=\"division-title\">Recording Transactions</h3>\n                <p class=\"division-description\">Double entry, books of accounts, and documentation</p>\n                <div class=\"topic-preview\">\n                    <ul class=\"topic-list\">\n                        <li>Double Entry System</li>\n                        <li>Source Documents</li>\n                        <li>Books of Original Entry</li>\n                    </ul>\n                </div>\n                <div class=\"stats-container\">\n                    <div class=\"stat\">\n                        <span class=\"mi -book\" data-mi=\"menu_book\">menu_book</span>\n                        <span>3 Topics</span>\n                    </div>\n                    <div class=\"stat\">\n                        <span class=\"mi -clock\" data-mi=\"schedule\">schedule</span>\n                        <span>5h</span>\n                    </div>\n                </div>\n                <div class=\"progress-bar\">\n                    <div class=\"progress-fill\" style=\"width: 0%\"></div>\n                </div>\n            </div>\n\n            <!-- Cash and Banking -->\n            <div class=\"division-card\">\n                <span class=\"mi -money-bill-wave division-icon\" data-mi=\"payments\">payments</span>\n                <h3 class=\"division-title\">Cash and Banking</h3>\n                <p class=\"division-description\">Cash management and banking transactions</p>\n                <div class=\"topic-preview\">\n                    <ul class=\"topic-list\">\n                        <li>Cashbook and Petty Cash</li>\n                        <li>Bank Reconciliation</li>\n                        <li>E-banking Systems</li>\n                    </ul>\n                </div>\n                <div class=\"stats-container\">\n                    <div class=\"stat\">\n                        <span class=\"mi -book\" data-mi=\"menu_book\">menu_book</span>\n                        <span>3 Topics</span>\n                    </div>\n                    <div class=\"stat\">\n                        <span class=\"mi -clock\" data-mi=\"schedule\">schedule</span>\n                        <span>3h</span>\n                    </div>\n                </div>\n                <div class=\"progress-bar\">\n                    <div class=\"progress-fill\" style=\"width: 0%\"></div>\n                </div>\n            </div>\n\n            <!-- Financial Statements -->\n            <div class=\"division-card\">\n                <span class=\"mi -file-invoice-dollar division-icon\" data-mi=\"help_outline\">help_outline</span>\n                <h3 class=\"division-title\">Financial Statements</h3>\n                <p class=\"division-description\">Preparation and analysis of financial reports</p>\n                <div class=\"topic-preview\">\n                    <ul class=\"topic-list\">\n                        <li>Trading and Profit &amp; Loss</li>\n                        <li>Balance Sheet</li>\n                        <li>Adjustments and Provisions</li>\n                    </ul>\n                </div>\n                <div class=\"stats-container\">\n                    <div class=\"stat\">\n                        <span class=\"mi -book\" data-mi=\"menu_book\">menu_book</span>\n                        <span>3 Topics</span>\n                    </div>\n                    <div class=\"stat\">\n                        <span class=\"mi -clock\" data-mi=\"schedule\">schedule</span>\n                        <span>6h</span>\n                    </div>\n                </div>\n                <div class=\"progress-bar\">\n                    <div class=\"progress-fill\" style=\"width: 0%\"></div>\n                </div>\n            </div>\n\n            <!-- Special Accounts -->\n            <div class=\"division-card\">\n                <span class=\"mi -building division-icon\" data-mi=\"business\">business</span>\n                <h3 class=\"division-title\">Special Accounts</h3>\n                <p class=\"division-description\">Specialized accounting for different organizations</p>\n                <div class=\"topic-preview\">\n                    <ul class=\"topic-list\">\n                        <li>Manufacturing Accounts</li>\n                        <li>Non-Profit Organizations</li>\n                        <li>Departmental Accounts</li>\n                    </ul>\n                </div>\n                <div class=\"stats-container\">\n                    <div class=\"stat\">\n                        <span class=\"mi -book\" data-mi=\"menu_book\">menu_book</span>\n                        <span>3 Topics</span>\n                    </div>\n                    <div class=\"stat\">\n                        <span class=\"mi -clock\" data-mi=\"schedule\">schedule</span>\n                        <span>5h</span>\n                    </div>\n                </div>\n                <div class=\"progress-bar\">\n                    <div class=\"progress-fill\" style=\"width: 0%\"></div>\n                </div>\n            </div>\n\n            <!-- Business Accounting -->\n            <div class=\"division-card\">\n                <span class=\"mi -handshake division-icon\" data-mi=\"handshake\">handshake</span>\n                <h3 class=\"division-title\">Business Accounting</h3>\n                <p class=\"division-description\">Partnership and company accounts</p>\n                <div class=\"topic-preview\">\n                    <ul class=\"topic-list\">\n                        <li>Partnership Accounts</li>\n                        <li>Company Formation</li>\n                        <li>Public Sector Accounting</li>\n                    </ul>\n                </div>\n                <div class=\"stats-container\">\n                    <div class=\"stat\">\n                        <span class=\"mi -book\" data-mi=\"menu_book\">menu_book</span>\n                        <span>3 Topics</span>\n                    </div>\n                    <div class=\"stat\">\n                        <span class=\"mi -clock\" data-mi=\"schedule\">schedule</span>\n                        <span>7h</span>\n                    </div>\n                </div>\n                <div class=\"progress-bar\">\n                    <div class=\"progress-fill\" style=\"width: 0%\"></div>\n                </div>\n            </div>\n\n            <!-- Advanced Topics -->\n            <div class=\"division-card\">\n                <span class=\"mi -chart-line division-icon\" data-mi=\"show_chart\">show_chart</span>\n                <h3 class=\"division-title\">Advanced Topics</h3>\n                <p class=\"division-description\">Complex accounting scenarios and analysis</p>\n                <div class=\"topic-preview\">\n                    <ul class=\"topic-list\">\n                        <li>Stock Valuation Methods</li>\n                        <li>Control Accounts</li>\n                        <li>Incomplete Records</li>\n                    </ul>\n                </div>\n                <div class=\"stats-container\">\n                    <div class=\"stat\">\n                        <span class=\"mi -book\" data-mi=\"menu_book\">menu_book</span>\n                        <span>3 Topics</span>\n                    </div>\n                    <div class=\"stat\">\n                        <span class=\"mi -clock\" data-mi=\"schedule\">schedule</span>\n                        <span>6h</span>\n                    </div>\n                </div>\n                <div class=\"progress-bar\">\n                    <div class=\"progress-fill\" style=\"width: 0%\"></div>\n                </div>\n            </div>\n\n            <!-- Study Resources -->\n            <div class=\"division-card bg-gradient-to-br from-blue-50 to-purple-50\">\n                <span class=\"mi -lightbulb division-icon text-yellow-500\" data-mi=\"lightbulb\">lightbulb</span>\n                <h3 class=\"division-title\">Study Resources</h3>\n                <p class=\"division-description\">Tools and resources to enhance your learning</p>\n                <div class=\"flex flex-col gap-2 mt-4\">\n                    <button class=\"text-sm px-4 py-2 bg-white rounded-lg hover:bg-blue-50 transition flex items-center gap-2 border border-gray-200\">\n                        <span class=\"mi -calculator text-blue-600\" data-mi=\"calculate\">calculate</span>\n                        <span>Financial Calculator</span>\n                    </button>\n                    <button class=\"text-sm px-4 py-2 bg-white rounded-lg hover:bg-blue-50 transition flex items-center gap-2 border border-gray-200\">\n                        <span class=\"mi -sticky-note text-yellow-500\" data-mi=\"sticky_note_2\">sticky_note_2</span>\n                        <span>Smart Notes</span>\n                    </button>\n                    <button class=\"text-sm px-4 py-2 bg-white rounded-lg hover:bg-blue-50 transition flex items-center gap-2 border border-gray-200\">\n                        <span class=\"mi -cards-blank text-green-500\" data-mi=\"help_outline\">help_outline</span>\n                        <span>Flashcards</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n\n        <!-- Tips Section -->\n        <div class=\"mt-12 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-8\">\n            <h2 class=\"text-xl font-bold text-gray-800 mb-4\">Study Tips</h2>\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"mi -check-circle text-green-500 mt-1\" data-mi=\"check_circle\">check_circle</span>\n                    <p class=\"text-gray-600\">Master fundamentals before advancing to complex topics</p>\n                </div>\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"mi -check-circle text-green-500 mt-1\" data-mi=\"check_circle\">check_circle</span>\n                    <p class=\"text-gray-600\">Practice double entry exercises daily</p>\n                </div>\n                <div class=\"flex items-start gap-3\">\n                    <span class=\"mi -check-circle text-green-500 mt-1\" data-mi=\"check_circle\">check_circle</span>\n                    <p class=\"text-gray-600\">Use the financial calculator for complex calculations</p>\n                </div>\n            </div>\n        </div>\n    </div>","bodyClass":"bg-gray-50","bodyStyle":"","css":["/* Your existing styles plus improvements */\n        .divisions-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: 1.5rem;\n            margin-top: 2rem;\n        }\n\n        .division-card {\n            background: white;\n            border-radius: 1rem;\n            padding: 1.5rem;\n            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\n            transition: all 0.3s ease;\n            cursor: pointer;\n            display: flex;\n            flex-direction: column;\n            height: 100%;\n        }\n\n        .division-card:hover {\n            transform: translateY(-4px);\n            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);\n        }\n\n        .division-icon {\n            font-size: 2rem;\n            margin-bottom: 1rem;\n            color: var(--accent-blue);\n        }\n\n        .division-title {\n            font-size: 1.25rem;\n            font-weight: 600;\n            color: #1F2937;\n            margin-bottom: 0.5rem;\n        }\n\n        .division-description {\n            color: #6B7280;\n            font-size: 0.875rem;\n            line-height: 1.25rem;\n            margin-bottom: 1rem;\n        }\n\n        .topic-preview {\n            margin-top: auto;\n            padding-top: 1rem;\n            border-top: 1px solid #E5E7EB;\n        }\n\n        .topic-list {\n            list-style: none;\n            padding: 0;\n            margin: 0;\n            font-size: 0.875rem;\n            color: #4B5563;\n        }\n\n        .topic-list li {\n            margin-bottom: 0.5rem;\n            display: flex;\n            align-items: center;\n        }\n\n        .topic-list li:before {\n            content: \"•\";\n            color: var(--accent-blue);\n            font-weight: bold;\n            margin-right: 0.5rem;\n        }\n\n        .stats-container {\n            display: flex;\n            gap: 1rem;\n            margin-top: 1rem;\n            font-size: 0.875rem;\n            color: #6B7280;\n        }\n\n        .stat {\n            display: flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .progress-bar {\n            background: #E5E7EB;\n            height: 4px;\n            border-radius: 2px;\n            overflow: hidden;\n            margin-top: 0.5rem;\n        }\n\n        .progress-fill {\n            height: 100%;\n            background: var(--accent-blue);\n            width: 0%;\n            transition: width 0.3s ease;\n        }"],"quiz":null,"tracker":null,"links":[]}