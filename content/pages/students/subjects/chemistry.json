{"slug":"/students/subjects/chemistry/","source":"students/subjects/chemistry/index.html","area":"students","kind":"subject-home","title":"Chemistry | Subject Overview","description":"","subject":"chemistry","body":"<!-- Unified Navigation -->\n  <nav class=\"bg-white/90 backdrop-blur border-b border-slate-200 sticky top-0 z-50\">\n    <div class=\"max-w-6xl mx-auto px-2 sm:px-4 lg:px-8\">\n      <!-- Mobile Layout -->\n      <div class=\"flex flex-col sm:hidden py-2\">\n        <!-- Top row: Dashboard and All Subjects -->\n        <div class=\"flex justify-between items-center gap-2 mb-2\">\n          <a href=\"/students/student-dashboard/\" class=\"inline-flex items-center px-2 py-1.5 border border-slate-200 rounded-lg text-xs font-medium text-slate-700 bg-white hover:bg-slate-50 transition-colors\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\" class=\"w-4 h-4 mr-1\">\n              <path fill-rule=\"evenodd\" d=\"M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z\" clip-rule=\"evenodd\"></path>\n            </svg>\n            Dashboard\n          </a>\n          <a href=\"/students/subjects/\" class=\"inline-flex items-center px-2 py-1.5 border border-slate-200 rounded-lg text-xs font-medium text-slate-700 bg-white hover:bg-slate-50 transition-colors\">\n            All Subjects\n          </a>\n        </div>\n        <!-- Bottom row: Current Subject centered -->\n        <div class=\"flex justify-center\">\n          <div class=\"flex items-center px-3 py-1.5 rounded-lg bg-blue-50 text-blue-700\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\" class=\"w-4 h-4 mr-1.5\">\n              <path fill-rule=\"evenodd\" d=\"M10 2c.12 0 .24.028.345.083L17.5 5.5a.75.75 0 010 1.32l-7.155 3.417a.75.75 0 01-.69 0L2.5 6.82a.75.75 0 010-1.32l7.155-3.417A.75.75 0 0110 2z\" clip-rule=\"evenodd\"></path>\n              <path fill-rule=\"evenodd\" d=\"M10.5 6.94L17 3.78v7.44a.75.75 0 01-.415.672L10 15.314V6.94zM3.415 11.892A.75.75 0 013 11.22V3.78l6.5 3.16v8.374l-6.085-3.422z\" clip-rule=\"evenodd\"></path>\n            </svg>\n            <span class=\"text-sm font-medium\">Chemistry</span>\n          </div>\n        </div>\n      </div>\n      \n      <!-- Desktop/Tablet Layout -->\n      <div class=\"hidden sm:flex justify-between h-16\">\n        <!-- Left side - Back to Dashboard -->\n        <div class=\"flex items-center\">\n          <a href=\"/students/student-dashboard/\" class=\"inline-flex items-center px-3 py-2 border border-slate-200 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition-colors\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\" class=\"w-5 h-5 mr-2\">\n              <path fill-rule=\"evenodd\" d=\"M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z\" clip-rule=\"evenodd\"></path>\n            </svg>\n            Dashboard\n          </a>\n        </div>\n\n        <!-- Center - Current Subject -->\n        <div class=\"flex items-center\">\n          <div class=\"flex items-center px-3 py-2 rounded-lg bg-blue-50 text-blue-700\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\" class=\"w-5 h-5 mr-2\">\n              <path fill-rule=\"evenodd\" d=\"M10 2c.12 0 .24.028.345.083L17.5 5.5a.75.75 0 010 1.32l-7.155 3.417a.75.75 0 01-.69 0L2.5 6.82a.75.75 0 010-1.32l7.155-3.417A.75.75 0 0110 2z\" clip-rule=\"evenodd\"></path>\n              <path fill-rule=\"evenodd\" d=\"M10.5 6.94L17 3.78v7.44a.75.75 0 01-.415.672L10 15.314V6.94zM3.415 11.892A.75.75 0 013 11.22V3.78l6.5 3.16v8.374l-6.085-3.422z\" clip-rule=\"evenodd\"></path>\n            </svg>\n            Chemistry\n          </div>\n        </div>\n\n        <!-- Right side - Quick Actions -->\n        <div class=\"flex items-center space-x-4\">\n          <a href=\"/students/subjects/\" class=\"inline-flex items-center px-3 py-2 border border-slate-200 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition-colors\">\n            All Subjects\n          </a>\n        </div>\n      </div>\n    </div>\n  </nav>\n\n  <div class=\"max-w-6xl mx-auto px-2 sm:px-6 lg:px-8 py-4 sm:py-8\">\n    <header class=\"mb-6 sm:mb-8 md:mb-12 text-center\">\n      <h1 class=\"text-2xl sm:text-3xl md:text-4xl font-bold text-gray-800 mb-2 sm:mb-4\">Chemistry</h1>\n      <p class=\"text-sm sm:text-base md:text-lg text-gray-600 px-2\">Structured learning order — start with Foundations of Chemistry.</p>\n    </header>\n\n    <div class=\"grid grid-cols-2 lg:grid-cols-3 gap-2 sm:gap-4 md:gap-6\">\n      <div class=\"division-card p-2.5 sm:p-5 md:p-6 rounded-lg sm:rounded-xl\">\n        <h2 class=\"text-sm sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2 leading-tight\"><a href=\"/students/subjects/chemistry/foundations/\" class=\"hover:text-blue-600\">1. Foundations of Chemistry</a></h2>\n        <p class=\"text-gray-700 text-[11px] sm:text-sm hidden sm:block\">Basic atomic theory, mole concept and simple chemical calculations.</p>\n      </div>\n\n      <div class=\"division-card p-2.5 sm:p-5 md:p-6 rounded-lg sm:rounded-xl\">\n        <h2 class=\"text-sm sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2 leading-tight\"><a href=\"/students/subjects/chemistry/states-of-matter/\" class=\"hover:text-blue-600\">2. States of Matter &amp; Gas Laws</a></h2>\n        <p class=\"text-gray-700 text-[11px] sm:text-sm hidden sm:block\">Solids, liquids, gases and the laws governing gas behaviour.</p>\n      </div>\n\n      <div class=\"division-card p-2.5 sm:p-5 md:p-6 rounded-lg sm:rounded-xl\">\n        <h2 class=\"text-sm sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2 leading-tight\"><a href=\"/students/subjects/chemistry/periodicity-bonding/\" class=\"hover:text-blue-600\">3. Periodicity &amp; Bonding</a></h2>\n        <p class=\"text-gray-700 text-[11px] sm:text-sm hidden sm:block\">Periodic trends and different bonding types.</p>\n      </div>\n\n      <div class=\"division-card p-2.5 sm:p-5 md:p-6 rounded-lg sm:rounded-xl\">\n        <h2 class=\"text-sm sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2 leading-tight\"><a href=\"/students/subjects/chemistry/stoichiometry-energetics/\" class=\"hover:text-blue-600\">4. Chemical Calculations &amp; Stoichiometry</a></h2>\n        <p class=\"text-gray-700 text-[11px] sm:text-sm hidden sm:block\">Mole calculations, balancing equations and stoichiometry.</p>\n      </div>\n\n      <div class=\"division-card p-2.5 sm:p-5 md:p-6 rounded-lg sm:rounded-xl\">\n        <h2 class=\"text-sm sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2 leading-tight\"><a href=\"/students/subjects/chemistry/acids-bases/\" class=\"hover:text-blue-600\">5. Acids, Bases, Salts &amp; Redox</a></h2>\n        <p class=\"text-gray-700 text-[11px] sm:text-sm hidden sm:block\">Acids and bases, titrations, buffers and basic redox concepts.</p>\n      </div>\n\n      <div class=\"division-card p-2.5 sm:p-5 md:p-6 rounded-lg sm:rounded-xl\">\n        <h2 class=\"text-sm sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2 leading-tight\"><a href=\"/students/subjects/chemistry/electrochemistry-redox/\" class=\"hover:text-blue-600\">6. Electrochemistry</a></h2>\n        <p class=\"text-gray-700 text-[11px] sm:text-sm hidden sm:block\">Electrolysis, cells and electrode potentials.</p>\n      </div>\n\n      <div class=\"division-card p-2.5 sm:p-5 md:p-6 rounded-lg sm:rounded-xl\">\n        <h2 class=\"text-sm sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2 leading-tight\"><a href=\"/students/subjects/chemistry/equilibria-kinetics/\" class=\"hover:text-blue-600\">7. Energy, Rates &amp; Equilibria</a></h2>\n        <p class=\"text-gray-700 text-[11px] sm:text-sm hidden sm:block\">Thermochemistry, kinetics and chemical equilibrium.</p>\n      </div>\n\n      <div class=\"division-card p-2.5 sm:p-5 md:p-6 rounded-lg sm:rounded-xl\">\n        <h2 class=\"text-sm sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2 leading-tight\"><a href=\"/students/subjects/chemistry/analytical-methods/\" class=\"hover:text-blue-600\">8. Inorganic &amp; Analytical Chemistry</a></h2>\n        <p class=\"text-gray-700 text-[11px] sm:text-sm hidden sm:block\">Element families, extraction, and analytical techniques.</p>\n      </div>\n\n      <div class=\"division-card p-2.5 sm:p-5 md:p-6 rounded-lg sm:rounded-xl\">\n        <h2 class=\"text-sm sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2 leading-tight\"><a href=\"/students/subjects/chemistry/organic-fundamentals/\" class=\"hover:text-blue-600\">9. Organic Chemistry</a></h2>\n        <p class=\"text-gray-700 text-[11px] sm:text-sm hidden sm:block\">Hydrocarbons, functional groups and biomolecules.</p>\n      </div>\n\n      <div class=\"division-card p-2.5 sm:p-5 md:p-6 rounded-lg sm:rounded-xl\">\n        <h2 class=\"text-sm sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2 leading-tight\"><a href=\"/students/subjects/chemistry/environmental-green/\" class=\"hover:text-blue-600\">10. Applied Chemistry &amp; Environment</a></h2>\n        <p class=\"text-gray-700 text-[11px] sm:text-sm hidden sm:block\">Industrial processes, pollution and sustainability.</p>\n      </div>\n\n      <div class=\"division-card p-2.5 sm:p-5 md:p-6 rounded-lg sm:rounded-xl\">\n        <h2 class=\"text-sm sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2 leading-tight\"><a href=\"/students/subjects/chemistry/nuclear-chemistry/\" class=\"hover:text-blue-600\">11. Nuclear Chemistry</a></h2>\n        <p class=\"text-gray-700 text-[11px] sm:text-sm hidden sm:block\">Radioactivity, nuclear reactions and applications.</p>\n      </div>\n\n      <div class=\"division-card p-2.5 sm:p-5 md:p-6 rounded-lg sm:rounded-xl\">\n        <h2 class=\"text-sm sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2 leading-tight\"><a href=\"/students/subjects/chemistry/Praticals/\" class=\"hover:text-blue-600\">12. Chemistry Practicals</a></h2>\n        <p class=\"text-gray-700 text-[11px] sm:text-sm hidden sm:block\">General Skills, Quantitative Analysis, Qualitative Analysis.</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- PhET attribution modal -->\n  <div id=\"phet-attribution-modal\" class=\"phet-modal\" role=\"dialog\" aria-hidden=\"true\" aria-labelledby=\"phet-title\">\n    <div class=\"panel\">\n      <h3 id=\"phet-title\" style=\"margin:0 0 .5rem; font-size:1.1rem;\">Simulation attribution</h3>\n      <div style=\"color:#0f172a;font-size:0.95rem;line-height:1.35;\">\n        This site may include interactive simulations provided by <strong>PhET Interactive Simulations</strong> (University of Colorado Boulder). \n        Simulation content is provided by PhET and is available under a <a href=\"https://creativecommons.org/licenses/by/4.0/\" target=\"_blank\" rel=\"noopener\">CC‑BY‑4.0</a> license. \n        Visit <a href=\"https://phet.colorado.edu\" target=\"_blank\" rel=\"noopener\">phet.colorado.edu</a> for details.\n      </div>\n      <div class=\"modal-footer\">\n        <label class=\"dontshow-label\">\n          <input id=\"phet-attribution-dontshow\" type=\"checkbox\">\n          <span>Don't show again</span>\n        </label>\n        <div class=\"modal-buttons\">\n          <button id=\"phet-attribution-close\" class=\"btn-ghost\">Close</button>\n          <button id=\"phet-attribution-ok\" class=\"btn-primary\">OK</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <style>\n    .phet-modal{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(2,6,23,0.45);z-index:1200;opacity:0;pointer-events:none;transition:opacity 180ms ease}\n    .phet-modal.show{opacity:1;pointer-events:auto}\n    .phet-modal .panel{background:#fff;padding:1rem;border-radius:10px;max-width:560px;width:calc(100% - 32px);box-shadow:0 12px 40px rgba(2,6,23,0.14);margin:16px}\n    .modal-footer{margin-top:.75rem; display:flex; flex-direction:column; gap:.75rem;}\n    .dontshow-label{font-size:0.85rem;color:#6b7280;display:flex;align-items:center;gap:.5rem;}\n    .modal-buttons{display:flex;gap:.5rem;justify-content:flex-end;}\n    .btn-ghost{background:#f3f4f6;border-radius:6px;padding:.45rem .7rem;border:1px solid #e5e7eb;}\n    .btn-primary{background:#0ea5a4;color:#fff;border-radius:6px;padding:.45rem .7rem;border:none;}\n    \n    @media (min-width: 480px) {\n      .modal-footer{flex-direction:row;align-items:center;justify-content:space-between;}\n    }\n  </style>","bodyClass":"min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 p-3 sm:p-4 md:p-6","bodyStyle":"","css":["body{font-family:Inter, sans-serif}.division-card{ -webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);background:rgba(255,255,255,0.75);border:1px solid rgba(255,255,255,0.2);box-shadow:0 8px 32px rgba(0,0,0,0.06);}",".phet-modal{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(2,6,23,0.45);z-index:1200;opacity:0;pointer-events:none;transition:opacity 180ms ease}\n    .phet-modal.show{opacity:1;pointer-events:auto}\n    .phet-modal .panel{background:#fff;padding:1rem;border-radius:10px;max-width:560px;width:calc(100% - 32px);box-shadow:0 12px 40px rgba(2,6,23,0.14);margin:16px}\n    .modal-footer{margin-top:.75rem; display:flex; flex-direction:column; gap:.75rem;}\n    .dontshow-label{font-size:0.85rem;color:#6b7280;display:flex;align-items:center;gap:.5rem;}\n    .modal-buttons{display:flex;gap:.5rem;justify-content:flex-end;}\n    .btn-ghost{background:#f3f4f6;border-radius:6px;padding:.45rem .7rem;border:1px solid #e5e7eb;}\n    .btn-primary{background:#0ea5a4;color:#fff;border-radius:6px;padding:.45rem .7rem;border:none;}\n    \n    @media (min-width: 480px) {\n      .modal-footer{flex-direction:row;align-items:center;justify-content:space-between;}\n    }"],"quiz":null,"tracker":null,"links":[]}