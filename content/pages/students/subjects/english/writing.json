{"slug":"/students/subjects/english/writing/","source":"students/subjects/english/writing/index.html","area":"students","kind":"division","title":"Writing","description":"","subject":"english","body":"<div class=\"max-w-5xl mx-auto\">\n    <nav class=\"mb-6\"><a href=\"/students/subjects/english/\" class=\"text-blue-600\">← Back to English</a></nav>\n    <h1 class=\"text-3xl font-bold mb-2\">Writing</h1>\n    <p class=\"text-gray-600 mb-4\">The writing process, sentence &amp; paragraph structure, essays and letters.</p>\n\n    <section class=\"space-y-4\">\n      <div class=\"card p-4 rounded-lg\"><h3 class=\"font-semibold\"><a href=\"/students/subjects/english/writing/writing-process/\" class=\"hover:text-blue-600\">Writing Process</a></h3><p class=\"text-sm text-gray-700\">Planning, drafting, revising and editing.</p></div>\n      <div class=\"card p-4 rounded-lg\"><h3 class=\"font-semibold\"><a href=\"/students/subjects/english/writing/paragraph-structure/\" class=\"hover:text-blue-600\">Paragraph Structure</a></h3><p class=\"text-sm text-gray-700\">Topic sentences, supporting details, cohesion and transitions.</p></div>\n      <div class=\"card p-4 rounded-lg\"><h3 class=\"font-semibold\"><a href=\"/students/subjects/english/writing/summary-precis/\" class=\"hover:text-blue-600\">Summary &amp; Précis</a></h3><p class=\"text-sm text-gray-700\">Concise summary writing and formal précis techniques.</p></div>\n      <div class=\"card p-4 rounded-lg\"><h3 class=\"font-semibold\"><a href=\"/students/subjects/english/writing/essay-types/\" class=\"hover:text-blue-600\">Essay Writing</a></h3><p class=\"text-sm text-gray-700\">Descriptive, narrative, argumentative and expository essays.</p></div>\n      <div class=\"card p-4 rounded-lg\"><h3 class=\"font-semibold\"><a href=\"/students/subjects/english/writing/letter-writing/\" class=\"hover:text-blue-600\">Formal &amp; Informal Letters</a></h3><p class=\"text-sm text-gray-700\">Structure, tone and templates for exams.</p></div>\n      <div class=\"card p-4 rounded-lg\"><h3 class=\"font-semibold\"><a href=\"/students/subjects/english/writing/advanced-sentence-building/\" class=\"hover:text-blue-600\">Advanced Sentence Building</a></h3><p class=\"text-sm text-gray-700\">Advanced cohesion, transitions and sentence variety.</p></div>\n    </section>\n  </div>","bodyClass":"min-h-screen bg-gradient-to-br from-yellow-50 to-orange-100 p-6","bodyStyle":"","css":["body{font-family:Inter, sans-serif}.card{ -webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);background:rgba(255,255,255,0.82);border:1px solid rgba(255,255,255,0.18);box-shadow:0 6px 24px rgba(0,0,0,0.05);}"],"quiz":null,"tracker":null,"links":[]}