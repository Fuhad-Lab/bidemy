{"slug":"/students/subjects/english/foundations/","source":"students/subjects/english/foundations/index.html","area":"students","kind":"division","title":"English — Foundations","description":"","subject":"english","body":"<div class=\"max-w-4xl mx-auto\">\n    <nav class=\"mb-6\"><a href=\"/students/subjects/english/\" class=\"text-blue-600\">← Back to English</a></nav>\n    <header class=\"mb-6\">\n      <h1 class=\"text-3xl font-bold\">Foundations</h1>\n      <p class=\"text-gray-600\">Basic building blocks: sentences, morphemes, word classes, phrases and clauses.</p>\n    </header>\n\n    <section class=\"grid md:grid-cols-2 gap-4\">\n      <article class=\"card p-5 rounded-lg\">\n        <h3 class=\"text-lg font-semibold mb-2\"><a href=\"/students/subjects/english/foundations/sentence-structure/\" class=\"hover:text-blue-600\">The concept of a Sentence</a></h3>\n        <p class=\"text-sm text-gray-700\">What constitutes a sentence and its communicative function.</p>\n      </article>\n\n      <article class=\"card p-5 rounded-lg\">\n        <h3 class=\"text-lg font-semibold mb-2\"><a href=\"/students/subjects/english/foundations/sentence-elements/\" class=\"hover:text-blue-600\">Elements of Sentence Structure</a></h3>\n        <p class=\"text-sm text-gray-700\">Subject, predicate, objects, complements and modifiers.</p>\n      </article>\n\n      <article class=\"card p-5 rounded-lg\">\n        <h3 class=\"text-lg font-semibold mb-2\"><a href=\"/students/subjects/english/foundations/morphemes-words/\" class=\"hover:text-blue-600\">Morphemes &amp; Words</a></h3>\n        <p class=\"text-sm text-gray-700\">Roots, prefixes, suffixes and word-formation basics.</p>\n      </article>\n\n      <article class=\"card p-5 rounded-lg\">\n        <h3 class=\"text-lg font-semibold mb-2\"><a href=\"/students/subjects/english/foundations/word-classes/\" class=\"hover:text-blue-600\">Word Classes</a></h3>\n        <p class=\"text-sm text-gray-700\">Nouns, verbs, adjectives, adverbs, pronouns, determiners, prepositions, conjunctions and interjections.</p>\n      </article>\n\n      <article class=\"card p-5 rounded-lg\">\n        <h3 class=\"text-lg font-semibold mb-2\"><a href=\"/students/subjects/english/foundations/phrases-clauses/\" class=\"hover:text-blue-600\">Phrases &amp; Clauses</a></h3>\n        <p class=\"text-sm text-gray-700\">Noun phrase, verb phrase, prepositional phrase; independent/dependent clauses (relative, adverbial, noun).</p>\n      </article>\n    </section>\n  </div>\n\n\n  \n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600&amp;display=swap\" rel=\"stylesheet\">\n  <style> body{font-family:Inter, sans-serif}.card{-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);background:rgba(255,255,255,0.8);border:1px solid rgba(255,255,255,0.3);}</style>\n\n\n  <div class=\"max-w-4xl mx-auto\">\n    <nav class=\"mb-6\"><a href=\"/students/subjects/english/\" class=\"text-blue-600\">← Back to English</a></nav>\n    <h1 class=\"text-3xl font-bold mb-4\">Foundations: Building Blocks</h1>\n    <p class=\"text-gray-700 mb-6\">Core building blocks: sentence concepts, morphemes, word classes, phrases and clauses.</p>\n\n    <div class=\"space-y-4\">\n      <article class=\"card p-5 rounded-lg\">\n        <h2 class=\"text-xl font-semibold\"><a href=\"/students/subjects/english/foundations/\" class=\"hover:text-blue-600\">Sentence Concepts</a></h2>\n        <p class=\"text-sm text-gray-700\">Basic sentence structures and simple vs compound sentences.</p>\n      </article>\n\n      <article class=\"card p-5 rounded-lg\">\n        <h2 class=\"text-xl font-semibold\"><a href=\"/students/subjects/english/foundations/word-classes/\" class=\"hover:text-blue-600\">Word Classes &amp; Morphemes</a></h2>\n        <p class=\"text-sm text-gray-700\">Nouns, verbs, adjectives, adverbs and word formation basics.</p>\n      </article>\n    </div>\n  </div>","bodyClass":"min-h-screen bg-gradient-to-br from-yellow-50 to-orange-100 p-6","bodyStyle":"","css":["body{font-family:Inter, sans-serif}.card{ -webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);background:rgba(255,255,255,0.78);border:1px solid rgba(255,255,255,0.2);box-shadow:0 6px 24px rgba(0,0,0,0.05);}","body{font-family:Inter, sans-serif}.card{-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);background:rgba(255,255,255,0.8);border:1px solid rgba(255,255,255,0.3);}"],"quiz":null,"tracker":null,"links":[]}