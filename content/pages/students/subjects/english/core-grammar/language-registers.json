{"slug":"/students/subjects/english/core-grammar/language-registers/","source":"students/subjects/english/core-grammar/language-registers.html","area":"students","kind":"content","title":"Language Registers — Core Grammar","description":"","subject":"english","body":"<div class=\"max-w-3xl mx-auto\">\n    <nav class=\"mb-4\"><a href=\"/students/subjects/english/core-grammar/\" class=\"text-blue-600\">← Back to Core Grammar</a></nav>\n    <article class=\"card p-6 rounded-lg\">\n      <h1 class=\"text-2xl font-bold mb-2\">Language Registers</h1>\n      <p class=\"text-gray-700 mb-4\">Distinguish formal, informal, academic and colloquial styles and when to use each.</p>\n\n      <h2 class=\"font-semibold\">Worked example</h2>\n      <p class=\"mb-2\">Rewrite informally: \"I regret to inform you that I cannot attend.\"</p>\n      <p class=\"mb-4\"><strong>Solution:</strong> \"Sorry, I can't make it.\"</p>\n\n      <h3 class=\"font-semibold\">Practice</h3>\n      <ol class=\"list-decimal pl-5 mb-4 text-gray-700\">\n        <li>Convert a sentence to formal tone.</li>\n        <li>Identify register in a short paragraph.</li>\n      </ol>\n\n      <h4 class=\"font-semibold\">Brief answers</h4>\n      <ol class=\"list-decimal pl-5 text-gray-700\">\n        <li>Example formal rewrite: \"I regret that I am unable to attend.\"</li>\n        <li>Answers will vary by paragraph.</li>\n      </ol>\n    </article>\n  </div>\n<!-- Topic Quiz System -->","bodyClass":"min-h-screen bg-gradient-to-br from-yellow-50 to-orange-100 p-6","bodyStyle":"","css":["body{font-family:Inter, sans-serif}.card{ -webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);background:rgba(255,255,255,0.85);border:1px solid rgba(255,255,255,0.18);}"],"quiz":null,"tracker":null,"links":[]}