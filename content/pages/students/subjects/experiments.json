             <a href=\"/students/subjects/\" class=\"bg-white bg-opacity-20 border border-white/30 text-white px-4 py-2 rounded hover:bg-white hover:bg-opacity-30 transition-colors\">Open Pendulum Demo</a>\n              </div>\n            </div>\n          </div>\n\n          <!-- Search bar -->\n          <div class=\"mt-6 mb-4\">\n            <input id=\"expSearch\" type=\"search\" placeholder=\"Search experiments...\" class=\"w-full max-w-md mx-auto block border rounded-lg p-3 shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500\">\n          </div>\n\n          <div id=\"cardsGrid\" class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-6\"></div>\n        </section>\n\n        <style>\n          @keyframes fadeIn {\n            from { opacity: 0; transform: translateY(10px); }\n            to { opacity: 1; transform: translateY(0); }\n          }\n          .animate-fade-in {\n            opacity: 0;\n            animation: fadeIn 0.6s ease-out forwards;\n          }\n          .delay-100 { animation-delay: 100ms; }\n          .delay-200 { animation-delay: 200ms; }\n        </style>\n      </div>\n    </div>","bodyClass":"bg-slate-50 min-h-screen text-slate-800","bodyStyle":"","css":["@keyframes fadeIn {\n            from { opacity: 0; transform: translateY(10px); }\n            to { opacity: 1; transform: translateY(0); }\n          }\n          .animate-fade-in {\n            opacity: 0;\n            animation: fadeIn 0.6s ease-out forwards;\n          }\n          .delay-100 { animation-delay: 100ms; }\n          .delay-200 { animation-delay: 200ms; }"],"quiz":null,"tracker":null,"links":["#cardsGrid"]}