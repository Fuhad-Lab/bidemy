{"slug":"/students/subjects/physics/","source":"students/subjects/physics/index.html","area":"students","kind":"subject-home","title":"Physics | Subject Overview","description":"","subject":"physics","body":"<nav class=\"bg-white/90 backdrop-blur border-b border-slate-200 sticky top-0 z-50\">\n    <div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\">\n      <div class=\"flex justify-between h-16\">\n        <!-- Left side - Back to Dashboard -->\n        <div class=\"flex items-center\">\n          <a href=\"/students/student-dashboard/\" class=\"inline-flex items-center px-3 py-2 border border-slate-200 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition-colors\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\" class=\"w-5 h-5 mr-2\">\n              <path fill-rule=\"evenodd\" d=\"M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z\" clip-rule=\"evenodd\"></path>\n            </svg>\n            Dashboard\n          </a>\n        </div>\n\n        <!-- Center - Current Subject -->\n        <div class=\"flex items-center\">\n          <div class=\"flex items-center px-3 py-2 rounded-lg bg-blue-50 text-blue-700\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\" class=\"w-5 h-5 mr-2\">\n              <path fill-rule=\"evenodd\" d=\"M10 2c.12 0 .24.028.345.083L17.5 5.5a.75.75 0 010 1.32l-7.155 3.417a.75.75 0 01-.69 0L2.5 6.82a.75.75 0 010-1.32l7.155-3.417A.75.75 0 0110 2z\" clip-rule=\"evenodd\"></path>\n              <path fill-rule=\"evenodd\" d=\"M10.5 6.94L17 3.78v7.44a.75.75 0 01-.415.672L10 15.314V6.94zM3.415 11.892A.75.75 0 013 11.22V3.78l6.5 3.16v8.374l-6.085-3.422z\" clip-rule=\"evenodd\"></path>\n            </svg>\n            Physics\n          </div>\n        </div>\n\n        <!-- Right side - Quick Actions -->\n        <div class=\"flex items-center space-x-4\">\n          <a href=\"/students/subjects/\" class=\"inline-flex items-center px-3 py-2 border border-slate-200 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition-colors\">\n            All Subjects\n          </a>\n        </div>\n      </div>\n    </div>\n  </nav>\n\n        \n        <header class=\"mb-12 text-center\">\n            <h1 class=\"text-4xl font-bold text-gray-800 mb-4\">Physics</h1>\n            <p class=\"text-lg text-gray-600\">Understanding the fundamental laws and principles of the physical world</p>\n        </header>\n\n        <div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\">\n            <!-- Division 1: Foundations -->\n            <div class=\"division-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/physics/foundations/\" class=\"hover:text-blue-600\">1. Foundations — Measurement &amp; Mathematical Tools</a>\n                </h2>\n                <p class=\"text-gray-600 mb-4 text-sm\">Essential measurement skills and mathematical foundations</p>\n                <ul class=\"space-y-2 text-sm text-gray-700\">\n                    <li>• Fundamental and derived quantities</li>\n                    <li>• Measurement techniques</li>\n                    <li>• Scalars and vectors</li>\n                    <li>• Units and dimensional analysis</li>\n                </ul>\n            </div>\n\n            <!-- Division 2: Mechanics -->\n            <div class=\"division-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/physics/mechanics/\" class=\"hover:text-blue-600\">2. Mechanics — Kinematics &amp; Dynamics</a>\n                </h2>\n                <p class=\"text-gray-600 mb-4 text-sm\">Motion, forces, and energy in physical systems</p>\n                <ul class=\"space-y-2 text-sm text-gray-700\">\n                    <li>• Motion and kinematics</li>\n                    <li>• Newton's Laws</li>\n                    <li>• Energy and power</li>\n                    <li>• Simple machines</li>\n                </ul>\n            </div>\n\n            <!-- Division 3: Properties of Matter -->\n            <div class=\"division-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/physics/properties/\" class=\"hover:text-blue-600\">3. Properties of Matter &amp; Elasticity</a>\n                </h2>\n                <p class=\"text-gray-600 mb-4 text-sm\">Material properties and behavior</p>\n                <ul class=\"space-y-2 text-sm text-gray-700\">\n                    <li>• Density and elasticity</li>\n                    <li>• Deformation of solids</li>\n                    <li>• Simple harmonic motion</li>\n                </ul>\n            </div>\n\n            <!-- Division 4: Fluid Mechanics -->\n            <div class=\"division-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/physics/fluids/\" class=\"hover:text-blue-600\">4. Fluid Mechanics &amp; Pressure</a>\n                </h2>\n                <p class=\"text-gray-600 mb-4 text-sm\">Behavior of fluids at rest and in motion</p>\n                <ul class=\"space-y-2 text-sm text-gray-700\">\n                    <li>• Pressure in fluids</li>\n                    <li>• Fluid dynamics</li>\n                    <li>• Buoyancy</li>\n                </ul>\n            </div>\n\n            <!-- Division 5: Waves -->\n            <div class=\"division-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/physics/waves/\" class=\"hover:text-blue-600\">5. Waves &amp; Sound</a>\n                </h2>\n                <p class=\"text-gray-600 mb-4 text-sm\">Wave phenomena and sound propagation</p>\n                <ul class=\"space-y-2 text-sm text-gray-700\">\n                    <li>• Wave properties</li>\n                    <li>• Sound waves</li>\n                    <li>• Wave applications</li>\n                </ul>\n            </div>\n\n            <!-- Division 6: Light -->\n            <div class=\"division-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/physics/optics/\" class=\"hover:text-blue-600\">6. Light &amp; Optics</a>\n                </h2>\n                <p class=\"text-gray-600 mb-4 text-sm\">Behavior and properties of light</p>\n                <ul class=\"space-y-2 text-sm text-gray-700\">\n                    <li>• Reflection and refraction</li>\n                    <li>• Lenses and instruments</li>\n                    <li>• Lasers and applications</li>\n                </ul>\n            </div>\n\n            <!-- Division 7: Thermal Physics -->\n            <div class=\"division-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/physics/thermal/\" class=\"hover:text-blue-600\">7. Thermal Physics &amp; Thermodynamics</a>\n                </h2>\n                <p class=\"text-gray-600 mb-4 text-sm\">Heat, temperature, and thermal processes</p>\n                <ul class=\"space-y-2 text-sm text-gray-700\">\n                    <li>• Heat and temperature</li>\n                    <li>• Heat transfer</li>\n                    <li>• Gas laws and thermodynamics</li>\n                </ul>\n            </div>\n\n            <!-- Division 8: Electricity -->\n            <div class=\"division-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/physics/electricity/\" class=\"hover:text-blue-600\">8. Electricity, Circuits &amp; Electronics</a>\n                </h2>\n                <p class=\"text-gray-600 mb-4 text-sm\">Electrical phenomena and applications</p>\n                <ul class=\"space-y-2 text-sm text-gray-700\">\n                    <li>• Electric charges and fields</li>\n                    <li>• Circuits and components</li>\n                    <li>• Electronics fundamentals</li>\n                </ul>\n            </div>\n\n            <!-- Division 9: Magnetism -->\n            <div class=\"division-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/physics/magnetism/\" class=\"hover:text-blue-600\">9. Magnetism &amp; Electromagnetism</a>\n                </h2>\n                <p class=\"text-gray-600 mb-4 text-sm\">Magnetic fields and electromagnetic phenomena</p>\n                <ul class=\"space-y-2 text-sm text-gray-700\">\n                    <li>• Magnetic fields</li>\n                    <li>• Electromagnetic induction</li>\n                    <li>• Applications</li>\n                </ul>\n            </div>\n\n            <!-- Division 10: Modern Physics -->\n            <div class=\"division-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/physics/modern/\" class=\"hover:text-blue-600\">10. Modern Physics, Atomic &amp; Nuclear</a>\n                </h2>\n                <p class=\"text-gray-600 mb-4 text-sm\">Contemporary physics concepts</p>\n                <ul class=\"space-y-2 text-sm text-gray-700\">\n                    <li>• Atomic structure</li>\n                    <li>• Nuclear physics</li>\n                    <li>• Modern applications</li>\n                </ul>\n            </div>\n\n            <!-- Division 11: Fields -->\n            <div class=\"division-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/physics/fields/\" class=\"hover:text-blue-600\">11. Fields, Gravitation &amp; Astrophysics</a>\n                </h2>\n                <p class=\"text-gray-600 mb-4 text-sm\">Field concepts and space physics</p>\n                <ul class=\"space-y-2 text-sm text-gray-700\">\n                    <li>• Field concepts</li>\n                    <li>• Gravitation</li>\n                    <li>• Basic astrophysics</li>\n                </ul>\n            </div>\n        </div>\n    \n    \n\n    <!-- PhET attribution modal -->\n    <div id=\"phet-attribution-modal\" class=\"phet-modal\" role=\"dialog\" aria-hidden=\"true\" aria-labelledby=\"phet-title\">\n        <div class=\"panel\">\n            <h3 id=\"phet-title\" style=\"margin:0 0 .5rem; font-size:1.1rem;\">Simulation attribution</h3>\n            <div style=\"color:#0f172a;font-size:0.95rem;line-height:1.35;\">\n                This site may include interactive simulations provided by <strong>PhET Interactive Simulations</strong> (University of Colorado Boulder). \n                Simulation content is provided by PhET and is available under a <a href=\"https://creativecommons.org/licenses/by/4.0/\" target=\"_blank\" rel=\"noopener\">CC‑BY‑4.0</a> license. \n                Visit <a href=\"https://phet.colorado.edu\" target=\"_blank\" rel=\"noopener\">phet.colorado.edu</a> for details.\n            </div>\n            <div style=\"margin-top:.75rem; display:flex; align-items:center; justify-content:space-between; gap:.5rem;\">\n                <label style=\"font-size:0.85rem;color:#6b7280;display:flex;align-items:center;gap:.5rem;\">\n                    <input id=\"phet-attribution-dontshow\" type=\"checkbox\">\n                    <span>Don't show again</span>\n                </label>\n                <div style=\"display:flex;gap:.5rem;\">\n                    <button id=\"phet-attribution-close\" class=\"btn-ghost\" style=\"background:#f3f4f6;border-radius:6px;padding:.45rem .7rem;border:1px solid #e5e7eb;\">Close</button>\n                    <button id=\"phet-attribution-ok\" class=\"btn-primary\" style=\"background:#0ea5a4;color:#fff;border-radius:6px;padding:.45rem .7rem;border:none;\">OK</button>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <style>\n        .phet-modal{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(2,6,23,0.45);z-index:1200;opacity:0;pointer-events:none;transition:opacity 180ms ease}\n        .phet-modal.show{opacity:1;pointer-events:auto}\n        .phet-modal .panel{background:#fff;padding:1rem;border-radius:10px;max-width:560px;width:calc(100% - 48px);box-shadow:0 12px 40px rgba(2,6,23,0.14)}\n    </style>","bodyClass":"min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 p-6","bodyStyle":"","css":["body { font-family: 'Inter', sans-serif; }\n        .division-card {\n            backdrop-filter: blur(16px);\n            background: rgba(255, 255, 255, 0.7);\n            border: 1px solid rgba(255, 255, 255, 0.2);\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\n        }",".phet-modal{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(2,6,23,0.45);z-index:1200;opacity:0;pointer-events:none;transition:opacity 180ms ease}\n        .phet-modal.show{opacity:1;pointer-events:auto}\n        .phet-modal .panel{background:#fff;padding:1rem;border-radius:10px;max-width:560px;width:calc(100% - 48px);box-shadow:0 12px 40px rgba(2,6,23,0.14)}"],"quiz":null,"tracker":null,"links":[]}