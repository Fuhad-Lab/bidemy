{"slug":"/students/subjects/mathematics/","source":"students/subjects/mathematics/index.html","area":"students","kind":"subject-home","title":"Mathematics | Subject Overview","description":"","subject":"mathematics","body":"<nav class=\"bg-white/90 backdrop-blur border-b border-slate-200 sticky top-0 z-50\">\n    <div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\">\n      <div class=\"flex justify-between h-16\">\n        <!-- Left side - Back to Dashboard -->\n        <div class=\"flex items-center\">\n          <a href=\"/students/student-dashboard/\" class=\"inline-flex items-center px-3 py-2 border border-slate-200 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition-colors\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\" class=\"w-5 h-5 mr-2\">\n              <path fill-rule=\"evenodd\" d=\"M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z\" clip-rule=\"evenodd\"></path>\n            </svg>\n            Dashboard\n          </a>\n        </div>\n\n        <!-- Center - Current Subject -->\n        <div class=\"flex items-center\">\n          <div class=\"flex items-center px-3 py-2 rounded-lg bg-blue-50 text-blue-700\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\" class=\"w-5 h-5 mr-2\">\n              <path fill-rule=\"evenodd\" d=\"M10 2c.12 0 .24.028.345.083L17.5 5.5a.75.75 0 010 1.32l-7.155 3.417a.75.75 0 01-.69 0L2.5 6.82a.75.75 0 010-1.32l7.155-3.417A.75.75 0 0110 2z\" clip-rule=\"evenodd\"></path>\n              <path fill-rule=\"evenodd\" d=\"M10.5 6.94L17 3.78v7.44a.75.75 0 01-.415.672L10 15.314V6.94zM3.415 11.892A.75.75 0 013 11.22V3.78l6.5 3.16v8.374l-6.085-3.422z\" clip-rule=\"evenodd\"></path>\n            </svg>\n            Mathematics\n          </div>\n        </div>\n\n        <!-- Right side - Quick Actions -->\n        <div class=\"flex items-center space-x-4\">\n          <a href=\"/students/subjects/\" class=\"inline-flex items-center px-3 py-2 border border-slate-200 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition-colors\">\n            All Subjects\n          </a>\n        </div>\n      </div>\n    </div>\n  </nav>\n\n    <header class=\"mb-12 text-center\">\n      <h1 class=\"text-4xl font-bold text-gray-800 mb-4\">Mathematics</h1>\n      <p class=\"text-lg text-gray-600\">Structured learning order — start with Foundations of Numbers &amp; Operations.</p>\n    </header>\n\n    <div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\">\n      <div class=\"division-card p-6 rounded-xl\">\n        <h2 class=\"text-xl font-semibold mb-2\"><a href=\"/students/subjects/mathematics/foundations/\" class=\"hover:text-blue-600\">1. Foundations of Numbers &amp; Operations</a></h2>\n        <p class=\"text-gray-700 text-sm\">Positive &amp; negative integers, fractions, ratios and basic financial arithmetic.</p>\n      </div>\n\n      <div class=\"division-card p-6 rounded-xl\">\n        <h2 class=\"text-xl font-semibold mb-2\"><a href=\"/students/subjects/mathematics/number-systems/\" class=\"hover:text-blue-600\">2. Number Systems &amp; Logic</a></h2>\n        <p class=\"text-gray-700 text-sm\">Bases, indices, logarithms, surds and basic logic.</p>\n      </div>\n\n      <div class=\"division-card p-6 rounded-xl\">\n        <h2 class=\"text-xl font-semibold mb-2\"><a href=\"/students/subjects/mathematics/algebraic-foundations/\" class=\"hover:text-blue-600\">3. Algebraic Foundations</a></h2>\n        <p class=\"text-gray-700 text-sm\">Expressions, equations, functions and polynomials.</p>\n      </div>\n\n      <div class=\"division-card p-6 rounded-xl\">\n        <h2 class=\"text-xl font-semibold mb-2\"><a href=\"/students/subjects/mathematics/geometry-trigonometry/\" class=\"hover:text-blue-600\">4. Geometry &amp; Trigonometry</a></h2>\n        <p class=\"text-gray-700 text-sm\">Shapes, mensuration, coordinate geometry and trigonometry.</p>\n      </div>\n\n      <div class=\"division-card p-6 rounded-xl\">\n        <h2 class=\"text-xl font-semibold mb-2\"><a href=\"/students/subjects/mathematics/matrices-determinants/\" class=\"hover:text-blue-600\">5. Matrices &amp; Determinants</a></h2>\n        <p class=\"text-gray-700 text-sm\">Matrices, determinants and applications to linear systems.</p>\n      </div>\n\n      <div class=\"division-card p-6 rounded-xl\">\n        <h2 class=\"text-xl font-semibold mb-2\"><a href=\"/students/subjects/mathematics/calculus/\" class=\"hover:text-blue-600\">6. Calculus</a></h2>\n        <p class=\"text-gray-700 text-sm\">Differentiation and integration with applications.</p>\n      </div>\n\n      <div class=\"division-card p-6 rounded-xl\">\n        <h2 class=\"text-xl font-semibold mb-2\"><a href=\"/students/subjects/mathematics/statistics-probability/\" class=\"hover:text-blue-600\">7. Statistics &amp; Probability</a></h2>\n        <p class=\"text-gray-700 text-sm\">Data representation, measures, permutations and probability.</p>\n      </div>\n    </div>\n  \n\n  <!-- PhET attribution modal -->\n  <div id=\"phet-attribution-modal\" class=\"phet-modal\" role=\"dialog\" aria-hidden=\"true\" aria-labelledby=\"phet-title\">\n    <div class=\"panel\">\n      <h3 id=\"phet-title\" style=\"margin:0 0 .5rem; font-size:1.1rem;\">Simulation attribution</h3>\n      <div style=\"color:#0f172a;font-size:0.95rem;line-height:1.35;\">\n        This site may include interactive simulations provided by <strong>PhET Interactive Simulations</strong> (University of Colorado Boulder). \n        Simulation content is provided by PhET and is available under a <a href=\"https://creativecommons.org/licenses/by/4.0/\" target=\"_blank\" rel=\"noopener\">CC‑BY‑4.0</a> license. \n        Visit <a href=\"https://phet.colorado.edu\" target=\"_blank\" rel=\"noopener\">phet.colorado.edu</a> for details.\n      </div>\n      <div style=\"margin-top:.75rem; display:flex; align-items:center; justify-content:space-between; gap:.5rem;\">\n        <label style=\"font-size:0.85rem;color:#6b7280;display:flex;align-items:center;gap:.5rem;\">\n          <input id=\"phet-attribution-dontshow\" type=\"checkbox\">\n          <span>Don't show again</span>\n        </label>\n        <div style=\"display:flex;gap:.5rem;\">\n          <button id=\"phet-attribution-close\" class=\"btn-ghost\" style=\"background:#f3f4f6;border-radius:6px;padding:.45rem .7rem;border:1px solid #e5e7eb;\">Close</button>\n          <button id=\"phet-attribution-ok\" class=\"btn-primary\" style=\"background:#0ea5a4;color:#fff;border-radius:6px;padding:.45rem .7rem;border:none;\">OK</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <style>\n    .phet-modal{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(2,6,23,0.45);z-index:1200;opacity:0;pointer-events:none;transition:opacity 180ms ease}\n    .phet-modal.show{opacity:1;pointer-events:auto}\n    .phet-modal .panel{background:#fff;padding:1rem;border-radius:10px;max-width:560px;width:calc(100% - 48px);box-shadow:0 12px 40px rgba(2,6,23,0.14)}\n  </style>","bodyClass":"min-h-screen bg-gradient-to-br from-green-50 to-teal-100 p-6","bodyStyle":"","css":["body{font-family:Inter, sans-serif}.division-card{ -webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);background:rgba(255,255,255,0.75);border:1px solid rgba(255,255,255,0.2);box-shadow:0 8px 32px rgba(0,0,0,0.06);}",".phet-modal{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(2,6,23,0.45);z-index:1200;opacity:0;pointer-events:none;transition:opacity 180ms ease}\n    .phet-modal.show{opacity:1;pointer-events:auto}\n    .phet-modal .panel{background:#fff;padding:1rem;border-radius:10px;max-width:560px;width:calc(100% - 48px);box-shadow:0 12px 40px rgba(2,6,23,0.14)}"],"quiz":