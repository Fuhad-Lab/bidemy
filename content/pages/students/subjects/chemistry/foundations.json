ysical &amp; Chemical Changes</a>\n        <a href=\"/students/subjects/chemistry/foundations/vapour-density-rmm/\" class=\"block p-4 bg-white/60 rounded\">Vapour Density &amp; RMM</a>\n        <a href=\"/students/subjects/chemistry/foundations/gay-lussac-combining-volumes/\" class=\"block p-4 bg-white/60 rounded\">Gay-Lussac's Combining Volumes</a>\n      </div>\n    </div>\n  </div>","bodyClass":"min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 p-6","bodyStyle":"","css":["body{font-family:Inter, sans-serif}.content-card{-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);background:rgba(255,255,255,0.92);border:1px solid rgba(255,255,255,0.2);}"],"quiz":null,"tracker":null,"links":[]}