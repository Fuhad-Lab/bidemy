{"slug":"/students/subjects/chemistry/chemistry-inorganic/","source":"students/subjects/chemistry/chemistry-inorganic.html","area":"students","kind":"division","title":"Inorganic Chemistry","description":"","subject":"chemistry","body":"<nav class=\"fixed inset-x-0 top-0 bg-white/60 backdrop-blur-sm border-b border-blue-100 z-50\">\n    <div class=\"max-w-6xl mx-auto px-4 py-3 flex items-center justify-between\">\n      <a href=\"/students/subjects/chemistry/chemistry/\" class=\"text-sm text-blue-600 hover:underline flex items-center gap-2\">\n        <span class=\"mi -arrow-left\" data-mi=\"arrow_back\">arrow_back</span>\n        <span>Back to Chemistry</span>\n      </a>\n      <img src=\"/site/assets/images/logo.png\" alt=\"logo\" class=\"h-10 w-auto\">\n    </div>\n  </nav>\n\n  <main class=\"max-w-6xl mx-auto px-4 pt-24 pb-12\">\n    <header class=\"mb-8\">\n      <h1 class=\"text-3xl font-extrabold text-blue-700 mb-4\">Inorganic Chemistry</h1>\n      <p class=\"text-gray-600\">Study of elements and compounds except carbon-based molecules.</p>\n    </header>\n\n    <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n      <div class=\"topic-group space-y-4\">\n        <h2 class=\"text-xl font-semibold text-blue-700\">Elements &amp; Hydrides</h2>\n        <div class=\"grid gap-4\">\n          <a href=\"/students/subjects/chemistry/chemistry-explanation/\" class=\"topic-card rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 transition hover:border-blue-300\">\n            <h3 class=\"font-semibold text-blue-700\">Hydrogen &amp; Hydrides</h3>\n            <p class=\"text-sm text-slate-500 mt-1\">Properties and reactions</p>\n            <div class=\"mt-3 flex items-center text-xs text-slate-400\">\n              <span class=\"mi -clock mr-1\" data-mi=\"schedule\">schedule</span>\n              <span>30 min</span>\n            </div>\n          </a>\n          <a href=\"/students/subjects/chemistry/chemistry-explanation/\" class=\"topic-card rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 transition hover:border-blue-300\">\n            <h3 class=\"font-semibold text-blue-700\">Halogens</h3>\n            <p class=\"text-sm text-slate-500 mt-1\">Group 17 elements</p>\n            <div class=\"mt-3 flex items-center text-xs text-slate-400\">\n              <span class=\"mi -clock mr-1\" data-mi=\"schedule\">schedule</span>\n              <span>35 min</span>\n            </div>\n          </a>\n          <a href=\"/students/subjects/chemistry/chemistry-explanation/\" class=\"topic-card rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 transition hover:border-blue-300\">\n            <h3 class=\"font-semibold text-blue-700\">Oxygen &amp; Oxides</h3>\n            <p class=\"text-sm text-slate-500 mt-1\">Reactions and compounds</p>\n            <div class=\"mt-3 flex items-center text-xs text-slate-400\">\n              <span class=\"mi -clock mr-1\" data-mi=\"schedule\">schedule</span>\n              <span>25 min</span>\n            </div>\n          </a>\n        </div>\n      </div>\n\n      <div class=\"topic-group space-y-4\">\n        <h2 class=\"text-xl font-semibold text-blue-700\">Non-Metals &amp; Compounds</h2>\n        <div class=\"grid gap-4\">\n          <a href=\"/students/subjects/chemistry/chemistry-explanation/\" class=\"topic-card rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 transition hover:border-blue-300\">\n            <h3 class=\"font-semibold text-blue-700\">Sulphur</h3>\n            <p class=\"text-sm text-slate-500 mt-1\">Properties and compounds</p>\n            <div class=\"mt-3 flex items-center text-xs text-slate-400\">\n              <span class=\"mi -clock mr-1\" data-mi=\"schedule\">schedule</span>\n              <span>30 min</span>\n            </div>\n          </a>\n          <a href=\"/students/subjects/chemistry/chemistry-explanation/\" class=\"topic-card rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 transition hover:border-blue-300\">\n            <h3 class=\"font-semibold text-blue-700\">Nitrogen</h3>\n            <p class=\"text-sm text-slate-500 mt-1\">Compounds and cycles</p>\n            <div class=\"mt-3 flex items-center text-xs text-slate-400\">\n              <span class=\"mi -clock mr-1\" data-mi=\"schedule\">schedule</span>\n              <span>35 min</span>\n            </div>\n          </a>\n          <a href=\"/students/subjects/chemistry/chemistry-explanation/\" class=\"topic-card rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 transition hover:border-blue-300\">\n            <h3 class=\"font-semibold text-blue-700\">Carbon</h3>\n            <p class=\"text-sm text-slate-500 mt-1\">Allotropes and properties</p>\n            <div class=\"mt-3 flex items-center text-xs text-slate-400\">\n              <span class=\"mi -clock mr-1\" data-mi=\"schedule\">schedule</span>\n              <span>30 min</span>\n            </div>\n          </a>\n        </div>\n      </div>\n\n      <div class=\"topic-group space-y-4\">\n        <h2 class=\"text-xl font-semibold text-blue-700\">Metals &amp; Transition Elements</h2>\n        <div class=\"grid gap-4\">\n          <a href=\"/students/subjects/chemistry/chemistry-explanation/\" class=\"topic-card rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 transition hover:border-blue-300\">\n            <h3 class=\"font-semibold text-blue-700\">Alkali Metals</h3>\n            <p class=\"text-sm text-slate-500 mt-1\">Group 1 elements</p>\n            <div class=\"mt-3 flex items-center text-xs text-slate-400\">\n              <span class=\"mi -clock mr-1\" data-mi=\"schedule\">schedule</span>\n              <span>25 min</span>\n            </div>\n          </a>\n          <a href=\"/students/subjects/chemistry/chemistry-explanation/\" class=\"topic-card rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 transition hover:border-blue-300\">\n            <h3 class=\"font-semibold text-blue-700\">Transition Metals</h3>\n            <p class=\"text-sm text-slate-500 mt-1\">d-block elements</p>\n            <div class=\"mt-3 flex items-center text-xs text-slate-400\">\n              <span class=\"mi -clock mr-1\" data-mi=\"schedule\">schedule</span>\n              <span>40 min</span>\n            </div>\n          </a>\n          <a href=\"/students/subjects/chemistry/chemistry-explanation/\" class=\"topic-card rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 transition hover:border-blue-300\">\n            <h3 class=\"font-semibold text-blue-700\">Metal Extraction</h3>\n            <p class=\"text-sm text-slate-500 mt-1\">Methods and processes</p>\n            <div class=\"mt-3 flex items-center text-xs text-slate-400\">\n              <span class=\"mi -clock mr-1\" data-mi=\"schedule\">schedule</span>\n              <span>35 min</span>\n            </div>\n          </a>\n        </div>\n      </div>\n    </div>\n  </main>\n\n  \n<!-- Topic Quiz System -->","bodyClass":"min-h-screen bg-gradient-to-br from-blue-50 via-white to-blue-100 font-inter","bodyStyle":"","css":[],"quiz":null,"tracker":null,"links":[]}