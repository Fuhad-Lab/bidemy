unded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 hover:shadow-md transition\">\n          <div class=\"font-bold text-blue-900\">Periodic Table</div>\n          <p class=\"mt-2 text-gray-600 text-sm\">Structure, trends, and elements</p>\n        </a>\n        <a href=\"/students/subjects/chemistry/chemistry-explanation/\" class=\"rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 hover:shadow-md transition\">\n          <div class=\"font-bold text-blue-900\">Air and Air Pollution</div>\n          <p class=\"mt-2 text-gray-600 text-sm\">Composition and environmental impact</p>\n        </a>\n        <a href=\"/students/subjects/chemistry/chemistry-explanation/\" class=\"rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 hover:shadow-md transition\">\n          <div class=\"font-bold text-blue-900\">Water and Solubility</div>\n          <p class=\"mt-2 text-gray-600 text-sm\">Properties and solutions</p>\n        </a>\n        <a href=\"/students/subjects/chemistry/chemistry-explanation/\" class=\"rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 hover:shadow-md transition\">\n          <div class=\"font-bold text-blue-900\">Mass-Volume Concepts</div>\n          <p class=\"mt-2 text-gray-600 text-sm\">Quantitative analysis and relationships</p>\n        </a>\n      </div>\n    </main>\n  <!-- Topic Quiz System -->\n\n\n\n\n  \n<!-- Topic Quiz System -->","bodyClass":"bg-gradient-to-br from-blue-50 via-white to-blue-100 min-h-screen","bodyStyle":"","css":["body{font-family:'Inter',sans-serif}"],"quiz":null,"tracker":null,"links":[]}