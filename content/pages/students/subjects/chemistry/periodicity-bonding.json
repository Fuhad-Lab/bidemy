{"slug":"/students/subjects/chemistry/periodicity-bonding/","source":"students/subjects/chemistry/periodicity-bonding/index.html","area":"students","kind":"division","title":"Periodicity & Bonding - Chemistry | Juanova Cortex","description":"","subject":"chemistry","body":"<!-- Navigation -->\n    <nav class=\"bg-white/80 backdrop-blur-md shadow-sm sticky top-0 z-50\">\n        <div class=\"max-w-6xl mx-auto px-4 py-4\">\n            <div class=\"flex items-center justify-between\">\n                <a href=\"/students/subjects/chemistry/\" class=\"flex items-center gap-2 text-gray-600 hover:text-gray-900 transition\">\n                    <span class=\"mi -arrow-left\" data-mi=\"arrow_back\">arrow_back</span>\n                    <span class=\"font-medium\">Back to Chemistry</span>\n                </a>\n                <h1 class=\"text-xl font-bold text-amber-800\">\n                    <span class=\"mi -atom mr-2\" data-mi=\"atom\">atom</span>Periodicity &amp; Bonding\n                </h1>\n                <div class=\"w-24\"></div>\n            </div>\n        </div>\n    </nav>\n\n    <main class=\"max-w-6xl mx-auto px-4 py-8\">\n        <!-- Module Header -->\n        <div class=\"bg-white rounded-2xl shadow-lg p-6 mb-8\">\n            <div class=\"flex items-start gap-4\">\n                <div class=\"w-16 h-16 bg-gradient-to-br from-amber-400 to-orange-500 rounded-2xl flex items-center justify-center text-white text-2xl shadow-lg\">\n                    <span class=\"mi -atom\" data-mi=\"atom\">atom</span>\n                </div>\n                <div class=\"flex-1\">\n                    <h2 class=\"text-2xl font-bold text-gray-800 mb-2\">Periodicity &amp; Bonding</h2>\n                    <p class=\"text-gray-600\">\n                        Understand how elements are organized in the periodic table, discover trends in their properties, \n                        and learn about the three main types of chemical bonding: ionic, covalent, and metallic.\n                    </p>\n                </div>\n            </div>\n            \n            <!-- Module Stats -->\n            <div class=\"grid grid-cols-3 gap-4 mt-6 pt-6 border-t border-gray-100\">\n                <div class=\"text-center\">\n                    <div class=\"text-3xl font-bold text-amber-600\">6</div>\n                    <div class=\"text-sm text-gray-500\">Topics</div>\n                </div>\n                <div class=\"text-center\">\n                    <div class=\"text-3xl font-bold text-orange-600\">~45</div>\n                    <div class=\"text-sm text-gray-500\">Minutes</div>\n                </div>\n                <div class=\"text-center\">\n                    <div class=\"text-3xl font-bold text-red-500\">48</div>\n                    <div class=\"text-sm text-gray-500\">Practice Questions</div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Learning Path -->\n        <div class=\"mb-8\">\n            <h3 class=\"text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2\">\n                <span class=\"mi -route text-amber-500\" data-mi=\"route\">route</span>\n                Learning Path\n            </h3>\n            <p class=\"text-sm text-gray-600 mb-4\">\n                Topics should be completed in order as each builds on the previous one.\n            </p>\n            \n            <div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-4\">\n                <!-- Topic 1: Periodic Table Overview -->\n                <a href=\"/students/subjects/chemistry/periodicity-bonding/periodic-table-overview/\" class=\"topic-card bg-white rounded-xl p-5 shadow-md block relative\">\n                    <div class=\"absolute top-3 left-3 w-8 h-8 bg-emerald-500 text-white rounded-full flex items-center justify-center font-bold text-sm\">1</div>\n                    <div class=\"mt-6\">\n                        <h4 class=\"font-semibold text-gray-800 mb-2\">Periodic Table Overview</h4>\n                        <p class=\"text-sm text-gray-600 mb-3\">Introduction to the periodic table, metals/non-metals, atomic structure basics.</p>\n                        <div class=\"flex items-center gap-2 flex-wrap\">\n                            <span class=\"text-xs bg-emerald-100 text-emerald-700 px-2 py-1 rounded-full\">\n                                <span class=\"mi -play-circle mr-1\" data-mi=\"play_circle\">play_circle</span>Start Here\n                            </span>\n                        </div>\n                    </div>\n                </a>\n\n                <!-- Topic 2: Electron Configuration -->\n                <a href=\"/students/subjects/chemistry/periodicity-bonding/electron-configuration/\" class=\"topic-card bg-white rounded-xl p-5 shadow-md block relative\">\n                    <div class=\"absolute top-3 left-3 w-8 h-8 bg-indigo-500 text-white rounded-full flex items-center justify-center font-bold text-sm\">2</div>\n                    <div class=\"mt-6\">\n                        <h4 class=\"font-semibold text-gray-800 mb-2\">Electron Configuration</h4>\n                        <p class=\"text-sm text-gray-600 mb-3\">How electrons are arranged in atoms: Aufbau, Hund's Rule, orbital diagrams.</p>\n                        <div class=\"flex items-center gap-2 flex-wrap\">\n                            <span class=\"prerequisite-badge\">\n                                <span class=\"mi -lock mr-1\" data-mi=\"lock\">lock</span>Requires: Topic 1\n                            </span>\n                        </div>\n                    </div>\n                </a>\n\n                <!-- Topic 3: Periodic Trends -->\n                <a href=\"/students/subjects/chemistry/periodicity-bonding/periodic-trends/\" class=\"topic-card bg-white rounded-xl p-5 shadow-md block relative\">\n                    <div class=\"absolute top-3 left-3 w-8 h-8 bg-purple-500 text-white rounded-full flex items-center justify-center font-bold text-sm\">3</div>\n                    <div class=\"mt-6\">\n                        <h4 class=\"font-semibold text-gray-800 mb-2\">Periodic Trends</h4>\n                        <p class=\"text-sm text-gray-600 mb-3\">Atomic radius, ionization energy, electronegativity trends across periods and groups.</p>\n                        <div class=\"flex items-center gap-2 flex-wrap\">\n                            <span class=\"prerequisite-badge\">\n                                <span class=\"mi -lock mr-1\" data-mi=\"lock\">lock</span>Requires: Topic 2\n                            </span>\n                        </div>\n                    </div>\n                </a>\n\n                <!-- Topic 4: Ionic Bonding -->\n                <a href=\"/students/subjects/chemistry/periodicity-bonding/ionic-bonding/\" class=\"topic-card bg-white rounded-xl p-5 shadow-md block relative\">\n                    <div class=\"absolute top-3 left-3 w-8 h-8 bg-orange-500 text-white rounded-full flex items-center justify-center font-bold text-sm\">4</div>\n                    <div class=\"mt-6\">\n                        <h4 class=\"font-semibold text-gray-800 mb-2\">Ionic Bonding</h4>\n                        <p class=\"text-sm text-gray-600 mb-3\">Electron transfer, ion formation, properties of ionic compounds, dot-cross diagrams.</p>\n                        <div class=\"flex items-center gap-2 flex-wrap\">\n                            <span class=\"prerequisite-badge\">\n                                <span class=\"mi -lock mr-1\" data-mi=\"lock\">lock</span>Requires: Topic 3\n                            </span>\n                        </div>\n                    </div>\n                </a>\n\n                <!-- Topic 5: Covalent Bonding -->\n                <a href=\"/students/subjects/chemistry/periodicity-bonding/covalent-bonding/\" class=\"topic-card bg-white rounded-xl p-5 shadow-md block relative\">\n                    <div class=\"absolute top-3 left-3 w-8 h-8 bg-green-500 text-white rounded-full flex items-center justify-center font-bold text-sm\">5</div>\n                    <div class=\"mt-6\">\n                        <h4 class=\"font-semibold text-gray-800 mb-2\">Covalent Bonding</h4>\n                        <p class=\"text-sm text-gray-600 mb-3\">Electron sharing, single/double/triple bonds, VSEPR theory, bond polarity.</p>\n                        <div class=\"flex items-center gap-2 flex-wrap\">\n                            <span class=\"prerequisite-badge\">\n                                <span class=\"mi -lock mr-1\" data-mi=\"lock\">lock</span>Requires: Topic 4\n                            </span>\n                        </div>\n                    </div>\n                </a>\n\n                <!-- Topic 6: Metallic Bonding -->\n                <a href=\"/students/subjects/chemistry/periodicity-bonding/metallic-bonding/\" class=\"topic-card bg-white rounded-xl p-5 shadow-md block relative\">\n                    <div class=\"absolute top-3 left-3 w-8 h-8 bg-slate-500 text-white rounded-full flex items-center justify-center font-bold text-sm\">6</div>\n                    <div class=\"mt-6\">\n                        <h4 class=\"font-semibold text-gray-800 mb-2\">Metallic Bonding</h4>\n                        <p class=\"text-sm text-gray-600 mb-3\">Sea of electrons model, properties of metals, comparison of all bonding types.</p>\n                        <div class=\"flex items-center gap-2 flex-wrap\">\n                            <span class=\"prerequisite-badge\">\n                                <span class=\"mi -lock mr-1\" data-mi=\"lock\">lock</span>Requires: Topic 5\n                            </span>\n                        </div>\n                    </div>\n                </a>\n            </div>\n        </div>\n\n        <!-- Module Summary -->\n        <div class=\"bg-gradient-to-r from-amber-100 to-orange-100 rounded-2xl p-6\">\n            <h3 class=\"text-lg font-semibold text-amber-800 mb-4 flex items-center gap-2\">\n                <span class=\"mi -graduation-cap\" data-mi=\"school\">school</span>\n                What You'll Master\n            </h3>\n            <div class=\"grid md:grid-cols-2 gap-4 text-sm text-amber-900\">\n                <div>\n                    <h4 class=\"font-semibold mb-2\">Periodic Table &amp; Trends</h4>\n                    <ul class=\"space-y-1\">\n                        <li><span class=\"mi -check text-green-600 mr-2\" data-mi=\"check\">check</span>Navigate and interpret the periodic table</li>\n                        <li><span class=\"mi -check text-green-600 mr-2\" data-mi=\"check\">check</span>Write electron configurations for any element</li>\n                        <li><span class=\"mi -check text-green-600 mr-2\" data-mi=\"check\">check</span>Predict trends in atomic properties</li>\n                        <li><span class=\"mi -check text-green-600 mr-2\" data-mi=\"check\">check</span>Explain shielding effect and effective nuclear charge</li>\n                    </ul>\n                </div>\n                <div>\n                    <h4 class=\"font-semibold mb-2\">Chemical Bonding</h4>\n                    <ul class=\"space-y-1\">\n                        <li><span class=\"mi -check text-green-600 mr-2\" data-mi=\"check\">check</span>Draw dot-cross diagrams for ionic compounds</li>\n                        <li><span class=\"mi -check text-green-600 mr-2\" data-mi=\"check\">check</span>Predict bond types and molecular shapes</li>\n                        <li><span class=\"mi -check text-green-600 mr-2\" data-mi=\"check\">check</span>Explain properties of different compound types</li>\n                        <li><span class=\"mi -check text-green-600 mr-2\" data-mi=\"check\">check</span>Compare ionic, covalent, and metallic bonding</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n\n        <!-- WAEC Tips -->\n        <div class=\"mt-6 bg-white rounded-xl p-5 shadow-md\">\n            <h3 class=\"font-semibold text-gray-800 mb-3 flex items-center gap-2\">\n                <span class=\"mi -lightbulb text-yellow-500\" data-mi=\"lightbulb\">lightbulb</span>\n                WAEC Exam Tips\n            </h3>\n            <div class=\"grid md:grid-cols-3 gap-4 text-sm\">\n                <div class=\"bg-yellow-50 p-3 rounded-lg\">\n                    <p class=\"font-medium text-yellow-800 mb-1\">Common Questions</p>\n                    <p class=\"text-yellow-700\">Explain trends, write electron configurations, draw bonding diagrams</p>\n                </div>\n                <div class=\"bg-blue-50 p-3 rounded-lg\">\n                    <p class=\"font-medium text-blue-800 mb-1\">Key Formulas</p>\n                    <p class=\"text-blue-700\">Z<sub>eff</sub> = Z - S, Max electrons = 2n², EN difference for bond type</p>\n                </div>\n                <div class=\"bg-pink-50 p-3 rounded-lg\">\n                    <p class=\"font-medium text-pink-800 mb-1\">Don't Forget</p>\n                    <p class=\"text-pink-700\">4s fills before 3d, IE exceptions at Groups 2→3 and 5→6</p>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"bg-white border-t mt-12 py-6\">\n        <div class=\"max-w-6xl mx-auto px-4 text-center text-sm text-gray-500\">\n            <p>Juanova Cortex E-Learning Platform</p>\n            <p class=\"mt-1\">Complete all topics in order for the best learning experience.</p>\n        </div>\n    </footer>\n\n    <!-- Chemistry Subject Quiz Handler -->","bodyClass":"min-h-screen bg-gradient-to-br from-amber-50 via-orange-50 to-yellow-50","bodyStyle":"","css":["body { font-family: 'Inter', sans-serif; }\n        \n        .topic-card {\n            transition: all 0.3s ease;\n            position: relative;\n            overflow: hidden;\n        }\n        .topic-card:hover {\n            transform: translateY(-4px);\n            box-shadow: 0 12px 24px rgba(0,0,0,0.1);\n        }\n        \n        .topic-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: linear-gradient(90deg, #f59e0b, #ef4444);\n        }\n        \n        .progress-ring {\n            position: absolute;\n            top: 12px;\n            right: 12px;\n            width: 48px;\n            height: 48px;\n        }\n        \n        .prerequisite-badge {\n            font-size: 0.65rem;\n            padding: 2px 8px;\n            border-radius: 9999px;\n            background: #fef3c7;\n            color: #92400e;\n        }\n        \n        .learning-path-line {\n            position: absolute;\n            left: 50%;\n            top: 100%;\n            width: 2px;\n            height: 24px;\n            background: linear-gradient(to bottom, #d1d5db, transparent);\n        }\n        \n        @keyframes pulse-ring {\n            0% { transform: scale(1); opacity: 1; }\n            100% { transform: scale(1.3); opacity: 0; }\n        }\n        \n        .pulse-animation::after {\n            content: '';\n            position: absolute;\n            inset: 0;\n            border-radius: 50%;\n            border: 2px solid currentColor;\n            animation: pulse-ring 1.5s ease-out infinite;\n        }"],"quiz":null,"tracker":null,"links":[]}