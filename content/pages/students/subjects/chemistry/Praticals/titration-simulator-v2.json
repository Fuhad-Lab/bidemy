{"slug":"/students/subjects/chemistry/Praticals/titration-simulator-v2/","source":"students/subjects/chemistry/Praticals/titration-simulator-v2.html","area":"students","kind":"content","title":"Chemistry Titration Simulator","description":"","subject":"chemistry","body":"<div class=\"max-w-6xl mx-auto\">\n        <h1 class=\"text-3xl font-bold text-center mb-8\">Chemistry Titration Simulator</h1>\n\n        <!-- Main Content -->\n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n            <!-- Equipment Selection -->\n            <div class=\"bg-white p-6 rounded-lg shadow\">\n                <h2 class=\"text-xl font-semibold mb-4\">Equipment</h2>\n                <div class=\"grid grid-cols-2 gap-4\">\n                    <button class=\"apparatus\" data-type=\"stand\">\n                        <img src=\"data:image/png;base64,\">\n                        <p class=\"text-center mt-2\">Stand</p>\n                    </button>\n                    <button class=\"apparatus\" data-type=\"burette\">\n                        <img src=\"data:image/png;base64,\">\n                        <p class=\"text-center mt-2\">Burette</p>\n                    </button>\n                    <button class=\"apparatus\" data-type=\"flask\">\n                        <img src=\"data:image/png;base64,\">\n                        <p class=\"text-center mt-2\">Flask</p>\n                    </button>\n                </div>\n\n                <h2 class=\"text-xl font-semibold mt-6 mb-4\">Solutions</h2>\n                <div class=\"grid grid-cols-2 gap-4\">\n                    <button class=\"apparatus\" data-type=\"hno3\">\n                        <div class=\"h-full bg-yellow-100 flex items-center justify-center\">\n                            <p class=\"text-center\">HNO₃</p>\n                        </div>\n                    </button>\n                    <button class=\"apparatus\" data-type=\"naoh\">\n                        <div class=\"h-full bg-blue-100 flex items-center justify-center\">\n                            <p class=\"text-center\">NaOH</p>\n                        </div>\n                    </button>\n                </div>\n            </div>\n\n            <!-- Workspace -->\n            <div class=\"col-span-2\">\n                <div class=\"workspace p-4 rounded-lg\">\n                    <div class=\"stand\" id=\"stand\"></div>\n                    <div class=\"burette\" id=\"burette\">\n                        <div class=\"burette-liquid\" id=\"burette-liquid\"></div>\n                    </div>\n                    <div class=\"flask\" id=\"flask\">\n                        <div class=\"flask-liquid\" id=\"flask-liquid\"></div>\n                    </div>\n                </div>\n\n                <!-- Controls -->\n                <div class=\"bg-white p-4 rounded-lg mt-4\">\n                    <div class=\"flex justify-between items-center\">\n                        <button class=\"bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600\">\n                            Add Drop\n                        </button>\n                        <div class=\"flex items-center space-x-4\">\n                            <span>Volume: </span>\n                            <span id=\"volume-reading\" class=\"font-mono\">50.00 mL</span>\n                        </div>\n                        <button class=\"bg-gray-500 text-white px-4 py-2 rounded hover:bg-gray-600\">\n                            Reset\n                        </button>\n                    </div>\n                </div>\n\n                <!-- Readings Table -->\n                <div class=\"bg-white p-4 rounded-lg mt-4\">\n                    <h2 class=\"text-xl font-semibold mb-4\">Readings</h2>\n                    <table class=\"w-full\">\n                        <thead>\n                            <tr>\n                                <th class=\"px-4 py-2\">Reading No.</th>\n                                <th class=\"px-4 py-2\">Initial (mL)</th>\n                                <th class=\"px-4 py-2\">Final (mL)</th>\n                                <th class=\"px-4 py-2\">Volume Used (mL)</th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"readings-table\">\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    \n<!-- Topic Quiz System -->","bodyClass":"bg-gray-100 p-8","bodyStyle":"","css":[".apparatus {\n            width: 100px;\n            height: 100px;\n            border: 2px solid #ccc;\n            cursor: pointer;\n            transition: all 0.3s;\n            user-select: none;\n        }\n\n        .apparatus.selected {\n            border-color: #2563eb;\n            background-color: #dbeafe;\n        }\n\n        .apparatus img {\n            width: 100%;\n            height: 100%;\n            object-fit: contain;\n        }\n\n        .workspace {\n            background-color: #8b5e3c;\n            min-height: 400px;\n            position: relative;\n            border-radius: 8px;\n        }\n\n        .burette {\n            width: 40px;\n            height: 300px;\n            background: #f0f9ff;\n            position: absolute;\n            top: 20px;\n            left: 50%;\n            transform: translateX(-50%);\n            border: 2px solid #93c5fd;\n            border-radius: 8px 8px 0 0;\n            display: none;\n        }\n\n        .burette.placed {\n            display: block;\n        }\n\n        .burette-liquid {\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            right: 0;\n            background: #fcd34d;\n            height: 100%;\n            transition: height 0.5s;\n            border-radius: 6px 6px 0 0;\n        }\n\n        .stand {\n            width: 200px;\n            height: 350px;\n            background: #4b5563;\n            position: absolute;\n            top: 10px;\n            left: 50%;\n            transform: translateX(-50%);\n            display: none;\n        }\n\n        .stand.placed {\n            display: block;\n        }\n\n        .flask {\n            width: 120px;\n            height: 150px;\n            background: transparent;\n            border: 2px solid #93c5fd;\n            border-radius: 0 0 60px 60px;\n            position: absolute;\n            bottom: 20px;\n            left: 50%;\n            transform: translateX(-50%);\n            display: none;\n        }\n\n        .flask.placed {\n            display: block;\n        }\n\n        .flask-liquid {\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            right: 0;\n            height: 60px;\n            background: #93c5fd;\n            border-radius: 0 0 58px 58px;\n            transition: background-color 0.5s;\n        }\n\n        .droplet {\n            width: 8px;\n            height: 8px;\n            background: #fcd34d;\n            border-radius: 50%;\n            position: absolute;\n            animation: drop 1s linear;\n        }\n\n        @keyframes drop {\n            from {\n                transform: translateY(0);\n            }\n            to {\n                transform: translateY(200px);\n            }\n        }"],"quiz":null,"tracker":null,"links":[]}