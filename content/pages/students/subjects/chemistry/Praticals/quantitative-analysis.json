{"slug":"/students/subjects/chemistry/Praticals/quantitative-analysis/","source":"students/subjects/chemistry/Praticals/quantitative-analysis.html","area":"students","kind":"content","title":"Chemistry Practicals — Quantitative Analysis","description":"","subject":"chemistry","body":"<!-- Unified Navigation -->\n  <nav class=\"bg-white/90 backdrop-blur border-b border-slate-200 sticky top-0 z-50 mb-8\">\n    <div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\">\n      <div class=\"flex justify-between h-16\">\n        <!-- Left side - Back to Dashboard -->\n        <div class=\"flex items-center gap-4\">\n          <a href=\"/students/student-dashboard/\" class=\"inline-flex items-center px-3 py-2 border border-slate-200 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition-colors\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\" class=\"w-5 h-5 mr-2\">\n              <path fill-rule=\"evenodd\" d=\"M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z\" clip-rule=\"evenodd\"></path>\n            </svg>\n            Dashboard\n          </a>\n          <a href=\"/students/subjects/chemistry/\" class=\"inline-flex items-center px-3 py-2 border border-slate-200 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition-colors\">\n            Back to Chemistry\n          </a>\n          <a href=\"/students/subjects/chemistry/Praticals/\" class=\"inline-flex items-center px-3 py-2 border border-slate-200 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition-colors\">\n            All Practicals\n          </a>\n        </div>\n\n        <!-- Center - Current Location -->\n        <div class=\"flex items-center\">\n          <div class=\"flex items-center px-3 py-2 rounded-lg bg-blue-50 text-blue-700\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\" class=\"w-5 h-5 mr-2\">\n              <path fill-rule=\"evenodd\" d=\"M10 2c.12 0 .24.028.345.083L17.5 5.5a.75.75 0 010 1.32l-7.155 3.417a.75.75 0 01-.69 0L2.5 6.82a.75.75 0 010-1.32l7.155-3.417A.75.75 0 0110 2z\" clip-rule=\"evenodd\"></path>\n              <path fill-rule=\"evenodd\" d=\"M10.5 6.94L17 3.78v7.44a.75.75 0 01-.415.672L10 15.314V6.94zM3.415 11.892A.75.75 0 013 11.22V3.78l6.5 3.16v8.374l-6.085-3.422z\" clip-rule=\"evenodd\"></path>\n            </svg>\n            Quantitative Analysis\n          </div>\n        </div>\n\n        <!-- Right side - Quick Actions -->\n        <div class=\"flex items-center space-x-4\">\n          <a href=\"/students/subjects/\" class=\"inline-flex items-center px-3 py-2 border border-slate-200 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition-colors\">\n            All Subjects\n          </a>\n        </div>\n      </div>\n    </div>\n  </nav>\n\n  <div class=\"max-w-5xl mx-auto px-4 sm:px-6 lg:px-8\">\n\n    <header class=\"mb-10 max-w-2xl\">\n      <h1 class=\"text-3xl font-semibold mb-3\">Quantitative Analysis Practicals</h1>\n      <p class=\"text-slate-600 text-lg\">Interactive simulations and guided practicals for titration and volumetric analysis. Choose a practical below to begin.</p>\n    </header>\n\n    <div class=\"grid md:grid-cols-2 gap-8\">\n      <!-- Modern Titration Card -->\n      <div class=\"card\">\n        <div class=\"preview-img bg-gradient-to-br from-sky-50 to-indigo-50 flex items-center justify-center p-6\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"120\" height=\"120\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"text-sky-500\"><path d=\"M10 2v7.31\"></path><path d=\"M14 9.3V1.99\"></path><path d=\"M8.5 2h7\"></path><path d=\"M14 9.3a6.5 6.5 0 1 1-4 0\"></path><path d=\"M5.52 16h12.96\"></path></svg>\n        </div>\n        <div class=\"p-6\">\n          <div class=\"flex items-center gap-2 mb-3\">\n            <span class=\"chip bg-sky-50 text-sky-600\">Interactive</span>\n            <span class=\"chip bg-purple-50 text-purple-600\">Modern UI</span>\n          </div>\n          <h2 class=\"text-xl font-semibold mb-2\">Titration Practical v2</h2>\n          <p class=\"text-slate-600 mb-6\">Step-by-step interactive titration simulator with modern interface and real-time guidance. Perfect for exam preparation.</p>\n          <a class=\"btn btn-primary\" href=\"/students/subjects/chemistry/Praticals/waec-titration-practical-v2/\">\n            Start Practical\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg>\n          </a>\n        </div>\n      </div>\n\n      <!-- Classic Titration Card -->\n      <div class=\"card\">\n        <div class=\"preview-img bg-gradient-to-br from-amber-50 to-red-50 flex items-center justify-center p-6\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"120\" height=\"120\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"text-amber-500\"><path d=\"M9 3h6\"></path><path d=\"M12 3v7\"></path><path d=\"M8 20h8a4 4 0 0 0 4-4 7 7 0 0 0-4-6.3 3 3 0 0 0 .5-7.7\"></path><path d=\"M8.5 14a3 3 0 0 0-1.5 5.7\"></path></svg>\n        </div>\n        <div class=\"p-6\">\n          <div class=\"flex items-center gap-2 mb-3\">\n            <span class=\"chip bg-amber-50 text-amber-600\">Classic</span>\n            <span class=\"chip bg-green-50 text-green-600\">WAEC Format</span>\n          </div>\n          <h2 class=\"text-xl font-semibold mb-2\">Classic Titration</h2>\n          <p class=\"text-slate-600 mb-6\">Traditional titration practical with readings table and step-by-step instructions. Follows standard WAEC examination format.</p>\n          <a class=\"btn btn-primary\" href=\"/students/subjects/chemistry/Praticals/waec-titration-practical/\">\n            Start Practical\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg>\n          </a>\n        </div>\n      </div>\n    </div>\n\n    <footer class=\"mt-12 text-center text-sm text-slate-500\">\n      <p>Need help? Ask your instructor or use the AI Tutor feature from your dashboard.</p>\n    </footer>\n  </div>\n\n  \n<!-- Topic Quiz System -->","bodyClass":"bg-slate-50 text-slate-900","bodyStyle":"","css":["body { font-family: Inter, system-ui, -apple-system, sans-serif; }\n    .card {\n      background: #fff;\n      border-radius: 16px;\n      overflow: hidden;\n      transition: transform 0.2s, box-shadow 0.2s;\n      box-shadow: 0 4px 24px rgba(0,0,0,0.08);\n    }\n    .card:hover {\n      transform: translateY(-2px);\n      box-shadow: 0 8px 32px rgba(0,0,0,0.12);\n    }\n    .preview-img {\n      width: 100%;\n      aspect-ratio: 16/9;\n      object-fit: cover;\n      background: linear-gradient(to bottom right, #e0f2fe, #e0e7ff);\n    }\n    .chip {\n      display: inline-flex;\n      align-items: center;\n      padding: 4px 12px;\n      border-radius: 9999px;\n      font-size: 0.75rem;\n      font-weight: 500;\n      gap: 4px;\n    }\n    .btn {\n      display: inline-flex;\n      align-items: center;\n      gap: 0.5rem;\n      padding: 0.625rem 1rem;\n      border-radius: 8px;\n      font-weight: 500;\n      transition: all 0.2s;\n    }\n    .btn-primary {\n      background: #0ea5e9;\n      color: white;\n    }\n    .btn-primary:hover {\n      background: #0284c7;\n      transform: translateY(-1px);\n    }"],"quiz":null,"tracker":null,"links":[]}