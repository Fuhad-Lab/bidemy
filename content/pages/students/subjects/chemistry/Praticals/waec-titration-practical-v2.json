{"slug":"/students/subjects/chemistry/Praticals/waec-titration-practical-v2/","source":"students/subjects/chemistry/Praticals/waec-titration-practical-v2.html","area":"students","kind":"content","title":"WAEC Chemistry Practical - Titration Simulator","description":"","subject":"chemistry","body":"<div class=\"max-w-6xl mx-auto\">\n        <header class=\"text-center mb-8\">\n            <h1 class=\"text-3xl font-bold\">WAEC Chemistry Practical</h1>\n            <p class=\"text-gray-600\">Titration Practice Simulator</p>\n        </header>\n\n        <div class=\"grid md:grid-cols-2 gap-8\">\n            <!-- Left Column - Steps -->\n            <div class=\"space-y-4\">\n                <div class=\"bg-white rounded-lg p-4 shadow\">\n                    <h2 class=\"text-xl font-semibold mb-4\">Practical Steps</h2>\n                    \n                    <div id=\"step1\" class=\"step-card current\">\n                        <h3 class=\"font-medium\">Step 1: Clean Glassware</h3>\n                        <div class=\"mt-2 space-y-2\">\n                            <button class=\"w-full text-left px-4 py-2 bg-gray-50 hover:bg-gray-100 rounded\">\n                                Clean Burette\n                            </button>\n                            <button class=\"w-full text-left px-4 py-2 bg-gray-50 hover:bg-gray-100 rounded\">\n                                Clean Pipette\n                            </button>\n                            <button class=\"w-full text-left px-4 py-2 bg-gray-50 hover:bg-gray-100 rounded\">\n                                Clean Conical Flask\n                            </button>\n                        </div>\n                    </div>\n\n                    <div id=\"step2\" class=\"step-card\">\n                        <h3 class=\"font-medium\">Step 2: Rinse with Solutions</h3>\n                        <div class=\"mt-2 space-y-2\">\n                            <button class=\"w-full text-left px-4 py-2 bg-gray-50 hover:bg-gray-100 rounded\">\n                                Rinse Burette with Titrant\n                            </button>\n                            <button class=\"w-full text-left px-4 py-2 bg-gray-50 hover:bg-gray-100 rounded\">\n                                Rinse Pipette with Analyte\n                            </button>\n                        </div>\n                    </div>\n\n                    <div id=\"step3\" class=\"step-card\">\n                        <h3 class=\"font-medium\">Step 3: Setup and Measurement</h3>\n                        <div class=\"mt-2 space-y-2\">\n                            <button class=\"w-full text-left px-4 py-2 bg-gray-50 hover:bg-gray-100 rounded\">\n                                Setup Apparatus\n                            </button>\n                            <button class=\"w-full text-left px-4 py-2 bg-gray-50 hover:bg-gray-100 rounded\">\n                                Fill Burette\n                            </button>\n                            <button class=\"w-full text-left px-4 py-2 bg-gray-50 hover:bg-gray-100 rounded\">\n                                Measure 25cm³ Analyte\n                            </button>\n                        </div>\n                    </div>\n\n                    <div id=\"step4\" class=\"step-card\">\n                        <h3 class=\"font-medium\">Step 4: Titration</h3>\n                        <div class=\"mt-2 space-y-2\">\n                            <button class=\"w-full text-left px-4 py-2 bg-gray-50 hover:bg-gray-100 rounded\">\n                                Add Indicator\n                            </button>\n                            <button class=\"w-full text-left px-4 py-2 bg-gray-50 hover:bg-gray-100 rounded\">\n                                Perform Titration\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Right Column - Practical Information -->\n            <div class=\"space-y-4\">\n                <div class=\"bg-white rounded-lg p-4 shadow\">\n                    <h2 class=\"text-xl font-semibold mb-4\">Practical Information</h2>\n                    <div id=\"practical-info\" class=\"prose\">\n                        <div class=\"practical-note\">\n                            This simulator helps you practice the sequence and understanding of titration practical. \n                            For each step, you'll receive detailed instructions about what you would do in the actual WAEC practical.\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"bg-white rounded-lg p-4 shadow\">\n                    <h2 class=\"text-xl font-semibold mb-4\">Current Task Details</h2>\n                    <div id=\"task-details\" class=\"prose\">\n                        Select a task to see detailed instructions\n                    </div>\n                </div>\n\n                <div class=\"bg-white rounded-lg p-4 shadow\">\n                    <h2 class=\"text-xl font-semibold mb-4\">Readings Table</h2>\n                    <table class=\"w-full\">\n                        <thead>\n                            <tr>\n                                <th class=\"px-4 py-2 text-left\">Reading No.</th>\n                                <th class=\"px-4 py-2 text-left\">Initial (cm³)</th>\n                                <th class=\"px-4 py-2 text-left\">Final (cm³)</th>\n                                <th class=\"px-4 py-2 text-left\">Volume Used (cm³)</th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"readings-table\"></tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    \n<!-- Topic Quiz System -->","bodyClass":"bg-gray-100 p-4","bodyStyle":"","css":[".step-card {\n            background: white;\n            border-radius: 8px;\n            padding: 1rem;\n            margin-bottom: 1rem;\n            border-left: 4px solid transparent;\n        }\n\n        .step-card.current {\n            border-left-color: #2563eb;\n            background: #f0f9ff;\n        }\n\n        .step-card.completed {\n            border-left-color: #059669;\n        }\n\n        .practical-note {\n            background: #fef3c7;\n            border: 1px solid #f59e0b;\n            padding: 1rem;\n            border-radius: 8px;\n            margin-top: 0.5rem;\n            font-size: 0.9rem;\n        }\n\n        .completion-badge {\n            background: #059669;\n            color: white;\n            padding: 0.25rem 0.5rem;\n            border-radius: 9999px;\n            font-size: 0.75rem;\n            margin-left: 0.5rem;\n        }"],"quiz":null,"tracker":null,"links":[]}