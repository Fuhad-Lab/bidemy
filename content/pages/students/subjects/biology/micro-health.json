{"slug":"/students/subjects/biology/micro-health/","source":"students/subjects/biology/micro-health/index.html","area":"students","kind":"division","title":"Micro-organisms & Health | Biology","description":"","subject":"biology","body":"<div class=\"max-w-4xl mx-auto\">\n        <nav class=\"mb-8\">\n            <a href=\"/students/subjects/biology/biology/\" class=\"text-emerald-600 hover:text-emerald-700\">← Back to Biology</a>\n        </nav>\n\n        <div class=\"content-card rounded-xl p-8\">\n            <header class=\"mb-8\">\n                <h1 class=\"text-3xl font-bold text-gray-800 mb-4\">Micro-organisms &amp; Health</h1>\n                <p class=\"text-lg text-gray-600\">Exploring the world of microorganisms and their impact on human health</p>\n            </header>\n\n            <div class=\"space-y-8\">\n                <!-- Division Overview -->\n                <section>\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Division Overview</h2>\n                    <p class=\"text-gray-700\">This division explores the fascinating world of microorganisms and their relationship with human health. You'll learn about different types of microorganisms, their roles in disease and health, and their practical applications in biotechnology.</p>\n                </section>\n\n                <!-- Topics Grid -->\n                <section>\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Topics</h2>\n                    <div class=\"grid md:grid-cols-2 gap-4\">\n                        <!-- Topic 1 -->\n                        <a href=\"/students/subjects/biology/micro-health/introduction-microorganisms/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">Introduction to Micro-organisms</h3>\n                            <p class=\"text-sm text-gray-600\">Explore the diversity of bacteria, viruses, fungi, and protozoa</p>\n                        </a>\n\n                        <!-- Topic 2 -->\n                        <a href=\"/students/subjects/biology/micro-health/microorganisms-health/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">Micro-organisms and Health</h3>\n                            <p class=\"text-sm text-gray-600\">Study disease transmission, immunity, vaccines, and antibiotics</p>\n                        </a>\n\n                        <!-- Topic 3 -->\n                        <a href=\"/students/subjects/biology/micro-health/applications/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">Applications</h3>\n                            <p class=\"text-sm text-gray-600\">Learn about fermentation and basic biotechnology applications</p>\n                        </a>\n                    </div>\n                </section>\n\n                <!-- Learning Path -->\n                <section>\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Learning Path</h2>\n                    <div class=\"space-y-4\">\n                        <div class=\"p-4 bg-white/50 rounded-lg\">\n                            <h3 class=\"font-medium text-gray-800 mb-2\">1. Foundation</h3>\n                            <p class=\"text-sm text-gray-600\">Begin with understanding different types of microorganisms and their basic characteristics</p>\n                        </div>\n                        <div class=\"p-4 bg-white/50 rounded-lg\">\n                            <h3 class=\"font-medium text-gray-800 mb-2\">2. Health Impact</h3>\n                            <p class=\"text-sm text-gray-600\">Learn how microorganisms affect human health and our defense mechanisms</p>\n                        </div>\n                        <div class=\"p-4 bg-white/50 rounded-lg\">\n                            <h3 class=\"font-medium text-gray-800 mb-2\">3. Practical Applications</h3>\n                            <p class=\"text-sm text-gray-600\">Explore how we use microorganisms in beneficial ways through biotechnology</p>\n                        </div>\n                    </div>\n                </section>\n\n                <!-- Resources -->\n                <section>\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Additional Resources</h2>\n                    <div class=\"grid md:grid-cols-2 gap-4\">\n                        <div class=\"p-4 bg-white/50 rounded-lg\">\n                            <h3 class=\"font-medium text-gray-800 mb-2\">Recommended Reading</h3>\n                            <ul class=\"text-sm text-gray-700 space-y-1\">\n                                <li>• Microbiology textbooks</li>\n                                <li>• Scientific journals</li>\n                                <li>• Health organization reports</li>\n                            </ul>\n                        </div>\n                        <div class=\"p-4 bg-white/50 rounded-lg\">\n                            <h3 class=\"font-medium text-gray-800 mb-2\">Online Resources</h3>\n                            <ul class=\"text-sm text-gray-700 space-y-1\">\n                                <li>• Virtual microscopy labs</li>\n                                <li>• Interactive simulations</li>\n                                <li>• Educational videos</li>\n                            </ul>\n                        </div>\n                    </div>\n                </section>\n            </div>\n        </div>\n    </div>","bodyClass":"min-h-screen bg-gradient-to-br from-emerald-50 to-teal-100 p-6","bodyStyle":"","css":["body { font-family: 'Inter', sans-serif; }\n        .content-card {\n            -webkit-backdrop-filter: blur(16px);\n            backdrop-filter: blur(16px);\n            background: rgba(255, 255, 255, 0.7);\n            border: 1px solid rgba(255, 255, 255, 0.2);\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\n        }"],"quiz":null,"tracker":null,"links":[]}