{"slug":"/students/subjects/biology/transport/","source":"students/subjects/biology/transport/index.html","area":"students","kind":"division","title":"Transport Systems | Biology","description":"","subject":"biology","body":"<div class=\"max-w-6xl mx-auto\">\n        <nav class=\"mb-8\">\n            <a href=\"/students/subjects/biology/\" class=\"text-emerald-600 hover:text-emerald-700\">← Back to Biology</a>\n        </nav>\n        \n        <header class=\"mb-12\">\n            <h1 class=\"text-4xl font-bold text-gray-800 mb-4\">Transport Systems</h1>\n            <p class=\"text-lg text-gray-600\">Understanding how organisms move materials and maintain internal balance</p>\n            \n            <div class=\"mt-6 p-6 topic-card rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">Why Study This?</h2>\n                <p class=\"text-gray-700\">Understanding transport &amp; exchange explains how organisms maintain internal stability and support metabolism. These systems are fundamental to life processes in both plants and animals.</p>\n                \n                <div class=\"mt-4\">\n                    <h3 class=\"font-semibold text-gray-800 mb-2\">Key Practical Skills:</h3>\n                    <ul class=\"text-gray-700 space-y-1\">\n                        <li>• Diffusion/osmosis demonstrations</li>\n                        <li>• Transpiration experiments</li>\n                        <li>• Spirometer demonstrations</li>\n                        <li>• Urine analysis tests</li>\n                    </ul>\n                </div>\n            </div>\n        </header>\n\n        <div class=\"grid md:grid-cols-2 gap-6\">\n            <!-- Transport Mechanisms -->\n            <div class=\"topic-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/biology/transport/transport-mechanisms/\" class=\"hover:text-emerald-600\">Transport Mechanisms</a>\n                </h2>\n                <div class=\"space-y-4\">\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Plant Transport:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Xylem transport</li>\n                            <li>• Phloem transport</li>\n                            <li>• Transpiration</li>\n                        </ul>\n                    </div>\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Animal Transport:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Blood composition</li>\n                            <li>• Circulatory system</li>\n                            <li>• Heart structure and function</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Gaseous Exchange -->\n            <div class=\"topic-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/biology/transport/gaseous-exchange/\" class=\"hover:text-emerald-600\">Gaseous Exchange</a>\n                </h2>\n                <div class=\"space-y-4\">\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Key Concepts:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Gas exchange surfaces</li>\n                            <li>• Breathing mechanisms</li>\n                            <li>• Cellular respiration</li>\n                        </ul>\n                    </div>\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Applications:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Respiratory diseases</li>\n                            <li>• Exercise physiology</li>\n                            <li>• Altitude adaptation</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Excretory Systems -->\n            <div class=\"topic-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/biology/transport/excretory-systems/\" class=\"hover:text-emerald-600\">Excretory Systems</a>\n                </h2>\n                <div class=\"space-y-4\">\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Key Concepts:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Kidney structure</li>\n                            <li>• Urine formation</li>\n                            <li>• Osmoregulation</li>\n                        </ul>\n                    </div>\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Clinical Links:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Kidney function tests</li>\n                            <li>• Dialysis principles</li>\n                            <li>• Homeostatic balance</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Homeostasis Integration -->\n            <div class=\"topic-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/biology/transport/homeostasis-integration/\" class=\"hover:text-emerald-600\">Homeostasis Integration</a>\n                </h2>\n                <div class=\"space-y-4\">\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">System Coordination:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Transport-excretion links</li>\n                            <li>• Gas exchange regulation</li>\n                            <li>• Water-salt balance</li>\n                        </ul>\n                    </div>\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Practical Studies:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• System modeling</li>\n                            <li>• Data interpretation</li>\n                            <li>• Case studies</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"mt-12 p-6 topic-card rounded-xl\">\n            <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Essential Laboratory Skills</h2>\n            <div class=\"grid md:grid-cols-2 gap-6\">\n                <div>\n                    <h3 class=\"font-medium text-gray-800 mb-2\">Transport Studies:</h3>\n                    <ul class=\"space-y-1 text-sm text-gray-700\">\n                        <li>• Setting up transpiration experiments</li>\n                        <li>• Blood smear preparation</li>\n                        <li>• Heart rate measurements</li>\n                        <li>• Osmosis investigations</li>\n                    </ul>\n                </div>\n                <div>\n                    <h3 class=\"font-medium text-gray-800 mb-2\">Analysis Techniques:</h3>\n                    <ul class=\"space-y-1 text-sm text-gray-700\">\n                        <li>• Using a spirometer</li>\n                        <li>• Measuring breathing rate</li>\n                        <li>• Urine testing procedures</li>\n                        <li>• Data collection and analysis</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </div>","bodyClass":"min-h-screen bg-gradient-to-br from-emerald-50 to-teal-100 p-6","bodyStyle":"","css":["body { font-family: 'Inter', sans-serif; }\n        .topic-card {\n            -webkit-backdrop-filter: blur(16px);\n            backdrop-filter: blur(16px);\n            background: rgba(255, 255, 255, 0.7);\n            border: 1px solid rgba(255, 255, 255, 0.2);\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\n        }"],"quiz":null,"tracker":null,"links":[]}