{"slug":"/students/subjects/biology/genetics/","source":"students/subjects/biology/genetics/index.html","area":"students","kind":"division","title":"Genetics & Evolution | Biology","description":"","subject":"biology","body":"<div class=\"max-w-4xl mx-auto\">\n        <nav class=\"mb-8\">\n            <a href=\"/students/subjects/biology/\" class=\"text-emerald-600 hover:text-emerald-700\">← Back to Biology</a>\n        </nav>\n        \n        <div class=\"content-card rounded-xl p-8\">\n            <header class=\"mb-8\">\n                <h1 class=\"text-3xl font-bold text-gray-800 mb-4\">Genetics &amp; Evolution</h1>\n                <p class=\"text-lg text-gray-600\">Understanding inheritance, variation, and evolutionary change</p>\n            </header>\n\n            <div class=\"space-y-8\">\n                <!-- Division Overview -->\n                <section>\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Division Overview</h2>\n                    <p class=\"text-gray-700\">\n                        This division explores how characteristics are passed from one generation to the next and how species \n                        change over time. From Mendel's fundamental principles to the basics of DNA and natural selection, \n                        you'll learn about the mechanisms that drive biological inheritance and evolution.\n                    </p>\n                </section>\n\n                <!-- Topics -->\n                <section>\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-6\">Topics</h2>\n                    <div class=\"grid md:grid-cols-2 gap-6\">\n                        <a href=\"/students/subjects/biology/genetics/mendelian-inheritance/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition\">\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">1. Mendelian Inheritance</h3>\n                            <ul class=\"text-sm text-gray-600 space-y-1\">\n                                <li>• Mendel's principles</li>\n                                <li>• Chromosomes and genes</li>\n                                <li>• Dominant and recessive traits</li>\n                                <li>• Inheritance patterns</li>\n                            </ul>\n                        </a>\n\n                        <a href=\"/students/subjects/biology/genetics/variation-evolution/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition\">\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">2. Variation &amp; Evolution</h3>\n                            <ul class=\"text-sm text-gray-600 space-y-1\">\n                                <li>• Sources of variation</li>\n                                <li>• Natural selection</li>\n                                <li>• Adaptation mechanisms</li>\n                                <li>• Survival of the fittest</li>\n                            </ul>\n                        </a>\n\n                        <a href=\"/students/subjects/biology/genetics/molecular-genetics/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition\">\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">3. Molecular Genetics</h3>\n                            <ul class=\"text-sm text-gray-600 space-y-1\">\n                                <li>• DNA structure</li>\n                                <li>• Genes and alleles</li>\n                                <li>• Mutations</li>\n                                <li>• Genetic code basics</li>\n                            </ul>\n                        </a>\n                    </div>\n                </section>\n\n                <!-- Learning Path -->\n                <section>\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Learning Path</h2>\n                    <div class=\"bg-white/50 rounded-lg p-6\">\n                        <ol class=\"space-y-4 text-gray-700\">\n                            <li class=\"flex items-start\">\n                                <span class=\"font-medium mr-2\">1.</span>\n                                <div>\n                                    <p class=\"font-medium\">Start with Mendelian Inheritance</p>\n                                    <p class=\"text-sm text-gray-600 mt-1\">Learn the fundamental principles of inheritance through Mendel's experiments and discoveries.</p>\n                                </div>\n                            </li>\n                            <li class=\"flex items-start\">\n                                <span class=\"font-medium mr-2\">2.</span>\n                                <div>\n                                    <p class=\"font-medium\">Explore Variation &amp; Evolution</p>\n                                    <p class=\"text-sm text-gray-600 mt-1\">Understand how variations arise and lead to evolutionary change through natural selection.</p>\n                                </div>\n                            </li>\n                            <li class=\"flex items-start\">\n                                <span class=\"font-medium mr-2\">3.</span>\n                                <div>\n                                    <p class=\"font-medium\">Discover Molecular Genetics</p>\n                                    <p class=\"text-sm text-gray-600 mt-1\">Learn about DNA, genes, and mutations at a conceptual level.</p>\n                                </div>\n                            </li>\n                        </ol>\n                    </div>\n                </section>\n\n                <!-- Resources -->\n                <section>\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Additional Resources</h2>\n                    <div class=\"grid md:grid-cols-2 gap-4\">\n                        <div class=\"p-4 bg-white/50 rounded-lg\">\n                            <h3 class=\"font-medium text-gray-800 mb-2\">Practical Work</h3>\n                            <ul class=\"text-sm text-gray-700 space-y-1\">\n                                <li>• Inheritance pattern studies</li>\n                                <li>• Variation observations</li>\n                                <li>• DNA model building</li>\n                            </ul>\n                        </div>\n                        <div class=\"p-4 bg-white/50 rounded-lg\">\n                            <h3 class=\"font-medium text-gray-800 mb-2\">Interactive Activities</h3>\n                            <ul class=\"text-sm text-gray-700 space-y-1\">\n                                <li>• Genetic cross simulations</li>\n                                <li>• Evolution animations</li>\n                                <li>• Virtual DNA analysis</li>\n                            </ul>\n                        </div>\n                    </div>\n                </section>\n            </div>\n        </div>\n    </div>","bodyClass":"min-h-screen bg-gradient-to-br from-emerald-50 to-teal-100 p-6","bodyStyle":"","css":["body { font-family: 'Inter', sans-serif; }\n        .content-card {\n            -webkit-backdrop-filter: blur(16px);\n            backdrop-filter: blur(16px);\n            background: rgba(255, 255, 255, 0.7);\n            border: 1px solid rgba(255, 255, 255, 0.2);\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\n        }"],"quiz":null,"tracker":null,"links":[]}