{"slug":"/students/subjects/biology/nutrition/","source":"students/subjects/biology/nutrition/index.html","area":"students","kind":"division","title":"Nutrition, Digestion & Energy | Biology","description":"","subject":"biology","body":"<div class=\"max-w-6xl mx-auto\">\n        <nav class=\"mb-8\">\n            <a href=\"/students/subjects/biology/\" class=\"text-emerald-600 hover:text-emerald-700\">← Back to Biology</a>\n        </nav>\n        \n        <header class=\"mb-12\">\n            <h1 class=\"text-4xl font-bold text-gray-800 mb-4\">Nutrition, Digestion &amp; Energy</h1>\n            <p class=\"text-lg text-gray-600\">Understanding how organisms obtain and process energy from food</p>\n            \n            <div class=\"mt-6 p-6 topic-card rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">Why Study This?</h2>\n                <p class=\"text-gray-700\">Energy flow through organisms (capturing and processing food) underpins physiology and ecology. Understanding these processes is essential for health, agriculture, and ecosystem studies.</p>\n                \n                <div class=\"mt-4\">\n                    <h3 class=\"font-semibold text-gray-800 mb-2\">Key Practical Skills:</h3>\n                    <ul class=\"text-gray-700 space-y-1\">\n                        <li>• Food substance tests (Benedict's, Biuret, iodine)</li>\n                        <li>• Photosynthesis experiments</li>\n                        <li>• Digestive system dissection/models</li>\n                    </ul>\n                </div>\n            </div>\n        </header>\n\n        <div class=\"grid md:grid-cols-2 gap-6\">\n            <!-- Food Substances -->\n            <div class=\"topic-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/biology/nutrition/food-substances/\" class=\"hover:text-emerald-600\">Nutrition &amp; Food Substances</a>\n                </h2>\n                <div class=\"space-y-4\">\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Key Concepts:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Carbohydrates</li>\n                            <li>• Proteins</li>\n                            <li>• Lipids</li>\n                            <li>• Vitamins and minerals</li>\n                        </ul>\n                    </div>\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Practical Work:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Food testing</li>\n                            <li>• Nutritional analysis</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Photosynthesis -->\n            <div class=\"topic-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/biology/nutrition/photosynthesis/\" class=\"hover:text-emerald-600\">Photosynthesis</a>\n                </h2>\n                <div class=\"space-y-4\">\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Key Concepts:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Light reactions</li>\n                            <li>• Dark reactions</li>\n                            <li>• Limiting factors</li>\n                        </ul>\n                    </div>\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Practical Work:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Leaf starch tests</li>\n                            <li>• Light/CO₂ experiments</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Digestive System -->\n            <div class=\"topic-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/biology/nutrition/digestive-system/\" class=\"hover:text-emerald-600\">Digestive System</a>\n                </h2>\n                <div class=\"space-y-4\">\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Key Concepts:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Digestive organs</li>\n                            <li>• Enzyme action</li>\n                            <li>• Absorption</li>\n                        </ul>\n                    </div>\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Practical Work:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Enzyme experiments</li>\n                            <li>• System models</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Comparative Nutrition -->\n            <div class=\"topic-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/biology/nutrition/comparative-nutrition/\" class=\"hover:text-emerald-600\">Comparative Nutrition</a>\n                </h2>\n                <div class=\"space-y-4\">\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Key Concepts:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Feeding mechanisms</li>\n                            <li>• Digestive adaptations</li>\n                            <li>• Nutritional requirements</li>\n                        </ul>\n                    </div>\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Practical Work:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Comparative studies</li>\n                            <li>• Feeding observations</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"mt-12 p-6 topic-card rounded-xl\">\n            <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Essential Laboratory Skills</h2>\n            <div class=\"grid md:grid-cols-2 gap-6\">\n                <div>\n                    <h3 class=\"font-medium text-gray-800 mb-2\">Chemical Testing:</h3>\n                    <ul class=\"space-y-1 text-sm text-gray-700\">\n                        <li>• Benedict's test for reducing sugars</li>\n                        <li>• Biuret test for proteins</li>\n                        <li>• Iodine test for starch</li>\n                        <li>• Emulsion test for fats</li>\n                    </ul>\n                </div>\n                <div>\n                    <h3 class=\"font-medium text-gray-800 mb-2\">Experimental Skills:</h3>\n                    <ul class=\"space-y-1 text-sm text-gray-700\">\n                        <li>• Setting up controls</li>\n                        <li>• Variables management</li>\n                        <li>• Data collection</li>\n                        <li>• Results analysis</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </div>","bodyClass":"min-h-screen bg-gradient-to-br from-emerald-50 to-teal-100 p-6","bodyStyle":"","css":["body { font-family: 'Inter', sans-serif; }\n        .topic-card {\n            -webkit-backdrop-filter: blur(16px);\n            backdrop-filter: blur(16px);\n            background: rgba(255, 255, 255, 0.7);\n            border: 1px solid rgba(255, 255, 255, 0.2);\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\n        }"],"quiz":null,"tracker":null,"links":[]}