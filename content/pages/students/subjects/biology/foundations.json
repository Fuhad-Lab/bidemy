{"slug":"/students/subjects/biology/foundations/","source":"students/subjects/biology/foundations/index.html","area":"students","kind":"division","title":"Biology: Foundations | Division Overview","description":"","subject":"biology","body":"<div class=\"max-w-6xl mx-auto\">\n        <nav class=\"mb-8\">\n            <a href=\"/students/subjects/biology/\" class=\"text-emerald-600 hover:text-emerald-700\">← Back to Biology</a>\n        </nav>\n        \n        <header class=\"mb-12\">\n            <h1 class=\"text-4xl font-bold text-gray-800 mb-4\">Foundations of Biology</h1>\n            <p class=\"text-lg text-gray-600\">Classification &amp; Cell Biology: The fundamental building blocks of life</p>\n            \n            <div class=\"mt-6 p-6 topic-card rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">Why Study This First?</h2>\n                <p class=\"text-gray-700\">Cells and classification are the language and units of biology. Without a firm cell-level understanding, physiology and ecology won't make sense.</p>\n                \n                <div class=\"mt-4\">\n                    <h3 class=\"font-semibold text-gray-800 mb-2\">Prerequisites:</h3>\n                    <p class=\"text-gray-700\">Basic chemistry (water, macromolecules) — if absent, we'll provide a short recap.</p>\n                </div>\n            </div>\n        </header>\n\n        <div class=\"grid md:grid-cols-2 gap-6\">\n            <!-- Classification -->\n            <div class=\"topic-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/biology/foundations/classification/\" class=\"hover:text-emerald-600\">Classification &amp; Organisation of Life</a>\n                </h2>\n                <div class=\"space-y-4\">\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Key Concepts:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Kingdoms of life</li>\n                            <li>• Basic taxonomy concepts</li>\n                            <li>• Hierarchical organization</li>\n                        </ul>\n                    </div>\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Practical Work:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Using classification keys</li>\n                            <li>• Identifying specimens</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Cell Structure -->\n            <div class=\"topic-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/biology/foundations/cell-structure/\" class=\"hover:text-emerald-600\">Cell Structure &amp; Ultrastructure</a>\n                </h2>\n                <div class=\"space-y-4\">\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Key Concepts:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Cell ultrastructure</li>\n                            <li>• Organelles and their roles</li>\n                            <li>• Cell membranes</li>\n                        </ul>\n                    </div>\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Practical Work:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Microscope techniques</li>\n                            <li>• Preparing/viewing cells</li>\n                            <li>• Cell staining</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Cell Properties -->\n            <div class=\"topic-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/biology/foundations/cell-properties/\" class=\"hover:text-emerald-600\">Cell Properties &amp; Functions</a>\n                </h2>\n                <div class=\"space-y-4\">\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Key Concepts:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Cell membrane function</li>\n                            <li>• Transport mechanisms</li>\n                            <li>• Organelle functions</li>\n                        </ul>\n                    </div>\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Practical Work:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Osmosis experiments</li>\n                            <li>• Cell counting</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Supporting Systems -->\n            <div class=\"topic-card p-6 rounded-xl\">\n                <h2 class=\"text-xl font-semibold text-gray-800 mb-3\">\n                    <a href=\"/students/subjects/biology/foundations/supporting-systems/\" class=\"hover:text-emerald-600\">Supporting Systems</a>\n                </h2>\n                <div class=\"space-y-4\">\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Key Concepts:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Basic tissues</li>\n                            <li>• Organs</li>\n                            <li>• Organ systems</li>\n                        </ul>\n                    </div>\n                    <div>\n                        <h3 class=\"font-medium text-gray-800\">Practical Work:</h3>\n                        <ul class=\"mt-2 space-y-1 text-sm text-gray-700\">\n                            <li>• Tissue examination</li>\n                            <li>• Drawing labeled diagrams</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"mt-12 p-6 topic-card rounded-xl\">\n            <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Key Laboratory Skills in This Division</h2>\n            <div class=\"grid md:grid-cols-2 gap-6\">\n                <div>\n                    <h3 class=\"font-medium text-gray-800 mb-2\">Microscopy Skills:</h3>\n                    <ul class=\"space-y-1 text-sm text-gray-700\">\n                        <li>• Preparing slides</li>\n                        <li>• Using microscopes</li>\n                        <li>• Staining techniques</li>\n                        <li>• Cell observation</li>\n                    </ul>\n                </div>\n                <div>\n                    <h3 class=\"font-medium text-gray-800 mb-2\">Drawing &amp; Documentation:</h3>\n                    <ul class=\"space-y-1 text-sm text-gray-700\">\n                        <li>• Scientific drawing</li>\n                        <li>• Labeling diagrams</li>\n                        <li>• Scale and magnification</li>\n                        <li>• Recording observations</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </div>","bodyClass":"min-h-screen bg-gradient-to-br from-emerald-50 to-teal-100 p-6","bodyStyle":"","css":["body { font-family: 'Inter', sans-serif; }\n        .topic-card {\n            backdrop-filter: blur(16px);\n            background: rgba(255, 255, 255, 0.7);\n            border: 1px solid rgba(255, 255, 255, 0.2);\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\n        }"],"quiz":null,"tracker":null,"links":[]}