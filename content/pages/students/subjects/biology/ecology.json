{"slug":"/students/subjects/biology/ecology/","source":"students/subjects/biology/ecology/index.html","area":"students","kind":"division","title":"Ecology & Ecosystems | Biology","description":"","subject":"biology","body":"<div class=\"max-w-4xl mx-auto\">\n        <nav class=\"mb-8\">\n            <a href=\"/students/subjects/biology/\" class=\"text-emerald-600 hover:text-emerald-700\">← Back to Biology</a>\n        </nav>\n        \n        <div class=\"content-card rounded-xl p-8\">\n            <header class=\"mb-8\">\n                <h1 class=\"text-3xl font-bold text-gray-800 mb-4\">Ecology &amp; Ecosystems</h1>\n                <p class=\"text-lg text-gray-600\">Understanding environmental interactions and biological systems</p>\n            </header>\n\n            <div class=\"space-y-8\">\n                <!-- Division Overview -->\n                <section>\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Division Overview</h2>\n                    <p class=\"text-gray-700\">\n                        This division explores how living organisms interact with each other and their environment. \n                        From basic ecological concepts to complex ecosystem dynamics, you'll learn about the \n                        interconnected web of life and the factors that influence biological communities.\n                    </p>\n                </section>\n\n                <!-- Topics -->\n                <section>\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-6\">Topics</h2>\n                    <div class=\"grid md:grid-cols-2 gap-6\">\n                        <a href=\"/students/subjects/biology/ecology/ecological-concepts/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition\">\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">1. Ecological Concepts</h3>\n                            <ul class=\"text-sm text-gray-600 space-y-1\">\n                   