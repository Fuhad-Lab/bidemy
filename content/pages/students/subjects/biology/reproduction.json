{"slug":"/students/subjects/biology/reproduction/","source":"students/subjects/biology/reproduction/index.html","area":"students","kind":"division","title":"Reproduction & Development | Biology","description":"","subject":"biology","body":"<div class=\"max-w-4xl mx-auto\">\n        <nav class=\"mb-8\">\n            <a href=\"/students/subjects/biology/\" class=\"text-emerald-600 hover:text-emerald-700\">← Back to Biology</a>\n        </nav>\n        \n        <div class=\"content-card rounded-xl p-8\">\n            <header class=\"mb-8\">\n                <h1 class=\"text-3xl font-bold text-gray-800 mb-4\">Reproduction &amp; Development</h1>\n                <p class=\"text-lg text-gray-600\">Exploring life cycles, reproduction, growth, and development across organisms</p>\n            </header>\n\n            <div class=\"space-y-8\">\n                <!-- Division Overview -->\n                <section>\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Division Overview</h2>\n                    <p class=\"text-gray-700\">\n                        This division explores the fundamental processes of reproduction and development across different organisms. \n                        From cellular division to complex life cycles, you'll learn about the mechanisms that ensure species continuity \n                        and the fascinating journey from a single cell to a complex organism.\n                    </p>\n                </section>\n\n                <!-- Topics -->\n                <section>\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-6\">Topics</h2>\n                    <div class=\"grid md:grid-cols-2 gap-6\">\n                        <a href=\"/students/subjects/biology/reproduction/cell-division/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition\">\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">1. Cell Division &amp; Growth</h3>\n                     