{"slug":"/students/subjects/biology/nutrition/digestive-system/","source":"students/subjects/biology/nutrition/digestive-system.html","area":"students","kind":"content","title":"Digestive System - Biology","description":"","subject":"biology","body":"<!-- Header -->\n    <nav class=\"bg-white shadow-sm fixed top-0 w-full z-50\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"flex justify-between h-16 items-center\">\n                <div class=\"flex items-center\">\n                    <a href=\"/students/subjects/biology/biology-nutrition/\" class=\"text-orange-600 hover:text-orange-800 mr-4\">\n                        <span class=\"mi -arrow-left\" data-mi=\"arrow_back\">arrow_back</span>\n                    </a>\n                    <h1 class=\"text-xl font-semibold text-gray-900\">Digestive System</h1>\n                </div>\n                <div class=\"flex items-center space-x-4\">\n                    <div class=\"text-sm text-gray-600 hidden sm:block\">\n                        Progress: <span id=\"progressPercent\">0%</span>\n                    </div>\n                    <div class=\"w-24 sm:w-32 h-2 bg-gray-200 rounded-full\">\n                        <div id=\"progressBar\" class=\"h-2 bg-orange-500 rounded-full transition-all duration-300\" style=\"width: 0%\"></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Main Content -->\n    <main class=\"pt-20 pb-8 px-4 max-w-5xl mx-auto\">\n        <!-- Learning Objectives -->\n        <div class=\"bg-orange-50 border-l-4 border-orange-500 p-4 rounded-r-lg mb-6 animate-fade-in-up\">\n            <h3 class=\"font-semibold text-orange-800 mb-2\"><span class=\"mi -bullseye mr-2\" data-mi=\"adjust\">adjust</span>Learning Objectives</h3>\n            <ul class=\"text-orange-700 text-sm space-y-1\">\n                <li>• Identify the main organs of the digestive system</li>\n                <li>• Describe the function of each digestive organ</li>\n                <li>• Explain the difference between mechanical and chemical digestion</li>\n                <li>• Trace the path of food through the digestive tract</li>\n            </ul>\n        </div>\n\n        <!-- Section 1: Introduction -->\n        <div class=\"section-card animate-fade-in-up\">\n            <h2 class=\"text-xl font-semibold text-gray-800 mb-4 flex items-center\">\n                <span class=\"bg-orange-100 text-orange-700 w-8 h-8 rounded-full flex items-center justify-center mr-3 text-sm font-bold\">1</span>\n                What is Digestion?\n            </h2>\n            \n            <p class=\"text-gray-700 mb-4\"><strong>Digestion</strong> is the process by which large, insoluble food molecules are broken down into smaller, soluble molecules that can be absorbed into the bloodstream and used by the body.</p>\n            \n            <div class=\"grid md:grid-cols-2 gap-4 mb-4\">\n                <div class=\"bg-blue-50 p-4 rounded-lg border-l-4 border-blue-500\">\n                    <h4 class=\"font-semibold text-blue-700 mb-2\"><span class=\"mi -cogs mr-2\" data-mi=\"settings\">settings</span>Mechanical Digestion</h4>\n                    <p class=\"text-gray-600 text-sm\">Physical breakdown of food into smaller pieces without chemical change.</p>\n                    <ul class=\"text-gray-600 text-sm mt-2 space-y-1\">\n                        <li>• Chewing (mastication) in the mouth</li>\n                        <li>• Churning in the stomach</li>\n                        <li>• Increases surface area for enzymes</li>\n                    </ul>\n                </div>\n                <div class=\"bg-green-50 p-4 rounded-lg border-l-4 border-green-500\">\n                    <h4 class=\"font-semibold text-green-700 mb-2\"><span class=\"mi -flask mr-2\" data-mi=\"science\">science</span>Chemical Digestion</h4>\n                    <p class=\"text-gray-600 text-sm\">Enzyme-catalyzed breakdown of large molecules into smaller ones.</p>\n                    <ul class=\"text-gray-600 text-sm mt-2 space-y-1\">\n                        <li>• Carbohydrates → Simple sugars</li>\n                        <li>• Proteins → Amino acids</li>\n                        <li>• Fats → Fatty acids &amp; glycerol</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 2: Organs of the Digestive System -->\n        <div class=\"section-card animate-fade-in-up\">\n            <h2 class=\"text-xl font-semibold text-gray-800 mb-4 flex items-center\">\n                <span class=\"bg-orange-100 text-orange-700 w-8 h-8 rounded-full flex items-center justify-center mr-3 text-sm font-bold\">2</span>\n                Organs of the Digestive System\n            </h2>\n\n            <div class=\"space-y-4\">\n                <!-- Mouth -->\n                <div class=\"bg-yellow-50 p-4 rounded-lg border-l-4 border-yellow-500\">\n                    <h4 class=\"font-semibold text-yellow-800 flex items-center\">\n                        <span class=\"mi -circle text-yellow-500 mr-2 text-xs\" data-mi=\"circle\">circle</span>1. Mouth (Buccal Cavity)\n                    </h4>\n                    <ul class=\"text-gray-600 text-sm mt-2 space-y-1\">\n                        <li>• <strong>Teeth:</strong> Cut, tear, and grind food (mechanical digestion)</li>\n                        <li>• <strong>Tongue:</strong> Mixes food with saliva, helps in swallowing</li>\n                        <li>• <strong>Salivary glands:</strong> Produce saliva containing amylase (breaks down starch)</li>\n                        <li>• Food forms a soft ball called <strong>bolus</strong></li>\n                    </ul>\n                </div>\n\n                <!-- Oesophagus -->\n                <div class=\"bg-pink-50 p-4 rounded-lg border-l-4 border-pink-500\">\n                    <h4 class=\"font-semibold text-pink-800 flex items-center\">\n                        <span class=\"mi -circle text-pink-500 mr-2 text-xs\" data-mi=\"circle\">circle</span>2. Oesophagus (Gullet)\n                    </h4>\n                    <ul class=\"text-gray-600 text-sm mt-2 space-y-1\">\n                        <li>• Muscular tube connecting mouth to stomach</li>\n                        <li>• Uses <strong>peristalsis</strong> (wave-like muscle contractions) to push food down</li>\n                        <li>• No digestion occurs here - just transport</li>\n                    </ul>\n                </div>\n\n                <!-- Stomach -->\n                <div class=\"bg-red-50 p-4 rounded-lg border-l-4 border-red-500\">\n                    <h4 class=\"font-semibold text-red-800 flex items-center\">\n                        <span class=\"mi -circle text-red-500 mr-2 text-xs\" data-mi=\"circle\">circle</span>3. Stomach\n                    </h4>\n                    <ul class=\"text-gray-600 text-sm mt-2 space-y-1\">\n                        <li>• Muscular sac with folds called <strong>rugae</strong></li>\n                        <li>• Produces <strong>gastric juice</strong> containing:\n                            <ul class=\"ml-4 mt-1\">\n                                <li>- <strong>Pepsin:</strong> Enzyme that digests proteins</li>\n                                <li>- <strong>Hydrochloric acid (HCl):</strong> Kills bacteria, activates pepsin</li>\n                                <li>- <strong>Mucus:</strong> Protects stomach lining</li>\n                            </ul>\n                        </li>\n                        <li>• Food is churned into a semi-liquid called <strong>chyme</strong></li>\n                    </ul>\n                </div>\n\n                <!-- Small Intestine -->\n                <div class=\"bg-purple-50 p-4 rounded-lg border-l-4 border-purple-500\">\n                    <h4 class=\"font-semibold text-purple-800 flex items-center\">\n                        <span class=\"mi -circle text-purple-500 mr-2 text-xs\" data-mi=\"circle\">circle</span>4. Small Intestine\n                    </h4>\n                    <ul class=\"text-gray-600 text-sm mt-2 space-y-1\">\n                        <li>• About 6 meters long, divided into <strong>duodenum, jejunum, ileum</strong></li>\n                        <li>• <strong>Duodenum:</strong> Receives bile (from liver) and pancreatic juice (from pancreas)</li>\n                        <li>• <strong>Ileum:</strong> Main site of absorption - has villi to increase surface area</li>\n                        <li>• Most chemical digestion and nutrient absorption happens here</li>\n                    </ul>\n                </div>\n\n                <!-- Liver -->\n                <div class=\"bg-amber-50 p-4 rounded-lg border-l-4 border-amber-500\">\n                    <h4 class=\"font-semibold text-amber-800 flex items-center\">\n                        <span class=\"mi -circle text-amber-500 mr-2 text-xs\" data-mi=\"circle\">circle</span>5. Liver &amp; Gall Bladder\n                    </h4>\n                    <ul class=\"text-gray-600 text-sm mt-2 space-y-1\">\n                        <li>• <strong>Liver:</strong> Produces <strong>bile</strong> (emulsifies fats into smaller droplets)</li>\n                        <li>• <strong>Gall bladder:</strong> Stores bile until needed</li>\n                        <li>• Bile is alkaline and helps neutralize stomach acid</li>\n                    </ul>\n                </div>\n\n                <!-- Pancreas -->\n                <div class=\"bg-teal-50 p-4 rounded-lg border-l-4 border-teal-500\">\n                    <h4 class=\"font-semibold text-teal-800 flex items-center\">\n                        <span class=\"mi -circle text-teal-500 mr-2 text-xs\" data-mi=\"circle\">circle</span>6. Pancreas\n                    </h4>\n                    <ul class=\"text-gray-600 text-sm mt-2 space-y-1\">\n                        <li>• Produces <strong>pancreatic juice</strong> containing enzymes:</li>\n                        <li>• <strong>Pancreatic amylase:</strong> Digests starch to maltose</li>\n                        <li>• <strong>Trypsin:</strong> Digests proteins to peptides</li>\n                        <li>• <strong>Lipase:</strong> Digests fats to fatty acids and glycerol</li>\n                    </ul>\n                </div>\n\n                <!-- Large Intestine -->\n                <div class=\"bg-green-50 p-4 rounded-lg border-l-4 border-green-500\">\n                    <h4 class=\"font-semibold text-green-800 flex items-center\">\n                        <span class=\"mi -circle text-green-500 mr-2 text-xs\" data-mi=\"circle\">circle</span>7. Large Intestine (Colon)\n                    </h4>\n                    <ul class=\"text-gray-600 text-sm mt-2 space-y-1\">\n                        <li>• Absorbs <strong>water</strong> from undigested food</li>\n                        <li>• Contains helpful bacteria that make vitamins</li>\n                        <li>• Forms and stores <strong>faeces</strong> before elimination</li>\n                        <li>• Ends at the rectum and anus</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 3: Enzyme Summary Table -->\n        <div class=\"section-card animate-fade-in-up\">\n            <h2 class=\"text-xl font-semibold text-gray-800 mb-4 flex items-center\">\n                <span class=\"bg-orange-100 text-orange-700 w-8 h-8 rounded-full flex items-center justify-center mr-3 text-sm font-bold\">3</span>\n                Digestive Enzymes Summary\n            </h2>\n\n            <div class=\"overflow-x-auto\">\n                <table class=\"w-full text-sm border-collapse\">\n                    <thead>\n                        <tr class=\"bg-orange-50\">\n                            <th class=\"border border-gray-200 p-3 text-left\">Enzyme</th>\n                            <th class=\"border border-gray-200 p-3 text-left\">Produced In</th>\n                            <th class=\"border border-gray-200 p-3 text-left\">Substrate</th>\n                            <th class=\"border border-gray-200 p-3 text-left\">Product</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        <tr>\n                            <td class=\"border border-gray-200 p-3 font-medium\">Salivary Amylase</td>\n                            <td class=\"border border-gray-200 p-3\">Salivary glands</td>\n                            <td class=\"border border-gray-200 p-3\">Starch</td>\n                            <td class=\"border border-gray-200 p-3\">Maltose</td>\n                        </tr>\n                        <tr class=\"bg-gray-50\">\n                            <td class=\"border border-gray-200 p-3 font-medium\">Pepsin</td>\n                            <td class=\"border border-gray-200 p-3\">Stomach</td>\n                            <td class=\"border border-gray-200 p-3\">Proteins</td>\n                            <td class=\"border border-gray-200 p-3\">Peptides</td>\n                        </tr>\n                        <tr>\n                            <td class=\"border border-gray-200 p-3 font-medium\">Pancreatic Amylase</td>\n                            <td class=\"border border-gray-200 p-3\">Pancreas</td>\n                            <td class=\"border border-gray-200 p-3\">Starch</td>\n                            <td class=\"border border-gray-200 p-3\">Maltose</td>\n                        </tr>\n                        <tr class=\"bg-gray-50\">\n                            <td class=\"border border-gray-200 p-3 font-medium\">Trypsin</td>\n                            <td class=\"border border-gray-200 p-3\">Pancreas</td>\n                            <td class=\"border border-gray-200 p-3\">Proteins/Peptides</td>\n                            <td class=\"border border-gray-200 p-3\">Amino acids</td>\n                        </tr>\n                        <tr>\n                            <td class=\"border border-gray-200 p-3 font-medium\">Lipase</td>\n                            <td class=\"border border-gray-200 p-3\">Pancreas</td>\n                            <td class=\"border border-gray-200 p-3\">Fats</td>\n                            <td class=\"border border-gray-200 p-3\">Fatty acids + Glycerol</td>\n                        </tr>\n                        <tr class=\"bg-gray-50\">\n                            <td class=\"border border-gray-200 p-3 font-medium\">Maltase</td>\n                            <td class=\"border border-gray-200 p-3\">Small intestine</td>\n                            <td class=\"border border-gray-200 p-3\">Maltose</td>\n                            <td class=\"border border-gray-200 p-3\">Glucose</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n        </div>\n\n        <!-- Section 4: Video -->\n        <div class=\"section-card animate-fade-in-up\">\n            <h2 class=\"text-xl font-semibold text-gray-800 mb-4 flex items-center\">\n                <span class=\"bg-orange-100 text-orange-700 w-8 h-8 rounded-full flex items-center justify-center mr-3 text-sm font-bold\">4</span>\n                Video: The Digestive System\n            </h2>\n            \n            <div class=\"bg-gray-50 p-4 rounded-lg border\">\n                <div class=\"video-container\">\n                    <iframe src=\"https://www.youtube.com/embed/Og5xAdC8EUI\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen=\"\"></iframe>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 5: Practice Problems -->\n        <div class=\"section-card animate-fade-in-up\">\n            <h2 class=\"text-xl font-semibold text-gray-800 mb-4 flex items-center\">\n                <span class=\"mi -pencil-alt text-orange-600 mr-3\" data-mi=\"edit\">edit</span>\n                Practice Questions\n            </h2>\n\n            <div class=\"space-y-4\">\n                <div class=\"bg-yellow-50 p-4 rounded-lg border border-yellow-200\">\n                    <p class=\"font-medium text-gray-800 mb-2\">1. What is the function of bile in digestion?</p>\n                    <details class=\"mt-2\">\n                        <summary class=\"text-sm text-blue-600 cursor-pointer hover:text-blue-800\">Show Answer</summary>\n                        <div class=\"mt-2 text-sm text-gray-700\">\n                            <ul class=\"list-disc list-inside\">\n                                <li><strong>Emulsifies fats</strong> - breaks large fat droplets into smaller ones</li>\n                                <li>Increases surface area for lipase to work</li>\n                                <li>Neutralizes acidic chyme from stomach (bile is alkaline)</li>\n                            </ul>\n                        </div>\n                    </details>\n                </div>\n\n                <div class=\"bg-yellow-50 p-4 rounded-lg border border-yellow-200\">\n                    <p class=\"font-medium text-gray-800 mb-2\">2. Explain why the stomach produces mucus.</p>\n                    <details class=\"mt-2\">\n                        <summary class=\"text-sm text-blue-600 cursor-pointer hover:text-blue-800\">Show Answer</summary>\n                        <div class=\"mt-2 text-sm text-gray-700\">\n                            The stomach produces mucus to <strong>protect the stomach lining</strong> from being digested by its own hydrochloric acid and pepsin. Without mucus, the stomach would digest itself!\n                        </div>\n                    </details>\n                </div>\n\n                <div class=\"bg-yellow-50 p-4 rounded-lg border border-yellow-200\">\n                    <p class=\"font-medium text-gray-800 mb-2\">3. What are villi and why are they important?</p>\n                    <details class=\"mt-2\">\n                        <summary class=\"text-sm text-blue-600 cursor-pointer hover:text-blue-800\">Show Answer</summary>\n                        <div class=\"mt-2 text-sm text-gray-700\">\n                            <strong>Villi</strong> are tiny finger-like projections lining the small intestine. They:\n                            <ul class=\"list-disc list-inside mt-1\">\n                                <li>Greatly increase surface area for absorption</li>\n                                <li>Have thin walls for quick diffusion of nutrients</li>\n                                <li>Contain blood capillaries to absorb sugars and amino acids</li>\n                                <li>Contain lacteals to absorb fatty acids and glycerol</li>\n                            </ul>\n                        </div>\n                    </details>\n                </div>\n\n                <div class=\"bg-yellow-50 p-4 rounded-lg border border-yellow-200\">\n                    <p class=\"font-medium text-gray-800 mb-2\">4. Trace the path of food through the digestive system.</p>\n                    <details class=\"mt-2\">\n                        <summary class=\"text-sm text-blue-600 cursor-pointer hover:text-blue-800\">Show Answer</summary>\n                        <div class=\"mt-2 text-sm text-gray-700\">\n                            <strong>Mouth → Oesophagus → Stomach → Small Intestine (Duodenum → Jejunum → Ileum) → Large Intestine → Rectum → Anus</strong>\n                        </div>\n                    </details>\n                </div>\n            </div>\n        </div>\n\n        <!-- Key Takeaways -->\n        <div class=\"bg-gradient-to-r from-orange-50 to-amber-50 p-5 rounded-lg border border-orange-200 animate-fade-in-up\">\n            <h3 class=\"font-semibold text-orange-800 mb-3\"><span class=\"mi -star mr-2\" data-mi=\"star\">star</span>Key Takeaways</h3>\n            <ul class=\"text-orange-700 text-sm space-y-2\">\n                <li>• Digestion breaks down large molecules into small, absorbable ones</li>\n                <li>• Mechanical digestion = physical breakdown; Chemical digestion = enzyme action</li>\n                <li>• Main organs: Mouth → Oesophagus → Stomach → Small Intestine → Large Intestine</li>\n                <li>• Liver produces bile; Pancreas produces digestive enzymes</li>\n                <li>• Absorption mainly occurs in the small intestine (villi increase surface area)</li>\n            </ul>\n        </div>\n\n        <!-- Navigation -->\n        <div class=\"flex justify-between items-center mt-8\">\n            <a href=\"/students/subjects/biology/biology-topic-nutrition-substances/\" class=\"px-4 py-2 text-gray-600 hover:text-gray-900\">\n                <span class=\"mi -chevron-left mr-2\" data-mi=\"chevron_left\">chevron_left</span>Previous\n            </a>\n            <a href=\"/students/subjects/biology/biology-topic-excretion/\" class=\"px-4 py-2 bg-orange-500 text-white rounded-lg hover:bg-orange-600\">\n                Next<span class=\"mi -chevron-right ml-2\" data-mi=\"chevron_right\">chevron_right</span>\n            </a>\n        </div>\n    </main>\n\n    \n\n<!-- Topic Quiz System -->","bodyClass":"bg-gray-50 min-h-screen","bodyStyle":"","css":["@keyframes fade-in-up {\n            from { opacity: 0; transform: translateY(20px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        .animate-fade-in-up { animation: fade-in-up 0.5s ease-out forwards; }\n        .section-card {\n            background: white;\n            border-radius: 12px;\n            padding: 1.5rem;\n            margin-bottom: 1.5rem;\n            box-shadow: 0 2px 8px rgba(0,0,0,0.05);\n            border: 1px solid #e5e7eb;\n        }\n        .video-container {\n            position: relative;\n            width: 100%;\n            padding-bottom: 56.25%;\n            height: 0;\n            overflow: hidden;\n            border-radius: 8px;\n            background: #f9fafb;\n        }\n        .video-container iframe {\n            position: absolute;\n            top: 0; left: 0;\n            width: 100%;\n            height: 100%;\n            border: none;\n        }"],"quiz":null,"tracker":null,"links":[]}