{"slug":"/students/subjects/physics/solid/solid-state-interactive/","source":"students/subjects/physics/solid/solid-state-interactive.html","area":"students","kind":"content","title":"Solid State - Interactive","description":"","subject":"physics","body":"<nav class=\"bg-blue-700 p-4 text-white\">Solid State Physics</nav>\n  <div class=\"p-6 max-w-6xl mx-auto\">\n    <div class=\"bg-white p-6 rounded shadow\">\n      <h2 class=\"font-bold mb-4\">Crystal Lattice &amp; Band Structure Demo</h2>\n      <div class=\"grid grid-cols-2 gap-4\">\n        <div>\n          <label class=\"block text-sm\">Lattice size (n × n)</label>\n          <input id=\"size\" type=\"range\" min=\"3\" max=\"12\" value=\"8\" class=\"w-full\">\n          <div class=\"text-sm mt-2\">n = <span id=\"sizeVal\">8</span></div>\n\n          <label class=\"block text-sm mt-4\">Tight-binding hopping (t)</label>\n          <input id=\"hopping\" type=\"range\" min=\"0\" max=\"10\" value=\"4\" class=\"w-full\">\n          <div class=\"text-sm mt-2\">t = <span id=\"tVal\">4</span></div>\n\n          <button id=\"toggleBands\" class=\"mt-4 px-3 py-2 bg-blue-600 text-white rounded\">Show Bands</button>\n        </div>\n        <div>\n          <div id=\"lattice\" class=\"border rounded p-4\" style=\"height:300px;overflow:auto\"></div>\n        </div>\n      </div>\n\n      <div id=\"bands\" class=\"mt-4 bg-gray-50 p-4 rounded hidden\"><canvas id=\"bandCanvas\" width=\"600\" height=\"220\" class=\"w-full\"></canvas></div>\n    </div>\n  </div>\n\n  \n<!-- Topic Quiz System -->","bodyClass":"bg-gray-50 min-h-screen","bodyStyle":"","css":["body{font-family:Inter,system-ui,sans-serif}.lattice{display:grid;grid-template-columns:repeat(var(--cols),24px);gap:6px}.atom{width:24px;height:24px;border-radius:50%;background:#60a5fa}"],"quiz":null,"tracker":null,"links":[]}