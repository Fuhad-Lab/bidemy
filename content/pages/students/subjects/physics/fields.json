{"slug":"/students/subjects/physics/fields/","source":"students/subjects/physics/fields/index.html","area":"students","kind":"division","title":"Fields, Gravitation & Astrophysics","description":"","subject":"physics","body":"<div class=\"max-w-6xl mx-auto\">\n    <nav class=\"mb-8\"><a href=\"/students/subjects/physics/\" class=\"text-blue-600 hover:text-blue-700\">← Back to Physics</a></nav>\n\n    <div class=\"content-card rounded-xl p-8\">\n      <header class=\"mb-12\">\n        <h1 class=\"text-3xl font-bold text-gray-800 mb-4\">Fields, Gravitation &amp; Astrophysics</h1>\n        <p class=\"text-lg text-gray-600\">Field concepts, Newtonian gravitation, orbital basics and introductory astrophysics.</p>\n      </header>\n\n      <div class=\"grid gap-8\">\n        <section>\n          <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Core Topics</h2>\n          <div class=\"grid md:grid-cols-2 gap-6\">\n            <a href=\"/students/subjects/physics/fields/fields-concepts/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Field Concepts</h3>\n              <p class=\"text-sm text-gray-600\">Field lines, field strength and potential description.</p>\n            </a>\n\n            <a href=\"/students/subjects/physics/fields/gravitation/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Gravitational Field &amp; Orbits</h3>\n              <p class=\"text-sm text-gray-600\">Newtonian gravitation, orbital motion and escape velocity concepts.</p>\n            </a>\n\n            <a href=\"/students/subjects/physics/fields/satellites/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Satellites &amp; Rockets</h3>\n              <p class=\"text-sm text-gray-600\">Orbital basics and conceptual rocket motion.</p>\n            </a>\n\n            <a href=\"/students/subjects/physics/fields/astrophysics/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Astrophysics Overview</h3>\n              <p class=\"text-sm text-gray-600\">Basic stellar concepts and applied astrophysics topics.</p>\n            </a>\n          </div>\n        </section>\n\n        <section>\n          <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Why this module</h2>\n          <div class=\"bg-white/50 rounded-lg p-6\">\n            <p class=\"text-gray-700\">After building electrostatic and magnetic field intuition, gravitation and orbital motion become straightforward and link physics to space applications.</p>\n          </div>\n        </section>\n      </div>\n    </div>\n  </div>","bodyClass":"min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 p-6","bodyStyle":"","css":["body{font-family:Inter, sans-serif} .content-card{-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);background:rgba(255,255,255,0.7);border:1px solid rgba(255,255,255,0.2);box-shadow:0 8px 32px rgba(0,0,0,0.1)}"],"quiz":null,"tracker":null,"links":[]}