{"slug":"/students/subjects/physics/template/","source":"students/subjects/physics/template.html","area":"students","kind":"division","title":"Physics Topic - Step-by-Step Learning","description":"","subject":"physics","body":"<!-- Top Navigation -->\n    <nav class=\"bg-white shadow-sm fixed top-0 w-full z-50\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"flex justify-between h-16\">\n                <div class=\"flex items-center\">\n                    <a href=\"/students/subjects/accounting/content/divisions/accounting-cycle/\" class=\"text-gray-600 hover:text-gray-900 mr-4\" aria-label=\"Back to topics\">\n                        <span class=\"mi -arrow-left\" data-mi=\"arrow_back\">arrow_back</span>\n                    </a>\n                    <h1 id=\"topicTitle\" class=\"text-xl font-semibold text-gray-900\">Topic Title</h1>\n                </div>\n                <div class=\"flex items-center space-x-4\">\n                    <div class=\"text-sm text-gray-600\">\n                        Progress: <span id=\"progressPercent\">0%</span>\n                    </div>\n                    <div class=\"w-32 h-2 bg-gray-200 rounded-full\">\n                        <div id=\"progressBar\" class=\"step-progress h-2 bg-blue-500 rounded-full\" style=\"width: 0%\"></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Main Content -->\n    <main class=\"pt-20 pb-24\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"grid md:grid-cols-12 gap-6\">\n                <!-- Left Sidebar - Steps -->\n                <div class=\"md:col-span-3\">\n                    <div class=\"bg-white rounded-lg shadow-sm p-4 sticky top-20\">\n                        <h3 class=\"font-semibold mb-4\">Learning Steps</h3>\n                        <ul id=\"stepsList\" class=\"space-y-2\">\n                            <!-- Steps will be dynamically populated -->\n                        </ul>\n                    </div>\n                </div>\n\n                <!-- Main Content Area -->\n                <div class=\"md:col-span-9\">\n                    <div id=\"stepContainer\" class=\"bg-white rounded-lg shadow-sm p-6 mb-6\">\n                        <!-- Step content will be dynamically loaded -->\n                    </div>\n\n                    <div id=\"resourcesContainer\" class=\"bg-white rounded-lg shadow-sm p-6\">\n                        <h3 class=\"text-lg font-semibold mb-4\">Resources</h3>\n                        <div id=\"resourcesGrid\" class=\"grid sm:grid-cols-2 lg:grid-cols-3 gap-4\">\n                            <!-- Resource cards will be dynamically populated -->\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    <!-- Bottom Navigation -->\n    <div class=\"fixed bottom-0 w-full bg-white border-t border-gray-200 z-40\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"flex justify-between py-4\">\n                <button id=\"prevStepBtn\" class=\"px-4 py-2 text-gray-600 hover:text-gray-900 disabled:opacity-50 disabled:cursor-not-allowed\">\n                    <span class=\"mi -chevron-left mr-2\" data-mi=\"chevron_left\">chevron_left</span>\n                    Previous\n                </button>\n                <button id=\"nextStepBtn\" class=\"px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 disabled:opacity-50 disabled:cursor-not-allowed\">\n                    Next\n                    <span class=\"mi -chevron-right ml-2\" data-mi=\"chevron_right\">chevron_right</span>\n                </button>\n            </div>\n        </div>\n    </div>\n\n    <!-- Resource Modal -->\n    <div id=\"resourceModal\" class=\"hidden fixed inset-0 bg-gray-800 bg-opacity-75 overflow-y-auto h-full w-full z-50 flex items-center justify-center\">\n        <div class=\"relative mx-auto p-5 border w-full max-w-4xl shadow-lg rounded-md bg-white\">\n            <div class=\"flex justify-between items-center pb-3 border-b\">\n                <h3 id=\"resourceModalTitle\" class=\"text-xl font-semibold\">Resource</h3>\n                <button id=\"closeResourceModal\" class=\"text-gray-600 hover:text-gray-900 text-2xl font-bold\">×</button>\n            </div>\n            <div id=\"resourceModalContent\" class=\"mt-4\">\n                <!-- Resource content will be loaded here -->\n            </div>\n        </div>\n    </div>\n\n    <!-- Quiz Modal -->\n    <div id=\"quizModal\" class=\"hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50\">\n        <div class=\"relative top-20 mx-auto p-5 border w-full max-w-2xl shadow-lg rounded-md bg-white\">\n            <div id=\"quizContent\" class=\"p-6\">\n                <!-- Quiz content will be dynamically loaded -->\n            </div>\n        </div>\n    </div>\n\n    \n<!-- Topic Quiz System -->","bodyClass":"bg-gray-50","bodyStyle":"","css":["@keyframes fade-in-up {\n            from { opacity: 0; transform: translateY(20px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        .animate-fade-in-up { animation: fade-in-up 0.6s ease-out forwards; }\n        .step-progress { transition: width 0.3s ease-in-out; }\n        .resource-card { transition: transform 0.2s; }\n        .resource-card:hover { transform: translateY(-4px); }\n        .step-button.active { background-color: #EFF6FF; color: #2563EB; }\n        .quiz-option.selected { border-color: #2563EB; background-color: #EFF6FF; }\n        .quiz-option.correct { border-color: #16A34A; background-color: #F0FDF4; }\n        .quiz-option.incorrect { background-color: #fff5f5; border-color: #e53e3e; }"],"quiz":null,"tracker":null,"links":[]}