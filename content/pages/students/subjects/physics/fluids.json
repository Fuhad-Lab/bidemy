{"slug":"/students/subjects/physics/fluids/","source":"students/subjects/physics/fluids/index.html","area":"students","kind":"division","title":"Fluids — Physics","description":"","subject":"physics","body":"<div class=\"max-w-6xl mx-auto\">\n    <nav class=\"mb-8\"><a href=\"/students/subjects/physics/\" class=\"text-blue-600\">← Back to Physics</a></nav>\n\n    <div class=\"content-card rounded-xl p-8\">\n      <header class=\"mb-6\">\n        <h1 class=\"text-3xl font-bold mb-2 text-gray-800\">Fluids</h1>\n        <p class=\"text-gray-600\">Pressure, buoyancy, viscosity, surface tension and Bernoulli's principle.</p>\n      </header>\n\n      <section class=\"mb-6\">\n        <h2 class=\"text-xl font-semibold mb-4\">Core Topics</h2>\n        <div class=\"grid md:grid-cols-2 gap-6\">\n          <a href=\"/students/subjects/physics/fluids/pressure/\" class=\"block p-6 bg-white/50 rounded-lg\">Pressure in Fluids</a>\n          <a href=\"/students/subjects/physics/fluids/buoyancy/\" class=\"block p-6 bg-white/50 rounded-lg\">Buoyancy &amp; Archimedes' Principle</a>\n          <a href=\"/students/subjects/physics/fluids/viscosity/\" class=\"block p-6 bg-white/50 rounded-lg\">Viscosity &amp; Flow</a>\n          <a href=\"/students/subjects/physics/fluids/surface-tension/\" class=\"block p-6 bg-white/50 rounded-lg\">Surface Tension</a>\n          <a href=\"/students/subjects/physics/fluids/bernoulli/\" class=\"block p-6 bg-white/50 rounded-lg\">Bernoulli's Principle</a>\n        </div>\n      </section>\n\n      <section>\n        <h2 class=\"text-xl font-semibold mb-4\">Why this module</h2>\n        <div class=\"bg-white/50 rounded-lg p-6\">\n          <p class=\"text-gray-700\">Fluids form the basis for hydraulics, aerodynamics and many engineering systems; understanding these concepts is essential for experiments and applications.</p>\n        </div>\n      </section>\n    </div>\n  </div>","bodyClass":"min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 p-6","bodyStyle":"","css":["body{font-family:Inter, sans-serif} .content-card{-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);background:rgba(255,255,255,0.75);border:1px solid rgba(255,255,255,0.2);box-shadow:0 8px 32px rgba(0,0,0,0.06);}"],"quiz":null,"tracker":null,"links":[]}