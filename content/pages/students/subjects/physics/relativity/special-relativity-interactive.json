{"slug":"/students/subjects/physics/relativity/special-relativity-interactive/","source":"students/subjects/physics/relativity/special-relativity-interactive.html","area":"students","kind":"content","title":"Special Relativity - Interactive","description":"","subject":"physics","body":"<nav class=\"bg-blue-700 p-4 text-white\"><div class=\"max-w-6xl mx-auto flex justify-between\"><a href=\"/students/subjects/physics/\">← Back</a><h1 class=\"font-bold\">Special Relativity</h1></div></nav>\n\n  <div class=\"flex\">\n    <aside class=\"w-64 bg-white p-4 border-r\">\n      <h2 class=\"font-semibold mb-4\">Steps</h2>\n      <ul id=\"stepsList\" class=\"space-y-2\"></ul>\n    </aside>\n\n    <main class=\"flex-1 p-6\">\n      <div id=\"progressBar\" class=\"h-3 bg-gray-200 rounded-full overflow-hidden mb-6\"><div id=\"progress\" class=\"h-full bg-blue-600\" style=\"width:0%\"></div></div>\n      <div id=\"stepContent\" class=\"bg-white p-6 rounded shadow min-h-[180px]\"></div>\n\n      <section class=\"mt-6 bg-white p-6 rounded shadow\">\n        <div class=\"grid grid-cols-2 gap-4 mb-4\">\n          <div>\n            <label class=\"block text-sm\">Velocity (as fraction of c)</label>\n            <input id=\"vel\" type=\"range\" min=\"0\" max=\"99\" value=\"50\" class=\"w-full\">\n            <div class=\"text-sm text-gray-600 mt-2\">v = <span id=\"vval\">0.50</span> c</div>\n          </div>\n\n          <div>\n            <label class=\"block text-sm\">Observer</label>\n            <select id=\"observer\" class=\"w-full p-2 border rounded\"><option value=\"stationary\">Stationary</option><option value=\"moving\">Moving</option></select>\n          </div>\n        </div>\n\n        <div class=\"relative w-full h-[360px] border rounded p-4\">\n          <canvas id=\"relCanvas\" class=\"absolute inset-0 w-full h-full\"></canvas>\n          <div id=\"entities\" class=\"absolute inset-0 pointer-events-none\"></div>\n        </div>\n\n        <div class=\"mt-4 grid grid-cols-3 gap-4 text-center\">\n          <div class=\"p-3 bg-blue-50 rounded\"><div class=\"text-sm\">Gamma (γ)</div><div id=\"gamma\" class=\"font-bold text-blue-600\">1.15</div></div>\n          <div class=\"p-3 bg-green-50 rounded\"><div class=\"text-sm\">Time Dilation</div><div id=\"timeDil\" class=\"font-bold text-green-600\">0.87×</div></div>\n          <div class=\"p-3 bg-yellow-50 rounded\"><div class=\"text-sm\">Length Contraction</div><div id=\"lenCon\" class=\"font-bold text-yellow-600\">0.87×</div></div>\n        </div>\n      </section>\n\n      <div class=\"flex justify-between mt-6\"><button id=\"prevBtn\" class=\"px-4 py-2 bg-gray-300 rounded\" disabled=\"\">Previous</button><button id=\"nextBtn\" class=\"px-4 py-2 bg-blue-600 text-white rounded\">Next</button></div>\n    </main>\n  </div>\n\n  <div id=\"quizModal\" class=\"hidden fixed inset-0 bg-black bg-opacity-40 items-center justify-center\"><div class=\"bg-white p-6 rounded max-w-lg w-full m-6\"><h3 class=\"text-xl font-bold mb-4\">Quick Quiz</h3><div id=\"quizContent\"></div><div class=\"mt-4 flex justify-end gap-2\"><button id=\"closeQuiz\" class=\"px-3 py-2 rounded bg-gray-200\">Close</button><button id=\"submitQuiz\" class=\"px-3 py-2 rounded bg-blue-600 text-white\">Submit</button></div></div></div>\n\n  \n<!-- Topic Quiz System -->","bodyClass":"bg-gray-50 min-h-screen","bodyStyle":"","css":["body{font-family:Inter, system-ui, sans-serif}\n    .step-active{background:#2563eb;color:#fff}\n    .step-inactive{background:#e5e7eb;color:#374151}\n    #relCanvas{background:#f8fafc}\n    .clock{width:40px;height:40px;border-radius:50%;background:#fff;border:2px solid #111;display:flex;align-items:center;justify-content:center;font-weight:600}"],"quiz":null,"tracker":null,"links":[]}