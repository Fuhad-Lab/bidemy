{"slug":"/students/subjects/physics/mechanics/newton-laws-steps/","source":"students/subjects/physics/mechanics/newton-laws-steps.html","area":"students","kind":"content","title":"Newton's Laws - Step by Step Guide","description":"","subject":"physics","body":"<!-- Top Navigation -->\n    <nav class=\"bg-white shadow-sm fixed top-0 w-full z-50\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"flex justify-between h-16\">\n                <div class=\"flex items-center\">\n                    <a href=\"/students/subjects/physics/mechanics/\" class=\"text-gray-600 hover:text-gray-900 mr-4\">\n                        <span class=\"mi -arrow-left\" data-mi=\"arrow_back\">arrow_back</span>\n                    </a>\n                    <h1 class=\"text-xl font-semibold text-gray-900\">Newton's Laws of Motion</h1>\n                </div>\n                <div class=\"flex items-center space-x-4\">\n                    <div class=\"text-sm text-gray-600\">\n                        Progress: <span id=\"progressPercent\">33%</span>\n                    </div>\n                    <div class=\"w-32 h-2 bg-gray-200 rounded-full\">\n                        <div class=\"step-progress h-2 bg-blue-500 rounded-full\" style=\"width: 33%\"></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Main Content -->\n    <main class=\"pt-20 pb-16\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"grid md:grid-cols-12 gap-6\">\n                <!-- Left Sidebar - Steps -->\n                <div class=\"md:col-span-3\">\n                    <div class=\"bg-white rounded-lg shadow-sm p-4\">\n                        <h3 class=\"font-semibold mb-4\">Learning Steps</h3>\n                        <ul class=\"space-y-2\">\n                            <li>\n                                <button class=\"w-full text-left px-3 py-2 rounded bg-blue-50 text-blue-600\">\n                                    <span class=\"mi -book-open mr-2\" data-mi=\"auto_stories\">auto_stories</span>\n                                    First Law of Motion\n                                </button>\n                            </li>\n                            <li>\n                                <button class=\"w-full text-left px-3 py-2 rounded text-gray-600 hover:bg-gray-50\">\n                                    <span class=\"mi -book mr-2\" data-mi=\"menu_book\">menu_book</span>\n                                    Second Law of Motion\n                                </button>\n                            </li>\n                            <li>\n                                <button class=\"w-full text-left px-3 py-2 rounded text-gray-600 hover:bg-gray-50\">\n                                    <span class=\"mi -book mr-2\" data-mi=\"menu_book\">menu_book</span>\n                                    Third Law of Motion\n                                </button>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n\n                <!-- Main Content Area -->\n                <div class=\"md:col-span-9\">\n                    <!-- Current Step Content -->\n                    <div class=\"bg-white rounded-lg shadow-sm p-6 mb-6\">\n                        <div class=\"space-y-6\">\n                            <div class=\"bg-blue-50 border-l-4 border-blue-500 p-4\">\n                                <h4 class=\"font-semibold mb-2\">Key Concept</h4>\n                                <p>An object will remain at rest or in uniform motion in a straight line unless acted upon by an external force.</p>\n                            </div>\n\n                            <div>\n                                <h4 class=\"font-semibold mb-3\">Understanding Inertia</h4>\n                                <p class=\"mb-4\">Inertia is the resistance of an object to any change in its state of motion. This includes:</p>\n                                <ul class=\"list-disc pl-6 space-y-2 text-gray-600\">\n                                    <li>Changes in speed</li>\n                                    <li>Changes in direction</li>\n                                    <li>Starting from rest</li>\n                                    <li>Coming to a stop</li>\n                                </ul>\n                            </div>\n\n                            <div>\n                                <h4 class=\"font-semibold mb-3\">Real-World Examples</h4>\n                                <div class=\"grid sm:grid-cols-2 gap-4\">\n                                    <div class=\"bg-gray-50 p-4 rounded-lg\">\n                                        <h5 class=\"font-medium mb-2\">Example 1: Car Braking</h5>\n                                        <p class=\"text-gray-600\">Passengers lean forward when a car suddenly brakes due to their inertia.</p>\n                                    </div>\n                                    <div class=\"bg-gray-50 p-4 rounded-lg\">\n                                        <h5 class=\"font-medium mb-2\">Example 2: Table Cloth Trick</h5>\n                                        <p class=\"text-gray-600\">Objects on a tablecloth stay in place when the cloth is quickly pulled away.</p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Resources Section -->\n                    <div class=\"bg-white rounded-lg shadow-sm p-6\">\n                        <h3 class=\"text-lg font-semibold mb-4\">Resources</h3>\n                        <div class=\"grid sm:grid-cols-2 lg:grid-cols-3 gap-4\">\n                            <!-- Video Resource -->\n                            <div class=\"resource-card bg-gray-50 rounded-lg p-4 cursor-pointer\">\n                                <div class=\"text-blue-500 mb-3\">\n                                    <span class=\"mi -play-circle text-2xl\" data-mi=\"play_circle\">play_circle</span>\n                                </div>\n                                <h4 class=\"font-medium mb-2\">Understanding Inertia</h4>\n                                <p class=\"text-sm text-gray-600\">5-minute video with demonstrations</p>\n                            </div>\n\n                            <!-- Simulation Resource -->\n                            <div class=\"resource-card bg-gray-50 rounded-lg p-4 cursor-pointer\">\n                                <div class=\"text-blue-500 mb-3\">\n                                    <span class=\"mi -laptop-code text-2xl\" data-mi=\"help_outline\">help_outline</span>\n                                </div>\n                                <h4 class=\"font-medium mb-2\">Interactive Forces Lab</h4>\n                                <p class=\"text-sm text-gray-600\">Experiment with forces and motion</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    <!-- Bottom Navigation -->\n    <div class=\"fixed bottom-0 w-full bg-white border-t border-gray-200\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"flex justify-between py-4\">\n                <button disabled=\"\" class=\"px-4 py-2 text-gray-400 cursor-not-allowed\">\n                    <span class=\"mi -chevron-left mr-2\" data-mi=\"chevron_left\">chevron_left</span>\n                    Previous\n                </button>\n                <button id=\"nextStep\" class=\"px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600\">\n                    Next\n                    <span class=\"mi -chevron-right ml-2\" data-mi=\"chevron_right\">chevron_right</span>\n                </button>\n            </div>\n        </div>\n    </div>\n\n    <!-- Quiz Modal -->\n    <div id=\"quizModal\" class=\"hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full\">\n        <div class=\"relative top-20 mx-auto p-5 border w-full max-w-2xl shadow-lg rounded-md bg-white\">\n            <div class=\"p-6\">\n                <h3 class=\"text-xl font-semibold mb-4\">Knowledge Check</h3>\n                <div class=\"mb-6\">\n                    <p class=\"mb-4\">What happens to an object in motion if no external forces act on it?</p>\n                    <div class=\"space-y-2\">\n                        <label class=\"flex items-center space-x-3 p-3 rounded-lg border hover:bg-gray-50 cursor-pointer\">\n                            <input type=\"radio\" name=\"q1\" value=\"0\" class=\"h-4 w-4 text-blue-600\">\n                            <span>It gradually slows down</span>\n                        </label>\n                        <label class=\"flex items-center space-x-3 p-3 rounded-lg border hover:bg-gray-50 cursor-pointer\">\n                            <input type=\"radio\" name=\"q1\" value=\"1\" class=\"h-4 w-4 text-blue-600\">\n                            <span>It continues moving at constant velocity</span>\n                        </label>\n                        <label class=\"flex items-center space-x-3 p-3 rounded-lg border hover:bg-gray-50 cursor-pointer\">\n                            <input type=\"radio\" name=\"q1\" value=\"2\" class=\"h-4 w-4 text-blue-600\">\n                            <span>It speeds up</span>\n                        </label>\n                        <label class=\"flex items-center space-x-3 p-3 rounded-lg border hover:bg-gray-50 cursor-pointer\">\n                            <input type=\"radio\" name=\"q1\" value=\"3\" class=\"h-4 w-4 text-blue-600\">\n                            <span>It changes direction</span>\n                        </label>\n                    </div>\n                </div>\n                <div class=\"flex justify-end\">\n                    <button class=\"px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600\">\n                        Submit Answer\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    \n    \n<!-- Topic Quiz System -->","bodyClass":"bg-gray-50","bodyStyle":"","css":[".step-progress {\n            transition: width 0.3s ease-in-out;\n        }\n        .resource-card {\n            transition: transform 0.2s;\n        }\n        .resource-card:hover {\n            transform: translateY(-4px);\n        }"],"quiz":null,"tracker":null,"links":[]}