{"slug":"/students/subjects/physics/mechanics/New-folder/simple-machines/","source":"students/subjects/physics/mechanics/New folder/simple-machines.html","area":"students","kind":"content","title":"Simple Machines - Step-by-Step Interactive Module","description":"","subject":"physics","body":"<nav class=\"bg-blue-700 p-4 text-white text-xl font-bold\">Simple Machines: Interactive Learning</nav>\n  <div class=\"flex\">\n    <!-- Sidebar Steps -->\n    <aside class=\"w-64 bg-white shadow-md p-4 min-h-screen\">\n      <h2 class=\"text-lg font-semibold mb-4\">Steps</h2>\n      <ul id=\"stepsList\" class=\"space-y-2\"></ul>\n    </aside>\n    <!-- Main Content -->\n    <main class=\"flex-1 p-8\">\n      <div id=\"progressBar\" class=\"mb-6 h-3 bg-gray-200 rounded-full overflow-hidden\">\n        <div id=\"progress\" class=\"h-full bg-blue-600 transition-all\" style=\"width: 0%\"></div>\n      </div>\n      <div id=\"stepContent\" class=\"bg-white rounded shadow p-6 min-h-[300px]\"></div>\n      <div class=\"flex justify-between mt-8\">\n        <button id=\"prevBtn\" class=\"px-4 py-2 bg-gray-300 rounded hover:bg-gray-400\" disabled=\"\">Previous</button>\n        <button id=\"nextBtn\" class=\"px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700\">Next</button>\n      </div>\n    </main>\n  </div>\n\n  <!-- Quiz Modal -->\n  <div id=\"quizModal\" class=\"fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center hidden\">\n    <div class=\"bg-white p-8 rounded shadow-lg max-w-lg w-full\">\n      <h3 class=\"text-xl font-bold mb-4\">Quiz Time!</h3>\n      <div id=\"quizContent\"></div>\n      <button id=\"closeQuiz\" class=\"mt-6 px-4 py-2 bg-blue-600 text-white rounded\">Close</button>\n    </div>\n  </div>\n\n  <!-- Simulation Modal -->\n  <div id=\"simModal\" class=\"fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center hidden\">\n    <div class=\"bg-white p-8 rounded shadow-lg max-w-2xl w-full\">\n      <h3 class=\"text-xl font-bold mb-4\">Simple Machines Simulation</h3>\n      <div id=\"simContent\" class=\"mb-4\"></div>\n      <button id=\"closeSim\" class=\"px-4 py-2 bg-blue-600 text-white rounded\">Close</button>\n    </div>\n  </div>","bodyClass":"bg-gray-50 min-h-screen","bodyStyle":"","css":[".step-active { background-color: #2563eb; color: white; }\n    .step-inactive { background-color: #e5e7eb; color: #374151; }"],"quiz":null,"tracker":null,"links":[]}