{"slug":"/students/subjects/physics/statmech/statistical-mechanics-interactive/","source":"students/subjects/physics/statmech/statistical-mechanics-interactive.html","area":"students","kind":"content","title":"Statistical Mechanics - Interactive","description":"","subject":"physics","body":"<nav class=\"bg-blue-700 p-4 text-white\"><div class=\"max-w-6xl mx-auto\">Statistical Mechanics</div></nav>\n  <div class=\"p-6 max-w-6xl mx-auto\">\n    <div class=\"bg-white p-6 rounded shadow\">\n      <h2 class=\"font-bold mb-4\">Maxwell-Boltzmann Distribution Demo</h2>\n      <div class=\"grid grid-cols-2 gap-4\">\n        <div>\n          <label class=\"block text-sm\">Temperature (K)</label>\n          <input id=\"temp\" type=\"range\" min=\"100\" max=\"2000\" value=\"300\" class=\"w-full\">\n          <div class=\"text-sm text-gray-600 mt-2\">T = <span id=\"tempVal\">300</span> K</div>\n          <label class=\"block text-sm mt-4\">Number of particles</label>\n          <input id=\"nParticles\" type=\"range\" min=\"50\" max=\"1000\" value=\"300\" class=\"w-full\">\n          <div class=\"text-sm text-gray-600 mt-2\">N = <span id=\"nVal\">300</span></div>\n        </div>\n        <div>\n          <canvas id=\"smCanvas\" width=\"600\" height=\"300\" class=\"w-full border rounded\"></canvas>\n        </div>\n      </div>\n\n      <div class=\"mt-4 grid grid-cols-3 gap-4 text-center\">\n        <div class=\"p-3 bg-blue-50 rounded\"><div class=\"text-sm\">Mean speed</div><div id=\"meanSpeed\" class=\"font-bold text-blue-600\">0</div></div>\n        <div class=\"p-3 bg-green-50 rounded\"><div class=\"text-sm\">Most probable</div><div id=\"mpSpeed\" class=\"font-bold text-green-600\">0</div></div>\n        <div class=\"p-3 bg-yellow-50 rounded\"><div class=\"text-sm\">Std dev</div><div id=\"stdDev\" class=\"font-bold text-yellow-600\">0</div></div>\n      </div>\n\n      <div class=\"mt-6 flex justify-end\"><button id=\"quizBtn\" class=\"px-4 py-2 bg-blue-600 text-white rounded\">Quiz</button></div>\n    </div>\n  </div>\n\n  <div id=\"quizModal\" class=\"hidden fixed inset-0 bg-black bg-opacity-40 items-center justify-center\"><div class=\"bg-white p-6 rounded max-w-lg w-full m-6\"><h3 class=\"font-bold mb-4\">Quick Quiz</h3><div id=\"quizContent\"></div><div class=\"mt-4 flex justify-end gap-2\"><button id=\"closeQuiz\" class=\"px-3 py-2 rounded bg-gray-200\">Close</button><button id=\"submitQuiz\" class=\"px-3 py-2 rounded bg-blue-600 text-white\">Submit</button></div></div></div>\n\n  \n<!-- Topic Quiz System -->","bodyClass":"bg-gray-50 min-h-screen","bodyStyle":"","css":["body{font-family:Inter,system-ui,sans-serif}.step-active{background:#2563eb;color:#fff}.step-inactive{background:#e5e7eb;color:#374151}#smCanvas{background:#f8fafc}"],"quiz":null,"tracker":null,"links":[]}