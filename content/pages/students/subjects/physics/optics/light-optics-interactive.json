{"slug":"/students/subjects/physics/optics/light-optics-interactive/","source":"students/subjects/physics/optics/light-optics-interactive.html","area":"students","kind":"content","title":"Light and Optics - Interactive Learning","description":"","subject":"physics","body":"<nav class=\"bg-blue-700 p-4\">\n        <div class=\"max-w-7xl mx-auto px-4 flex justify-between items-center\">\n            <a href=\"/students/subjects/physics/\" class=\"text-white hover:text-blue-100 flex items-center gap-2\">\n                <span class=\"mi -arrow-left\" data-mi=\"arrow_back\">arrow_back</span>\n                <span>Back to Physics</span>\n            </a>\n            <h1 class=\"text-white text-xl font-bold\">Light and Optics</h1>\n        </div>\n    </nav>\n\n    <div class=\"flex\">\n        <!-- Sidebar Steps -->\n        <aside class=\"w-64 bg-white shadow-md p-4 min-h-screen\">\n            <h2 class=\"text-lg font-semibold mb-4\">Learning Steps</h2>\n            <ul id=\"stepsList\" class=\"space-y-2\"></ul>\n        </aside>\n\n        <!-- Main Content -->\n        <main class=\"flex-1 p-8\">\n            <div id=\"progressBar\" class=\"mb-6 h-3 bg-gray-200 rounded-full overflow-hidden\">\n                <div id=\"progress\" class=\"h-full bg-blue-600 transition-all\" style=\"width: 0%\"></div>\n            </div>\n\n            <div id=\"stepContent\" class=\"bg-white rounded-xl shadow-sm p-6 min-h-[300px]\"></div>\n\n            <!-- Ray Diagram Simulation -->\n            <div id=\"simulationContainer\" class=\"mt-6 bg-white rounded-xl shadow-sm p-6\">\n                <h3 class=\"text-lg font-semibold mb-4\">Interactive Ray Diagram</h3>\n                <div class=\"flex gap-4 mb-4\">\n                    <button id=\"convexLensBtn\" class=\"px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700\">\n                        Convex Lens\n                    </button>\n                    <button id=\"concaveLensBtn\" class=\"px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300\">\n                        Concave Lens\n                    </button>\n                    <button id=\"mirrorBtn\" class=\"px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300\">\n                        Mirror\n                    </button>\n                </div>\n                <canvas id=\"opticsCanvas\" class=\"w-full border rounded-lg bg-gray-50\" height=\"400\"></canvas>\n                <div class=\"mt-4 grid grid-cols-2 gap-4\">\n                    <div>\n                        <label class=\"block text-sm font-medium text-gray-700\">Object Distance (cm)</label>\n                        <input type=\"range\" id=\"objectDistanceSlider\" min=\"10\" max=\"100\" value=\"50\" class=\"w-full\">\n                        <span id=\"objectDistanceValue\" class=\"text-sm text-gray-600\">50 cm</span>\n                    </div>\n                    <div>\n                        <label class=\"block text-sm font-medium text-gray-700\">Focal Length (cm)</label>\n                        <input type=\"range\" id=\"focalLengthSlider\" min=\"10\" max=\"50\" value=\"30\" class=\"w-full\">\n                        <span id=\"focalLengthValue\" class=\"text-sm text-gray-600\">30 cm</span>\n                    </div>\n                </div>\n                <div class=\"mt-4 p-4 bg-blue-50 rounded-lg\">\n                    <div class=\"grid grid-cols-2 gap-4 text-center\">\n                        <div>\n                            <p class=\"text-sm font-medium text-gray-700\">Image Distance</p>\n                            <p id=\"imageDistanceDisplay\" class=\"text-lg font-bold text-blue-600\">--</p>\n                        </div>\n                        <div>\n                            <p class=\"text-sm font-medium text-gray-700\">Magnification</p>\n                            <p id=\"magnificationDisplay\" class=\"text-lg font-bold text-blue-600\">--</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"flex justify-between mt-8\">\n                <button id=\"prevBtn\" class=\"px-4 py-2 bg-gray-300 rounded hover:bg-gray-400\" disabled=\"\">Previous</button>\n                <button id=\"nextBtn\" class=\"px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700\">Next</button>\n            </div>\n        </main>\n    </div>\n\n    <!-- Quiz Modal -->\n    <div id=\"quizModal\" class=\"fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center hidden\">\n        <div class=\"bg-white p-8 rounded-xl shadow-lg max-w-lg w-full\">\n            <h3 class=\"text-xl font-bold mb-4\">Check Your Understanding</h3>\n            <div id=\"quizContent\"></div>\n            <div class=\"mt-6 flex justify-end gap-4\">\n                <button id=\"closeQuiz\" class=\"px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300\">Close</button>\n                <button id=\"submitQuiz\" class=\"px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700\">Submit</button>\n            </div>\n        </div>\n    </div>\n\n    \n<!-- Topic Quiz System -->","bodyClass":"bg-gray-50 min-h-screen font-inter","bodyStyle":"","css":[".step-active { background-color: #2563eb; color: white; }\n        .step-inactive { background-color: #e5e7eb; color: #374151; }\n        #opticsCanvas { touch-action: none; }"],"quiz":null,"tracker":null,"links":[]}