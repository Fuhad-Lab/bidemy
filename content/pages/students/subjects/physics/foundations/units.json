{"slug":"/students/subjects/physics/foundations/units/","source":"students/subjects/physics/foundations/units.html","area":"students","kind":"content","title":"Units & Dimensional Analysis | Physics Foundations","description":"","subject":"physics","body":"<div class=\"max-w-6xl mx-auto\">\n        <nav class=\"mb-8\">\n            <a href=\"/students/subjects/physics/foundations/\" class=\"text-blue-600 hover:text-blue-700\">← Back to Foundations</a>\n        </nav>\n\n        <div class=\"content-card rounded-xl p-8\">\n            <header class=\"mb-12\">\n                <h1 class=\"text-3xl font-bold text-gray-800 mb-4\">Units &amp; Dimensional Analysis</h1>\n                <p class=\"text-lg text-gray-600\">Understanding measurement systems and using dimensions to analyze physical equations</p>\n            </header>\n\n            <div class=\"grid gap-8\">\n                <!-- SI Units -->\n                <section>\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">SI Units System</h2>\n                    <div class=\"bg-white/50 rounded-lg p-6\">\n                        <div class=\"grid md:grid-cols-2 gap-6\">\n                            <div>\n                                <h3 class=\"font-medium text-gray-800 mb-3\">Base Units</h3>\n                                <div class=\"overflow-x-auto\">\n                                    <table class=\"w-full text-sm\">\n                                        <thead>\n                                            <tr class=\"text-left\">\n                                                <th class=\"pb-2 pr-4\">Quantity</th>\n                                                <th class=\"pb-2 pr-4\">Unit</th>\n                                                <th class=\"pb-2\">Symbol</th>\n                                            </tr>\n                                        </thead>\n                                        <tbody class=\"text-gray-700\">\n                                            <tr>\n                                                <td class=\"pb-2 pr-4\">Length</td>\n                                                <td class=\"pb-2 pr-4\">meter</td>\n                                                <td class=\"pb-2\">m</td>\n                                            </tr>\n                                            <tr>\n                                                <td class=\"pb-2 pr-4\">Mass</td>\n                                                <td class=\"pb-2 pr-4\">kilogram</td>\n                                                <td class=\"pb-2\">kg</td>\n                                            </tr>\n                                            <tr>\n                                                <td class=\"pb-2 pr-4\">Time</td>\n                                                <td class=\"pb-2 pr-4\">second</td>\n                                                <td class=\"pb-2\">s</td>\n                                            </tr>\n                                        </tbody>\n                                    </table>\n                                </div>\n                            </div>\n                            <div>\n                                <h3 class=\"font-medium text-gray-800 mb-3\">Common Prefixes</h3>\n                                <div class=\"overflow-x-auto\">\n                                    <table class=\"w-full text-sm\">\n                                        <thead>\n                                            <tr class=\"text-left\">\n                                                <th class=\"pb-2 pr-4\">Prefix</th>\n                                                <th class=\"pb-2 pr-4\">Symbol</th>\n                                                <th class=\"pb-2\">Factor</th>\n                                            </tr>\n                                        </thead>\n                                        <tbody class=\"text-gray-700\">\n                                            <tr>\n                                                <td class=\"pb-2 pr-4\">mega</td>\n                                                <td class=\"pb-2 pr-4\">M</td>\n                                                <td class=\"pb-2\">10⁶</td>\n                                            </tr>\n                                            <tr>\n                                                <td class=\"pb-2 pr-4\">kilo</td>\n                                                <td class=\"pb-2 pr-4\">k</td>\n                                                <td class=\"pb-2\">10³</td>\n                                            </tr>\n                                            <tr>\n                                                <td class=\"pb-2 pr-4\">milli</td>\n                                                <td class=\"pb-2 pr-4\">m</td>\n                                                <td class=\"pb-2\">10⁻³</td>\n                                            </tr>\n                                            <tr>\n                                                <td class=\"pb-2 pr-4\">micro</td>\n                                                <td class=\"pb-2 pr-4\">μ</td>\n                                                <td class=\"pb-2\">10⁻⁶</td>\n                                            </tr>\n                                        </tbody>\n                                    </table>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n\n                <!-- Unit Conversion -->\n                <section>\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Unit Conversion</h2>\n                    <div class=\"bg-white/50 rounded-lg p-6\">\n                        <div class=\"grid md:grid-cols-2 gap-6\">\n                            <div>\n                                <h3 class=\"font-medium text-gray-800 mb-3\">Conversion Method</h3>\n                                <ol class=\"space-y-2 text-sm text-gray-700 list-decimal pl-4\">\n                                    <li>Write the given quantity with its unit</li>\n                                    <li>Write the conversion factor as a fraction</li>\n                                    <li>Multiply and cancel out units</li>\n                                    <li>Calculate the final answer</li>\n                                </ol>\n                            </div>\n                            <div>\n                                <h3 class=\"font-medium text-gray-800 mb-3\">Common Conversions</h3>\n                                <ul class=\"space-y-2 text-sm text-gray-700\">\n                                    <li>1 km = 1000 m</li>\n                                    <li>1 hour = 3600 seconds</li>\n                                    <li>1 kg = 1000 g</li>\n                                    <li>1 N = 1 kg⋅m/s²</li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n\n                <!-- Dimensional Analysis -->\n                <section>\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Dimensional Analysis</h2>\n                    <div class=\"space-y-6\">\n                        <!-- Basic Dimensions -->\n                        <div class=\"bg-white/50 rounded-lg p-6\">\n                            <h3 class=\"font-medium text-gray-800 mb-3\">Basic Dimensions</h3>\n                            <div class=\"grid md:grid-cols-2 gap-6\">\n                                <div>\n                                    <p class=\"text-gray-700 mb-3\">Fundamental Dimensions:</p>\n                                    <ul class=\"space-y-2 text-sm text-gray-700\">\n                                        <li>• Length: [L]</li>\n                                        <li>• Mass: [M]</li>\n                                        <li>• Time: [T]</li>\n                                        <li>• Temperature: [θ]</li>\n                                    </ul>\n                                </div>\n                                <div>\n                                    <p class=\"text-gray-700 mb-3\">Examples of Derived Dimensions:</p>\n                                    <ul class=\"space-y-2 text-sm text-gray-700\">\n                                        <li>• Velocity: [LT⁻¹]</li>\n                                        <li>• Force: [MLT⁻²]</li>\n                                        <li>• Energy: [ML²T⁻²]</li>\n                                        <li>• Pressure: [ML⁻¹T⁻²]</li>\n                                    </ul>\n                                </div>\n                            </div>\n                        </div>\n\n                        <!-- Uses of Dimensional Analysis -->\n                        <div class=\"bg-white/50 rounded-lg p-6\">\n                            <h3 class=\"font-medium text-gray-800 mb-3\">Uses of Dimensional Analysis</h3>\n                            <div class=\"grid md:grid-cols-2 gap-6\">\n                                <div>\n                                    <h4 class=\"font-medium text-gray-800 mb-2\">Checking Equations</h4>\n                                    <ul class=\"space-y-2 text-sm text-gray-700\">\n                                        <li>• Verify equation correctness</li>\n                                        <li>• Find missing constants</li>\n                                        <li>• Identify errors</li>\n                                    </ul>\n                                </div>\n                                <div>\n                                    <h4 class=\"font-medium text-gray-800 mb-2\">Deriving Relations</h4>\n                                    <ul class=\"space-y-2 text-sm text-gray-700\">\n                                        <li>• Find possible relationships</li>\n                                        <li>• Determine dependencies</li>\n                                        <li>• Simplify problems</li>\n                                    </ul>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n\n                <!-- Dimensional Analysis Method -->\n                <section>\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Steps in Dimensional Analysis</h2>\n                    <div class=\"bg-white/50 rounded-lg p-6\">\n                        <ol class=\"space-y-4 text-gray-700\">\n                            <li>\n                                <p class=\"font-medium mb-2\">1. Write Dimensional Formula</p>\n                                <p class=\"text-sm\">Express each quantity in terms of fundamental dimensions [M], [L], [T]</p>\n                            </li>\n                            <li>\n                                <p class=\"font-medium mb-2\">2. Check Dimensional Homogeneity</p>\n                                <p class=\"text-sm\">Both sides of equation must have same dimensions</p>\n                            </li>\n                            <li>\n                                <p class=\"font-medium mb-2\">3. Apply Dimensional Methods</p>\n                                <p class=\"text-sm\">Use methods like Rayleigh's method for complex problems</p>\n                            </li>\n                        </ol>\n                    </div>\n                </section>\n\n                <!-- Practice Problems -->\n                <section>\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Practice Problems</h2>\n                    <div class=\"bg-white/50 rounded-lg p-6\">\n                        <ol class=\"list-decimal pl-6 space-y-4 text-gray-700\">\n                            <li>\n                                <p class=\"font-medium mb-2\">Unit Conversion:</p>\n                                <p>Convert 72 kilometers per hour to meters per second.</p>\n                                <p class=\"mt-2 text-sm text-blue-600\">Hint: Use 1 km = 1000 m and 1 hr = 3600 s</p>\n                            </li>\n                            <li>\n                                <p class=\"font-medium mb-2\">Dimensional Check:</p>\n                                <p>Find the dimensions of pressure (P = F/A) using fundamental dimensions.</p>\n                                <p class=\"mt-2 text-sm text-blue-600\">Hint: Force dimensions are [MLT⁻²] and area is [L²]</p>\n                            </li>\n                            <li>\n                                <p class=\"font-medium mb-2\">Dimensional Analysis:</p>\n                                <p>The period (T) of a simple pendulum depends on length (l) and acceleration due to gravity (g). Find the relationship.</p>\n                                <p class=\"mt-2 text-sm text-blue-600\">Hint: Use T = k√(l/g) where k is dimensionless</p>\n                            </li>\n                        </ol>\n                    </div>\n                </section>\n\n                <!-- Common Errors -->\n                <section>\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Common Errors to Avoid</h2>\n                    <div class=\"bg-white/50 rounded-lg p-6\">\n                        <div class=\"grid md:grid-cols-2 gap-6\">\n                            <div>\n                                <h3 class=\"font-medium text-gray-800 mb-2\">In Unit Conversion</h3>\n                                <ul class=\"space-y-2 text-sm text-gray-700\">\n                                    <li>• Forgetting to convert all units</li>\n                                    <li>• Using wrong conversion factors</li>\n                                    <li>• Not canceling units properly</li>\n                                </ul>\n                            </div>\n                            <div>\n                                <h3 class=\"font-medium text-gray-800 mb-2\">In Dimensional Analysis</h3>\n                                <ul class=\"space-y-2 text-sm text-gray-700\">\n                                    <li>• Missing fundamental dimensions</li>\n                                    <li>• Incorrect dimensional equations</li>\n                                    <li>• Not checking homogeneity</li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n            </div>\n        </div>\n    </div>\n<!-- Topic Quiz System -->","bodyClass":"min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 p-6","bodyStyle":"","css":["body { font-family: 'Inter', sans-serif; }\n        .content-card {\n            -webkit-backdrop-filter: blur(16px);\n            backdrop-filter: blur(16px);\n            background: rgba(255, 255, 255, 0.7);\n            border: 1px solid rgba(255, 255, 255, 0.2);\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\n        }"],"quiz":null,"tracker":null,"links":[]}