{"slug":"/students/subjects/physics/fluids/fluid-dynamics-interactive/","source":"students/subjects/physics/fluids/fluid-dynamics-interactive.html","area":"students","kind":"content","title":"Fluid Dynamics - Interactive Learning","description":"","subject":"physics","body":"<nav class=\"bg-blue-700 p-4\">\n        <div class=\"max-w-7xl mx-auto px-4 flex justify-between items-center\">\n            <a href=\"/students/subjects/physics/\" class=\"text-white hover:text-blue-100 flex items-center gap-2\">\n                <span class=\"mi -arrow-left\" data-mi=\"arrow_back\">arrow_back</span>\n                <span>Back to Physics</span>\n            </a>\n            <h1 class=\"text-white text-xl font-bold\">Fluid Dynamics</h1>\n        </div>\n    </nav>\n\n    <div class=\"flex\">\n        <!-- Sidebar Steps -->\n        <aside class=\"w-64 bg-white shadow-md p-4 min-h-screen\">\n            <h2 class=\"text-lg font-semibold mb-4\">Learning Steps</h2>\n            <ul id=\"stepsList\" class=\"space-y-2\"></ul>\n        </aside>\n\n        <!-- Main Content -->\n        <main class=\"flex-1 p-8\">\n            <div id=\"progressBar\" class=\"mb-6 h-3 bg-gray-200 rounded-full overflow-hidden\">\n                <div id=\"progress\" class=\"h-full bg-blue-600 transition-all\" style=\"width: 0%\"></div>\n            </div>\n\n            <div id=\"stepContent\" class=\"bg-white rounded-xl shadow-sm p-6 min-h-[300px]\"></div>\n\n            <!-- Fluid Simulation -->\n            <div id=\"simulationContainer\" class=\"mt-6 bg-white rounded-xl shadow-sm p-6\">\n                <div class=\"flex gap-4 mb-4\">\n                    <button id=\"laminarBtn\" class=\"px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700\">\n                        Laminar Flow\n                    </button>\n                    <button id=\"turbulentBtn\" class=\"px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300\">\n                        Turbulent Flow\n                    </button>\n                    <button id=\"pressureBtn\" class=\"px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300\">\n                        Pressure Changes\n                    </button>\n                </div>\n\n                <div class=\"relative w-full h-[400px] border rounded-lg bg-gray-50\">\n                    <canvas id=\"fluidCanvas\" class=\"absolute top-0 left-0 w-full h-full\"></canvas>\n                    <div id=\"particleContainer\"></div>\n                </div>\n\n                <div class=\"mt-4 grid grid-cols-2 gap-4\">\n                    <div>\n                        <label class=\"block text-sm font-medium text-gray-700\">Flow Speed</label>\n                        <input type=\"range\" id=\"speedSlider\" min=\"1\" max=\"10\" value=\"5\" class=\"w-full\">\n                        <span id=\"speedValue\" class=\"text-sm text-gray-600\">5 m/s</span>\n                    </div>\n                    <div>\n                        <label class=\"block text-sm font-medium text-gray-700\">Viscosity</label>\n                        <input type=\"range\" id=\"viscositySlider\" min=\"1\" max=\"100\" value=\"50\" class=\"w-full\">\n                        <span id=\"viscosityValue\" class=\"text-sm text-gray-600\">50 cP</span>\n                    </div>\n                </div>\n\n                <div class=\"mt-4 grid grid-cols-3 gap-4 text-center\">\n                    <div class=\"p-4 bg-blue-50 rounded-lg\">\n                        <p class=\"text-sm font-medium text-gray-700\">Reynolds Number</p>\n                        <p id=\"reynoldsDisplay\" class=\"text-lg font-bold text-blue-600\">2000</p>\n                    </div>\n                    <div class=\"p-4 bg-green-50 rounded-lg\">\n                        <p class=\"text-sm font-medium text-gray-700\">Flow Rate</p>\n                        <p id=\"flowRateDisplay\" class=\"text-lg font-bold text-green-600\">0.5 m³/s</p>\n                    </div>\n                    <div class=\"p-4 bg-yellow-50 rounded-lg\">\n                        <p class=\"text-sm font-medium text-gray-700\">Pressure Drop</p>\n                        <p id=\"pressureDisplay\" class=\"text-lg font-bold text-yellow-600\">0 Pa</p>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"flex justify-between mt-8\">\n                <button id=\"prevBtn\" class=\"px-4 py-2 bg-gray-300 rounded hover:bg-gray-400\" disabled=\"\">Previous</button>\n                <button id=\"nextBtn\" class=\"px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700\">Next</button>\n            </div>\n        </main>\n    </div>\n\n    <!-- Quiz Modal -->\n    <div id=\"quizModal\" class=\"fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center hidden\">\n        <div class=\"bg-white p-8 rounded-xl shadow-lg max-w-lg w-full\">\n            <h3 class=\"text-xl font-bold mb-4\">Check Your Understanding</h3>\n            <div id=\"quizContent\"></div>\n            <div class=\"mt-6 flex justify-end gap-4\">\n                <button id=\"closeQuiz\" class=\"px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300\">Close</button>\n                <button id=\"submitQuiz\" class=\"px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700\">Submit</button>\n            </div>\n        </div>\n    </div>\n\n    \n<!-- Topic Quiz System -->","bodyClass":"bg-gray-50 min-h-screen font-inter","bodyStyle":"","css":[".step-active { background-color: #2563eb; color: white; }\n        .step-inactive { background-color: #e5e7eb; color: #374151; }\n        #fluidCanvas { touch-action: none; }\n        .particle {\n            width: 4px;\n            height: 4px;\n            background-color: #3b82f6;\n            position: absolute;\n            border-radius: 50%;\n            transition: transform 0.1s linear;\n        }"],"quiz":null,"tracker":null,"links":[]}