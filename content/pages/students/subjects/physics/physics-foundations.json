{"slug":"/students/subjects/physics/physics-foundations/","source":"students/subjects/physics/physics-foundations.html","area":"students","kind":"division","title":"Physics Foundations - Learning Dashboard","description":"","subject":"physics","body":"<!-- Top Navigation -->\n    <nav class=\"bg-white shadow-sm sticky top-0 z-50\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"flex justify-between h-16 items-center\">\n                <div class=\"flex items-center\">\n                    <a href=\"/subjects/physics/\" class=\"text-gray-600 hover:text-gray-900 mr-4\">\n                        <span class=\"mi -arrow-left\" data-mi=\"arrow_back\">arrow_back</span>\n                    </a>\n                    <h1 class=\"text-xl font-semibold text-gray-900\">Physics Foundations</h1>\n                </div>\n                <div class=\"flex items-center\">\n                    <span class=\"text-sm text-gray-500\">4 Topics</span>\n                </div>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <div class=\"hero-gradient text-white py-16 px-4\">\n        <div class=\"max-w-4xl mx-auto text-center\">\n            <h1 class=\"text-4xl md:text-5xl font-bold mb-4 animate-fade-in-up\">Physics Foundations</h1>\n            <p class=\"text-xl md:text-2xl text-blue-100 mb-6 animate-fade-in-up\" style=\"animation-delay: 0.1s\">\n                Master the essential building blocks of physics\n            </p>\n            <p class=\"text-blue-200 max-w-2xl mx-auto animate-fade-in-up\" style=\"animation-delay: 0.2s\">\n                Before diving into complex physics concepts, you need a solid foundation. \n                Learn about measurement, quantities, and vectors—the language of physics.\n            </p>\n        </div>\n    </div>\n\n    <!-- Learning Objectives -->\n    <div class=\"max-w-7xl mx-auto px-4 -mt-8\">\n        <div class=\"bg-white rounded-xl shadow-lg p-6 mb-8\">\n            <h2 class=\"text-xl font-semibold text-gray-800 mb-4 flex items-center\">\n                <span class=\"mi -bullseye text-blue-500 mr-3\" data-mi=\"adjust\">adjust</span>Learning Objectives\n            </h2>\n            <div class=\"grid md:grid-cols-2 gap-4\">\n                <div class=\"flex items-start space-x-3\">\n                    <span class=\"mi -check-circle text-green-500 mt-1\" data-mi=\"check_circle\">check_circle</span>\n                    <span class=\"text-gray-700\">Understand how to measure physical quantities accurately</span>\n                </div>\n                <div class=\"flex items-start space-x-3\">\n                    <span class=\"mi -check-circle text-green-500 mt-1\" data-mi=\"check_circle\">check_circle</span>\n                    <span class=\"text-gray-700\">Distinguish between scalar and vector quantities</span>\n                </div>\n                <div class=\"flex items-start space-x-3\">\n                    <span class=\"mi -check-circle text-green-500 mt-1\" data-mi=\"check_circle\">check_circle</span>\n                    <span class=\"text-gray-700\">Identify fundamental and derived quantities</span>\n                </div>\n                <div class=\"flex items-start space-x-3\">\n                    <span class=\"mi -check-circle text-green-500 mt-1\" data-mi=\"check_circle\">check_circle</span>\n                    <span class=\"text-gray-700\">Perform vector operations and calculations</span>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Topics Grid -->\n    <main class=\"max-w-7xl mx-auto px-4 py-8\">\n        <h2 class=\"text-2xl font-bold text-gray-800 mb-6\">Topics in This Section</h2>\n        \n        <div class=\"grid md:grid-cols-2 gap-6 mb-12\">\n            <!-- Measurement Topic -->\n            <a href=\"/students/subjects/physics/foundations/measurement/\" class=\"topic-card bg-white rounded-xl shadow-md overflow-hidden card-blue block\">\n                <div class=\"p-6\">\n                    <div class=\"flex items-center mb-4\">\n                        <div class=\"w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mr-4\">\n                            <span class=\"mi -ruler-combined text-blue-600 text-xl\" data-mi=\"straighten\">straighten</span>\n                        </div>\n                        <div>\n                            <h3 class=\"text-xl font-semibold text-gray-800\">Measurement in Physics</h3>\n                            <p class=\"text-sm text-gray-500\">3 sections • ~30 min</p>\n                        </div>\n                    </div>\n                    <p class=\"text-gray-600 mb-4\">\n                        Learn about precision, accuracy, and how to use measuring instruments like vernier calipers and micrometers.\n                    </p>\n                    <div class=\"flex items-center text-sm text-gray-500\">\n                        <span class=\"bg-blue-100 text-blue-700 px-2 py-1 rounded mr-2\">Interactive</span>\n                        <span class=\"bg-green-100 text-green-700 px-2 py-1 rounded\">Quiz</span>\n                    </div>\n                </div>\n            </a>\n\n            <!-- Quantities Topic -->\n            <a href=\"/students/subjects/physics/foundations/quantities/\" class=\"topic-card bg-white rounded-xl shadow-md overflow-hidden card-green block\">\n                <div class=\"p-6\">\n                    <div class=\"flex items-center mb-4\">\n                        <div class=\"w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mr-4\">\n                            <span class=\"mi -weight text-green-600 text-xl\" data-mi=\"fitness_center\">fitness_center</span>\n                        </div>\n                        <div>\n                            <h3 class=\"text-xl font-semibold text-gray-800\">Physical Quantities</h3>\n                            <p class=\"text-sm text-gray-500\">3 sections • ~25 min</p>\n                        </div>\n                    </div>\n                    <p class=\"text-gray-600 mb-4\">\n                        Understand the difference between fundamental and derived quantities, and the SI system of units.\n                    </p>\n                    <div class=\"flex items-center text-sm text-gray-500\">\n                        <span class=\"bg-blue-100 text-blue-700 px-2 py-1 rounded mr-2\">Interactive</span>\n                        <span class=\"bg-green-100 text-green-700 px-2 py-1 rounded\">Quiz</span>\n                    </div>\n                </div>\n            </a>\n\n            <!-- Vectors Topic -->\n            <a href=\"/students/subjects/physics/foundations/vectors/\" class=\"topic-card bg-white rounded-xl shadow-md overflow-hidden card-purple block\">\n                <div class=\"p-6\">\n                    <div class=\"flex items-center mb-4\">\n                        <div class=\"w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mr-4\">\n                            <span class=\"mi -arrows-alt text-purple-600 text-xl\" data-mi=\"help_outline\">help_outline</span>\n                        </div>\n                        <div>\n                            <h3 class=\"text-xl font-semibold text-gray-800\">Scalars and Vectors</h3>\n                            <p class=\"text-sm text-gray-500\">4 sections • ~35 min</p>\n                        </div>\n                    </div>\n                    <p class=\"text-gray-600 mb-4\">\n                        Learn about quantities with direction, vector operations, and how to resolve vectors into components.\n                    </p>\n                    <div class=\"flex items-center text-sm text-gray-500\">\n                        <span class=\"bg-purple-100 text-purple-700 px-2 py-1 rounded mr-2\">Simulation</span>\n                        <span class=\"bg-green-100 text-green-700 px-2 py-1 rounded\">Quiz</span>\n                    </div>\n                </div>\n            </a>\n\n            <!-- Coming Soon -->\n            <div class=\"topic-card bg-white rounded-xl shadow-md overflow-hidden card-orange opacity-75\">\n                <div class=\"p-6\">\n                    <div class=\"flex items-center mb-4\">\n                        <div class=\"w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center mr-4\">\n                            <span class=\"mi -calculator text-orange-600 text-xl\" data-mi=\"calculate\">calculate</span>\n                        </div>\n                        <div>\n                            <h3 class=\"text-xl font-semibold text-gray-800\">Dimensional Analysis</h3>\n                            <p class=\"text-sm text-gray-500\">Coming Soon</p>\n                        </div>\n                    </div>\n                    <p class=\"text-gray-600 mb-4\">\n                        Learn how to use dimensional analysis to check equations and derive relationships.\n                    </p>\n                    <div class=\"flex items-center text-sm text-gray-500\">\n                        <span class=\"bg-orange-100 text-orange-700 px-2 py-1 rounded\">In Development</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Why Learn Foundations -->\n        <div class=\"bg-gradient-to-r from-blue-600 to-indigo-600 rounded-xl p-8 text-white mb-8\">\n            <h2 class=\"text-2xl font-bold mb-4\">Why Learn Physics Foundations?</h2>\n            <div class=\"grid md:grid-cols-3 gap-6\">\n                <div>\n                    <div class=\"w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center mb-3\">\n                        <span class=\"mi -language text-xl\" data-mi=\"language\">language</span>\n                    </div>\n                    <h3 class=\"font-semibold mb-2\">The Language of Physics</h3>\n                    <p class=\"text-blue-100 text-sm\">Measurements and quantities form the vocabulary scientists use to describe the universe.</p>\n                </div>\n                <div>\n                    <div class=\"w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center mb-3\">\n                        <span class=\"mi -cogs text-xl\" data-mi=\"settings\">settings</span>\n                    </div>\n                    <h3 class=\"font-semibold mb-2\">Essential Tools</h3>\n                    <p class=\"text-blue-100 text-sm\">Vectors and units are the tools you'll use in every physics topic, from mechanics to electromagnetism.</p>\n                </div>\n                <div>\n                    <div class=\"w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center mb-3\">\n                        <span class=\"mi -check-double text-xl\" data-mi=\"help_outline\">help_outline</span>\n                    </div>\n                    <h3 class=\"font-semibold mb-2\">Problem Solving</h3>\n                    <p class=\"text-blue-100 text-sm\">Strong foundations help you tackle complex problems with confidence and accuracy.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Start Learning Button -->\n        <div class=\"text-center mb-8\">\n            <a href=\"/students/subjects/physics/foundations/measurement/\" class=\"inline-flex items-center px-8 py-4 bg-blue-600 text-white font-semibold rounded-full hover:bg-blue-700 transition-all shadow-lg hover:shadow-xl\">\n                Start Learning <span class=\"mi -arrow-right ml-2\" data-mi=\"arrow_forward\">arrow_forward</span>\n            </a>\n        </div>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"bg-white border-t py-6\">\n        <div class=\"max-w-7xl mx-auto px-4 text-center text-gray-500 text-sm\">\n            <p>Physics Foundations • Part of the Physics Learning Series</p>\n        </div>\n    </footer>\n\n    <!-- Topic Quiz System -->","bodyClass":"bg-gray-50 min-h-screen","bodyStyle":"","css":["@keyframes fade-in-up {\n            from { opacity: 0; transform: translateY(20px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        .animate-fade-in-up { animation: fade-in-up 0.5s ease-out forwards; }\n        .topic-card { transition: all 0.3s ease; }\n        .topic-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(0,0,0,0.1); }\n        \n        /* Hero gradient */\n        .hero-gradient {\n            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 50%, #60a5fa 100%);\n        }\n        \n        /* Card colors */\n        .card-blue { border-left: 4px solid #3b82f6; }\n        .card-green { border-left: 4px solid #10b981; }\n        .card-purple { border-left: 4px solid #8b5cf6; }\n        .card-orange { border-left: 4px solid #f59e0b; }\n        \n        @media (max-width: 768px) {\n            .topic-card { margin-bottom: 1rem; }\n        }"],"quiz":null,"tracker":null,"links":[]}