{"slug":"/students/subjects/physics/projects/safety/","source":"students/subjects/physics/projects/safety.html","area":"students","kind":"content","title":"Safety & Ethics | Physics","description":"","subject":"physics","body":"<div class=\"max-w-4xl mx-auto\">\n    <nav class=\"mb-6\"><a href=\"/students/subjects/physics/projects/\" class=\"text-blue-600\">← Back to Projects</a></nav>\n    <article class=\"content-card rounded-xl p-8\">\n      <h1 class=\"text-2xl font-bold mb-2\">Safety &amp; Ethics</h1>\n      <p class=\"text-gray-700 mb-4\">Laboratory safety, proper handling of equipment and ethical considerations for experiments.</p>\n        <h3 class=\"mt-6 text-md font-semibold\">Quick checklist</h3>\n        <ul class=\"list-disc list-inside text-gray-700\">\n          <li>Wear eye protection when working with lasers or chemicals.</li>\n          <li>Disconnect power supplies before adjusting circuits.</li>\n          <li>Dispose of waste safely and follow supervisor guidance.</li>\n        </ul>\n    </article>\n  </div>\n<!-- Topic Quiz System -->","bodyClass":"min-h-screen bg-gradient-to-br from-green-50 to-lime-50 p-6","bodyStyle":"","css":["body{font-family:Inter, sans-serif} .content-card{-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);background:rgba(255,255,255,0.8);border:1px solid rgba(255,255,255,0.2);box-shadow:0 8px 32px rgba(0,0,0,0.06);}"],"quiz":null,"tracker":null,"links":[]}