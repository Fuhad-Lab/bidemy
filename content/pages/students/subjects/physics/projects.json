{"slug":"/students/subjects/physics/projects/","source":"students/subjects/physics/projects/index.html","area":"students","kind":"division","title":"Projects, Practical Skills & Experimentation","description":"","subject":"physics","body":"<div class=\"max-w-6xl mx-auto\">\n    <nav class=\"mb-8\"><a href=\"/students/subjects/physics/\" class=\"text-blue-600 hover:text-blue-700\">← Back to Physics</a></nav>\n\n    <div class=\"content-card rounded-xl p-8\">\n      <header class=\"mb-12\">\n        <h1 class=\"text-3xl font-bold text-gray-800 mb-4\">Projects, Practical Skills &amp; Experimentation</h1>\n        <p class=\"text-lg text-gray-600\">Ongoing projects, laboratory technique, data handling and exam-style practicals.</p>\n      </header>\n\n      <div class=\"grid gap-8\">\n        <section>\n          <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Focus Areas</h2>\n          <div class=\"grid md:grid-cols-2 gap-6\">\n            <a href=\"/students/subjects/physics/projects/projects-overview/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Projects &amp; Design</h3>\n              <p class=\"text-sm text-gray-600\">Design experiments and demonstrations: circuits, motion setups, optics projects.</p>\n            </a>\n\n            <a href=\"/students/subjects/physics/projects/lab-skills/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Laboratory Technique</h3>\n              <p class=\"text-sm text-gray-600\">Data collection, uncertainty analysis and graphing methods.</p>\n            </a>\n\n            <a href=\"/students/subjects/physics/projects/past-papers/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Past Practical Questions</h3>\n              <p class=\"text-sm text-gray-600\">WAEC-style practicals and mock exam guidance.</p>\n            </a>\n\n            <a href=\"/students/subjects/physics/projects/safety/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Safety &amp; Ethics</h3>\n              <p class=\"text-sm text-gray-600\">Lab safety practices, handling chemicals and electrical safety.</p>\n            </a>\n          </div>\n        </section>\n\n        <section>\n          <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Why this module</h2>\n          <div class=\"bg-white/50 rounded-lg p-6\">\n            <p class=\"text-gray-700\">Practical competence cements theory and is assessed heavily in exams; projects integrate multiple modules and develop experimental skills.</p>\n          </div>\n        </section>\n      </div>\n    </div>\n  </div>","bodyClass":"min-h-screen bg-gradient-to-br from-green-50 to-lime-50 p-6","bodyStyle":"","css":["body{font-family:Inter, sans-serif} .content-card{-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);background:rgba(255,255,255,0.7);border:1px solid rgba(255,255,255,0.2);box-shadow:0 8px 32px rgba(0,0,0,0.1)}"],"quiz":null,"tracker":null,"links":[]}