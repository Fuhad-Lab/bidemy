{"slug":"/students/subjects/physics/modern/","source":"students/subjects/physics/modern/index.html","area":"students","kind":"division","title":"Modern Physics, Atomic & Nuclear","description":"","subject":"physics","body":"<div class=\"max-w-6xl mx-auto\">\n    <nav class=\"mb-8\"><a href=\"/students/subjects/physics/\" class=\"text-blue-600 hover:text-blue-700\">← Back to Physics</a></nav>\n\n    <div class=\"content-card rounded-xl p-8\">\n      <header class=\"mb-12\">\n        <h1 class=\"text-3xl font-bold text-gray-800 mb-4\">Modern Physics, Atomic &amp; Nuclear</h1>\n        <p class=\"text-lg text-gray-600\">Atomic models, quantization, photoelectric ideas, nuclear basics and modern applications.</p>\n      </header>\n\n      <div class=\"grid gap-8\">\n        <section>\n          <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Core Topics</h2>\n          <div class=\"grid md:grid-cols-2 gap-6\">\n            <a href=\"/students/subjects/physics/modern/atomic-models/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Atomic Models</h3>\n              <p class=\"text-sm text-gray-600\">Historical models through to the modern quantum picture.</p>\n            </a>\n\n            <a href=\"/students/subjects/physics/modern/quantization/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Energy Quantization &amp; Duality</h3>\n              <p class=\"text-sm text-gray-600\">Photoelectric effect, quantized energy levels and wave-particle ideas.</p>\n            </a>\n\n            <a href=\"/students/subjects/physics/modern/nuclear/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Nuclear Physics Basics</h3>\n              <p class=\"text-sm text-gray-600\">Radioactivity, decay modes and basic nuclear properties.</p>\n            </a>\n\n            <a href=\"/students/subjects/physics/modern/applications/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Applications</h3>\n              <p class=\"text-sm text-gray-600\">Lasers, semiconductors and atomic physics applications.</p>\n            </a>\n          </div>\n        </section>\n\n        <section>\n          <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Why this module</h2>\n          <div class=\"bg-white/50 rounded-lg p-6\">\n            <p class=\"text-gray-700\">Modern physics builds on classical waves and fields; introduce it after mechanics, waves and electromagnetism.</p>\n          </div>\n        </section>\n      </div>\n    </div>\n  </div>","bodyClass":"min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 p-6","bodyStyle":"","css":["body{font-family:Inter, sans-serif} .content-card{-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);background:rgba(255,255,255,0.7);border:1px solid rgba(255,255,255,0.2);box-shadow:0 8px 32px rgba(0,0,0,0.1)}"],"quiz":null,"tracker":null,"links":[]}