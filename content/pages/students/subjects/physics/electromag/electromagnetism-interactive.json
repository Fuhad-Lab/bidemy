{"slug":"/students/subjects/physics/electromag/electromagnetism-interactive/","source":"students/subjects/physics/electromag/electromagnetism-interactive.html","area":"students","kind":"content","title":"Electromagnetism - Interactive Learning","description":"","subject":"physics","body":"<nav class=\"bg-blue-700 p-4 text-white\">\n    <div class=\"max-w-6xl mx-auto flex justify-between items-center\">\n      <a href=\"/students/subjects/physics/\">← Back to Physics</a>\n      <h1 class=\"font-bold\">Electromagnetism</h1>\n    </div>\n  </nav>\n\n  <div class=\"flex\">\n    <aside class=\"w-64 bg-white p-4 border-r\">\n      <h2 class=\"font-semibold mb-4\">Steps</h2>\n      <ul id=\"stepsList\" class=\"space-y-2\"></ul>\n    </aside>\n\n    <main class=\"flex-1 p-6\">\n      <div id=\"progressBar\" class=\"h-3 bg-gray-200 rounded-full overflow-hidden mb-6\"><div id=\"progress\" class=\"h-full bg-blue-600\" style=\"width:0%\"></div></div>\n\n      <div id=\"stepContent\" class=\"bg-white p-6 rounded shadow min-h-[220px]\"></div>\n\n      <section class=\"mt-6 bg-white p-6 rounded shadow\">\n        <div class=\"flex gap-4 mb-4\">\n          <button id=\"electricBtn\" class=\"px-4 py-2 bg-blue-600 text-white rounded\">Electric Fields</button>\n          <button id=\"magneticBtn\" class=\"px-4 py-2 bg-gray-200 rounded\">Magnetic Fields</button>\n          <button id=\"emWaveBtn\" class=\"px-4 py-2 bg-gray-200 rounded\">EM Waves</button>\n        </div>\n\n        <div class=\"relative w-full h-[420px] border rounded\">\n          <canvas id=\"emCanvas\" class=\"absolute inset-0 w-full h-full\"></canvas>\n          <div id=\"charges\" class=\"absolute inset-0 pointer-events-none\"></div>\n        </div>\n\n        <div class=\"mt-4 grid grid-cols-2 gap-4\">\n          <div>\n            <label class=\"block text-sm\">Charge +/−</label>\n            <select id=\"chargeType\" class=\"w-full p-2 border rounded\">\n              <option value=\"+\">Positive</option>\n              <option value=\"-\">Negative</option>\n            </select>\n            <button id=\"addCharge\" class=\"mt-2 px-3 py-2 bg-green-600 text-white rounded\">Add Charge</button>\n          </div>\n\n          <div>\n            <label class=\"block text-sm\">Field Sample Density</label>\n            <input id=\"density\" type=\"range\" min=\"6\" max=\"28\" value=\"14\" class=\"w-full\">\n            <div class=\"text-sm text-gray-600 mt-2\">Adjust vectors drawn for field visualization</div>\n          </div>\n        </div>\n\n        <div class=\"mt-4 grid grid-cols-3 gap-4 text-center\">\n          <div class=\"p-3 bg-blue-50 rounded\"><div class=\"text-sm\">Total Charges</div><div id=\"totalCharges\" class=\"font-bold text-blue-600\">0</div></div>\n          <div class=\"p-3 bg-green-50 rounded\"><div class=\"text-sm\">Field Strength (sample)</div><div id=\"fieldSample\" class=\"font-bold text-green-600\">0</div></div>\n          <div class=\"p-3 bg-yellow-50 rounded\"><div class=\"text-sm\">Energy (qual.)</div><div id=\"energySample\" class=\"font-bold text-yellow-600\">0</div></div>\n        </div>\n      </section>\n\n      <div class=\"flex justify-between mt-6\">\n        <button id=\"prevBtn\" class=\"px-4 py-2 bg-gray-300 rounded\" disabled=\"\">Previous</button>\n        <button id=\"nextBtn\" class=\"px-4 py-2 bg-blue-600 text-white rounded\">Next</button>\n      </div>\n    </main>\n  </div>\n\n  <div id=\"quizModal\" class=\"hidden fixed inset-0 bg-black bg-opacity-40 items-center justify-center\">\n    <div class=\"bg-white p-6 rounded max-w-lg w-full m-6\">\n      <h3 class=\"text-xl font-bold mb-4\">Quick Quiz</h3>\n      <div id=\"quizContent\"></div>\n      <div class=\"mt-4 flex justify-end gap-2\"><button id=\"closeQuiz\" class=\"px-3 py-2 rounded bg-gray-200\">Close</button><button id=\"submitQuiz\" class=\"px-3 py-2 rounded bg-blue-600 text-white\">Submit</button></div>\n    </div>\n  </div>\n\n  \n<!-- Topic Quiz System -->","bodyClass":"bg-gray-50 min-h-screen","bodyStyle":"","css":["body { font-family: Inter, system-ui, sans-serif; }\n    .step-active { background-color: #2563eb; color: white; }\n    .step-inactive { background-color: #e5e7eb; color: #374151; }\n    #emCanvas { background: #f8fafc; touch-action: none; }\n    .charge { position: absolute; width: 18px; height: 18px; border-radius: 50%; display:flex;align-items:center;justify-content:center;font-weight:700;color:#fff; }\n    .positive { background:#ef4444; }\n    .negative { background:#3b82f6; }"],"quiz":null,"tracker":null,"links":[]}