{"slug":"/students/subjects/physics/mechanics/","source":"students/subjects/physics/mechanics/index.html","area":"students","kind":"division","title":"Mechanics — Motion, Forces & Energy | Physics","description":"","subject":"physics","body":"<div class=\"max-w-6xl mx-auto\">\n        <nav class=\"mb-8\">\n            <a href=\"/students/subjects/physics/\" class=\"text-blue-600 hover:text-blue-700\">← Back to Physics</a>\n        </nav>\n\n        <div class=\"content-card rounded-xl p-8\">\n            <header class=\"mb-12\">\n                <h1 class=\"text-3xl font-bold text-gray-800 mb-4\">Mechanics</h1>\n                <p class=\"text-lg text-gray-600\">Understanding motion, forces, energy, and their interactions in physical systems</p>\n            </header>\n\n            <div class=\"grid gap-8\">\n                <!-- Introduction -->\n                <section class=\"mb-8\">\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Why Study Mechanics?</h2>\n                    <div class=\"bg-white/50 rounded-lg p-6\">\n                        <p class=\"text-gray-700\">Mechanics forms the foundation of classical physics and explains how objects move and interact. From the motion of planets to the workings of machines, mechanical principles govern much of the physical world around us.</p>\n                    </div>\n                </section>\n\n                <!-- Topics Grid -->\n                <section class=\"mb-8\">\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Core Topics</h2>\n                    <div class=\"grid md:grid-cols-2 gap-6\">\n                        <!-- Linear Motion -->\n                        <a href=\"/students/subjects/physics/mechanics/linear-motion/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">Linear Motion</h3>\n                            <p class=\"text-sm text-gray-600\">Displacement, velocity, and acceleration in straight-line motion</p>\n                        </a>\n\n                        <!-- Equations of Motion -->\n                        <a href=\"/students/subjects/physics/mechanics/equations-of-motion/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">Equations of Motion</h3>\n                            <p class=\"text-sm text-gray-600\">Motion under gravity and uniformly accelerated motion</p>\n                        </a>\n\n                        <!-- Projectile Motion -->\n                        <a href=\"/students/subjects/physics/mechanics/projectile-motion/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">Projectile Motion</h3>\n                            <p class=\"text-sm text-gray-600\">Motion of objects under gravity with initial velocity</p>\n                        </a>\n\n                        <!-- Circular Motion -->\n                        <a href=\"/students/subjects/physics/mechanics/circular-motion/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">Circular Motion</h3>\n                            <p class=\"text-sm text-gray-600\">Basic concepts of motion in a circle</p>\n                        </a>\n\n                        <!-- Newton's Laws -->\n                        <a href=\"/students/subjects/physics/mechanics/newtons-laws/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">Newton's Laws of Motion</h3>\n                            <p class=\"text-sm text-gray-600\">The three fundamental laws governing motion and forces</p>\n                        </a>\n\n                        <!-- Momentum -->\n                        <a href=\"/students/subjects/physics/mechanics/momentum/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">Momentum &amp; Impulse</h3>\n                            <p class=\"text-sm text-gray-600\">Linear momentum, conservation, and impulse-momentum theorem</p>\n                        </a>\n\n                        <!-- Equilibrium -->\n                        <a href=\"/students/subjects/physics/mechanics/equilibrium/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">Equilibrium of Forces</h3>\n                            <p class=\"text-sm text-gray-600\">Static equilibrium and balanced forces</p>\n                        </a>\n\n                        <!-- Friction -->\n                        <a href=\"/students/subjects/physics/mechanics/friction/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">Friction</h3>\n                            <p class=\"text-sm text-gray-600\">Types of friction and their effects on motion</p>\n                        </a>\n\n                        <!-- Work & Energy -->\n                        <a href=\"/students/subjects/physics/mechanics/work-energy-power/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">Work, Energy &amp; Power</h3>\n                            <p class=\"text-sm text-gray-600\">Energy transformations, conservation, and power calculations</p>\n                        </a>\n\n                        <!-- Simple Machines -->\n                        <a href=\"/students/subjects/physics/mechanics/simple-machines/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">Simple Machines</h3>\n                            <p class=\"text-sm text-gray-600\">Mechanical advantage and types of simple machines</p>\n                        </a>\n                    </div>\n                </section>\n\n                <!-- Key Concepts -->\n                <section class=\"mb-8\">\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Key Concepts</h2>\n                    <div class=\"grid md:grid-cols-2 gap-6\">\n                        <div class=\"p-6 bg-white/50 rounded-lg\">\n                            <h3 class=\"font-medium text-gray-800 mb-2\">Mathematical Tools</h3>\n                            <ul class=\"space-y-2 text-sm text-gray-700\">\n                                <li>• Vector analysis</li>\n                                <li>• Differential calculus</li>\n                                <li>• Graphical interpretation</li>\n                                <li>• Problem-solving strategies</li>\n                            </ul>\n                        </div>\n                        <div class=\"p-6 bg-white/50 rounded-lg\">\n                            <h3 class=\"font-medium text-gray-800 mb-2\">Conservation Laws</h3>\n                            <ul class=\"space-y-2 text-sm text-gray-700\">\n                                <li>• Conservation of energy</li>\n                                <li>• Conservation of momentum</li>\n                                <li>• Conservation of angular momentum</li>\n                                <li>• System analysis</li>\n                            </ul>\n                        </div>\n                    </div>\n                </section>\n\n                <!-- Applications -->\n                <section>\n                    <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Real-World Applications</h2>\n                    <div class=\"grid md:grid-cols-3 gap-6\">\n                        <div class=\"p-6 bg-white/50 rounded-lg\">\n                            <h3 class=\"font-medium text-gray-800 mb-2\">Engineering</h3>\n                            <ul class=\"space-y-2 text-sm text-gray-700\">\n                                <li>• Machine design</li>\n                                <li>• Structural analysis</li>\n                                <li>• Vehicle dynamics</li>\n                            </ul>\n                        </div>\n                        <div class=\"p-6 bg-white/50 rounded-lg\">\n                            <h3 class=\"font-medium text-gray-800 mb-2\">Space Science</h3>\n                            <ul class=\"space-y-2 text-sm text-gray-700\">\n                                <li>• Orbital mechanics</li>\n                                <li>• Spacecraft design</li>\n                                <li>• Mission planning</li>\n                            </ul>\n                        </div>\n                        <div class=\"p-6 bg-white/50 rounded-lg\">\n                            <h3 class=\"font-medium text-gray-800 mb-2\">Sports</h3>\n                            <ul class=\"space-y-2 text-sm text-gray-700\">\n                                <li>• Projectile motion</li>\n                                <li>• Impact analysis</li>\n                                <li>• Equipment design</li>\n                            </ul>\n                        </div>\n                    </div>\n                </section>\n            </div>\n        </div>\n    </div>","bodyClass":"min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 p-6","bodyStyle":"","css":["body { font-family: 'Inter', sans-serif; }\n        .content-card {\n            -webkit-backdrop-filter: blur(16px);\n            backdrop-filter: blur(16px);\n            background: rgba(255, 255, 255, 0.7);\n            border: 1px solid rgba(255, 255, 255, 0.2);\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\n        }"],"quiz":null,"tracker":null,"links":[]}