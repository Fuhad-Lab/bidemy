{"slug":"/students/subjects/physics/waves/sound-waves-interactive/","source":"students/subjects/physics/waves/sound-waves-interactive.html","area":"students","kind":"content","title":"Sound and Waves - Interactive Learning","description":"","subject":"physics","body":"<nav class=\"bg-blue-700 p-4\">\n        <div class=\"max-w-7xl mx-auto px-4 flex justify-between items-center\">\n            <a href=\"/students/subjects/physics/\" class=\"text-white hover:text-blue-100 flex items-center gap-2\">\n                <span class=\"mi -arrow-left\" data-mi=\"arrow_back\">arrow_back</span>\n                <span>Back to Physics</span>\n            </a>\n            <h1 class=\"text-white text-xl font-bold\">Sound and Waves</h1>\n        </div>\n    </nav>\n\n    <div class=\"flex\">\n        <!-- Sidebar Steps -->\n        <aside class=\"w-64 bg-white shadow-md p-4 min-h-screen\">\n            <h2 class=\"text-lg font-semibold mb-4\">Learning Steps</h2>\n            <ul id=\"stepsList\" class=\"space-y-2\"></ul>\n        </aside>\n\n        <!-- Main Content -->\n        <main class=\"flex-1 p-8\">\n            <div id=\"progressBar\" class=\"mb-6 h-3 bg-gray-200 rounded-full overflow-hidden\">\n                <div id=\"progress\" class=\"h-full bg-blue-600 transition-all\" style=\"width: 0%\"></div>\n            </div>\n\n            <div id=\"stepContent\" class=\"bg-white rounded-xl shadow-sm p-6 min-h-[300px]\"></div>\n\n            <!-- Wave Simulation -->\n            <div id=\"simulationContainer\" class=\"mt-6 bg-white rounded-xl shadow-sm p-6\">\n                <div class=\"flex gap-4 mb-4\">\n                    <button id=\"standingWaveBtn\" class=\"px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700\">\n                        Standing Wave\n                    </button>\n                    <button id=\"interferenceBtn\" class=\"px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300\">\n                        Wave Interference\n                    </button>\n                    <button id=\"resonanceBtn\" class=\"px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300\">\n                        Resonance\n                    </button>\n                </div>\n\n                <canvas id=\"waveCanvas\" class=\"w-full border rounded-lg bg-gray-50\" height=\"300\"></canvas>\n                \n                <div class=\"mt-4 grid grid-cols-2 gap-4\">\n                    <div>\n                        <label class=\"block text-sm font-medium text-gray-700\">Frequency (Hz)</label>\n                        <input type=\"range\" id=\"frequencySlider\" min=\"1\" max=\"10\" value=\"2\" class=\"w-full\">\n                        <span id=\"frequencyValue\" class=\"text-sm text-gray-600\">2 Hz</span>\n                    </div>\n                    <div>\n                        <label class=\"block text-sm font-medium text-gray-700\">Amplitude</label>\n                        <input type=\"range\" id=\"amplitudeSlider\" min=\"10\" max=\"50\" value=\"30\" class=\"w-full\">\n                        <span id=\"amplitudeValue\" class=\"text-sm text-gray-600\">30 units</span>\n                    </div>\n                </div>\n\n                <!-- Wave Parameters Display -->\n                <div class=\"mt-4 grid grid-cols-3 gap-4\">\n                    <div class=\"p-4 bg-blue-50 rounded-lg text-center\">\n                        <p class=\"text-sm font-medium text-gray-700\">Wavelength</p>\n                        <p id=\"wavelengthDisplay\" class=\"text-lg font-bold text-blue-600\">50 cm</p>\n                    </div>\n                    <div class=\"p-4 bg-green-50 rounded-lg text-center\">\n                        <p class=\"text-sm font-medium text-gray-700\">Period</p>\n                        <p id=\"periodDisplay\" class=\"text-lg font-bold text-green-600\">0.5 s</p>\n                    </div>\n                    <div class=\"p-4 bg-yellow-50 rounded-lg text-center\">\n                        <p class=\"text-sm font-medium text-gray-700\">Wave Speed</p>\n                        <p id=\"speedDisplay\" class=\"text-lg font-bold text-yellow-600\">100 cm/s</p>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"flex justify-between mt-8\">\n                <button id=\"prevBtn\" class=\"px-4 py-2 bg-gray-300 rounded hover:bg-gray-400\" disabled=\"\">Previous</button>\n                <button id=\"nextBtn\" class=\"px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700\">Next</button>\n            </div>\n        </main>\n    </div>\n\n    <!-- Quiz Modal -->\n    <div id=\"quizModal\" class=\"fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center hidden\">\n        <div class=\"bg-white p-8 rounded-xl shadow-lg max-w-lg w-full\">\n            <h3 class=\"text-xl font-bold mb-4\">Check Your Understanding</h3>\n            <div id=\"quizContent\"></div>\n            <div class=\"mt-6 flex justify-end gap-4\">\n                <button id=\"closeQuiz\" class=\"px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300\">Close</button>\n                <button id=\"submitQuiz\" class=\"px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700\">Submit</button>\n            </div>\n        </div>\n    </div>\n\n    \n<!-- Topic Quiz System -->","bodyClass":"bg-gray-50 min-h-screen font-inter","bodyStyle":"","css":[".step-active { background-color: #2563eb; color: white; }\n        .step-inactive { background-color: #e5e7eb; color: #374151; }\n        #waveCanvas { touch-action: none; }\n        @keyframes vibrate {\n            0% { transform: translateX(0); }\n            25% { transform: translateX(-2px); }\n            75% { transform: translateX(2px); }\n            100% { transform: translateX(0); }\n        }\n        .vibrating { animation: vibrate 0.1s infinite; }"],"quiz":null,"tracker":null,"links":[]}