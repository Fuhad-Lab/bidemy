{"slug":"/students/subjects/physics/magnetism/","source":"students/subjects/physics/magnetism/index.html","area":"students","kind":"division","title":"Magnetism & Electromagnetism","description":"","subject":"physics","body":"<div class=\"max-w-6xl mx-auto\">\n    <nav class=\"mb-8\"><a href=\"/students/subjects/physics/\" class=\"text-blue-600 hover:text-blue-700\">← Back to Physics</a></nav>\n\n    <div class=\"content-card rounded-xl p-8\">\n      <header class=\"mb-12\">\n        <h1 class=\"text-3xl font-bold text-gray-800 mb-4\">Magnetism &amp; Electromagnetism</h1>\n        <p class=\"text-lg text-gray-600\">Magnetic fields, forces on currents, electromagnetic induction and applications.</p>\n      </header>\n\n      <div class=\"grid gap-8\">\n        <section>\n          <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Core Topics</h2>\n          <div class=\"grid md:grid-cols-2 gap-6\">\n            <a href=\"/students/subjects/physics/magnetism/magnetic-field/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Magnetic Field Concepts</h3>\n              <p class=\"text-sm text-gray-600\">Field lines, magnetic flux, forces on moving charges and current-carrying wires.</p>\n            </a>\n\n            <a href=\"/students/subjects/physics/magnetism/electromagnet/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Electromagnets &amp; Applications</h3>\n              <p class=\"text-sm text-gray-600\">Design of electromagnets and uses in relays, motors and MRI basics.</p>\n            </a>\n\n            <a href=\"/students/subjects/physics/magnetism/induction/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Electromagnetic Induction</h3>\n              <p class=\"text-sm text-gray-600\">Faraday's law, Lenz's law and generator/transformer intuition.</p>\n            </a>\n\n            <a href=\"/students/subjects/physics/magnetism/practicals/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Key Practicals</h3>\n              <p class=\"text-sm text-gray-600\">Electromagnet experiments, field mapping and induced emf demonstrations.</p>\n            </a>\n          </div>\n        </section>\n\n        <section>\n          <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Why this module</h2>\n          <div class=\"bg-white/50 rounded-lg p-6\">\n            <p class=\"text-gray-700\">Magnetism connects to electricity and is essential for motors, generators and modern devices.</p>\n          </div>\n        </section>\n      </div>\n    </div>\n  </div>","bodyClass":"min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 p-6","bodyStyle":"","css":["body{font-family:Inter, sans-serif} .content-card{-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);background:rgba(255,255,255,0.7);border:1px solid rgba(255,255,255,0.2);box-shadow:0 8px 32px rgba(0,0,0,0.1)}"],"quiz":null,"tracker":null,"links":[]}