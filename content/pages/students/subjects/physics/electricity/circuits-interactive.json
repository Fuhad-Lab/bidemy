{"slug":"/students/subjects/physics/electricity/circuits-interactive/","source":"students/subjects/physics/electricity/circuits-interactive.html","area":"students","kind":"content","title":"Electric Circuits - Interactive Learning","description":"","subject":"physics","body":"<nav class=\"bg-blue-700 p-4\">\n        <div class=\"max-w-7xl mx-auto px-4 flex justify-between items-center\">\n            <a href=\"/students/subjects/physics/\" class=\"text-white hover:text-blue-100 flex items-center gap-2\">\n                <span class=\"mi -arrow-left\" data-mi=\"arrow_back\">arrow_back</span>\n                <span>Back to Physics</span>\n            </a>\n            <h1 class=\"text-white text-xl font-bold\">Electric Circuits</h1>\n        </div>\n    </nav>\n\n    <div class=\"flex\">\n        <!-- Sidebar Steps -->\n        <aside class=\"w-64 bg-white shadow-md p-4 min-h-screen\">\n            <h2 class=\"text-lg font-semibold mb-4\">Learning Steps</h2>\n            <ul id=\"stepsList\" class=\"space-y-2\"></ul>\n        </aside>\n\n        <!-- Main Content -->\n        <main class=\"flex-1 p-8\">\n            <div id=\"progressBar\" class=\"mb-6 h-3 bg-gray-200 rounded-full overflow-hidden\">\n                <div id=\"progress\" class=\"h-full bg-blue-600 transition-all\" style=\"width: 0%\"></div>\n            </div>\n\n            <div id=\"stepContent\" class=\"bg-white rounded-xl shadow-sm p-6 min-h-[300px]\"></div>\n\n            <!-- Circuit Simulation -->\n            <div id=\"simulationContainer\" class=\"mt-6 bg-white rounded-xl shadow-sm p-6\">\n                <h3 class=\"text-lg font-semibold mb-4\">Interactive Circuit Simulation</h3>\n                <div id=\"circuitContainer\" class=\"relative w-full h-[300px] border rounded-lg bg-gray-50\">\n                    <canvas id=\"circuitCanvas\" class=\"absolute top-0 left-0 w-full h-full\"></canvas>\n                    <div id=\"electrons\"></div>\n                </div>\n                <div class=\"mt-4 grid grid-cols-2 gap-4\">\n                    <div>\n                        <label class=\"block text-sm font-medium text-gray-700\">Voltage (V)</label>\n                        <input type=\"range\" id=\"voltageSlider\" min=\"0\" max=\"12\" value=\"6\" class=\"w-full\">\n                        <span id=\"voltageValue\" class=\"text-sm text-gray-600\">6 V</span>\n                    </div>\n                    <div>\n                        <label class=\"block text-sm font-medium text-gray-700\">Resistance (Ω)</label>\n                        <input type=\"range\" id=\"resistanceSlider\" min=\"1\" max=\"20\" value=\"10\" class=\"w-full\">\n                        <span id=\"resistanceValue\" class=\"text-sm text-gray-600\">10 Ω</span>\n                    </div>\n                </div>\n                <div class=\"mt-4 p-4 bg-blue-50 rounded-lg\">\n                    <div class=\"grid grid-cols-3 gap-4 text-center\">\n                        <div>\n                            <p class=\"text-sm font-medium text-gray-700\">Voltage</p>\n                            <p id=\"voltageDisplay\" class=\"text-lg font-bold text-blue-600\">6 V</p>\n                        </div>\n                        <div>\n                            <p class=\"text-sm font-medium text-gray-700\">Current</p>\n                            <p id=\"currentDisplay\" class=\"text-lg font-bold text-blue-600\">0.6 A</p>\n                        </div>\n                        <div>\n                            <p class=\"text-sm font-medium text-gray-700\">Power</p>\n                            <p id=\"powerDisplay\" class=\"text-lg font-bold text-blue-600\">3.6 W</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"flex justify-between mt-8\">\n                <button id=\"prevBtn\" class=\"px-4 py-2 bg-gray-300 rounded hover:bg-gray-400\" disabled=\"\">Previous</button>\n                <button id=\"nextBtn\" class=\"px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700\">Next</button>\n            </div>\n        </main>\n    </div>\n\n    <!-- Quiz Modal -->\n    <div id=\"quizModal\" class=\"fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center hidden\">\n        <div class=\"bg-white p-8 rounded-xl shadow-lg max-w-lg w-full\">\n            <h3 class=\"text-xl font-bold mb-4\">Check Your Understanding</h3>\n            <div id=\"quizContent\"></div>\n            <div class=\"mt-6 flex justify-end gap-4\">\n                <button id=\"closeQuiz\" class=\"px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300\">Close</button>\n                <button id=\"submitQuiz\" class=\"px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700\">Submit</button>\n            </div>\n        </div>\n    </div>\n\n    \n<!-- Topic Quiz System -->","bodyClass":"bg-gray-50 min-h-screen font-inter","bodyStyle":"","css":[".step-active { background-color: #2563eb; color: white; }\n        .step-inactive { background-color: #e5e7eb; color: #374151; }\n        #circuitCanvas { touch-action: none; }\n        .electron { \n            width: 6px;\n            height: 6px;\n            background-color: #3b82f6;\n            border-radius: 50%;\n            position: absolute;\n            transition: transform 0.1s linear;\n        }"],"quiz":null,"tracker":null,"links":[]}