{"slug":"/students/subjects/physics/optics/","source":"students/subjects/physics/optics/index.html","area":"students","kind":"division","title":"Optics — Physics","description":"","subject":"physics","body":"<div class=\"max-w-6xl mx-auto\">\n    <nav class=\"mb-8\"><a href=\"/students/subjects/physics/\" class=\"text-blue-600\">← Back to Physics</a></nav>\n\n    <div class=\"content-card rounded-xl p-8\">\n      <header class=\"mb-6\">\n        <h1 class=\"text-3xl font-bold mb-2 text-gray-800\">Optics</h1>\n        <p class=\"text-gray-600\">Reflection, refraction, lenses, interference and optical instruments.</p>\n      </header>\n\n      <section class=\"mb-6\">\n        <h2 class=\"text-xl font-semibold mb-4\">Core Topics</h2>\n        <div class=\"grid md:grid-cols-2 gap-6\">\n          <a href=\"/students/subjects/physics/optics/reflection/\" class=\"block p-6 bg-white/50 rounded-lg\">Reflection</a>\n          <a href=\"/students/subjects/physics/optics/refraction/\" class=\"block p-6 bg-white/50 rounded-lg\">Refraction &amp; Snell's Law</a>\n          <a href=\"/students/subjects/physics/optics/lenses-mirrors/\" class=\"block p-6 bg-white/50 rounded-lg\">Lenses &amp; Mirrors</a>\n          <a href=\"/students/subjects/physics/optics/interference-diffraction/\" class=\"block p-6 bg-white/50 rounded-lg\">Interference &amp; Diffraction</a>\n        </div>\n      </section>\n\n      <section>\n        <h2 class=\"text-xl font-semibold mb-4\">Why this module</h2>\n        <div class=\"bg-white/50 rounded-lg p-6\">\n          <p class=\"text-gray-700\">Optics is foundational for imaging, sensors and measurement; a hands-on understanding helps with experiments and design.</p>\n        </div>\n      </section>\n    </div>\n  </div>\n\n\n\n\n\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Light &amp; Optics | Physics</title>\n  \n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\">\n  <style>\n    body { font-family: 'Inter', sans-serif; }\n    .content-card {\n      -webkit-backdrop-filter: blur(16px);\n      backdrop-filter: blur(16px);\n      background: rgba(255, 255, 255, 0.7);\n      border: 1px solid rgba(255, 255, 255, 0.2);\n      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\n    }\n  </style>\n\n\n  <div class=\"max-w-6xl mx-auto\">\n    <nav class=\"mb-8\">\n      <a href=\"/students/subjects/physics/\" class=\"text-blue-600 hover:text-blue-700\">← Back to Physics</a>\n    </nav>\n\n    <div class=\"content-card rounded-xl p-8\">\n      <header class=\"mb-12\">\n        <h1 class=\"text-3xl font-bold text-gray-800 mb-4\">Light &amp; Optics</h1>\n        <p class=\"text-lg text-gray-600\">Reflection, refraction, lenses, instruments and lasers with ray diagrams and practicals.</p>\n      </header>\n\n      <div class=\"grid gap-8\">\n        <section>\n          <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Core Topics</h2>\n          <div class=\"grid md:grid-cols-2 gap-6\">\n            <a href=\"/students/subjects/physics/optics/reflection/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Reflection of Light</h3>\n              <p class=\"text-sm text-gray-600\">Plane and curved surfaces; laws of reflection and ray diagrams.</p>\n            </a>\n\n            <a href=\"/students/subjects/physics/optics/refraction/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Refraction &amp; Snell's Law</h3>\n              <p class=\"text-sm text-gray-600\">Snell's law, refractive index and total internal reflection.</p>\n            </a>\n\n            <a href=\"/students/subjects/physics/optics/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Lenses &amp; Image Formation</h3>\n              <p class=\"text-sm text-gray-600\">Lens formula, magnification and ray constructions.</p>\n            </a>\n\n            <a href=\"/students/subjects/physics/optics/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Optical Instruments</h3>\n              <p class=\"text-sm text-gray-600\">Microscope, telescope and resolving power.</p>\n            </a>\n\n            <a href=\"/students/subjects/physics/optics/\" class=\"block p-6 bg-white/50 rounded-lg hover:bg-white/60 transition duration-150\">\n              <h3 class=\"font-semibold text-gray-800 mb-2\">Lasers &amp; Applications</h3>\n              <p class=\"text-sm text-gray-600\">Basic properties of lasers and common applications.</p>\n            </a>\n          </div>\n        </section>\n\n        <section>\n          <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">Why this module</h2>\n          <div class=\"bg-white/50 rounded-lg p-6\">\n            <p class=\"text-gray-700\">Start with geometric optics and ray diagrams before moving to instruments and laser basics.</p>\n          </div>\n        </section>\n      </div>\n    </div>\n  </div>","bodyClass":"min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 p-6","bodyStyle":"","css":["body{font-family:Inter, sans-serif} .content-card{-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);background:rgba(255,255,255,0.75);border:1px solid rgba(255,255,255,0.2);box-shadow:0 8px 32px rgba(0,0,0,0.06);}","body { font-family: 'Inter', sans-serif; }\n    .content-card {\n      -webkit-backdrop-filter: blur(16px);\n      backdrop-filter: blur(16px);\n      background: rgba(255, 255, 255, 0.7);\n      border: 1px solid rgba(255, 255, 255, 0.2);\n      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\n    }"],"quiz":null,"tracker":null,"links":[]}