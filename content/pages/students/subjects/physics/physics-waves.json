{"slug":"/students/subjects/physics/physics-waves/","source":"students/subjects/physics/physics-waves.html","area":"students","kind":"division","title":"Waves & Optics - Physics","description":"","subject":"physics","body":"<nav class=\"fixed inset-x-0 top-0 bg-white/60 backdrop-blur-sm border-b border-blue-100 z-50\">\n    <div class=\"max-w-6xl mx-auto px-4 py-3 flex items-center justify-between\">\n      <a href=\"/students/subjects/physics/physics/\" class=\"text-sm text-blue-600 hover:underline\">← Back to Physics</a>\n      <img src=\"/site/assets/images/logo.png\" alt=\"logo\" class=\"h-10 w-auto\">\n    </div>\n  </nav>\n\n  <main class=\"main-content max-w-6xl mx-auto px-4 pt-24 pb-12\">\n    <header class=\"mb-8\">\n      <h1 class=\"text-3xl font-extrabold text-blue-700 mb-4\">Waves &amp; Optics</h1>\n      <p class=\"text-gray-600\">Explore wave motion, sound, light and their applications in physics.</p>\n    </header>\n\n    <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n      <div class=\"topic-group space-y-4\">\n        <h2 class=\"text-xl font-semibold text-blue-700\">Wave Motion</h2>\n        <div class=\"grid gap-4\">\n          <a href=\"/students/subjects/physics/physics-explanation/\" class=\"topic-card rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 transition hover:border-blue-300\">\n            <h3 class=\"font-semibold text-blue-700\">Transverse &amp; Longitudinal</h3>\n            <p class=\"text-sm text-slate-500 mt-1\">Types of waves and their characteristics</p>\n            <div class=\"mt-3 flex items-center text-xs text-slate-400\">\n              <span class=\"mi -clock mr-1\" data-mi=\"schedule\">schedule</span>\n              <span>20 min</span>\n            </div>\n          </a>\n          <a href=\"/students/subjects/physics/physics-explanation/\" class=\"topic-card rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 transition hover:border-blue-300\">\n            <h3 class=\"font-semibold text-blue-700\">Speed &amp; Frequency</h3>\n            <p class=\"text-sm text-slate-500 mt-1\">Wave equations and relationships</p>\n            <div class=\"mt-3 flex items-center text-xs text-slate-400\">\n              <span class=\"mi -clock mr-1\" data-mi=\"schedule\">schedule</span>\n              <span>25 min</span>\n            </div>\n          </a>\n          <a href=\"/students/subjects/physics/physics-explanation/\" class=\"topic-card rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 transition hover:border-blue-300\">\n            <h3 class=\"font-semibold text-blue-700\">Stationary Waves</h3>\n            <p class=\"text-sm text-slate-500 mt-1\">Standing waves and resonance</p>\n            <div class=\"mt-3 flex items-center text-xs text-slate-400\">\n              <span class=\"mi -clock mr-1\" data-mi=\"schedule\">schedule</span>\n              <span>30 min</span>\n            </div>\n          </a>\n        </div>\n      </div>\n\n      <div class=\"topic-group space-y-4\">\n        <h2 class=\"text-xl font-semibold text-blue-700\">Sound</h2>\n        <div class=\"grid gap-4\">\n          <a href=\"/students/subjects/physics/physics-explanation/\" class=\"topic-card rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 transition hover:border-blue-300\">\n            <h3 class=\"font-semibold text-blue-700\">Sound Basics</h3>\n            <p class=\"text-sm text-slate-500 mt-1\">Wave propagation and speed</p>\n            <div class=\"mt-3 flex items-center text-xs text-slate-400\">\n              <span class=\"mi -clock mr-1\" data-mi=\"schedule\">schedule</span>\n              <span>25 min</span>\n            </div>\n          </a>\n          <a href=\"/students/subjects/physics/physics-explanation/\" class=\"topic-card rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 transition hover:border-blue-300\">\n            <h3 class=\"font-semibold text-blue-700\">Doppler Effect</h3>\n            <p class=\"text-sm text-slate-500 mt-1\">Change in frequency with motion</p>\n            <div class=\"mt-3 flex items-center text-xs text-slate-400\">\n              <span class=\"mi -clock mr-1\" data-mi=\"schedule\">schedule</span>\n              <span>20 min</span>\n            </div>\n          </a>\n          <a href=\"/students/subjects/physics/physics-explanation/\" class=\"topic-card rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 transition hover:border-blue-300\">\n            <h3 class=\"font-semibold text-blue-700\">Applications</h3>\n            <p class=\"text-sm text-slate-500 mt-1\">Musical instruments and devices</p>\n            <div class=\"mt-3 flex items-center text-xs text-slate-400\">\n              <span class=\"mi -clock mr-1\" data-mi=\"schedule\">schedule</span>\n              <span>30 min</span>\n            </div>\n          </a>\n        </div>\n      </div>\n\n      <div class=\"topic-group space-y-4\">\n        <h2 class=\"text-xl font-semibold text-blue-700\">Light &amp; Optics</h2>\n        <div class=\"grid gap-4\">\n          <a href=\"/students/subjects/physics/physics-explanation/\" class=\"topic-card rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 transition hover:border-blue-300\">\n            <h3 class=\"font-semibold text-blue-700\">Reflection</h3>\n            <p class=\"text-sm text-slate-500 mt-1\">Laws and applications</p>\n            <div class=\"mt-3 flex items-center text-xs text-slate-400\">\n              <span class=\"mi -clock mr-1\" data-mi=\"schedule\">schedule</span>\n              <span>25 min</span>\n            </div>\n          </a>\n          <a href=\"/students/subjects/physics/physics-explanation/\" class=\"topic-card rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 transition hover:border-blue-300\">\n            <h3 class=\"font-semibold text-blue-700\">Refraction</h3>\n            <p class=\"text-sm text-slate-500 mt-1\">Light bending and Snell's Law</p>\n            <div class=\"mt-3 flex items-center text-xs text-slate-400\">\n              <span class=\"mi -clock mr-1\" data-mi=\"schedule\">schedule</span>\n              <span>30 min</span>\n            </div>\n          </a>\n          <a href=\"/students/subjects/physics/physics-explanation/\" class=\"topic-card rounded-xl bg-white/60 backdrop-blur-sm shadow-sm border p-5 transition hover:border-blue-300\">\n            <h3 class=\"font-semibold text-blue-700\">Interference</h3>\n            <p class=\"text-sm text-slate-500 mt-1\">Wave nature of light</p>\n            <div class=\"mt-3 flex items-center text-xs text-slate-400\">\n              <span class=\"mi -clock mr-1\" data-mi=\"schedule\">schedule</span>\n              <span>35 min</span>\n            </div>\n          </a>\n        </div>\n      </div>\n    </div>\n  </main>\n\n  \n<!-- Topic Quiz System -->","bodyClass":"min-h-screen bg-gradient-to-br from-blue-50 via-white to-blue-100 font-inter","bodyStyle":"","css":[],"quiz":null,"tracker":null,"links":[]}